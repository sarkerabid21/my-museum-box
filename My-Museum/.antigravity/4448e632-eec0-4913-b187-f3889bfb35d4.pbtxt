            }
            lines {
              text: "    const rotY = facing === \'south\' ? 0 : Math.PI;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const signFrame = new THREE.Mesh("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
