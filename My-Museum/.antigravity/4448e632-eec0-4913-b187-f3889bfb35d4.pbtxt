  code_action {
    action_spec {
      create_file {
        instruction: "import { useEffect, useMemo, useRef, useState } from \'react\';\nimport * as THREE from \'three\';\nimport { RoomEnvironment } from \'three/addons/environments/RoomEnvironment.js\';\nimport {\n  ArrowDown,\n  ArrowLeft,\n  ArrowRight,\n  ArrowUp,\n  ChevronDown,\n  ChevronUp,\n  Eye,\n  FolderKanban,\n  Home,\n  Palette,\n  Plus,\n  Users,\n} from \'lucide-react\';\nimport type {\n  ArtworkItem,\n  AvatarConfig,\n  MuseumMember,\n  MuseumMeta,\n  VisitorPresence,\n  WallTheme,\n} from \'../types/museum\';\nimport { DEFAULT_AVATAR_BY_GENDER } from \'../types/museum\';\nimport {\n  calculateMuseumLayout,\n  clampPlayerPosition,\n  getArtworkPlacement,\n  type MuseumLayout,\n} from \'../museum/layout\';\nimport { animateAvatarRig, buildAvatarRig, type AvatarRig } from \'../three/avatarBuilder\';\nimport { buildMuseumArchitecture, type BuiltMuseum } from \'../three/museumBuilder\';\nimport { createAfterDrawScheduler, detectSoftwareGl } from \'../three/webglUtils\';\n\ninterface Museum3DViewProps {\n  museum: MuseumMeta;\n  avatar: AvatarConfig;\n  artworks: ArtworkItem[];\n  members: MuseumMember[];\n  liveVisitors: VisitorPresence[];\n  showInvitedIn3D: boolean;\n  canCurate: boolean;\n  teleportTargetId: string | null;\n  onClearTeleport: () => void;\n  onSelectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\n  onOpenCatalog: () => void;\n  onOpenUpload: () => void;\n  onOpenAccess: () => void;\n  onReturnHome: () => void;\n  onChangeWallTheme: (theme: WallTheme) => void;\n  onPositionBroadcast?: (x: number, z: number, yaw: number) => void;\n}\n\n// Reusable scratch vectors allocated outside render loop (zero GC)\nconst _forward = new THREE.Vector3();\nconst _right = new THREE.Vector3();\nconst _move = new THREE.Vector3();\nconst _camDesired = new THREE.Vector3();\nconst _camLook = new THREE.Vector3();\n\nconst THEME_FOG_COLOR: Record<WallTheme, number> = {\n  alabaster: 0xeae4da,\n  travertine: 0xdfd5c7,\n  charcoal: 0x1e1c1a,\n};\n\nexport function Museum3DView({\n  museum,\n  avatar,\n  artworks,\n  members,\n  liveVisitors,\n  showInvitedIn3D,\n  canCurate,\n  teleportTargetId,\n  onClearTeleport,\n  onSelectArtwork,\n  onOpenCatalog,\n  onOpenUpload,\n  onOpenAccess,\n  onReturnHome,\n  onChangeWallTheme,\n  onPositionBroadcast,\n}: Museum3DViewProps) {\n  const mountRef = useRef<HTMLDivElement | null>(null);\n  const [cameraMode, setCameraMode] = useState<\'third\' | \'first\'>(\'third\');\n  const [dockCollapsed, setDockCollapsed] = useState(false);\n  const [activeWingLabel, setActiveWingLabel] = useState(\'Entrance Foyer\');\n  const [hoveredTitle, setHoveredTitle] = useState<string | null>(null);\n\n  const layout = useMemo(() => calculateMuseumLayout(artworks.length), [artworks.length]);\n\n  // Combine live Firestore co-visitors + simulated companion avatars for invited members\n  const companionVisitors = useMemo<VisitorPresence[]>(() => {\n    const combined: VisitorPresence[] = [...liveVisitors];\n    if (showInvitedIn3D) {\n      const liveNames = new Set(liveVisitors.map((v) => v.displayName.toLowerCase()));\n      members.forEach((m, idx) => {\n        if (liveNames.has(m.displayName.toLowerCase())) return;\n        const preset = DEFAULT_AVATAR_BY_GENDER[m.gender];\n        const placement = getArtworkPlacement(idx % Math.max(1, artworks.length));\n        combined.push({\n          uid: `invited-${m.id}`,\n          museumId: museum.id,\n          ownerId: museum.ownerId,\n          displayName: m.displayName,\n          gender: m.gender,\n          skinTone: preset.skinTone,\n          hairStyle: preset.hairStyle,\n          hairColor: preset.hairColor,\n          outfitStyle: preset.outfitStyle,\n          outfitColor: m.gender === \'woman\' ? \'#6E2E36\' : \'#2D4739\',\n          accentColor: preset.accentColor,\n          accessory: preset.accessory,\n          x: idx % 2 === 0 ? -2.35 : 2.35,\n          z: Math.min(-1.8, placement.z + 1.2),\n          yaw: idx % 2 === 0 ? Math.PI * 0.35 : -Math.PI * 0.35,\n          isSimulated: true,\n        });\n      });\n    }\n    return combined;\n  }, [liveVisitors, showInvitedIn3D, members, artworks.length, museum.id, museum.ownerId]);\n\n  // Refs bridging React state into stable single-mount WebGL loop\n  const layoutRef = useRef<MuseumLayout>(layout);\n  layoutRef.current = layout;\n  const artworksRef = useRef(artworks);\n  artworksRef.current = artworks;\n  const cameraModeRef = useRef(cameraMode);\n  cameraModeRef.current = cameraMode;\n  const onSelectArtworkRef = useRef(onSelectArtwork);\n  onSelectArtworkRef.current = onSelectArtwork;\n  const onPositionBroadcastRef = useRef(onPositionBroadcast);\n  onPositionBroadcastRef.current = onPositionBroadcast;\n\n  const sceneRef = useRef<THREE.Scene | null>(null);\n  const rendererRef = useRef<THREE.WebGLRenderer | null>(null);\n  const builtMuseumRef = useRef<BuiltMuseum | null>(null);\n  const interactablesRef = useRef<THREE.Object3D[]>([]);\n  const playerRigRef = useRef<AvatarRig | null>(null);\n  const playerSlotRef = useRef<THREE.Group | null>(null);\n  const companionsSlotRef = useRef<THREE.Group | null>(null);\n  const companionRigsRef = useRef<\n    Map<\n      string,\n      {\n        rig: AvatarRig;\n        visitor: VisitorPresence;\n        targetX: number;\n        targetZ: number;\n        targetYaw: number;\n      }\n    >\n  >(new Map());\n\n  // Mutable player kinematics state\n  const playerStateRef = useRef({\n    x: 0,\n    z: 3.2,\n    yaw: 0, // 0 faces -Z down the grand gallery corridor!\n    camYaw: 0,\n    camPitch: 0.22,\n    speed: 0,\n    lastBroadcast: 0,\n  });\n\n  // Mobile/D-pad held input state\n  const virtualKeysRef = useRef<Record<string, boolean>>({});\n\n  // Mount WebGLRenderer & Walkable 3D Museum Scene ONCE\n  useEffect(() => {\n    const container = mountRef.current;\n    if (!container) return;\n\n    const isSoftwareGl = detectSoftwareGl();\n    const renderer = new THREE.WebGLRenderer({\n      antialias: !isSoftwareGl,\n      powerPreference: \'high-performance\',\n    });\n    const width = Math.max(320, container.clientWidth);\n    const height = Math.max(320, container.clientHeight);\n    renderer.setSize(width, height);\n    renderer.setPixelRatio(isSoftwareGl ? 1 : Math.min(window.devicePixelRatio, 2));\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 1.08;\n    renderer.shadowMap.enabled = !isSoftwareGl;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n    renderer.domElement.style.display = \'block\';\n    renderer.domElement.style.width = \'100%\';\n    renderer.domElement.style.height = \'100%\';\n    container.appendChild(renderer.domElement);\n    rendererRef.current = renderer;\n\n    const scene = new THREE.Scene();\n    const fogHex = THEME_FOG_COLOR[museum.wallTheme];\n    scene.background = new THREE.Color(fogHex);\n    scene.fog = new THREE.FogExp2(fogHex, 0.017);\n    sceneRef.current = scene;\n\n    // Mandatory studio environment map for metallic bronze frames & marble reflections\n    const pmrem = new THREE.PMREMGenerator(renderer);\n    const envTex = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;\n    scene.environment = envTex;\n    pmrem.dispose();\n\n    const camera = new THREE.PerspectiveCamera(56, width / height, 0.1, 140);\n    camera.position.set(0, 2.5, 7.6);\n    camera.lookAt(0, 1.8, -6);\n\n    // Warm/cool museum architectural lighting rig (<= 1 shadow caster)\n    const hemiLight = new THREE.HemisphereLight(0xf6f8ff, 0x8b7b6b, 0.92);\n    scene.add(hemiLight);\n\n    const keyDir = new THREE.DirectionalLight(0xfff1dc, 1.35);\n    keyDir.position.set(6, 14, 6);\n    keyDir.castShadow = !isSoftwareGl;\n    keyDir.shadow.mapSize.set(1024, 1024);\n    keyDir.shadow.camera.near = 1;\n    keyDir.shadow.camera.far = 55;\n    keyDir.shadow.camera.left = -18;\n    keyDir.shadow.camera.right = 18;\n    keyDir.shadow.camera.top = 18;\n    keyDir.shadow.camera.bottom = -28;\n    keyDir.shadow.bias = -0.0005;\n    keyDir.shadow.normalBias = 0.02;\n    scene.add(keyDir);\n\n    // Warm gallery corridor fill point lights (capped at 4 for lossless performance)\n    const corridorLights: THREE.PointLight[] = [];\n    for (let i = 0; i < 4; i++) {\n      const pt = new THREE.PointLight(0xffe8c8, 16, 22, 1.7);\n      pt.position.set(0, 5.1, -i * 9.5 - 2);\n      scene.add(pt);\n      corridorLights.push(pt);\n    }\n\n    const playerSlot = new THREE.Group();\n    scene.add(playerSlot);\n    playerSlotRef.current = playerSlot;\n\n    const companionsSlot = new THREE.Group();\n    scene.add(companionsSlot);\n    companionsSlotRef.current = companionsSlot;\n\n    // Keyboard & Pointer controls\n    const keys: Record<string, boolean> = {};\n    let isDragging = false;\n    let dragMoved = false;\n    let lastPointerX = 0;\n    let lastPointerY = 0;\n    const raycaster = new THREE.Raycaster();\n    const pointerNdc = new THREE.Vector2();\n    let lastHoverRaycast = 0;\n\n    const onKeyDown = (e: KeyboardEvent) => {\n      const target = e.target as HTMLElement | null;\n      if (\n        target &&\n        (target.tagName === \'INPUT\' ||\n          target.tagName === \'TEXTAREA\' ||\n          target.tagName === \'SELECT\')\n      ) {\n        return;\n      }\n      keys[e.code] = true;\n      if (e.code === \'KeyV\') {\n        setCameraMode((prev) => (prev === \'third\' ? \'first\' : \'third\'));\n      } else if (e.code === \'KeyH\') {\n        setDockCollapsed((prev) => !prev);\n      }\n    };\n\n    const onKeyUp = (e: KeyboardEvent) => {\n      keys[e.code] = false;\n    };\n\n    const onPointerDown = (e: PointerEvent) => {\n      isDragging = true;\n      dragMoved = false;\n      lastPointerX = e.clientX;\n      lastPointerY = e.clientY;\n    };\n\n    const onPointerMove = (e: PointerEvent) => {\n      if (isDragging) {\n        const dx = e.clientX - lastPointerX;\n        const dy = e.clientY - lastPointerY;\n        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) dragMoved = true;\n        lastPointerX = e.clientX;\n        lastPointerY = e.clientY;\n        playerStateRef.current.camYaw -= dx * 0.0055;\n        playerStateRef.current.camPitch = THREE.MathUtils.clamp(\n          playerStateRef.current.camPitch + dy * 0.0038,\n          -0.2,\n          0.62\n        );\n        return;\n      }\n\n      // Throttled hover raycast on artwork frames\n      const now = performance.now();\n      if (now - lastHoverRaycast < 90) return;\n      lastHoverRaycast = now;\n      const rect = renderer.domElement.getBoundingClientRect();\n      pointerNdc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;\n      pointerNdc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;\n      raycaster.setFromCamera(pointerNdc, camera);\n      const hits = raycaster.intersectObjects(interactablesRef.current, false);\n      if (hits.length > 0 && hits[0].distance < 15) {\n        const id = hits[0].object.userData.artworkId as string | undefined;\n        const found = artworksRef.current.find((a) => a.id === id);\n        renderer.domElement.style.cursor = \'pointer\';\n        setHoveredTitle(found ? found.title : null);\n      } else {\n        renderer.domElement.style.cursor = \'grab\';\n        setHoveredTitle(null);\n      }\n    };\n\n    const onPointerUp = (e: PointerEvent) => {\n      const wasClick = isDragging && !dragMoved;\n      isDragging = false;\n      if (!wasClick) return;\n\n      const rect = renderer.domElement.getBoundingClientRect();\n      pointerNdc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;\n      pointerNdc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;\n      raycaster.setFromCamera(pointerNdc, camera);\n      const hits = raycaster.intersectObjects(interactablesRef.current, false);\n      if (hits.length > 0) {\n        const id = hits[0].object.userData.artworkId as string | undefined;\n        if (id) {\n          const idx = artworksRef.current.findIndex((a) => a.id === id);\n          if (idx >= 0) {\n            onSelectArtworkRef.current(artworksRef.current[idx], idx);\n          }\n        }\n      }\n    };\n\n    const onResize = () => {\n      if (!container) return;\n      const w = Math.max(320, container.clientWidth);\n      const h = Math.max(320, container.clientHeight);\n      camera.aspect = w / h;\n      camera.updateProjectionMatrix();\n      renderer.setSize(w, h);\n    };\n\n    window.addEventListener(\'keydown\', onKeyDown);\n    window.addEventListener(\'keyup\', onKeyUp);\n    window.addEventListener(\'resize\', onResize);\n    renderer.domElement.addEventListener(\'pointerdown\', onPointerDown);\n    window.addEventListener(\'pointermove\', onPointerMove);\n    window.addEventListener(\'pointerup\', onPointerUp);\n\n    const onContextLost = (e: Event) => e.preventDefault();\n    renderer.domElement.addEventListener(\'webglcontextlost\', onContextLost);\n\n    // Animation loop paced via afterDraw() on software WebGL, rAF on GPU\n    const clock = new THREE.Clock();\n    let frameId = 0;\n    let disposed = false;\n    let lastWingCheck = 0;\n\n    const afterDraw = createAfterDrawScheduler(renderer, (id) => {\n      frameId = id;\n    });\n\n    const tick = () => {\n      if (disposed) return;\n      const delta = Math.min(clock.getDelta(), 0.1);\n      const elapsed = clock.getElapsedTime();\n      const ps = playerStateRef.current;\n      const curLayout = layoutRef.current;\n\n      const k = keys;\n      const vk = virtualKeysRef.current;\n      const forwardIn =\n        (k.KeyW || k.ArrowUp || vk.up ? 1 : 0) -\n        (k.KeyS || k.ArrowDown || vk.down ? 1 : 0);\n      const strafeIn =\n        (k.KeyD || k.ArrowRight || vk.right ? 1 : 0) -\n        (k.KeyA || k.ArrowLeft || vk.left ? 1 : 0);\n      const turnLeft = k.KeyQ ? 1 : 0;\n      const turnRight = k.KeyE ? 1 : 0;\n\n      if (turnLeft || turnRight) {\n        ps.camYaw += (turnLeft - turnRight) * 1.9 * delta;\n      }\n\n      const walkSpeed = k.ShiftLeft || k.ShiftRight ? 6.2 : 4.1;\n      _forward.set(-Math.sin(ps.camYaw), 0, -Math.cos(ps.camYaw));\n      _right.set(Math.cos(ps.camYaw), 0, -Math.sin(ps.camYaw));\n      _move.set(0, 0, 0);\n      _move.addScaledVector(_forward, forwardIn);\n      _move.addScaledVector(_right, strafeIn);\n\n      if (_move.lengthSq() > 0.001) {\n        _move.normalize();\n        const nextPos = clampPlayerPosition(\n          ps.x + _move.x * walkSpeed * delta,\n          ps.z + _move.z * walkSpeed * delta,\n          curLayout\n        );\n        ps.x = nextPos.x;\n        ps.z = nextPos.z;\n        ps.speed = walkSpeed;\n\n        // Smoothly orient avatar body toward direction of travel\n        const desiredYaw = Math.atan2(_move.x, _move.z);\n        let diff = desiredYaw - ps.yaw;\n        while (diff > Math.PI) diff -= Math.PI * 2;\n        while (diff < -Math.PI) diff += Math.PI * 2;\n        ps.yaw += diff * (1 - Math.exp(-12 * delta));\n      } else {\n        ps.speed = 0;\n      }\n\n      // Update player avatar rig transform & stride animation\n      const playerRig = playerRigRef.current;\n      if (playerRig) {\n        playerRig.root.position.set(ps.x, 0, ps.z);\n        playerRig.root.rotation.y = ps.yaw;\n        playerRig.root.visible = cameraModeRef.current === \'third\';\n        animateAvatarRig(playerRig, ps.speed, elapsed, delta);\n      }\n\n      // Animate co-visitors (live Firestore interpolation + gentle strolling for invited companions)\n      let companionIdx = 0;\n      companionRigsRef.current.forEach((entry) => {\n        if (entry.visitor.isSimulated) {\n          const baseZ = Math.min(-2.5, -(companionIdx * 4.2 + 3.2));\n          const patrolZ = baseZ + Math.sin(elapsed * 0.35 + companionIdx * 1.9) * 2.2;\n          const patrolX = (companionIdx % 2 === 0 ? -2.6 : 2.6) + Math.cos(elapsed * 0.25 + companionIdx) * 0.4;\n          const dz = patrolZ - entry.rig.root.position.z;\n          const dx = patrolX - entry.rig.root.position.x;\n          entry.rig.root.position.x += dx * (1 - Math.exp(-3 * delta));\n          entry.rig.root.position.z += dz * (1 - Math.exp(-3 * delta));\n          const moveSpeed = Math.hypot(dx, dz) / Math.max(delta, 0.016);\n          if (moveSpeed > 0.15) {\n            entry.rig.root.rotation.y = Math.atan2(dx, dz);\n          }\n          animateAvatarRig(entry.rig, Math.min(2.1, moveSpeed * 0.6), elapsed + companionIdx, delta);\n        } else {\n          const lerpAlpha = 1 - Math.exp(-7 * delta);\n          const dx = entry.targetX - entry.rig.root.position.x;\n          const dz = entry.targetZ - entry.rig.root.position.z;\n          entry.rig.root.position.x += dx * lerpAlpha;\n          entry.rig.root.position.z += dz * lerpAlpha;\n          entry.rig.root.rotation.y += (entry.targetYaw - entry.rig.root.rotation.y) * lerpAlpha;\n          const distSpeed = Math.hypot(dx, dz) * 3.5;\n          animateAvatarRig(entry.rig, distSpeed, elapsed + companionIdx, delta);\n        }\n        companionIdx++;\n      });\n\n      // Keep corridor lights centered along player\'s Z progress\n      for (let i = 0; i < corridorLights.length; i++) {\n        corridorLights[i].position.z =\n          Math.max(curLayout.northWallZ + 2, Math.min(curLayout.southWallZ - 2, ps.z - i * 8 + 4));\n      }\n\n      // Smooth damped Third-Person or First-Person Camera with wall pull-in\n      const camDamp = 1 - Math.exp(-9 * delta);\n      if (cameraModeRef.current === \'first\') {\n        _camDesired.set(ps.x, 1.66, ps.z);\n        camera.position.lerp(_camDesired, camDamp);\n        _camLook.set(\n          ps.x - Math.sin(ps.camYaw) * 6,\n          1.66 - Math.sin(ps.camPitch) * 3.5,\n          ps.z - Math.cos(ps.camYaw) * 6\n        );\n        camera.lookAt(_camLook);\n      } else {\n        const dist = 4.35;\n        const desiredX = ps.x + Math.sin(ps.camYaw) * dist;\n        const desiredZ = ps.z + Math.cos(ps.camYaw) * dist;\n        const clampedCam = clampPlayerPosition(desiredX, desiredZ, curLayout);\n        const desiredY = 2.15 + Math.sin(ps.camPitch) * 1.4;\n        _camDesired.set(clampedCam.x, desiredY, clampedCam.z);\n        camera.position.lerp(_camDesired, camDamp);\n\n        _camLook.set(\n          ps.x - Math.sin(ps.camYaw) * 2.2,\n          1.55,\n          ps.z - Math.cos(ps.camYaw) * 2.2\n        );\n        camera.lookAt(_camLook);\n      }\n\n      // Throttled HUD wing indicator & Firestore presence broadcast (<= 2Hz)\n      const nowMs = performance.now();\n      if (nowMs - lastWingCheck > 320) {\n        lastWingCheck = nowMs;\n        if (ps.z > 0.2) {\n          setActiveWingLabel(\'Entrance Foyer\');\n        } else {\n          const wingIdx = Math.min(\n            curLayout.bayCount,\n            Math.max(1, Math.floor(-ps.z / curLayout.bayLength) + 1)\n          );\n          setActiveWingLabel(`Wing ${wingIdx} of ${curLayout.bayCount}`);\n        }\n      }\n\n      if (nowMs - ps.lastBroadcast > 650) {\n        ps.lastBroadcast = nowMs;\n        onPositionBroadcastRef.current?.(ps.x, ps.z, ps.yaw);\n      }\n\n      renderer.render(scene, camera);\n\n      if (isSoftwareGl) {\n        afterDraw(tick);\n      } else {\n        frameId = requestAnimationFrame(tick);\n      }\n    };\n\n    if (isSoftwareGl) {\n      // Draw immediate initial frame, then pace via afterDraw\n      renderer.render(scene, camera);\n      afterDraw(tick);\n    } else {\n      frameId = requestAnimationFrame(tick);\n    }\n\n    return () => {\n      disposed = true;\n      cancelAnimationFrame(frameId);\n      clearTimeout(frameId);\n      window.removeEventListener(\'keydown\', onKeyDown);\n      window.removeEventListener(\'keyup\', onKeyUp);\n      window.removeEventListener(\'resize\', onResize);\n      renderer.domElement.removeEventListener(\'pointerdown\', onPointerDown);\n      window.removeEventListener(\'pointermove\', onPointerMove);\n      window.removeEventListener(\'pointerup\', onPointerUp);\n      renderer.domElement.removeEventListener(\'webglcontextlost\', onContextLost);\n      builtMuseumRef.current?.dispose();\n      builtMuseumRef.current = null;\n      playerRigRef.current?.dispose();\n      playerRigRef.current = null;\n      companionRigsRef.current.forEach((c) => c.rig.dispose());\n      companionRigsRef.current.clear();\n      envTex.dispose();\n      renderer.dispose();\n      sceneRef.current = null;\n      rendererRef.current = null;\n      if (renderer.domElement.parentNode === container) {\n        container.removeChild(renderer.domElement);\n      }\n    };\n  }, []);\n\n  // Dynamically rebuild museum architecture & wall slots whenever artworks or wallTheme changes\n  useEffect(() => {\n    const scene = sceneRef.current;\n    const renderer = rendererRef.current;\n    if (!scene || !renderer) return;\n\n    const fogHex = THEME_FOG_COLOR[museum.wallTheme];\n    scene.background = new THREE.Color(fogHex);\n    scene.fog = new THREE.FogExp2(fogHex, 0.017);\n\n    if (builtMuseumRef.current) {\n      scene.remove(builtMuseumRef.current.group);\n      builtMuseumRef.current.dispose();\n    }\n\n    const built = buildMuseumArchitecture(\n      layout,\n      artworks,\n      museum.wallTheme,\n      renderer.capabilities.getMaxAnisotropy()\n    );\n    scene.add(built.group);\n    builtMuseumRef.current = built;\n    interactablesRef.current = built.interactables;\n\n    // Ensure player remains safely inside new layout bounds\n    const clamped = clampPlayerPosition(\n      playerStateRef.current.x,\n      playerStateRef.current.z,\n      layout\n    );\n    playerStateRef.current.x = clamped.x;\n    playerStateRef.current.z = clamped.z;\n  }, [layout, artworks, museum.wallTheme]);\n\n  // Rebuild player 3D avatar when user\'s avatar configuration changes\n  useEffect(() => {\n    const slot = playerSlotRef.current;\n    if (!slot) return;\n    if (playerRigRef.current) {\n      slot.remove(playerRigRef.current.root);\n      playerRigRef.current.dispose();\n    }\n    const rig = buildAvatarRig(avatar, { showNameplate: true, showContactShadow: true });\n    rig.root.position.set(playerStateRef.current.x, 0, playerStateRef.current.z);\n    rig.root.rotation.y = playerStateRef.current.yaw;\n    slot.add(rig.root);\n    playerRigRef.current = rig;\n  }, [avatar]);\n\n  // Sync co-visitor / invited companion 3D avatars in the museum hall\n  useEffect(() => {\n    const slot = companionsSlotRef.current;\n    if (!slot) return;\n\n    const activeIds = new Set(companionVisitors.map((v) => v.uid));\n    // Remove departed visitors\n    companionRigsRef.current.forEach((entry, uid) => {\n      if (!activeIds.has(uid)) {\n        slot.remove(entry.rig.root);\n        entry.rig.dispose();\n        companionRigsRef.current.delete(uid);\n      }\n    });\n\n    // Add or update active visitors\n    for (const v of companionVisitors) {\n      const existing = companionRigsRef.current.get(v.uid);\n      if (existing) {\n        existing.targetX = v.x;\n        existing.targetZ = v.z;\n        existing.targetYaw = v.yaw;\n        existing.visitor = v;\n      } else {\n        const rig = buildAvatarRig(\n          {\n            displayName: v.displayName,\n            gender: v.gender,\n            skinTone: v.skinTone,\n            hairStyle: v.hairStyle,\n            hairColor: v.hairColor,\n            outfitStyle: v.outfitStyle,\n            outfitColor: v.outfitColor,\n            accentColor: v.accentColor,\n            accessory: v.accessory,\n          },\n          { showNameplate: true, showContactShadow: true }\n        );\n        rig.root.position.set(v.x, 0, v.z);\n        rig.root.rotation.y = v.yaw;\n        slot.add(rig.root);\n        companionRigsRef.current.set(v.uid, {\n          rig,\n          visitor: v,\n          targetX: v.x,\n          targetZ: v.z,\n          targetYaw: v.yaw,\n        });\n      }\n    }\n  }, [companionVisitors]);\n\n  // Teleport avatar cleanly in front of an artwork selected from the Catalog\n  useEffect(() => {\n    if (!teleportTargetId) return;\n    const idx = artworks.findIndex((a) => a.id === teleportTargetId);\n    if (idx >= 0) {\n      const placement = getArtworkPlacement(idx);\n      playerStateRef.current.x = placement.standPoint.x;\n      playerStateRef.current.z = placement.standPoint.z;\n      // Orient camera and avatar toward the artwork wall\n      const lookYaw = placement.wallSide === \'west\' ? Math.PI / 2 : -Math.PI / 2;\n      playerStateRef.current.camYaw = lookYaw;\n      playerStateRef.current.yaw = placement.wallSide === \'west\' ? -Math.PI / 2 : Math.PI / 2;\n    }\n    onClearTeleport();\n  }, [teleportTargetId, artworks, onClearTeleport]);\n\n  const cycleTheme = () => {\n    const order: WallTheme[] = [\'alabaster\', \'travertine\', \'charcoal\'];\n    const next = order[(order.indexOf(museum.wallTheme) + 1) % order.length];\n    onChangeWallTheme(next);\n  };\n\n  const setVirtualKey = (dir: string, active: boolean) => {\n    virtualKeysRef.current[dir] = active;\n  };\n\n  return (\n    <div\n      className=\"relative w-screen h-screen overflow-hidden bg-[#1C1917] select-none\"\n      data-testid=\"museum-3d-view\"\n      data-wings={layout.bayCount}\n      data-artworks={artworks.length}\n      data-visitors={companionVisitors.length + 1}\n    >\n      {/* Dedicated WebGL Mount Container */}\n      <div ref={mountRef} className=\"w-full h-full\" />\n\n      {/* Minimal Top-Left Museum Placard (solid rgba, zero backdrop-blur over WebGL) */}\n      <div className=\"absolute top-4 left-4 z-10 pointer-events-auto bg-[#181512]/90 text-[#F7F5F0] px-4 py-2.5 border border-stone-700/80 max-w-[min(440px,calc(100vw-2rem))]\">\n        <div className=\"flex items-center justify-between gap-4\">\n          <div className=\"min-w-0\">\n            <h1 className=\"font-editorial text-lg font-semibold leading-tight truncate\">\n              {museum.title}\n            </h1>\n            <p className=\"text-xs text-stone-300 font-mono tabular-nums mt-0.5 truncate\">\n              {activeWingLabel} \302\267 {artworks.length}/{layout.totalWallSlots} Walls \302\267{\' \'}\n              {companionVisitors.length + 1} {companionVisitors.length === 0 ? \'Visitor\' : \'Visitors\'}\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onReturnHome}\n            aria-label=\"Return to Avatar Studio\"\n            className=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-xs font-medium text-stone-100 border border-stone-600 transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n          >\n            <Home className=\"w-3.5 h-3.5\" />\n            Studio\n          </button>\n        </div>\n      </div>\n\n      {/* Subtle Hover Prompt when pointing at a framed painting */}\n      {hoveredTitle && (\n        <div className=\"absolute top-20 left-1/2 -translate-x-1/2 z-10 pointer-events-none bg-[#181512]/90 text-[#F7F5F0] px-4 py-2 border border-[#C99A5B]/60 text-xs\">\n          Click to inspect <span className=\"font-semibold text-[#E8CFA6]\">{hoveredTitle}</span>\n        </div>\n      )}\n\n      {/* Compact On-Screen Touch / Click Walk Pad (Mobile & Mouse convenience) */}\n      <div\n        className=\"absolute bottom-24 right-4 z-10 md:hidden grid grid-cols-3 gap-1 w-28\"\n        aria-label=\"Directional walk pad\"\n      >\n        <div />\n        <button\n          type=\"button\"\n          aria-label=\"Walk forward\"\n          onPointerDown={() => setVirtualKey(\'up\', true)}\n          onPointerUp={() => setVirtualKey(\'up\', false)}\n          onPointerLeave={() => setVirtualKey(\'up\', false)}\n          className=\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\"\n        >\n          <ArrowUp className=\"w-4 h-4\" />\n        </button>\n        <div />\n        <button\n          type=\"button\"\n          aria-label=\"Walk left\"\n          onPointerDown={() => setVirtualKey(\'left\', true)}\n          onPointerUp={() => setVirtualKey(\'left\', false)}\n          onPointerLeave={() => setVirtualKey(\'left\', false)}\n          className=\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n        </button>\n        <button\n          type=\"button\"\n          aria-label=\"Walk backward\"\n          onPointerDown={() => setVirtualKey(\'down\', true)}\n          onPointerUp={() => setVirtualKey(\'down\', false)}\n          onPointerLeave={() => setVirtualKey(\'down\', false)}\n          className=\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\"\n        >\n          <ArrowDown className=\"w-4 h-4\" />\n        </button>\n        <button\n          type=\"button\"\n          aria-label=\"Walk right\"\n          onPointerDown={() => setVirtualKey(\'right\', true)}\n          onPointerUp={() => setVirtualKey(\'right\', false)}\n          onPointerLeave={() => setVirtualKey(\'right\', false)}\n          className=\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\"\n        >\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n\n      {/* Collapsible Unified Bottom Control Dock (Zero Viewport Occlusion) */}\n      <div className=\"absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center max-w-[96vw]\">\n        <button\n          type=\"button\"\n          onClick={() => setDockCollapsed((v) => !v)}\n          aria-expanded={!dockCollapsed}\n          className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-[#181512]/90 text-stone-300 hover:text-white border border-b-0 border-stone-700 text-xs transition-colors cursor-pointer whitespace-nowrap\"\n        >\n          {dockCollapsed ? (\n            <>\n              <ChevronUp className=\"w-3.5 h-3.5\" />\n              Show Controls\n            </>\n          ) : (\n            <>\n              <ChevronDown className=\"w-3.5 h-3.5\" />\n              Hide Controls\n            </>\n          )}\n        </button>\n\n        {!dockCollapsed && (\n          <nav\n            aria-label=\"Museum controls\"\n            className=\"bg-[#181512]/92 text-[#F7F5F0] border border-stone-700 px-3 py-2 flex flex-wrap items-center justify-center gap-2 shadow-2xl\"\n          >\n            {canCurate && (\n              <button\n                type=\"button\"\n                onClick={onOpenUpload}\n                className=\"inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#8A5A2B] hover:bg-[#9E6833] text-white text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                Add Artwork\n              </button>\n            )}\n\n            <button\n              type=\"button\"\n              onClick={onOpenCatalog}\n              className=\"inline-flex items-center gap-1.5 px-3 py-2 bg-stone-800 hover:bg-stone-700 text-stone-100 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n            >\n              <FolderKanban className=\"w-3.5 h-3.5 text-[#D4B282]\" />\n              Catalog by Date ({artworks.length})\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onOpenAccess}\n              className=\"inline-flex items-center gap-1.5 px-3 py-2 bg-stone-800 hover:bg-stone-700 text-stone-100 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n            >\n              <Users className=\"w-3.5 h-3.5 text-[#D4B282]\" />\n              Share Access\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setCameraMode((m) => (m === \'third\' ? \'first\' : \'third\'))}\n              className=\"inline-flex items-center gap-1.5 px-3 py-2 bg-stone-800 hover:bg-stone-700 text-stone-100 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n            >\n              <Eye className=\"w-3.5 h-3.5 text-[#D4B282]\" />\n              {cameraMode === \'third\' ? \'3rd Person\' : \'1st Person\'}\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={cycleTheme}\n              className=\"inline-flex items-center gap-1.5 px-3 py-2 bg-stone-800 hover:bg-stone-700 text-stone-100 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0 capitalize\"\n            >\n              <Palette className=\"w-3.5 h-3.5 text-[#D4B282]\" />\n              {museum.wallTheme}\n            </button>\n\n            <span className=\"hidden lg:inline-block text-xs text-stone-400 pl-2 border-l border-stone-700 whitespace-nowrap\">\n              WASD / Arrows to walk \302\267 Drag to look \302\267 Click painting\n            </span>\n          </nav>\n        )}\n      </div>\n    </div>\n  );\n}\n"
