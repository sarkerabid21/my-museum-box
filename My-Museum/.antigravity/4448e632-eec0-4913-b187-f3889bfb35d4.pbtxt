        replacement_chunks {
          target_content: "interface HomeStudioProps {\n  user: User | null;\n  authLoading: boolean;\n  avatar: AvatarConfig;\n  museum: MuseumMeta;\n  artworks: ArtworkItem[];\n  members: MuseumMember[];\n  accessibleMuseums: MuseumMeta[];\n  pendingInvite: PendingMuseumInvite | null;\n  inviteBannerState: InviteBannerState;\n  inviteBannerMessage: string | null;\n  onDismissInvite: () => void;\n  onSignInGoogle: () => void;\n  onSignOut: () => void;\n  onChangeAvatar: (next: AvatarConfig) => void;\n  onEnterMuseum: () => void;\n  onOpenCatalog: () => void;\n  onOpenUpload: () => void;\n  onOpenAccess: () => void;\n  onSwitchMuseum: (museumId: string) => void;\n  onInspectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\n}"
          replacement_content: "interface HomeStudioProps {\n  user: User | null;\n  authLoading: boolean;\n  avatar: AvatarConfig;\n  isExclusiveAbid: boolean;\n  customGlbBuffer: ArrayBuffer | null;\n  customGlbName: string | null;\n  museum: MuseumMeta;\n  artworks: ArtworkItem[];\n  members: MuseumMember[];\n  accessibleMuseums: MuseumMeta[];\n  pendingInvite: PendingMuseumInvite | null;\n  inviteBannerState: InviteBannerState;\n  inviteBannerMessage: string | null;\n  onDismissInvite: () => void;\n  onSignInGoogle: () => void;\n  onSignOut: () => void;\n  onChangeAvatar: (next: AvatarConfig) => void;\n  onUploadCustomGlb: (file: File) => Promise<void>;\n  onClearCustomGlb: () => Promise<void>;\n  onEnterMuseum: () => void;\n  onOpenCatalog: () => void;\n  onOpenUpload: () => void;\n  onOpenAccess: () => void;\n  onSwitchMuseum: (museumId: string) => void;\n  onInspectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\n}"
