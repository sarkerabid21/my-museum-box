        replacement_content: "import { useRef, useState, type ChangeEvent } from \'react\';\nimport type { User } from \'firebase/auth\';\nimport {\n  ArrowRight,\n  Calendar,\n  ExternalLink,\n  FolderKanban,\n  LogOut,\n  Mail,\n  Play,\n  Plus,\n  RotateCcw,\n  ShieldCheck,\n  Upload,\n  Users,\n  X,\n} from \'lucide-react\';\nimport type { PendingMuseumInvite } from \'../services/gmailService\';\nimport {\n  ABID_SIGNATURE_VIDEO_URL,\n  ABID_TRIPO_SOURCE_URL,\n  EXCLUSIVE_ABID_EMAIL,\n} from \'../museum/exclusiveAvatar\';"
