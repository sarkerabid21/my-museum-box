            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Smooth damped Third-Person or First-Person Camera with wall pull-in"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const camDamp = 1 - Math.exp(-9 * delta);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (cameraModeRef.current === \'first\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
