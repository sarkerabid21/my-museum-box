\\\\"), { showNameplate: false, showContactShadow: true });\\n    scene.add(rig.root);\\n\\n    const camera = new THREE.PerspectiveCamera(35, w / h, 0.1, 30);\\n    window.__abidV3 = { renderer, scene, camera, rig, overlay };\\n\\n    camera.position.set(0.32, 1.54, 1.35);\\n    camera.lookAt(0, 1.42, 0);\\n    renderer.render(scene, camera);\\n  });\\n  await page.screenshot({ path: \\\\\\\".playwright-cli/v3-closeup.png\\\\\\\" });\\n\\n  await page.evaluate(() => {\\n    const { renderer, scene, camera } = window.__abidV3;\\n    camera.position.set(0.55, 1.25, 3.15);\\n    camera.lookAt(0, 0.95, 0);\\n    renderer.render(scene, camera);\\n  });\\n  await page.screenshot({ path: \\\\\\\".playwright-cli/v3-front.png\\\\\\\" });\\n\\n  await page.evaluate(() => {\\n    const { rig, renderer, overlay } = window.__abidV3;\\n    rig.dispose();\\n    renderer.dispose();\\n    overlay.remove();\\n    delete window.__abidV3;\\n  });\\n}\\\"\\n\'\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Verifying final polished 3D character render\", \"toolSummary\":\"Final 3D visual check\"}"
