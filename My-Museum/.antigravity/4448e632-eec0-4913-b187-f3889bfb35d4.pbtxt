            }
            lines {
              text: "        _camDesired.set(clampedCam.x, desiredY, clampedCam.z);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        camera.position.lerp(_camDesired, camDamp);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
