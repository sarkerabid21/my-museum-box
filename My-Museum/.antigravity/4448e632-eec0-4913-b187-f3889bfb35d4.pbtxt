            lines {
              text: "export function buildOutdoorWorld("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  layout: MuseumLayout,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
