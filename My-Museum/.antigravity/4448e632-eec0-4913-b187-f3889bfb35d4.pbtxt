  code_action {
    action_spec {
      command {
        instruction: "Replace buildCompositeTree and buildStreetLampPost with lightweight instanced-mesh builders (addInstancedTrees, addInstancedFlowers, addInstancedLampPosts)"
        is_edit: true
        file {
          absolute_uri: "file:///src/three/outdoorBuilder.ts"
