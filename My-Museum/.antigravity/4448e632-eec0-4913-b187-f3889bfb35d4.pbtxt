        use_fast_apply: true
        replacement_chunks {
          target_content: "interface WorldMinimapProps {\n  playerX: number;\n  playerZ: number;\n  playerYaw: number;\n  zone: WorldZoneInfo;\n  vehicles: ReadonlyArray<Pick<TrafficVehicleState, \'id\' | \'kind\' | \'x\' | \'z\' | \'status\'>>;\n  walletBdt: number;\n  drivingLabel?: string | null;\n}\n\nconst MAP_W = 204;\nconst MAP_H = 112;\n\nexport function WorldMinimap({\n  playerX,\n  playerZ,\n  playerYaw,\n  zone,\n  vehicles,\n  walletBdt,\n  drivingLabel = null,\n}: WorldMinimapProps) {\n  const playerPt = projectWorldToMinimap(playerX, playerZ, MAP_W, MAP_H);\n  const museumPt = projectWorldToMinimap(0, 0, MAP_W, MAP_H);\n  const ctgPt = projectWorldToMinimap(-88, 35, MAP_W, MAP_H);\n  const coxsPt = projectWorldToMinimap(88, 35, MAP_W, MAP_H);\n\n  // Convert avatar yaw (0 = +Z down on minimap, +PI/2 = +X right on minimap) into CSS degrees where 0deg points UP (-Z)\n  const headingDeg = 180 - (playerYaw * 180) / Math.PI;\n\n  const badgeStyles: Record<WorldZoneInfo[\'symbol\'], string> = {\n    MUSEUM: \'bg-[#8A5A2B] text-white border-[#D4B282]\',\n    GARDEN: \'bg-emerald-900 text-emerald-100 border-emerald-500/60\',\n    ROAD: \'bg-stone-800 text-amber-200 border-amber-500/50\',\n    CTG: \'bg-emerald-700 text-white border-emerald-300\',\n    COXS: \'bg-sky-700 text-white border-sky-300\',\n  };\n\n  return (\n    <aside\n      aria-label=\"Live world minimap\"\n      data-testid=\"world-minimap\"\n      data-zone-symbol={zone.symbol}\n      className=\"absolute top-4 right-4 z-20 w-[220px] bg-[#181512]/94 text-[#F7F5F0] border border-stone-700 shadow-2xl select-none\"\n    >\n      {/* Top Location Symbol Strip */}\n      <div className=\"px-2.5 py-1.5 border-b border-stone-700/90 flex items-center justify-between gap-2\">\n        <div className=\"flex items-center gap-1.5 min-w-0\">\n          {zone.symbol === \'MUSEUM\' ? (\n            <Landmark className=\"w-3.5 h-3.5 text-[#E8CFA6] shrink-0\" />\n          ) : (\n            <Navigation className=\"w-3.5 h-3.5 text-[#E8CFA6] shrink-0\" />\n          )}\n          <span\n            className={`px-1.5 py-0.5 text-[10px] font-mono font-bold tracking-wider border ${badgeStyles[zone.symbol]}`}\n            data-testid=\"minimap-zone-symbol\"\n          >\n            {zone.symbol}\n          </span>\n          <span className=\"text-[11px] text-stone-300 truncate\">{zone.label}</span>\n        </div>\n      </div>\n\n      {/* Schematic Interactive Map Canvas */}\n      <div className=\"p-2\">\n        <svg\n          width={MAP_W}\n          height={MAP_H}\n          viewBox={`0 0 ${MAP_W} ${MAP_H}`}\n          className=\"block w-full h-[112px] bg-[#1E251F] border border-stone-700/80\"\n          role=\"img\"\n          aria-label={`Map showing current location: ${zone.label} (${zone.symbol})`}\n        >\n          {/* Chittagong green hillside tint (West) */}\n          <rect x={0} y={0} width={52} height={MAP_H} fill=\"#1F3B2B\" />\n\n          {/* Cox\'s Bazar coastal ocean tint (East) */}\n          <rect x={156} y={0} width={48} height={MAP_H} fill=\"#0F3A52\" />\n          <rect x={148} y={0} width={10} height={MAP_H} fill=\"#8C7B56\" opacity={0.45} />\n\n          {/* Garden Courtyard */}\n          <rect x={68} y={40} width={68} height={24} fill=\"#2A4D30\" />\n          <rect x={96} y={40} width={12} height={26} fill=\"#9C9283\" opacity={0.65} />\n\n          {/* Museum Architectural Footprint */}\n          <text\n            x={museumPt.mx}\n            y={10}\n            textAnchor=\"middle\"\n            fill=\"#E8CFA6\"\n            fontSize=\"7\"\n            fontFamily=\"monospace\"\n            fontWeight=\"800\"\n          >\n            MUSEUM\n          </text>\n          <rect\n            x={museumPt.mx - 18}\n            y={13}\n            width={36}\n            height={28}\n            fill={zone.symbol === \'MUSEUM\' ? \'#A6723B\' : \'#574A3D\'}\n            stroke=\"#E8CFA6\"\n            strokeWidth={1.4}\n          />\n          {/* Museum Classical Symbol */}\n          <text\n            x={museumPt.mx}\n            y={31}\n            textAnchor=\"middle\"\n            fill=\"#FAF5EC\"\n            fontSize=\"13\"\n            fontWeight=\"700\"\n          >\n            \360\237\217\233\n          </text>\n\n          {/* Highway Asphalt Band */}\n          <rect x={0} y={66} width={MAP_W} height={19} fill=\"#2B2F36\" />\n          <line\n            x1={0}\n            y1={75.5}\n            x2={MAP_W}\n            y2={75.5}\n            stroke=\"#EAB308\"\n            strokeWidth={1}\n            strokeDasharray=\"4 3\"\n          />\n\n          {/* Opposite-Side Varied Architectural Footprints */}\n          <circle cx={52} cy={98} r={5.5} fill=\"#5C7080\" opacity={0.85} />\n          <rect x={65} y={92} width={15} height={10} fill=\"#945844\" opacity={0.85} />\n          <rect x={86} y={91} width={16} height={11} fill=\"#8F887D\" opacity={0.85} />\n          <circle cx={114} cy={97} r={6} fill=\"#2E7D86\" opacity={0.85} />\n          <rect x={126} y={92} width={14} height={10} fill=\"#7B9989\" opacity={0.85} />\n          <rect x={145} y={91} width={12} height={11} fill=\"#A38B68\" opacity={0.85} />\n\n          {/* West Landmark Badge: CTG */}\n          <g transform={`translate(${ctgPt.mx}, ${ctgPt.my - 20})`}>\n            <rect\n              x={-16}\n              y={-8}\n              width={32}\n              height={15}\n              fill={zone.symbol === \'CTG\' ? \'#10B981\' : \'#0B5E3C\'}\n              stroke=\"#E2E8F0\"\n              strokeWidth={1}\n            />\n            <text\n              x={0}\n              y={2.5}\n              textAnchor=\"middle\"\n              fill=\"#FFFFFF\"\n              fontSize=\"8.5\"\n              fontFamily=\"monospace\"\n              fontWeight=\"800\"\n            >\n              CTG\n            </text>\n          </g>\n\n          {/* East Landmark Badge: COXS */}\n          <g transform={`translate(${coxsPt.mx}, ${coxsPt.my - 20})`}>\n            <rect\n              x={-18}\n              y={-8}\n              width={36}\n              height={15}\n              fill={zone.symbol === \'COXS\' ? \'#38BDF8\' : \'#0369A1\'}\n              stroke=\"#E2E8F0\"\n              strokeWidth={1}\n            />\n            <text\n              x={0}\n              y={2.5}\n              textAnchor=\"middle\"\n              fill=\"#FFFFFF\"\n              fontSize=\"8.5\"\n              fontFamily=\"monospace\"\n              fontWeight=\"800\"\n            >\n              COXS\n            </text>\n          </g>\n\n          {/* Live Moving Traffic Vehicle Blips */}\n          {vehicles.map((v) => {\n            if (v.status === \'player_driving\') return null;\n            const pt = projectWorldToMinimap(v.x, v.z, MAP_W, MAP_H);\n            const color =\n              v.kind === \'rickshaw\'\n                ? \'#F97316\'\n                : v.kind === \'bike\'\n                  ? \'#60A5FA\'\n                  : \'#F8FAFC\';\n            return (\n              <circle\n                key={v.id}\n                cx={pt.mx}\n                cy={pt.my}\n                r={v.kind === \'car\' ? 2.4 : 1.9}\n                fill={color}\n                opacity={0.9}\n              />\n            );\n          })}\n\n          {/* Live Player Position & Heading Chevron */}\n          <g transform={`translate(${playerPt.mx}, ${playerPt.my}) rotate(${headingDeg})`}>\n            <polygon\n              points=\"0,-5.5 4.2,4.2 0,2.1 -4.2,4.2\"\n              fill=\"#FACC15\"\n              stroke=\"#181512\"\n              strokeWidth={1.1}\n            />\n          </g>\n        </svg>\n      </div>\n\n      {/* Footer Wallet & Active Vehicle Readout */}\n      <div className=\"px-2.5 py-1.5 border-t border-stone-800 flex items-center justify-between text-[11px] font-mono\">\n        <span className=\"inline-flex items-center gap-1 text-emerald-300\" data-testid=\"wallet-balance\">\n          <Wallet className=\"w-3 h-3\" />\n          \340\247\263{walletBdt}\n        </span>\n        <span className=\"text-stone-400 truncate max-w-[125px]\">\n          {drivingLabel ? drivingLabel : \'On Foot\'}\n        </span>\n      </div>\n    </aside>\n  );\n}"
          replacement_content: "interface WorldMinimapProps {\n  playerX: number;\n  playerZ: number;\n  playerYaw: number;\n  zone: WorldZoneInfo;\n  vehicles: ReadonlyArray<Pick<TrafficVehicleState, \'id\' | \'kind\' | \'x\' | \'z\' | \'status\'>>;\n  walletBdt: number;\n  drivingLabel?: string | null;\n  hasCrossHall?: boolean;\n}\n\nconst MAP_W = 204;\nconst MAP_H = 112;\n\nexport function WorldMinimap({\n  playerX,\n  playerZ,\n  playerYaw,\n  zone,\n  vehicles,\n  walletBdt,\n  drivingLabel = null,\n  hasCrossHall = false,\n}: WorldMinimapProps) {\n  const playerPt = projectWorldToMinimap(playerX, playerZ, MAP_W, MAP_H);\n  const museumPt = projectWorldToMinimap(0, 0, MAP_W, MAP_H);\n  const ctgPt = projectWorldToMinimap(-88, 35, MAP_W, MAP_H);\n  const coxsPt = projectWorldToMinimap(88, 35, MAP_W, MAP_H);\n\n  // Convert avatar yaw (0 = +Z down on minimap, +PI/2 = +X right on minimap) into CSS degrees where 0deg points UP (-Z)\n  const headingDeg = 180 - (playerYaw * 180) / Math.PI;\n\n  const badgeStyles: Record<WorldZoneInfo[\'symbol\'], string> = {\n    MUSEUM: \'bg-[#8A5A2B] text-white border-[#D4B282]\',\n    GARDEN: \'bg-emerald-900 text-emerald-100 border-emerald-500/60\',\n    ROAD: \'bg-stone-800 text-amber-200 border-amber-500/50\',\n    CTG: \'bg-emerald-700 text-white border-emerald-300\',\n    COXS: \'bg-sky-700 text-white border-sky-300\',\n  };\n\n  return (\n    <aside\n      aria-label=\"Live world minimap\"\n      data-testid=\"world-minimap\"\n      data-zone-symbol={zone.symbol}\n      className=\"absolute top-2.5 right-2.5 sm:top-4 sm:right-4 z-20 w-[132px] sm:w-[216px] bg-[#181512]/94 text-[#F7F5F0] border border-stone-700 shadow-2xl select-none\"\n    >\n      {/* Top Location Symbol Strip */}\n      <div className=\"px-1.5 py-1 sm:px-2.5 sm:py-1.5 border-b border-stone-700/90 flex items-center justify-between gap-1.5 sm:gap-2\">\n        <div className=\"flex items-center gap-1 sm:gap-1.5 min-w-0\">\n          {zone.symbol === \'MUSEUM\' ? (\n            <Landmark className=\"w-3 h-3 sm:w-3.5 sm:h-3.5 text-[#E8CFA6] shrink-0\" />\n          ) : (\n            <Navigation className=\"w-3 h-3 sm:w-3.5 sm:h-3.5 text-[#E8CFA6] shrink-0\" />\n          )}\n          <span\n            className={`px-1 py-0.5 sm:px-1.5 text-[9px] sm:text-[10px] font-mono font-bold tracking-wider border ${badgeStyles[zone.symbol]}`}\n            data-testid=\"minimap-zone-symbol\"\n          >\n            {zone.symbol}\n          </span>\n          <span className=\"hidden sm:inline text-[11px] text-stone-300 truncate\">{zone.label}</span>\n        </div>\n      </div>\n\n      {/* Schematic Interactive Map Canvas (scales crisply on compact mobile screens) */}\n      <div className=\"p-1 sm:p-2\">\n        <svg\n          viewBox={`0 0 ${MAP_W} ${MAP_H}`}\n          preserveAspectRatio=\"xMidYMid meet\"\n          className=\"block w-full h-[66px] sm:h-[110px] bg-[#1E251F] border border-stone-700/80\"\n          role=\"img\"\n          aria-label={`Map showing current location: ${zone.label} (${zone.symbol})`}\n        >\n          {/* Chittagong green hillside tint (West) */}\n          <rect x={0} y={0} width={52} height={MAP_H} fill=\"#1F3B2B\" />\n\n          {/* Cox\'s Bazar coastal ocean tint (East) */}\n          <rect x={156} y={0} width={48} height={MAP_H} fill=\"#0F3A52\" />\n          <rect x={148} y={0} width={10} height={MAP_H} fill=\"#8C7B56\" opacity={0.45} />\n\n          {/* Garden Courtyard */}\n          <rect x={68} y={40} width={68} height={24} fill=\"#2A4D30\" />\n          <rect x={96} y={40} width={12} height={26} fill=\"#9C9283\" opacity={0.65} />\n\n          {/* Museum Architectural Footprint (shows Cross wings once Grand Cross Hall is unlocked) */}\n          <text\n            x={museumPt.mx}\n            y={10}\n            textAnchor=\"middle\"\n            fill=\"#E8CFA6\"\n            fontSize=\"7\"\n            fontFamily=\"monospace\"\n            fontWeight=\"800\"\n          >\n            MUSEUM\n          </text>\n          {hasCrossHall && (\n            <rect\n              x={museumPt.mx - 28}\n              y={17}\n              width={56}\n              height={11}\n              fill={zone.symbol === \'MUSEUM\' ? \'#9A6834\' : \'#4E4237\'}\n              stroke=\"#E8CFA6\"\n              strokeWidth={1.1}\n            />\n          )}\n          <rect\n            x={museumPt.mx - 18}\n            y={13}\n            width={36}\n            height={28}\n            fill={zone.symbol === \'MUSEUM\' ? \'#A6723B\' : \'#574A3D\'}\n            stroke=\"#E8CFA6\"\n            strokeWidth={1.4}\n          />\n          {/* Museum Classical Symbol */}\n          <text\n            x={museumPt.mx}\n            y={31}\n            textAnchor=\"middle\"\n            fill=\"#FAF5EC\"\n            fontSize=\"13\"\n            fontWeight=\"700\"\n          >\n            \360\237\217\233\n          </text>\n\n          {/* Highway Asphalt Band */}\n          <rect x={0} y={66} width={MAP_W} height={19} fill=\"#2B2F36\" />\n          <line\n            x1={0}\n            y1={75.5}\n            x2={MAP_W}\n            y2={75.5}\n            stroke=\"#EAB308\"\n            strokeWidth={1}\n            strokeDasharray=\"4 3\"\n          />\n\n          {/* Opposite-Side Varied Architectural Footprints */}\n          <circle cx={52} cy={98} r={5.5} fill=\"#5C7080\" opacity={0.85} />\n          <rect x={65} y={92} width={15} height={10} fill=\"#945844\" opacity={0.85} />\n          <rect x={86} y={91} width={16} height={11} fill=\"#8F887D\" opacity={0.85} />\n          <circle cx={114} cy={97} r={6} fill=\"#2E7D86\" opacity={0.85} />\n          <rect x={126} y={92} width={14} height={10} fill=\"#7B9989\" opacity={0.85} />\n          <rect x={145} y={91} width={12} height={11} fill=\"#A38B68\" opacity={0.85} />\n\n          {/* West Landmark Badge: CTG */}\n          <g transform={`translate(${ctgPt.mx}, ${ctgPt.my - 20})`}>\n            <rect\n              x={-16}\n              y={-8}\n              width={32}\n              height={15}\n              fill={zone.symbol === \'CTG\' ? \'#10B981\' : \'#0B5E3C\'}\n              stroke=\"#E2E8F0\"\n              strokeWidth={1}\n            />\n            <text\n              x={0}\n              y={2.5}\n              textAnchor=\"middle\"\n              fill=\"#FFFFFF\"\n              fontSize=\"8.5\"\n              fontFamily=\"monospace\"\n              fontWeight=\"800\"\n            >\n              CTG\n            </text>\n          </g>\n\n          {/* East Landmark Badge: COXS */}\n          <g transform={`translate(${coxsPt.mx}, ${coxsPt.my - 20})`}>\n            <rect\n              x={-18}\n              y={-8}\n              width={36}\n              height={15}\n              fill={zone.symbol === \'COXS\' ? \'#38BDF8\' : \'#0369A1\'}\n              stroke=\"#E2E8F0\"\n              strokeWidth={1}\n            />\n            <text\n              x={0}\n              y={2.5}\n              textAnchor=\"middle\"\n              fill=\"#FFFFFF\"\n              fontSize=\"8.5\"\n              fontFamily=\"monospace\"\n              fontWeight=\"800\"\n            >\n              COXS\n            </text>\n          </g>\n\n          {/* Live Moving Traffic Vehicle Blips */}\n          {vehicles.map((v) => {\n            if (v.status === \'player_driving\') return null;\n            const pt = projectWorldToMinimap(v.x, v.z, MAP_W, MAP_H);\n            const color =\n              v.kind === \'rickshaw\'\n                ? \'#F97316\'\n                : v.kind === \'bike\'\n                  ? \'#60A5FA\'\n                  : \'#F8FAFC\';\n            return (\n              <circle\n                key={v.id}\n                cx={pt.mx}\n                cy={pt.my}\n                r={v.kind === \'car\' ? 2.4 : 1.9}\n                fill={color}\n                opacity={0.9}\n              />\n            );\n          })}\n\n          {/* Live Player Position & Heading Chevron */}\n          <g transform={`translate(${playerPt.mx}, ${playerPt.my}) rotate(${headingDeg})`}>\n            <polygon\n              points=\"0,-5.5 4.2,4.2 0,2.1 -4.2,4.2\"\n              fill=\"#FACC15\"\n              stroke=\"#181512\"\n              strokeWidth={1.1}\n            />\n          </g>\n        </svg>\n      </div>\n\n      {/* Footer Wallet & Active Vehicle Readout */}\n      <div className=\"px-1.5 py-1 sm:px-2.5 sm:py-1.5 border-t border-stone-800 flex items-center justify-between gap-1 text-[10px] sm:text-[11px] font-mono\">\n        <span className=\"inline-flex items-center gap-0.5 sm:gap-1 text-emerald-300 shrink-0\" data-testid=\"wallet-balance\">\n          <Wallet className=\"w-2.5 h-2.5 sm:w-3 sm:h-3\" />\n          \340\247\263{walletBdt}\n        </span>\n        <span className=\"text-stone-400 truncate max-w-[66px] sm:max-w-[125px]\">\n          {drivingLabel ? drivingLabel : \'On Foot\'}\n        </span>\n      </div>\n    </aside>\n  );\n}"
          start_line: 8
          end_line: 240
        }
      }
    }
