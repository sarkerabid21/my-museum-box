        replacement_chunks {
          target_content: "  const nearbyDoorIsOpen = nearbyDoor ? openDoorList.includes(nearbyDoor.id) : false;\n  const nearbyDoorTargetRoomIndex = nearbyDoor\n    ? currentRoomIndex === nearbyDoor.fromRoomIndex\n      ? nearbyDoor.toRoomIndex\n      : nearbyDoor.fromRoomIndex\n    : 0;\n  const nearbyDoorTargetName = nearbyDoor\n    ? getResolvedRoomName(nearbyDoorTargetRoomIndex, museum.roomNames)\n    : \'\';\n\n  return (\n    <div\n      ref={rootContainerRef}\n      tabIndex={0}\n      className=\"relative w-screen h-screen overflow-hidden bg-[#1C1917] select-none outline-none\"\n      data-testid=\"museum-3d-view\"\n      data-rooms={layout.roomCount}\n      data-current-room={currentRoomIndex}\n      data-open-doors={openDoorList.join(\',\')}\n      data-artworks={artworks.length}\n      data-visitors={companionVisitors.length + 1}\n    >\n      {/* Dedicated WebGL Mount Container */}\n      <div ref={mountRef} className=\"w-full h-full\" />\n\n      {/* Minimal Top-Left Museum & Active Room Placard */}\n      <div className=\"absolute top-4 left-4 z-10 pointer-events-auto bg-[#181512]/92 text-[#F7F5F0] px-4 py-2.5 border border-stone-700/80 max-w-[min(470px,calc(100vw-2rem))]\">\n        <div className=\"flex items-center justify-between gap-4\">\n          <div className=\"min-w-0\">\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"font-editorial text-lg font-semibold leading-tight truncate\">\n                Room {currentRoom.romanNumeral} \302\267 {currentRoomName}\n              </h1>\n              {canRenameRooms && (\n                <button\n                  type=\"button\"\n                  onClick={() => onRequestRenameRoom(currentRoom.index)}\n                  aria-label={`Rename Room ${currentRoom.romanNumeral}`}\n                  title=\"Rename this room signboard\"\n                  className=\"p-1 text-stone-400 hover:text-[#E8CFA6] transition-colors cursor-pointer shrink-0\"\n                >\n                  <Pencil className=\"w-3.5 h-3.5\" />\n                </button>\n              )}\n            </div>\n            <p className=\"text-xs text-stone-300 font-mono tabular-nums mt-0.5 truncate\">\n              {museum.title} \302\267 {artworks.length}/{layout.totalWallSlots} Walls \302\267{\' \'}\n              {activeCompanionCount + 1} Active\n              {companionVisitors.length > activeCompanionCount\n                ? ` \302\267 ${companionVisitors.length - activeCompanionCount} Standing`\n                : \'\'}\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onReturnHome}\n            aria-label=\"Return to Avatar Studio\"\n            className=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-xs font-medium text-stone-100 border border-stone-600 transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n          >\n            <Home className=\"w-3.5 h-3.5\" />\n            Studio\n          </button>\n        </div>\n      </div>\n\n      {/* Nearby Door Keyboard & Click Prompt */}\n      {nearbyDoor && (\n        <div\n          className=\"absolute bottom-[116px] left-1/2 -translate-x-1/2 z-20 bg-[#181512]/95 text-[#F7F5F0] px-4 py-2.5 border border-[#C99A5B] shadow-2xl flex items-center gap-3\"\n          data-testid=\"door-prompt\"\n        >\n          {nearbyDoorIsOpen ? (\n            <DoorOpen className=\"w-4 h-4 text-[#E8CFA6] shrink-0\" />\n          ) : (\n            <DoorClosed className=\"w-4 h-4 text-[#E8CFA6] shrink-0\" />\n          )}\n          <span className=\"text-xs whitespace-nowrap\">\n            Press <kbd className=\"px-1.5 py-0.5 bg-stone-800 border border-stone-600 font-mono text-[#E8CFA6]\">F</kbd> or{\' \'}\n            <kbd className=\"px-1.5 py-0.5 bg-stone-800 border border-stone-600 font-mono text-[#E8CFA6]\">Space</kbd> to{\' \'}\n            {nearbyDoorIsOpen ? \'close\' : \'open\'} door to{\' \'}\n            <strong className=\"text-[#E8CFA6]\">{nearbyDoorTargetName}</strong>\n          </span>\n          <button\n            type=\"button\"\n            onClick={() => toggleDoorById(nearbyDoor.id)}\n            className=\"px-2.5 py-1 bg-[#8A5A2B] hover:bg-[#9E6833] text-white text-xs font-medium transition-colors cursor-pointer whitespace-nowrap\"\n          >\n            {nearbyDoorIsOpen ? \'Close Door\' : \'Open Door\'}\n          </button>\n        </div>\n      )}\n\n      {/* Subtle Hover Prompt for Artworks, Door Signboards, or Doors */}\n      {hoveredPrompt && (\n        <div className=\"absolute top-20 left-1/2 -translate-x-1/2 z-10 pointer-events-none bg-[#181512]/92 text-[#F7F5F0] px-4 py-2 border border-[#C99A5B]/60 text-xs whitespace-nowrap\">\n          {hoveredPrompt.kind === \'artwork\' && (\n            <>\n              Click to inspect <span className=\"font-semibold text-[#E8CFA6]\">{hoveredPrompt.label}</span>\n            </>\n          )}\n          {hoveredPrompt.kind === \'signboard\' && (\n            <>\n              Click signboard to rename <span className=\"font-semibold text-[#E8CFA6]\">{hoveredPrompt.label}</span>\n            </>\n          )}\n          {hoveredPrompt.kind === \'door\' && (\n            <>\n              Click or press [F] \342\200\224 <span className=\"font-semibold text-[#E8CFA6]\">{hoveredPrompt.label}</span>\n            </>\n          )}\n          {hoveredPrompt.kind === \'expansion\' && (\n            <span className=\"text-[#E8CFA6]\">{hoveredPrompt.label}</span>\n          )}\n        </div>\n      )}"
          replacement_content: "  const nearbyDoorIsOpen = nearbyDoor ? openDoorList.includes(nearbyDoor.id) : false;\n  const isNearbyExitDoor = nearbyDoor?.id === EXIT_DOOR_ID;\n  const nearbyDoorTargetRoomIndex = nearbyDoor\n    ? currentRoomIndex === nearbyDoor.fromRoomIndex\n      ? nearbyDoor.toRoomIndex\n      : nearbyDoor.fromRoomIndex\n    : 0;\n  const nearbyDoorTargetName = nearbyDoor\n    ? isNearbyExitDoor\n      ? worldZone.id === \'museum\'\n        ? \'Outdoor Garden & Highway\'\n        : getResolvedRoomName(0, museum.roomNames)\n      : getResolvedRoomName(nearbyDoorTargetRoomIndex, museum.roomNames)\n    : \'\';\n\n  return (\n    <div\n      ref={rootContainerRef}\n      tabIndex={0}\n      className=\"relative w-screen h-screen overflow-hidden bg-[#1C1917] select-none outline-none\"\n      data-testid=\"museum-3d-view\"\n      data-rooms={layout.roomCount}\n      data-current-room={currentRoomIndex}\n      data-zone={worldZone.id}\n      data-zone-symbol={worldZone.symbol}\n      data-driving={drivingVehicleInfo?.id ?? \'\'}\n      data-open-doors={openDoorList.join(\',\')}\n      data-artworks={artworks.length}\n      data-visitors={companionVisitors.length + 1}\n    >\n      {/* Dedicated WebGL Mount Container */}\n      <div ref={mountRef} className=\"w-full h-full\" />\n\n      {/* Minimal Top-Left Museum & Active Location Placard */}\n      <div className=\"absolute top-4 left-4 z-10 pointer-events-auto bg-[#181512]/92 text-[#F7F5F0] px-4 py-2.5 border border-stone-700/80 max-w-[min(450px,calc(100vw-16rem))]\">\n        <div className=\"flex items-center justify-between gap-4\">\n          <div className=\"min-w-0\">\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"font-editorial text-lg font-semibold leading-tight truncate\">\n                {worldZone.id === \'museum\'\n                  ? `Room ${currentRoom.romanNumeral} \302\267 ${currentRoomName}`\n                  : `${worldZone.symbol} \302\267 ${worldZone.label}`}\n              </h1>\n              {worldZone.id === \'museum\' && canRenameRooms && (\n                <button\n                  type=\"button\"\n                  onClick={() => onRequestRenameRoom(currentRoom.index)}\n                  aria-label={`Rename Room ${currentRoom.romanNumeral}`}\n                  title=\"Rename this room signboard\"\n                  className=\"p-1 text-stone-400 hover:text-[#E8CFA6] transition-colors cursor-pointer shrink-0\"\n                >\n                  <Pencil className=\"w-3.5 h-3.5\" />\n                </button>\n              )}\n            </div>\n            <p className=\"text-xs text-stone-300 font-mono tabular-nums mt-0.5 truncate\">\n              {museum.title} \302\267 {artworks.length}/{layout.totalWallSlots} Walls \302\267{\' \'}\n              {activeCompanionCount + 1} Active\n              {companionVisitors.length > activeCompanionCount\n                ? ` \302\267 ${companionVisitors.length - activeCompanionCount} Standing`\n                : \'\'}\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onReturnHome}\n            aria-label=\"Return to Avatar Studio\"\n            className=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-xs font-medium text-stone-100 border border-stone-600 transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n          >\n            <Home className=\"w-3.5 h-3.5\" />\n            Studio\n          </button>\n        </div>\n      </div>\n\n      {/* Live Side Minimap with Museum, CTG & COXS Symbols */}\n      <WorldMinimap\n        playerX={minimapSnap.x}\n        playerZ={minimapSnap.z}\n        playerYaw={minimapSnap.yaw}\n        zone={worldZone}\n        vehicles={minimapSnap.vehicles}\n        walletBdt={walletBdt}\n        drivingLabel={\n          drivingVehicleInfo\n            ? `${drivingVehicleInfo.stolen ? \'Chintai \302\267 \' : \'\'}${drivingVehicleInfo.title}`\n            : null\n        }\n      />\n\n      {/* Active Driving Banner (with Dismount Button) */}\n      {drivingVehicleInfo && (\n        <div\n          className=\"absolute bottom-[116px] left-1/2 -translate-x-1/2 z-20 bg-[#181512]/95 text-[#F7F5F0] px-4 py-2.5 border border-[#C99A5B] shadow-2xl flex items-center gap-3\"\n          data-testid=\"driving-banner\"\n        >\n          <Car className=\"w-4 h-4 text-[#E8CFA6] shrink-0\" />\n          <span className=\"text-xs whitespace-nowrap\">\n            Driving <strong className=\"text-[#E8CFA6]\">{drivingVehicleInfo.title}</strong>\n            {drivingVehicleInfo.stolen ? \' (Chintai)\' : \'\'} \302\267 W/S Gas \302\267 A/D Steer \302\267 Shift Boost\n          </span>\n          <button\n            type=\"button\"\n            onClick={exitCurrentVehicle}\n            className=\"px-2.5 py-1 bg-[#8A5A2B] hover:bg-[#9E6833] text-white text-xs font-medium transition-colors cursor-pointer whitespace-nowrap\"\n          >\n            Get Off [F]\n          </button>\n        </div>\n      )}\n\n      {/* Nearby Passing Vehicle Stop & Talk Prompt */}\n      {!drivingVehicleInfo && nearbyVehicle && !talkSession && (\n        <div\n          className=\"absolute bottom-[116px] left-1/2 -translate-x-1/2 z-20 bg-[#181512]/95 text-[#F7F5F0] px-4 py-2.5 border border-emerald-500/80 shadow-2xl flex items-center gap-3\"\n          data-testid=\"vehicle-hail-prompt\"\n        >\n          <MessageSquare className=\"w-4 h-4 text-emerald-300 shrink-0\" />\n          <span className=\"text-xs whitespace-nowrap\">\n            Press <kbd className=\"px-1.5 py-0.5 bg-stone-800 border border-stone-600 font-mono text-emerald-300\">E</kbd> to stop{\' \'}\n            <strong className=\"text-emerald-200\">{nearbyVehicle.title}</strong> ({nearbyVehicle.driverName}) \342\200\224 Talk / Vara / Chintai\n          </span>\n          <button\n            type=\"button\"\n            onClick={() => stopAndTalkToVehicle(nearbyVehicle.id)}\n            className=\"px-2.5 py-1 bg-emerald-700 hover:bg-emerald-600 text-white text-xs font-medium transition-colors cursor-pointer whitespace-nowrap\"\n          >\n            Stop &amp; Talk\n          </button>\n        </div>\n      )}\n\n      {/* Nearby Door Keyboard & Click Prompt (including Room 1 Outdoor Exit Door) */}\n      {!drivingVehicleInfo && !nearbyVehicle && nearbyDoor && (\n        <div\n          className=\"absolute bottom-[116px] left-1/2 -translate-x-1/2 z-20 bg-[#181512]/95 text-[#F7F5F0] px-4 py-2.5 border border-[#C99A5B] shadow-2xl flex items-center gap-3\"\n          data-testid=\"door-prompt\"\n        >\n          {nearbyDoorIsOpen ? (\n            <DoorOpen className=\"w-4 h-4 text-[#E8CFA6] shrink-0\" />\n          ) : (\n            <DoorClosed className=\"w-4 h-4 text-[#E8CFA6] shrink-0\" />\n          )}\n          <span className=\"text-xs whitespace-nowrap\">\n            Press <kbd className=\"px-1.5 py-0.5 bg-stone-800 border border-stone-600 font-mono text-[#E8CFA6]\">F</kbd> or{\' \'}\n            <kbd className=\"px-1.5 py-0.5 bg-stone-800 border border-stone-600 font-mono text-[#E8CFA6]\">Space</kbd> to{\' \'}\n            {nearbyDoorIsOpen ? \'close\' : \'open\'} door to{\' \'}\n            <strong className=\"text-[#E8CFA6]\">{nearbyDoorTargetName}</strong>\n          </span>\n          <button\n            type=\"button\"\n            onClick={() => toggleDoorById(nearbyDoor.id)}\n            className=\"px-2.5 py-1 bg-[#8A5A2B] hover:bg-[#9E6833] text-white text-xs font-medium transition-colors cursor-pointer whitespace-nowrap\"\n          >\n            {nearbyDoorIsOpen ? \'Close Door\' : isNearbyExitDoor ? \'Open Exit Door\' : \'Open Door\'}\n          </button>\n        </div>\n      )}\n\n      {/* Subtle Hover Prompt for Artworks, Door Signboards, Doors, or Street Vehicles */}\n      {hoveredPrompt && (\n        <div className=\"absolute top-20 left-1/2 -translate-x-1/2 z-10 pointer-events-none bg-[#181512]/92 text-[#F7F5F0] px-4 py-2 border border-[#C99A5B]/60 text-xs whitespace-nowrap\">\n          {hoveredPrompt.kind === \'artwork\' && (\n            <>\n              Click to inspect <span className=\"font-semibold text-[#E8CFA6]\">{hoveredPrompt.label}</span>\n            </>\n          )}\n          {hoveredPrompt.kind === \'signboard\' && (\n            <>\n              Click signboard to rename <span className=\"font-semibold text-[#E8CFA6]\">{hoveredPrompt.label}</span>\n            </>\n          )}\n          {hoveredPrompt.kind === \'door\' && (\n            <>\n              Click or press [F] \342\200\224 <span className=\"font-semibold text-[#E8CFA6]\">{hoveredPrompt.label}</span>\n            </>\n          )}\n          {hoveredPrompt.kind === \'vehicle\' && (\n            <>\n              Click or press [E] to Stop &amp; Talk \342\200\224 <span className=\"font-semibold text-emerald-300\">{hoveredPrompt.label}</span>\n            </>\n          )}\n          {hoveredPrompt.kind === \'expansion\' && (\n            <span className=\"text-[#E8CFA6]\">{hoveredPrompt.label}</span>\n          )}\n        </div>\n      )}\n\n      {/* Vehicle Stop, Fare Negotiation & Chintai Modal */}\n      {talkSession && (\n        <VehicleTalkModal\n          session={talkSession}\n          walletBdt={walletBdt}\n          errorText={talkError}\n          onSelectDestination={handleSelectTalkDest}\n          onBargain={handleBargainFare}\n          onPayAndRide={handlePayAndRide}\n          onChintai={handleChintaiTakeover}\n          onClose={handleCloseTalk}\n        />\n      )}"
