    content: "import test from \'node:test\';\nimport assert from \'node:assert/strict\';\nimport {\n  calculateMuseumLayout,\n  getArtworkPlacement,\n  clampPlayerPosition,\n  sortArtworksByDate,\n  groupArtworksByDate,\n  validateArtworkInput,\n  validateAccessGrant,\n  HALL_HALF_WIDTH,\n} from \'./layout\';\nimport type { ArtworkItem } from \'../types/museum\';\n\nconst makeArtwork = (id: string, title: string, dateCaptured: string): ArtworkItem => ({\n  id,\n  museumId: \'demo-museum\',\n  ownerId: \'owner-1\',\n  uploadedBy: \'owner-1\',\n  uploadedByName: \'Curator\',\n  title,\n  artist: \'Artist\',\n  dateCaptured,\n  notes: \'\',\n  imageUrl: \'/src/assets/images/test.jpg\',\n  aspectRatio: \'4:3\',\n  frameStyle: \'bronze\',\n  isOpenByCode: true,\n  viewerEmails: [],\n});\n\ntest(\'calculateMuseumLayout expands gallery wings dynamically as artworks increase\', () => {\n  const empty = calculateMuseumLayout(0);\n  assert.equal(empty.bayCount, 2);\n  assert.equal(empty.totalWallSlots, 4);\n\n  const four = calculateMuseumLayout(4);\n  assert.equal(four.bayCount, 2);\n  assert.equal(four.totalWallSlots, 4);\n\n  const five = calculateMuseumLayout(5);\n  assert.equal(five.bayCount, 3);\n  assert.equal(five.totalWallSlots, 6);\n  assert.ok(five.totalLength > four.totalLength);\n\n  const seven = calculateMuseumLayout(7);\n  assert.equal(seven.bayCount, 4);\n  assert.equal(seven.totalWallSlots, 8);\n  assert.ok(seven.northWallZ < five.northWallZ);\n});\n\ntest(\'getArtworkPlacement places alternating west/east artworks facing inward\', () => {\n  const p0 = getArtworkPlacement(0);\n  const p1 = getArtworkPlacement(1);\n  const p2 = getArtworkPlacement(2);\n\n  assert.equal(p0.wallSide, \'west\');\n  assert.equal(p1.wallSide, \'east\');\n  assert.equal(p0.bayIndex, 0);\n  assert.equal(p1.bayIndex, 0);\n  assert.equal(p2.bayIndex, 1);\n  assert.equal(p2.wingLabel, \'Wing II\');\n  assert.ok(p0.x < 0 && p1.x > 0);\n  assert.equal(p0.z, p1.z);\n  assert.ok(p2.z < p0.z);\n  assert.ok(Math.abs(p0.standPoint.x) < HALL_HALF_WIDTH);\n});\n\ntest(\'clampPlayerPosition keeps avatar inside dynamic corridor and outside benches\', () => {\n  const layout = calculateMuseumLayout(6);\n  const outWest = clampPlayerPosition(-99, -5, layout);\n  assert.ok(outWest.x > -HALL_HALF_WIDTH);\n\n  const outNorth = clampPlayerPosition(0, -999, layout);\n  assert.ok(outNorth.z > layout.northWallZ);\n\n  const bench = layout.benches[0];\n  const insideBench = clampPlayerPosition(0.1, bench.centerZ, layout);\n  const stillInside =\n    insideBench.x > bench.minX &&\n    insideBench.x < bench.maxX &&\n    insideBench.z > bench.minZ &&\n    insideBench.z < bench.maxZ;\n  assert.equal(stillInside, false);\n});\n\ntest(\'sortArtworksByDate and groupArtworksByDate sort newest and oldest accurately\', () => {\n  const list = [\n    makeArtwork(\'a\', \'Mid Piece\', \'2025-05-10\'),\n    makeArtwork(\'b\', \'Newest Piece\', \'2026-10-01\'),\n    makeArtwork(\'c\', \'Oldest Piece\', \'2024-01-15\'),\n    makeArtwork(\'d\', \'Alpha Same Day\', \'2025-05-10\'),\n  ];\n\n  const newest = sortArtworksByDate(list, \'newest\');\n  assert.deepEqual(\n    newest.map((a) => a.id),\n    [\'b\', \'d\', \'a\', \'c\']\n  );\n\n  const oldest = sortArtworksByDate(list, \'oldest\');\n  assert.deepEqual(\n    oldest.map((a) => a.id),\n    [\'c\', \'d\', \'a\', \'b\']\n  );\n\n  const groups = groupArtworksByDate(list, \'newest\');\n  assert.equal(groups.length, 3);\n  assert.equal(groups[0].dateKey, \'2026-10-01\');\n  assert.equal(groups[1].items.length, 2);\n});\n\ntest(\'validators reject empty or malformed inputs without silent fallbacks\', () => {\n  const badArt = validateArtworkInput({\n    title: \'   \',\n    artist: \'\',\n    dateCaptured: \'invalid-date\',\n    imageUrl: \'\',\n    notes: \'\',\n  });\n  assert.equal(badArt.valid, false);\n  assert.ok(badArt.errors.title);\n  assert.ok(badArt.errors.artist);\n  assert.ok(badArt.errors.dateCaptured);\n  assert.ok(badArt.errors.imageUrl);\n\n  const goodArt = validateArtworkInput({\n    title: \'Evening Study\',\n    artist: \'A. Sarker\',\n    dateCaptured: \'2026-11-20\',\n    imageUrl: \'/src/assets/images/sample.jpg\',\n    notes: \'Oil on linen\',\n  });\n  assert.equal(goodArt.valid, true);\n\n  const badGrant = validateAccessGrant({\n    email: \'not-an-email\',\n    displayName: \'\',\n    role: \'visitor\',\n    gender: \'woman\',\n    existingEmails: [],\n  });\n  assert.equal(badGrant.valid, false);\n  assert.ok(badGrant.errors.email);\n  assert.ok(badGrant.errors.displayName);\n\n  const dupGrant = validateAccessGrant({\n    email: \'elena@gallery.org\',\n    displayName: \'Elena\',\n    role: \'curator\',\n    gender: \'woman\',\n    existingEmails: [\'elena@gallery.org\'],\n  });\n  assert.equal(dupGrant.valid, false);\n  assert.ok(dupGrant.errors.email);\n});\n"
