  planner_response {
    thinking: "**Refining Museum View**\n\nI\'m now carefully reviewing `Museum3DView.tsx`. I\'ve started by adding an optional `selfUid` prop, which can be a string or null. This is the first step in adapting the component to our new requirements, and I\'ll carefully consider the implications as I continue.\n\n\n**Adding New Component Props**\n\nI\'m now integrating `selfEmail` and `onPresenceOffline` props into the component. The plan is to enhance visitor presence handling, using a 5-second `presenceNow` tick to update statuses. This is linked to smooth avatar transitions, from live to offline.\n\nI\'m also working on replacing the old steering controls, `strafeIn` and separate turn controls, with a new `stepPlayerSteering(...)`.\n\n\n**Implementing Animation and Logic**\n\nI\'m now deep in the implementation details. I\'m focusing on the animation loop: when active, I\'m interpolating visitor coordinates and yaw towards the live Firestore values, using `animateAvatarRig`. When inactive, I\'m smoothly settling the avatar at saved coordinates. I\'m also adding data attributes for automated checks. My next step is implementing the presence broadcast with the specified timing, and handling offline persistence.\n\n\n"
    message_id: "HcQCa-6CJOay694P7c2KyQI"
    tool_calls {
      id: "call_12055140169970939103"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Synchronize left/right camera & 3D model rotation, replace fake patrol with real-time active vs standing offline companion 3D models, and improve live presence sync in Museum3DView.tsx\", \"Instruction\":\"Update Museum3DView.tsx to use cameraSteering, trustedCircle companion resolver, active/standing animation and nameplates, and live heartbeat + offline standing persistence\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":74, \"ReplacementContent\":\"import {\\n  calculateMuseumLayout,\\n  clampPlayerPosition,\\n  findNearbyDoor,\\n  getArtworkPlacement,\\n  getDoorId,\\n  getResolvedRoomName,\\n  getRoomIndexAtZ,\\n  toRomanNumeral,\\n  type DoorDefinition,\\n  type MuseumLayout,\\n} from \'../museum/layout\';\\nimport {\\n  normalizeAngle,\\n  shortestAngleDelta,\\n  stepPlayerSteering,\\n} from \'../museum/cameraSteering\';\\nimport {\\n  resolveMuseumCompanionAvatars,\\n  type CompanionAvatarEntry,\\n} from \'../museum/trustedCircle\';\\nimport {\\n  animateAvatarRig,\\n  buildAvatarRig,\\n  buildCustomGlbAvatarRig,\\n  type AvatarRig,\\n} from \'../three/avatarBuilder\';\\nimport { buildMuseumArchitecture, type BuiltMuseum, type DoorRig } from \'../three/museumBuilder\';\\nimport { createAfterDrawScheduler, detectSoftwareGl } from \'../three/webglUtils\';\\n\\ninterface Museum3DViewProps {\\n  museum: MuseumMeta;\\n  avatar: AvatarConfig;\\n  selfUid?: string | null;\\n  selfEmail?: string | null;\\n  customGlbBuffer?: ArrayBuffer | null;\\n  artworks: ArtworkItem[];\\n  members: MuseumMember[];\\n  liveVisitors: VisitorPresence[];\\n  showInvitedIn3D: boolean;\\n  canCurate: boolean;\\n  canRenameRooms: boolean;\\n  teleportTargetId: string | null;\\n  onClearTeleport: () => void;\\n  onSelectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\\n  onRequestRenameRoom: (roomIndex: number) => void;\\n  onNotify?: (msg: string) => void;\\n  onOpenCatalog: () => void;\\n  onOpenUpload: () => void;\\n  onOpenAccess: () => void;\\n  onReturnHome: () => void;\\n  onChangeWallTheme: (theme: WallTheme) => void;\\n  onPositionBroadcast?: (x: number, z: number, yaw: number) => void;\\n  onPresenceOffline?: (x: number, z: number, yaw: number) => void;\\n  isPaused?: boolean;\\n}\", \"StartLine\":29, \"TargetContent\":\"import { DEFAULT_AVATAR_BY_GENDER } from \'../types/museum\';\\nimport {\\n  calculateMuseumLayout,\\n  clampPlayerPosition,\\n  findNearbyDoor,\\n  getArtworkPlacement,\\n  getDoorId,\\n  getResolvedRoomName,\\n  getRoomIndexAtZ,\\n  toRomanNumeral,\\n  type DoorDefinition,\\n  type MuseumLayout,\\n} from \'../museum/layout\';\\nimport {\\n  animateAvatarRig,\\n  buildAvatarRig,\\n  buildCustomGlbAvatarRig,\\n  type AvatarRig,\\n} from \'../three/avatarBuilder\';\\nimport { buildMuseumArchitecture, type BuiltMuseum, type DoorRig } from \'../three/museumBuilder\';\\nimport { createAfterDrawScheduler, detectSoftwareGl } from \'../three/webglUtils\';\\n\\ninterface Museum3DViewProps {\\n  museum: MuseumMeta;\\n  avatar: AvatarConfig;\\n  customGlbBuffer?: ArrayBuffer | null;\\n  artworks: ArtworkItem[];\\n  members: MuseumMember[];\\n  liveVisitors: VisitorPresence[];\\n  showInvitedIn3D: boolean;\\n  canCurate: boolean;\\n  canRenameRooms: boolean;\\n  teleportTargetId: string | null;\\n  onClearTeleport: () => void;\\n  onSelectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\\n  onRequestRenameRoom: (roomIndex: number) => void;\\n  onNotify?: (msg: string) => void;\\n  onOpenCatalog: () => void;\\n  onOpenUpload: () => void;\\n  onOpenAccess: () => void;\\n  onReturnHome: () => void;\\n  onChangeWallTheme: (theme: WallTheme) => void;\\n  onPositionBroadcast?: (x: number, z: number, yaw: number) => void;\\n  isPaused?: boolean;\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":220, \"ReplacementContent\":\"// Reusable scratch vectors allocated outside render loop (zero GC)\\nconst _camDesired = new THREE.Vector3();\\nconst _camLook = new THREE.Vector3();\\n\\nconst THEME_FOG_COLOR: Record<WallTheme, number> = {\\n  alabaster: 0xeae4da,\\n  travertine: 0xdfd5c7,\\n  charcoal: 0x1e1c1a,\\n};\\n\\ninterface HoverPrompt {\\n  kind: \'artwork\' | \'door\' | \'signboard\' | \'expansion\';\\n  label: string;\\n}\\n\\nfunction getCompanionVisualSignature(v: CompanionAvatarEntry): string {\\n  return [\\n    v.displayName,\\n    v.gender,\\n    v.skinTone,\\n    v.hairStyle,\\n    v.hairColor,\\n    v.outfitStyle,\\n    v.outfitColor,\\n    v.accentColor,\\n    v.accessory,\\n    v.isActive ? \'active\' : \'standing\',\\n  ].join(\'|\');\\n}\\n\\nexport function Museum3DView({\\n  museum,\\n  avatar,\\n  selfUid = null,\\n  selfEmail = null,\\n  customGlbBuffer = null,\\n  artworks,\\n  members,\\n  liveVisitors,\\n  showInvitedIn3D,\\n  canCurate,\\n  canRenameRooms,\\n  teleportTargetId,\\n  onClearTeleport,\\n  onSelectArtwork,\\n  onRequestRenameRoom,\\n  onNotify,\\n  onOpenCatalog,\\n  onOpenUpload,\\n  onOpenAccess,\\n  onReturnHome,\\n  onChangeWallTheme,\\n  onPositionBroadcast,\\n  onPresenceOffline,\\n  isPaused = false,\\n}: Museum3DViewProps) {\\n  const mountRef = useRef<HTMLDivElement | null>(null);\\n  const [cameraMode, setCameraMode] = useState<\'third\' | \'first\'>(\'third\');\\n  const [dockCollapsed, setDockCollapsed] = useState(false);\\n  const [currentRoomIndex, setCurrentRoomIndex] = useState(0);\\n  const [hoveredPrompt, setHoveredPrompt] = useState<HoverPrompt | null>(null);\\n  const [nearbyDoor, setNearbyDoor] = useState<DoorDefinition | null>(null);\\n  const [openDoorList, setOpenDoorList] = useState<string[]>([]);\\n  const [presenceNowMs, setPresenceNowMs] = useState(() => Date.now());\\n\\n  // Periodically refresh heartbeat window so disconnected visitors transition cleanly to standing\\n  useEffect(() => {\\n    const id = window.setInterval(() => setPresenceNowMs(Date.now()), 5000);\\n    return () => window.clearInterval(id);\\n  }, []);\\n\\n  const layout = useMemo(() => calculateMuseumLayout(artworks.length), [artworks.length]);\\n\\n  const currentRoom = layout.rooms[currentRoomIndex] ?? layout.rooms[0];\\n  const currentRoomName = getResolvedRoomName(currentRoom.index, museum.roomNames);\\n\\n  // Merge real-time Firestore active visitors + offline standing 3D models (zero fake patrolling)\\n  const companionVisitors = useMemo<CompanionAvatarEntry[]>(\\n    () =>\\n      resolveMuseumCompanionAvatars({\\n        museum,\\n        liveVisitors,\\n        members,\\n        showInvitedIn3D,\\n        selfUid,\\n        selfEmail,\\n        nowMs: presenceNowMs,\\n      }),\\n    [museum, liveVisitors, members, showInvitedIn3D, selfUid, selfEmail, presenceNowMs]\\n  );\\n\\n  const activeCompanionCount = useMemo(\\n    () => companionVisitors.filter((v) => v.isActive).length,\\n    [companionVisitors]\\n  );\\n\\n  // Refs bridging React state into stable single-mount WebGL loop\\n  const layoutRef = useRef<MuseumLayout>(layout);\\n  layoutRef.current = layout;\\n  const artworksRef = useRef(artworks);\\n  artworksRef.current = artworks;\\n  const roomNamesRef = useRef(museum.roomNames);\\n  roomNamesRef.current = museum.roomNames;\\n  const cameraModeRef = useRef(cameraMode);\\n  cameraModeRef.current = cameraMode;\\n  const onSelectArtworkRef = useRef(onSelectArtwork);\\n  onSelectArtworkRef.current = onSelectArtwork;\\n  const onRequestRenameRoomRef = useRef(onRequestRenameRoom);\\n  onRequestRenameRoomRef.current = onRequestRenameRoom;\\n  const onNotifyRef = useRef(onNotify);\\n  onNotifyRef.current = onNotify;\\n  const onPositionBroadcastRef = useRef(onPositionBroadcast);\\n  onPositionBroadcastRef.current = onPositionBroadcast;\\n  const onPresenceOfflineRef = useRef(onPresenceOffline);\\n  onPresenceOfflineRef.current = onPresenceOffline;\\n  const isPausedRef = useRef(isPaused);\\n  isPausedRef.current = isPaused;\\n  const resumeLoopRef = useRef<(() => void) | null>(null);\\n  const renderOnceRef = useRef<(() => void) | null>(null);\\n  const clearKeysRef = useRef<(() => void) | null>(null);\\n  const rootContainerRef = useRef<HTMLDivElement | null>(null);\\n\\n  const openDoorIdsRef = useRef<Set<string>>(new Set());\\n  const doorRigsRef = useRef<DoorRig[]>([]);\\n\\n  const sceneRef = useRef<THREE.Scene | null>(null);\\n  const rendererRef = useRef<THREE.WebGLRenderer | null>(null);\\n  const builtMuseumRef = useRef<BuiltMuseum | null>(null);\\n  const interactablesRef = useRef<THREE.Object3D[]>([]);\\n  const playerRigRef = useRef<AvatarRig | null>(null);\\n  const playerSlotRef = useRef<THREE.Group | null>(null);\\n  const companionsSlotRef = useRef<THREE.Group | null>(null);\\n  const companionRigsRef = useRef<\\n    Map<\\n      string,\\n      {\\n        rig: AvatarRig;\\n        visitor: CompanionAvatarEntry;\\n        visualSignature: string;\\n        targetX: number;\\n        targetZ: number;\\n        targetYaw: number;\\n      }\\n    >\\n  >(new Map());\\n\\n  // Mutable player kinematics state \342\200\224 spawn inside Room 1 South bay facing North toward the vase & doorway\\n  const playerStateRef = useRef({\\n    x: 0,\\n    z: 4.5,\\n    yaw: Math.PI, // Avatar faces -Z (into the room)\\n    camYaw: 0,\\n    camPitch: 0.12,\\n    speed: 0,\\n    lastBroadcast: 0,\\n    lastBroadcastX: Number.NaN,\\n    lastBroadcastZ: Number.NaN,\\n    lastBroadcastYaw: Number.NaN,\\n  });\", \"StartLine\":75, \"TargetContent\":\"// Reusable scratch vectors allocated outside render loop (zero GC)\\nconst _forward = new THREE.Vector3();\\nconst _right = new THREE.Vector3();\\nconst _move = new THREE.Vector3();\\nconst _camDesired = new THREE.Vector3();\\nconst _camLook = new THREE.Vector3();\\n\\nconst THEME_FOG_COLOR: Record<WallTheme, number> = {\\n  alabaster: 0xeae4da,\\n  travertine: 0xdfd5c7,\\n  charcoal: 0x1e1c1a,\\n};\\n\\ninterface HoverPrompt {\\n  kind: \'artwork\' | \'door\' | \'signboard\' | \'expansion\';\\n  label: string;\\n}\\n\\nexport function Museum3DView({\\n  museum,\\n  avatar,\\n  customGlbBuffer = null,\\n  artworks,\\n  members,\\n  liveVisitors,\\n  showInvitedIn3D,\\n  canCurate,\\n  canRenameRooms,\\n  teleportTargetId,\\n  onClearTeleport,\\n  onSelectArtwork,\\n  onRequestRenameRoom,\\n  onNotify,\\n  onOpenCatalog,\\n  onOpenUpload,\\n  onOpenAccess,\\n  onReturnHome,\\n  onChangeWallTheme,\\n  onPositionBroadcast,\\n  isPaused = false,\\n}: Museum3DViewProps) {\\n  const mountRef = useRef<HTMLDivElement | null>(null);\\n  const [cameraMode, setCameraMode] = useState<\'third\' | \'first\'>(\'third\');\\n  const [dockCollapsed, setDockCollapsed] = useState(false);\\n  const [currentRoomIndex, setCurrentRoomIndex] = useState(0);\\n  const [hoveredPrompt, setHoveredPrompt] = useState<HoverPrompt | null>(null);\\n  const [nearbyDoor, setNearbyDoor] = useState<DoorDefinition | null>(null);\\n  const [openDoorList, setOpenDoorList] = useState<string[]>([]);\\n\\n  const layout = useMemo(() => calculateMuseumLayout(artworks.length), [artworks.length]);\\n\\n  const currentRoom = layout.rooms[currentRoomIndex] ?? layout.rooms[0];\\n  const currentRoomName = getResolvedRoomName(currentRoom.index, museum.roomNames);\\n\\n  // Combine live Firestore co-visitors + simulated companion avatars for invited members\\n  const companionVisitors = useMemo<VisitorPresence[]>(() => {\\n    const combined: VisitorPresence[] = [...liveVisitors];\\n    if (showInvitedIn3D) {\\n      const liveNames = new Set(liveVisitors.map((v) => v.displayName.toLowerCase()));\\n      members.forEach((m, idx) => {\\n        if (liveNames.has(m.displayName.toLowerCase())) return;\\n        const preset = DEFAULT_AVATAR_BY_GENDER[m.gender];\\n        const placement = getArtworkPlacement(idx % Math.max(1, Math.min(8, artworks.length || 1)));\\n        combined.push({\\n          uid: `invited-${m.id}`,\\n          museumId: museum.id,\\n          ownerId: museum.ownerId,\\n          displayName: m.displayName,\\n          gender: m.gender,\\n          skinTone: preset.skinTone,\\n          hairStyle: preset.hairStyle,\\n          hairColor: preset.hairColor,\\n          outfitStyle: preset.outfitStyle,\\n          outfitColor: m.gender === \'woman\' ? \'#6E2E36\' : \'#2D4739\',\\n          accentColor: preset.accentColor,\\n          accessory: preset.accessory,\\n          x: idx % 2 === 0 ? -3.4 : 3.4,\\n          z: Math.max(-6.2, Math.min(4.8, placement.z)),\\n          yaw: idx % 2 === 0 ? Math.PI * 0.35 : -Math.PI * 0.35,\\n          isSimulated: true,\\n        });\\n      });\\n    }\\n    return combined;\\n  }, [liveVisitors, showInvitedIn3D, members, artworks.length, museum.id, museum.ownerId]);\\n\\n  // Refs bridging React state into stable single-mount WebGL loop\\n  const layoutRef = useRef<MuseumLayout>(layout);\\n  layoutRef.current = layout;\\n  const artworksRef = useRef(artworks);\\n  artworksRef.current = artworks;\\n  const roomNamesRef = useRef(museum.roomNames);\\n  roomNamesRef.current = museum.roomNames;\\n  const cameraModeRef = useRef(cameraMode);\\n  cameraModeRef.current = cameraMode;\\n  const onSelectArtworkRef = useRef(onSelectArtwork);\\n  onSelectArtworkRef.current = onSelectArtwork;\\n  const onRequestRenameRoomRef = useRef(onRequestRenameRoom);\\n  onRequestRenameRoomRef.current = onRequestRenameRoom;\\n  const onNotifyRef = useRef(onNotify);\\n  onNotifyRef.current = onNotify;\\n  const onPositionBroadcastRef = useRef(onPositionBroadcast);\\n  onPositionBroadcastRef.current = onPositionBroadcast;\\n  const isPausedRef = useRef(isPaused);\\n  isPausedRef.current = isPaused;\\n  const resumeLoopRef = useRef<(() => void) | null>(null);\\n  const renderOnceRef = useRef<(() => void) | null>(null);\\n  const clearKeysRef = useRef<(() => void) | null>(null);\\n  const rootContainerRef = useRef<HTMLDivElement | null>(null);\\n\\n  const openDoorIdsRef = useRef<Set<string>>(new Set());\\n  const doorRigsRef = useRef<DoorRig[]>([]);\\n\\n  const sceneRef = useRef<THREE.Scene | null>(null);\\n  const rendererRef = useRef<THREE.WebGLRenderer | null>(null);\\n  const builtMuseumRef = useRef<BuiltMuseum | null>(null);\\n  const interactablesRef = useRef<THREE.Object3D[]>([]);\\n  const playerRigRef = useRef<AvatarRig | null>(null);\\n  const playerSlotRef = useRef<THREE.Group | null>(null);\\n  const companionsSlotRef = useRef<THREE.Group | null>(null);\\n  const companionRigsRef = useRef<\\n    Map<\\n      string,\\n      {\\n        rig: AvatarRig;\\n        visitor: VisitorPresence;\\n        targetX: number;\\n        targetZ: number;\\n        targetYaw: number;\\n      }\\n    >\\n  >(new Map());\\n\\n  // Mutable player kinematics state \342\200\224 spawn inside Room 1 South bay facing North toward the vase & doorway\\n  const playerStateRef = useRef({\\n    x: 0,\\n    z: 4.5,\\n    yaw: Math.PI, // Avatar faces -Z (into the room)\\n    camYaw: 0,\\n    camPitch: 0.12,\\n    speed: 0,\\n    lastBroadcast: 0,\\n  });\"}, {\"AllowMultiple\":false, \"EndLine\":447, \"ReplacementContent\":\"        playerStateRef.current.camYaw = normalizeAngle(\\n          playerStateRef.current.camYaw - dx * 0.0055\\n        );\\n        playerStateRef.current.camPitch = THREE.MathUtils.clamp(\\n          playerStateRef.current.camPitch + dy * 0.0038,\\n          -0.25,\\n          0.62\\n        );\\n        return;\", \"StartLine\":439, \"TargetContent\":\"        playerStateRef.current.camYaw -= dx * 0.0055;\\n        playerStateRef.current.camPitch = THREE.MathUtils.clamp(\\n          playerStateRef.current.camPitch + dy * 0.0038,\\n          -0.25,\\n          0.62\\n        );\\n        return;\"}, {\"AllowMultiple\":false, \"EndLine\":755, \"ReplacementContent\":\"      const k = keys;\\n      const vk = virtualKeysRef.current;\\n      const forwardIn =\\n        (k.KeyW || k.ArrowUp || vk.up ? 1 : 0) -\\n        (k.KeyS || k.ArrowDown || vk.down ? 1 : 0);\\n      // Turning left/right (A/D, ArrowLeft/ArrowRight, Q/E, or mobile pad) rotates BOTH the 3D model and screen view smoothly\\n      const turnIn =\\n        (k.KeyA || k.ArrowLeft || k.KeyQ || vk.left ? 1 : 0) -\\n        (k.KeyD || k.ArrowRight || k.KeyE || vk.right ? 1 : 0);\\n\\n      const steering = stepPlayerSteering(\\n        {\\n          forward: forwardIn,\\n          turn: turnIn,\\n          sprint: Boolean(k.ShiftLeft || k.ShiftRight),\\n        },\\n        {\\n          camYaw: ps.camYaw,\\n          avatarYaw: ps.yaw,\\n        },\\n        delta\\n      );\\n\\n      ps.camYaw = steering.camYaw;\\n      ps.yaw = steering.avatarYaw;\\n\\n      if (steering.isMoving) {\\n        const tryX = ps.x + steering.moveDirX * steering.walkSpeed * delta;\\n        const tryZ = ps.z + steering.moveDirZ * steering.walkSpeed * delta;\\n        let nextPos = clampPlayerPosition(tryX, tryZ, curLayout, openDoors, ps.z);\\n\\n        // Smoothly glide around central floral vase plinth if walking straight into it\\n        const nearPedestal = curLayout.pedestals.some(\\n          (p) => Math.hypot(tryX - p.x, tryZ - p.z) < p.radius + 0.15\\n        );\\n        const movedDist = Math.hypot(nextPos.x - ps.x, nextPos.z - ps.z);\\n        if (nearPedestal && movedDist < steering.walkSpeed * delta * 0.35 && !steering.isTurning) {\\n          const slideDir = ps.x >= 0 ? 1 : -1;\\n          nextPos = clampPlayerPosition(\\n            ps.x + slideDir * steering.walkSpeed * 0.9 * delta,\\n            tryZ,\\n            curLayout,\\n            openDoors,\\n            ps.z\\n          );\\n        }\\n\\n        ps.x = nextPos.x;\\n        ps.z = nextPos.z;\\n      }\\n\\n      ps.speed = steering.animSpeed;\\n\\n      // Update player avatar rig transform & stride animation\\n      const playerRig = playerRigRef.current;\\n      if (playerRig) {\\n        playerRig.root.position.set(ps.x, 0, ps.z);\\n        playerRig.root.rotation.y = ps.yaw;\\n        playerRig.root.visible = cameraModeRef.current === \'third\';\\n        animateAvatarRig(playerRig, ps.speed, elapsed, delta);\\n      }\\n\\n      // Animate co-visitors: active online users walk/turn smoothly in real time; offline users stand straight in place\\n      let companionIdx = 0;\\n      companionRigsRef.current.forEach((entry) => {\\n        if (entry.visitor.isActive) {\\n          const lerpAlpha = 1 - Math.exp(-8 * delta);\\n          const dx = entry.targetX - entry.rig.root.position.x;\\n          const dz = entry.targetZ - entry.rig.root.position.z;\\n          entry.rig.root.position.x += dx * lerpAlpha;\\n          entry.rig.root.position.z += dz * lerpAlpha;\\n\\n          const yawDelta = shortestAngleDelta(entry.rig.root.rotation.y, entry.targetYaw);\\n          entry.rig.root.rotation.y = normalizeAngle(\\n            entry.rig.root.rotation.y + yawDelta * lerpAlpha\\n          );\\n\\n          const distSpeed = Math.hypot(dx, dz) * 4.2 + Math.abs(yawDelta) * 0.9;\\n          animateAvatarRig(entry.rig, Math.min(7.5, distSpeed), elapsed + companionIdx, delta);\\n        } else {\\n          // Offline / standby member: settle straight at their saved position and stand completely still\\n          const settleAlpha = 1 - Math.exp(-6 * delta);\\n          entry.rig.root.position.x += (entry.targetX - entry.rig.root.position.x) * settleAlpha;\\n          entry.rig.root.position.z += (entry.targetZ - entry.rig.root.position.z) * settleAlpha;\\n          const yawDelta = shortestAngleDelta(entry.rig.root.rotation.y, entry.targetYaw);\\n          entry.rig.root.rotation.y = normalizeAngle(\\n            entry.rig.root.rotation.y + yawDelta * settleAlpha\\n          );\\n          animateAvatarRig(entry.rig, 0, elapsed + companionIdx, delta, { standStill: true });\\n        }\\n        companionIdx++;\\n      });\\n\\n      // Keep dynamic room lights centered on the player\'s current & adjacent rooms\\n      const activeRoomIdx = getRoomIndexAtZ(ps.z, curLayout);\\n      const activeRoom = curLayout.rooms[activeRoomIdx] ?? curLayout.rooms[0];\\n      if (roomLights[0]) roomLights[0].position.set(0, 5.4, activeRoom.centerZ + 4.2);\\n      if (roomLights[1]) roomLights[1].position.set(0, 5.4, activeRoom.centerZ - 4.2);\\n      const nextRoom = curLayout.rooms[activeRoomIdx + 1] ?? activeRoom;\\n      const prevRoom = curLayout.rooms[activeRoomIdx - 1] ?? activeRoom;\\n      if (roomLights[2]) roomLights[2].position.set(0, 5.4, nextRoom.centerZ);\\n      if (roomLights[3]) roomLights[3].position.set(0, 5.4, prevRoom.centerZ);\\n\\n      // Smooth damped Third-Person or First-Person Camera strictly clamped inside walls & closed doors\\n      const camDamp = 1 - Math.exp(-10 * delta);\\n      if (cameraModeRef.current === \'first\') {\\n        _camDesired.set(ps.x, 1.66, ps.z);\\n        camera.position.lerp(_camDesired, camDamp);\\n        _camLook.set(\\n          ps.x - Math.sin(ps.camYaw) * 6,\\n          1.66 - Math.sin(ps.camPitch) * 3.5,\\n          ps.z - Math.cos(ps.camYaw) * 6\\n        );\\n        camera.lookAt(_camLook);\\n      } else {\\n        const dist = 3.8;\\n        const desiredX = ps.x + Math.sin(ps.camYaw) * dist;\\n        const desiredZ = ps.z + Math.cos(ps.camYaw) * dist;\\n        const clampedCam = clampPlayerPosition(desiredX, desiredZ, curLayout, openDoors, ps.z);\\n        const desiredY = 2.08 + Math.sin(ps.camPitch) * 1.1;\\n        _camDesired.set(clampedCam.x, desiredY, clampedCam.z);\\n        camera.position.lerp(_camDesired, camDamp);\\n\\n        _camLook.set(\\n          ps.x - Math.sin(ps.camYaw) * 2.8,\\n          1.66,\\n          ps.z - Math.cos(ps.camYaw) * 2.8\\n        );\\n        camera.lookAt(_camLook);\\n      }\\n\\n      // Throttled HUD room & nearby door indicator + real-time Firestore presence broadcast\\n      if (nowMs - lastHudCheck > 180) {\\n        lastHudCheck = nowMs;\\n        container.dataset.playerX = ps.x.toFixed(2);\\n        container.dataset.playerZ = ps.z.toFixed(2);\\n        container.dataset.playerYaw = ps.yaw.toFixed(3);\\n        container.dataset.camYaw = ps.camYaw.toFixed(3);\\n        container.dataset.currentRoom = String(activeRoomIdx);\\n        setCurrentRoomIndex(activeRoomIdx);\\n\\n        const near = findNearbyDoor(ps.x, ps.z, curLayout);\\n        setNearbyDoor((prev) => (prev?.id === near?.id ? prev : near));\\n      }\\n\\n      const movedSinceBroadcast =\\n        Number.isNaN(ps.lastBroadcastX) ||\\n        Math.hypot(ps.x - ps.lastBroadcastX, ps.z - ps.lastBroadcastZ) > 0.03 ||\\n        Math.abs(shortestAngleDelta(ps.lastBroadcastYaw || 0, ps.yaw)) > 0.04;\\n      const sinceBroadcast = nowMs - ps.lastBroadcast;\\n      if ((movedSinceBroadcast && sinceBroadcast > 260) || sinceBroadcast > 6000) {\\n        ps.lastBroadcast = nowMs;\\n        ps.lastBroadcastX = ps.x;\\n        ps.lastBroadcastZ = ps.z;\\n        ps.lastBroadcastYaw = ps.yaw;\\n        onPositionBroadcastRef.current?.(ps.x, ps.z, ps.yaw);\\n      }\\n\\n      try {\\n        renderer.render(scene, camera);\\n        frameCount++;\\n        if (frameCount <= 5 || frameCount % 30 === 0) {\\n          container.dataset.frames = String(frameCount);\\n        }\\n      } catch (err) {\\n        console.error(\'Museum3DView render error:\', err);\\n      }\", \"StartLine\":591, \"TargetContent\":\"      const k = keys;\\n      const vk = virtualKeysRef.current;\\n      const forwardIn =\\n        (k.KeyW || k.ArrowUp || vk.up ? 1 : 0) -\\n        (k.KeyS || k.ArrowDown || vk.down ? 1 : 0);\\n      const strafeIn =\\n        (k.KeyD || vk.right ? 1 : 0) -\\n        (k.KeyA || vk.left ? 1 : 0);\\n      const turnLeft = k.KeyQ || k.ArrowLeft ? 1 : 0;\\n      const turnRight = k.KeyE || k.ArrowRight ? 1 : 0;\\n\\n      if (turnLeft || turnRight) {\\n        ps.camYaw += (turnLeft - turnRight) * 2.1 * delta;\\n      }\\n\\n      const walkSpeed = k.ShiftLeft || k.ShiftRight ? 7.4 : 4.8;\\n      _forward.set(-Math.sin(ps.camYaw), 0, -Math.cos(ps.camYaw));\\n      _right.set(Math.cos(ps.camYaw), 0, -Math.sin(ps.camYaw));\\n      _move.set(0, 0, 0);\\n      _move.addScaledVector(_forward, forwardIn);\\n      _move.addScaledVector(_right, strafeIn);\\n\\n      if (_move.lengthSq() > 0.001) {\\n        _move.normalize();\\n        const tryX = ps.x + _move.x * walkSpeed * delta;\\n        const tryZ = ps.z + _move.z * walkSpeed * delta;\\n        let nextPos = clampPlayerPosition(tryX, tryZ, curLayout, openDoors, ps.z);\\n\\n        // Smoothly glide around central floral vase plinth if walking straight into it\\n        const nearPedestal = curLayout.pedestals.some(\\n          (p) => Math.hypot(tryX - p.x, tryZ - p.z) < p.radius + 0.15\\n        );\\n        const movedDist = Math.hypot(nextPos.x - ps.x, nextPos.z - ps.z);\\n        if (\\n          nearPedestal &&\\n          movedDist < walkSpeed * delta * 0.35 &&\\n          Math.abs(forwardIn) > 0 &&\\n          strafeIn === 0\\n        ) {\\n          const slideDir = ps.x >= 0 ? 1 : -1;\\n          nextPos = clampPlayerPosition(\\n            ps.x + slideDir * walkSpeed * 0.9 * delta,\\n            tryZ,\\n            curLayout,\\n            openDoors,\\n            ps.z\\n          );\\n        }\\n\\n        ps.x = nextPos.x;\\n        ps.z = nextPos.z;\\n        ps.speed = walkSpeed;\\n\\n        const desiredYaw = Math.atan2(_move.x, _move.z);\\n        let diff = desiredYaw - ps.yaw;\\n        while (diff > Math.PI) diff -= Math.PI * 2;\\n        while (diff < -Math.PI) diff += Math.PI * 2;\\n        ps.yaw += diff * (1 - Math.exp(-12 * delta));\\n      } else {\\n        ps.speed = 0;\\n      }\\n\\n      // Update player avatar rig transform & stride animation\\n      const playerRig = playerRigRef.current;\\n      if (playerRig) {\\n        playerRig.root.position.set(ps.x, 0, ps.z);\\n        playerRig.root.rotation.y = ps.yaw;\\n        playerRig.root.visible = cameraModeRef.current === \'third\';\\n        animateAvatarRig(playerRig, ps.speed, elapsed, delta);\\n      }\\n\\n      // Animate co-visitors\\n      let companionIdx = 0;\\n      companionRigsRef.current.forEach((entry) => {\\n        if (entry.visitor.isSimulated) {\\n          const baseZ = -2.2 + (companionIdx % 2) * 3.8;\\n          const patrolZ = baseZ + Math.sin(elapsed * 0.35 + companionIdx * 1.9) * 1.8;\\n          const patrolX =\\n            (companionIdx % 2 === 0 ? -3.6 : 3.6) + Math.cos(elapsed * 0.25 + companionIdx) * 0.4;\\n          const dz = patrolZ - entry.rig.root.position.z;\\n          const dx = patrolX - entry.rig.root.position.x;\\n          entry.rig.root.position.x += dx * (1 - Math.exp(-3 * delta));\\n          entry.rig.root.position.z += dz * (1 - Math.exp(-3 * delta));\\n          const moveSpeed = Math.hypot(dx, dz) / Math.max(delta, 0.016);\\n          if (moveSpeed > 0.15) {\\n            entry.rig.root.rotation.y = Math.atan2(dx, dz);\\n          }\\n          animateAvatarRig(entry.rig, Math.min(2.1, moveSpeed * 0.6), elapsed + companionIdx, delta);\\n        } else {\\n          const lerpAlpha = 1 - Math.exp(-7 * delta);\\n          const dx = entry.targetX - entry.rig.root.position.x;\\n          const dz = entry.targetZ - entry.rig.root.position.z;\\n          entry.rig.root.position.x += dx * lerpAlpha;\\n          entry.rig.root.position.z += dz * lerpAlpha;\\n          entry.rig.root.rotation.y += (entry.targetYaw - entry.rig.root.rotation.y) * lerpAlpha;\\n          const distSpeed = Math.hypot(dx, dz) * 3.5;\\n          animateAvatarRig(entry.rig, distSpeed, elapsed + companionIdx, delta);\\n        }\\n        companionIdx++;\\n      });\\n\\n      // Keep dynamic room lights centered on the player\'s current & adjacent rooms\\n      const activeRoomIdx = getRoomIndexAtZ(ps.z, curLayout);\\n      const activeRoom = curLayout.rooms[activeRoomIdx] ?? curLayout.rooms[0];\\n      if (roomLights[0]) roomLights[0].position.set(0, 5.4, activeRoom.centerZ + 4.2);\\n      if (roomLights[1]) roomLights[1].position.set(0, 5.4, activeRoom.centerZ - 4.2);\\n      const nextRoom = curLayout.rooms[activeRoomIdx + 1] ?? activeRoom;\\n      const prevRoom = curLayout.rooms[activeRoomIdx - 1] ?? activeRoom;\\n      if (roomLights[2]) roomLights[2].position.set(0, 5.4, nextRoom.centerZ);\\n      if (roomLights[3]) roomLights[3].position.set(0, 5.4, prevRoom.centerZ);\\n\\n      // Smooth damped Third-Person or First-Person Camera strictly clamped inside walls & closed doors\\n      const camDamp = 1 - Math.exp(-9 * delta);\\n      if (cameraModeRef.current === \'first\') {\\n        _camDesired.set(ps.x, 1.66, ps.z);\\n        camera.position.lerp(_camDesired, camDamp);\\n        _camLook.set(\\n          ps.x - Math.sin(ps.camYaw) * 6,\\n          1.66 - Math.sin(ps.camPitch) * 3.5,\\n          ps.z - Math.cos(ps.camYaw) * 6\\n        );\\n        camera.lookAt(_camLook);\\n      } else {\\n        const dist = 3.8;\\n        const desiredX = ps.x + Math.sin(ps.camYaw) * dist;\\n        const desiredZ = ps.z + Math.cos(ps.camYaw) * dist;\\n        const clampedCam = clampPlayerPosition(desiredX, desiredZ, curLayout, openDoors, ps.z);\\n        const desiredY = 2.08 + Math.sin(ps.camPitch) * 1.1;\\n        _camDesired.set(clampedCam.x, desiredY, clampedCam.z);\\n        camera.position.lerp(_camDesired, camDamp);\\n\\n        _camLook.set(\\n          ps.x - Math.sin(ps.camYaw) * 2.8,\\n          1.66,\\n          ps.z - Math.cos(ps.camYaw) * 2.8\\n        );\\n        camera.lookAt(_camLook);\\n      }\\n\\n      // Throttled HUD room & nearby door indicator + Firestore presence broadcast\\n      if (nowMs - lastHudCheck > 200) {\\n        lastHudCheck = nowMs;\\n        container.dataset.playerX = ps.x.toFixed(2);\\n        container.dataset.playerZ = ps.z.toFixed(2);\\n        container.dataset.currentRoom = String(activeRoomIdx);\\n        setCurrentRoomIndex(activeRoomIdx);\\n\\n        const near = findNearbyDoor(ps.x, ps.z, curLayout);\\n        setNearbyDoor((prev) => (prev?.id === near?.id ? prev : near));\\n      }\\n\\n      if (nowMs - ps.lastBroadcast > 650) {\\n        ps.lastBroadcast = nowMs;\\n        onPositionBroadcastRef.current?.(ps.x, ps.z, ps.yaw);\\n      }\\n\\n      try {\\n        renderer.render(scene, camera);\\n        frameCount++;\\n        if (frameCount <= 5 || frameCount % 30 === 0) {\\n          container.dataset.frames = String(frameCount);\\n        }\\n      } catch (err) {\\n        console.error(\'Museum3DView render error:\', err);\\n      }\"}, {\"AllowMultiple\":false, \"EndLine\":826, \"ReplacementContent\":\"    const onPageHide = () => {\\n      const ps = playerStateRef.current;\\n      onPresenceOfflineRef.current?.(ps.x, ps.z, ps.yaw);\\n    };\\n    window.addEventListener(\'pagehide\', onPageHide);\\n\\n    return () => {\\n      const ps = playerStateRef.current;\\n      onPresenceOfflineRef.current?.(ps.x, ps.z, ps.yaw);\\n      disposed = true;\\n      resumeLoopRef.current = null;\\n      renderOnceRef.current = null;\\n      clearKeysRef.current = null;\\n      cancelAnimationFrame(frameId);\\n      clearTimeout(frameId);\\n      window.removeEventListener(\'pagehide\', onPageHide);\\n      window.removeEventListener(\'keydown\', onKeyDown);\\n      window.removeEventListener(\'keyup\', onKeyUp);\\n      window.removeEventListener(\'blur\', clearAllKeys);\\n      window.removeEventListener(\'resize\', onResize);\\n      renderer.domElement.removeEventListener(\'pointerdown\', onPointerDown);\\n      window.removeEventListener(\'pointermove\', onPointerMove);\\n      window.removeEventListener(\'pointerup\', onPointerUp);\\n      renderer.domElement.removeEventListener(\'webglcontextlost\', onContextLost);\\n      builtMuseumRef.current?.dispose();\\n      builtMuseumRef.current = null;\\n      playerRigRef.current?.dispose();\\n      playerRigRef.current = null;\\n      companionRigsRef.current.forEach((c) => c.rig.dispose());\\n      companionRigsRef.current.clear();\\n      envTex.dispose();\\n      renderer.dispose();\\n      sceneRef.current = null;\\n      rendererRef.current = null;\\n      if (renderer.domElement.parentNode === container) {\\n        container.removeChild(renderer.domElement);\\n      }\\n    };\\n  }, []);\", \"StartLine\":796, \"TargetContent\":\"    return () => {\\n      disposed = true;\\n      resumeLoopRef.current = null;\\n      renderOnceRef.current = null;\\n      clearKeysRef.current = null;\\n      cancelAnimationFrame(frameId);\\n      clearTimeout(frameId);\\n      window.removeEventListener(\'keydown\', onKeyDown);\\n      window.removeEventListener(\'keyup\', onKeyUp);\\n      window.removeEventListener(\'blur\', clearAllKeys);\\n      window.removeEventListener(\'resize\', onResize);\\n      renderer.domElement.removeEventListener(\'pointerdown\', onPointerDown);\\n      window.removeEventListener(\'pointermove\', onPointerMove);\\n      window.removeEventListener(\'pointerup\', onPointerUp);\\n      renderer.domElement.removeEventListener(\'webglcontextlost\', onContextLost);\\n      builtMuseumRef.current?.dispose();\\n      builtMuseumRef.current = null;\\n      playerRigRef.current?.dispose();\\n      playerRigRef.current = null;\\n      companionRigsRef.current.forEach((c) => c.rig.dispose());\\n      companionRigsRef.current.clear();\\n      envTex.dispose();\\n      renderer.dispose();\\n      sceneRef.current = null;\\n      rendererRef.current = null;\\n      if (renderer.domElement.parentNode === container) {\\n        container.removeChild(renderer.domElement);\\n      }\\n    };\\n  }, []);\"}, {\"AllowMultiple\":false, \"EndLine\":980, \"ReplacementContent\":\"  // Sync live active & offline standing 3D avatars in the museum\\n  useEffect(() => {\\n    const slot = companionsSlotRef.current;\\n    if (!slot) return;\\n\\n    const activeIds = new Set(companionVisitors.map((v) => v.uid));\\n    companionRigsRef.current.forEach((entry, uid) => {\\n      if (!activeIds.has(uid)) {\\n        slot.remove(entry.rig.root);\\n        entry.rig.dispose();\\n        companionRigsRef.current.delete(uid);\\n      }\\n    });\\n\\n    for (const v of companionVisitors) {\\n      const visualSignature = getCompanionVisualSignature(v);\\n      const existing = companionRigsRef.current.get(v.uid);\\n      if (existing && existing.visualSignature === visualSignature) {\\n        existing.targetX = v.x;\\n        existing.targetZ = v.z;\\n        existing.targetYaw = v.yaw;\\n        existing.visitor = v;\\n      } else {\\n        const startX = existing ? existing.rig.root.position.x : v.x;\\n        const startZ = existing ? existing.rig.root.position.z : v.z;\\n        const startYaw = existing ? existing.rig.root.rotation.y : v.yaw;\\n        if (existing) {\\n          slot.remove(existing.rig.root);\\n          existing.rig.dispose();\\n        }\\n        const rig = buildAvatarRig(\\n          {\\n            displayName: v.displayName,\\n            gender: v.gender,\\n            skinTone: v.skinTone,\\n            hairStyle: v.hairStyle,\\n            hairColor: v.hairColor,\\n            outfitStyle: v.outfitStyle,\\n            outfitColor: v.outfitColor,\\n            accentColor: v.accentColor,\\n            accessory: v.accessory,\\n          },\\n          {\\n            showNameplate: true,\\n            showContactShadow: true,\\n            nameplateSubtitle: v.isActive ? \'Active \302\267 Live\' : \'Standing \302\267 Offline\',\\n            statusTone: v.isActive ? \'active\' : \'standing\',\\n          }\\n        );\\n        rig.root.position.set(startX, 0, startZ);\\n        rig.root.rotation.y = startYaw;\\n        slot.add(rig.root);\\n        companionRigsRef.current.set(v.uid, {\\n          rig,\\n          visitor: v,\\n          visualSignature,\\n          targetX: v.x,\\n          targetZ: v.z,\\n          targetYaw: v.yaw,\\n        });\\n      }\\n    }\\n    renderOnceRef.current?.();\\n  }, [companionVisitors]);\", \"StartLine\":930, \"TargetContent\":\"  // Sync co-visitor / invited companion 3D avatars in the museum\\n  useEffect(() => {\\n    const slot = companionsSlotRef.current;\\n    if (!slot) return;\\n\\n    const activeIds = new Set(companionVisitors.map((v) => v.uid));\\n    companionRigsRef.current.forEach((entry, uid) => {\\n      if (!activeIds.has(uid)) {\\n        slot.remove(entry.rig.root);\\n        entry.rig.dispose();\\n        companionRigsRef.current.delete(uid);\\n      }\\n    });\\n\\n    for (const v of companionVisitors) {\\n      const existing = companionRigsRef.current.get(v.uid);\\n      if (existing) {\\n        existing.targetX = v.x;\\n        existing.targetZ = v.z;\\n        existing.targetYaw = v.yaw;\\n        existing.visitor = v;\\n      } else {\\n        const rig = buildAvatarRig(\\n          {\\n            displayName: v.displayName,\\n            gender: v.gender,\\n            skinTone: v.skinTone,\\n            hairStyle: v.hairStyle,\\n            hairColor: v.hairColor,\\n            outfitStyle: v.outfitStyle,\\n            outfitColor: v.outfitColor,\\n            accentColor: v.accentColor,\\n            accessory: v.accessory,\\n          },\\n          { showNameplate: true, showContactShadow: true }\\n        );\\n        rig.root.position.set(v.x, 0, v.z);\\n        rig.root.rotation.y = v.yaw;\\n        slot.add(rig.root);\\n        companionRigsRef.current.set(v.uid, {\\n          rig,\\n          visitor: v,\\n          targetX: v.x,\\n          targetZ: v.z,\\n          targetYaw: v.yaw,\\n        });\\n      }\\n    }\\n  }, [companionVisitors]);\"}, {\"AllowMultiple\":false, \"EndLine\":1076, \"ReplacementContent\":\"            <p className=\\\"text-xs text-stone-300 font-mono tabular-nums mt-0.5 truncate\\\">\\n              {museum.title} \302\267 {artworks.length}/{layout.totalWallSlots} Walls \302\267{\' \'}\\n              {activeCompanionCount + 1} Active\\n              {companionVisitors.length > activeCompanionCount\\n                ? ` \302\267 ${companionVisitors.length - activeCompanionCount} Standing`\\n                : \'\'}\\n            </p>\", \"StartLine\":1068, \"TargetContent\":\"            <p className=\\\"text-xs text-stone-300 font-mono tabular-nums mt-0.5 truncate\\\">\\n              {currentRoom.architectureSubtitle} \302\267 {artworks.length}/{layout.totalWallSlots} Walls \302\267{\' \'}\\n              {layout.roomCount} {layout.roomCount === 1 ? \'Room\' : \'Rooms\'}\\n            </p>\"}, {\"AllowMultiple\":false, \"EndLine\":1185, \"ReplacementContent\":\"        <button\\n          type=\\\"button\\\"\\n          aria-label=\\\"Turn left\\\"\\n          onPointerDown={() => setVirtualKey(\'left\', true)}\\n          onPointerUp={() => setVirtualKey(\'left\', false)}\\n          onPointerLeave={() => setVirtualKey(\'left\', false)}\\n          className=\\\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\\\"\\n        >\\n          <ArrowLeft className=\\\"w-4 h-4\\\" />\\n        </button>\\n        <button\\n          type=\\\"button\\\"\\n          aria-label=\\\"Walk backward\\\"\\n          onPointerDown={() => setVirtualKey(\'down\', true)}\\n          onPointerUp={() => setVirtualKey(\'down\', false)}\\n          onPointerLeave={() => setVirtualKey(\'down\', false)}\\n          className=\\\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\\\"\\n        >\\n          <ArrowDown className=\\\"w-4 h-4\\\" />\\n        </button>\\n        <button\\n          type=\\\"button\\\"\\n          aria-label=\\\"Turn right\\\"\\n          onPointerDown={() => setVirtualKey(\'right\', true)}\\n          onPointerUp={() => setVirtualKey(\'right\', false)}\\n          onPointerLeave={() => setVirtualKey(\'right\', false)}\\n          className=\\\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\\\"\\n        >\\n          <ArrowRight className=\\\"w