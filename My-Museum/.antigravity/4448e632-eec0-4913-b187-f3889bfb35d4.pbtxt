    content: "{\n  \"entities\": {\n    \"UserProfile\": {\n      \"title\": \"UserProfile\",\n      \"description\": \"Private user profile and customizable 3D avatar configuration.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"uid\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"displayName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 80 },\n        \"email\": { \"type\": \"string\", \"maxLength\": 160 },\n        \"gender\": { \"type\": \"string\", \"enum\": [\"man\", \"woman\"] },\n        \"skinTone\": { \"type\": \"string\", \"maxLength\": 16, \"pattern\": \"^#[0-9a-fA-F]{6}$\" },\n        \"hairStyle\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"hairColor\": { \"type\": \"string\", \"maxLength\": 16, \"pattern\": \"^#[0-9a-fA-F]{6}$\" },\n        \"outfitStyle\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"outfitColor\": { \"type\": \"string\", \"maxLength\": 16, \"pattern\": \"^#[0-9a-fA-F]{6}$\" },\n        \"accentColor\": { \"type\": \"string\", \"maxLength\": 16, \"pattern\": \"^#[0-9a-fA-F]{6}$\" },\n        \"accessory\": { \"type\": \"string\", \"enum\": [\"none\", \"glasses\", \"scarf\", \"lanyard\"] },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"uid\", \"displayName\", \"gender\", \"skinTone\", \"hairStyle\", \"hairColor\", \"outfitStyle\", \"outfitColor\", \"accentColor\", \"accessory\", \"createdAt\", \"updatedAt\"]\n    },\n    \"Museum\": {\n      \"title\": \"Museum\",\n      \"description\": \"Personal or shared 3D virtual museum hall metadata and access settings.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"ownerName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 80 },\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n        \"description\": { \"type\": \"string\", \"maxLength\": 400 },\n        \"accessCode\": { \"type\": \"string\", \"minLength\": 4, \"maxLength\": 20, \"pattern\": \"^[A-Z0-9\\\\-]+$\" },\n        \"wallTheme\": { \"type\": \"string\", \"enum\": [\"alabaster\", \"travertine\", \"charcoal\"] },\n        \"isOpenByCode\": { \"type\": \"boolean\" },\n        \"memberEmails\": { \"type\": \"array\", \"description\": \"Bounded list of up to 10 verified collaborator emails.\" },\n        \"curatorEmails\": { \"type\": \"array\", \"description\": \"Bounded list of up to 10 verified co-curator emails allowed to add artworks.\" },\n        \"artworkCount\": { \"type\": \"number\" },\n        \"roomNames\": { \"type\": \"object\", \"description\": \"Optional bounded map of up to 30 custom room names keyed by room index.\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"ownerId\", \"ownerName\", \"title\", \"description\", \"accessCode\", \"wallTheme\", \"isOpenByCode\", \"memberEmails\", \"curatorEmails\", \"artworkCount\", \"createdAt\", \"updatedAt\"]\n    },\n    \"MuseumCode\": {\n      \"title\": \"MuseumCode\",\n      \"description\": \"Lookup index mapping a shareable museum access code to its museumId.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"accessCode\": { \"type\": \"string\", \"minLength\": 4, \"maxLength\": 20, \"pattern\": \"^[A-Z0-9\\\\-]+$\" },\n        \"museumId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"ownerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"accessCode\", \"museumId\", \"ownerId\", \"title\", \"createdAt\"]\n    },\n    \"Artwork\": {\n      \"title\": \"Artwork\",\n      \"description\": \"Framed museum artwork placed on an expandable 3D gallery wall.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"museumId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"ownerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"uploadedBy\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"uploadedByName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 80 },\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 120 },\n        \"artist\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n        \"dateCaptured\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 10, \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n        \"notes\": { \"type\": \"string\", \"maxLength\": 500 },\n        \"imageUrl\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 450000 },\n        \"aspectRatio\": { \"type\": \"string\", \"enum\": [\"4:3\", \"3:4\", \"1:1\"] },\n        \"frameStyle\": { \"type\": \"string\", \"enum\": [\"bronze\", \"walnut\", \"obsidian\", \"alabaster\"] },\n        \"isOpenByCode\": { \"type\": \"boolean\" },\n        \"viewerEmails\": { \"type\": \"array\", \"description\": \"Mirrored bounded list of up to 10 invited emails for secure list queries.\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"museumId\", \"ownerId\", \"uploadedBy\", \"uploadedByName\", \"title\", \"artist\", \"dateCaptured\", \"notes\", \"imageUrl\", \"aspectRatio\", \"frameStyle\", \"isOpenByCode\", \"viewerEmails\", \"createdAt\", \"updatedAt\"]\n    },\n    \"MuseumMember\": {\n      \"title\": \"MuseumMember\",\n      \"description\": \"Granted access record for an invited museum visitor or co-curator.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"museumId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"ownerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"email\": { \"type\": \"string\", \"minLength\": 3, \"maxLength\": 160 },\n        \"displayName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 80 },\n        \"role\": { \"type\": \"string\", \"enum\": [\"visitor\", \"curator\"] },\n        \"gender\": { \"type\": \"string\", \"enum\": [\"man\", \"woman\"] },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"museumId\", \"ownerId\", \"email\", \"displayName\", \"role\", \"gender\", \"createdAt\"]\n    },\n    \"VisitorPresence\": {\n      \"title\": \"VisitorPresence\",\n      \"description\": \"Real-time 3D position and avatar state of a visitor walking inside a museum.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"museumId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"ownerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"uid\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"displayName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 80 },\n        \"gender\": { \"type\": \"string\", \"enum\": [\"man\", \"woman\"] },\n        \"skinTone\": { \"type\": \"string\", \"maxLength\": 16, \"pattern\": \"^#[0-9a-fA-F]{6}$\" },\n        \"hairStyle\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"hairColor\": { \"type\": \"string\", \"maxLength\": 16, \"pattern\": \"^#[0-9a-fA-F]{6}$\" },\n        \"outfitStyle\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"outfitColor\": { \"type\": \"string\", \"maxLength\": 16, \"pattern\": \"^#[0-9a-fA-F]{6}$\" },\n        \"accentColor\": { \"type\": \"string\", \"maxLength\": 16, \"pattern\": \"^#[0-9a-fA-F]{6}$\" },\n        \"accessory\": { \"type\": \"string\", \"enum\": [\"none\", \"glasses\", \"scarf\", \"lanyard\"] },\n        \"x\": { \"type\": \"number\" },\n        \"z\": { \"type\": \"number\" },\n        \"yaw\": { \"type\": \"number\" },\n        \"isOpenByCode\": { \"type\": \"boolean\" },\n        \"viewerEmails\": { \"type\": \"array\", \"description\": \"Bounded list of up to 10 invited emails for secure list queries.\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"museumId\", \"ownerId\", \"uid\", \"displayName\", \"gender\", \"skinTone\", \"hairStyle\", \"hairColor\", \"outfitStyle\", \"outfitColor\", \"accentColor\", \"accessory\", \"x\", \"z\", \"yaw\", \"isOpenByCode\", \"viewerEmails\", \"updatedAt\"]\n    }\n  },\n  \"firestore\": {\n    \"/users/{userId}\": {\n      \"schema\": { \"$ref\": \"#/entities/UserProfile\" },\n      \"description\": \"User avatar profile and private account metadata.\"\n    },\n    \"/museums/{museumId}\": {\n      \"schema\": { \"$ref\": \"#/entities/Museum\" },\n      \"description\": \"Museum master records owned by users and optionally shared with invited emails or by access code.\"\n    },\n    \"/museumCodes/{code}\": {\n      \"schema\": { \"$ref\": \"#/entities/MuseumCode\" },\n      \"description\": \"Access code lookup records pointing to a museumId.\"\n    },\n    \"/museums/{museumId}/artworks/{artworkId}\": {\n      \"schema\": { \"$ref\": \"#/entities/Artwork\" },\n      \"description\": \"Curated images displayed on the expanding 3D museum walls.\"\n    },\n    \"/museums/{museumId}/members/{memberId}\": {\n      \"schema\": { \"$ref\": \"#/entities/MuseumMember\" },\n      \"description\": \"Invited visitors and co-curators granted access to a museum.\"\n    },\n    \"/museums/{museumId}/presence/{visitorId}\": {\n      \"schema\": { \"$ref\": \"#/entities/VisitorPresence\" },\n      \"description\": \"Live 3D avatar coordinates and styling for visitors currently inside the museum.\"\n    }\n  }\n}\n"
