      arguments_json: "{\"CodeContent\":\"import * as THREE from \'three\';\\n\\nlet cachedSoftwareGl: boolean | null = null;\\n\\nexport function detectSoftwareGl(): boolean {\\n  if (cachedSoftwareGl !== null) return cachedSoftwareGl;\\n  try {\\n    const canvas = document.createElement(\'canvas\');\\n    const gl = canvas.getContext(\'webgl2\') || canvas.getContext(\'webgl\');\\n    if (!gl) {\\n      cachedSoftwareGl = true;\\n      return true;\\n    }\\n    const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');\\n    const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\\n    const gpu = String(gl.getParameter(param) ?? \'\');\\n    gl.getExtension(\'WEBGL_lose_context\')?.loseContext();\\n    cachedSoftwareGl = /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\\n    return cachedSoftwareGl;\\n  } catch {\\n    cachedSoftwareGl = true;\\n    return true;\\n  }\\n}\\n\\nexport function createAfterDrawScheduler(\\n  renderer: THREE.WebGLRenderer,\\n  getTimerSetter: (id: number) => void\\n): (cb: () => void) => void {\\n  return (cb: () => void) => {\\n    const gl = renderer.getContext() as WebGL2RenderingContext;\\n    if (typeof gl.fenceSync !== \'function\') {\\n      getTimerSetter(window.setTimeout(cb, 80));\\n      return;\\n    }\\n    const sync = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0);\\n    gl.flush();\\n    const poll = () => {\\n      const state = sync ? gl.getSyncParameter(sync, gl.SYNC_STATUS) : gl.SIGNALED;\\n      if (state === gl.UNSIGNALED) {\\n        getTimerSetter(window.setTimeout(poll, 5));\\n      } else {\\n        if (sync) gl.deleteSync(sync);\\n        getTimerSetter(window.setTimeout(cb, 80));\\n      }\\n    };\\n    getTimerSetter(window.setTimeout(poll, 5));\\n  };\\n}\\n\\n/**\\n * Compresses an uploaded user photo into a crisp museum-ready JPEG Data URL (< 320KB)\\n * and automatically infers the closest museum frame aspect ratio (\'4:3\', \'3:4\', or \'1:1\').\\n */\\nexport async function compressUploadedImage(\\n  file: File\\n): Promise<{ dataUrl: string; aspectRatio: \'4:3\' | \'3:4\' | \'1:1\' }> {\\n  return new Promise((resolve, reject) => {\\n    const reader = new FileReader();\\n    reader.onerror = () => reject(new Error(\'Could not read the selected image file.\'));\\n    reader.onload = () => {\\n      const img = new Image();\\n      img.onerror = () => reject(new Error(\'Selected file is not a valid image.\'));\\n      img.onload = () => {\\n        const ratio = img.width / Math.max(1, img.height);\\n        const aspectRatio: \'4:3\' | \'3:4\' | \'1:1\' =\\n          ratio > 1.15 ? \'4:3\' : ratio < 0.85 ? \'3:4\' : \'1:1\';\\n\\n        const maxDim = 920;\\n        let w = img.width;\\n        let h = img.height;\\n        if (w > h && w > maxDim) {\\n          h = Math.round((h * maxDim) / w);\\n          w = maxDim;\\n        } else if (h >= w && h > maxDim) {\\n          w = Math.round((w * maxDim) / h);\\n          h = maxDim;\\n        }\\n\\n        const canvas = document.createElement(\'canvas\');\\n        canvas.width = w;\\n        canvas.height = h;\\n        const ctx = canvas.getContext(\'2d\');\\n        if (!ctx) {\\n          reject(new Error(\'Canvas context unavailable.\'));\\n          return;\\n        }\\n        ctx.drawImage(img, 0, 0, w, h);\\n\\n        let quality = 0.82;\\n        let dataUrl = canvas.toDataURL(\'image/jpeg\', quality);\\n        while (dataUrl.length > 360000 && quality > 0.4) {\\n          quality -= 0.1;\\n          dataUrl = canvas.toDataURL(\'image/jpeg\', quality);\\n        }\\n        resolve({ dataUrl, aspectRatio });\\n      };\\n      img.src = String(reader.result);\\n    };\\n    reader.readAsDataURL(file);\\n  });\\n}\\n\", \"Description\":\"Add software WebGL detection, afterDraw frame pacing, and client-side image compression helpers\", \"Overwrite\":true, \"TargetFile\":\"/src/three/webglUtils.ts\", \"toolAction\":\"Creating WebGL utility helpers\", \"toolSummary\":\"Create webglUtils.ts\"}"
      thinking_signature: "\022\375\n\n\372\n\001i\024}\023\021-\250\313\213\'\3447O\271\"\a\300\n\224)\335$G\324\000\340S\253\214\250\003f\362\243\207\363\223P4\212 N\313E\215\317\270,E)\245\233\347bZE\271?c\203\266[\r\030\2239\376\347\026\377\253Q\2273@\224\353b\3720\245z\'\230@\217\246\002\261\363\340G\242\211\016\240\357:\027*\272\366y\312RK(\200\210\250\311\260\245\023\332\207\001\211\0018&\225\240Z\244ct\312p7\232}\347M\024\b\301\372\237R\205Xe\b #\360\b>\254\354\b&\023<\375\223\350\252\033\027\'\f3\r\017\264vWM\261\213\274\215-\315\273\275\274\300Z>B\365\206-5\030\363\205 \223\315/\3737\323\336]\221\303\216\221\235}o\231e\202O}\256F\257\n\364~F\302\000\272,\332\200\217l\200\230j?\024\375\3736/\006\234t\n\214\202EO\307\035\371\226\235\v)\347\244C\325\263\234\030\262\335\260C\221\022\363\333\032m\241F8\266Q\264,!S\022\nF\200/\357\335\367o\331Z\002\016\376\005\2646\256\341r9\265\360\312\017\004\023\354\243\355T\033\023\233\251\025\331\205\001Mp5\362D\266\021\020:fXL.\334BW\316\222\362\r8\334\266\245\265\331\375\\\331:l1\212\217\331\352)2\311T9\345BW\336\003X6\271/\027\f\3776\317l\325q\227\327\373\037\316;\202\365\262Zb\242r\201\263\303U3S^\347\034l\nA\246p\206\321\233\216\356\001l\350\3409\203,zr\353\305\'\223\357}i\220\020Bv\333\255Y\274\320\017In<\335\352\370\017\324\232\307\356g=p\266\363\300\361\322\331\273\017$\311\031\214\377\0276\365\256\016Q-\025\247\266G\323\006\342\314\310\324sV\317.\362\31504\271\207\312f\337\004\351\375\333\024\321\231F\305\261bh\212\245\001\342ig\2371J$\224\276\2458\217\244=tY\006:\271\025\345H\037\225\324\360\205Nf\226\352\350\020\\\355\327\346\255=\210\345\230\303?\213\361\243<\346\313R\350\216\f\016//\244=X\353\000\2205>G\227w\342V\032\024_@\324\343\026\371\346\230\260U\314\232g\212\227\225\030\221\206\254?\33416K\220\247j\214\257\a\027\376\036\270\027>\276\322\356\255\242\030\346J@C\325i\023\016q\033\275\267\220\b\027\003\333\317\345D\207\213\322l\323\274Gn\231\261\276y\375\376\\\025m\371\275\372Mr\365\263H\275=`\374\004&;&\207C`sJrQ /\337\261\326\270K;\177b\361\"=\275.\354~\370\374\v\264^\267-\r\255\000\207\203\370ltsjz\267|:i\0162\021\327C\261\215Y6\2031L\303182\215\305\016V\372\005\177/\226k(\213\364!Sm\224\376Y\243\'\313\342\312\200\0336gsq\230~\204\356\240~\241\320\340\371E4\355\265KTYJu\004*L\254I\305\240\225D\326r|\aa\320\377\233\313\255*\252\177\237\322\235\277\025\310\v\000<\222\361\314\246\210\235~\321\206\212\341\351\237\335\310\310\312V\330\233\237\274\260n8gm\207x\313km\234\357^;\213Y>\356\373\301\370C/E\346xp[\023\342V{r\224\364]\356\347\255<\237\342Wq9\274\312kK\250#\227\310\367\350\371\b\t=\276\204`\303n\357^\244N\277\360G.\216H\350\377\216\231\202\006:\001V\200\002\212\307 Xq\362\347\224\260S\210\206\272\264\337Pw\304\370\256\333Tf\201\355\023S\331jrL\177\344\361\216G\325\267 \214\373\177\232\334\250\267\231\t\rHL\333\336$\264\213D\002;\2639\202\302\2308\207\322v\036\300\334\022\300\025\026\325\240\342t\311g{r\221I\351\321\303Gc\257sl\225\202\234\333\331\316\344B\273\205b\017\352q\335\277:\344\177$S\206\301\246\327\033\241 \027]\236\021o\277\177*Q\327b3D\265\374\215\363(\004\001\225\302I\002:\210\222Z\332\361\3777\332\372\364e=\363\035\347`\350\317\237\'H\025n\225\324zN\233\v?\376|\272/\365{\006\370\356\206(\351\367\215L\211o\004\315\226\006:\256\r\217?\273\274c|\025\263R(h\253\351\353\206SZ*\222wb\001\345\247\233?^o\316\265\250\263\233(%Q\"W\376\260\263\234\366/\222\241\330\f\003f\340\201\236%\253\303%\342\177\026JI\202\253;\036\232\372\250\205\206\365\217\'\b\217\302Bh\227\342\352\332\224\363\026\026br\030T\247\360\356\a\274\225\003\263\202\257\257\241r8\225\234\342\033\335\252u\361d[\255\333Y\255\017e\222\245B\005\016f\376\224H\214\033a\335\327\252\266\201\316\024\336Q\261\260XW\264\304M\027c\234\245-\331\377/\"Hk\344<\024\2079s\313\225\036?\303\353\237\364\266m\224\b\272\016D\a\344\231\207\303^\017\025o\362@\333\273@\336\216\334\301`\207>\302\353\230 \362 \262\340bU\305{\b\313\257\325N8\021Fy\fg\030r\032\032\265I$\256\355TJ`\032S\374\314\336\262+\021\340-\251Y[9\037\237\367#3\311\031j\203\035\267\017T\362\001\212\001\243\201\263\216\325\332\264g|\362\327\355\357"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12219765034920325950"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\n\\ninterface ErrorBoundaryState {\\n  hasError: boolean;\\n  message: string;\\n}\\n\\nexport class ErrorBoundary extends React.Component<\\n  { children: React.ReactNode },\\n  ErrorBoundaryState\\n> {\\n  constructor(props: { children: React.ReactNode }) {\\n    super(props);\\n    this.state = { hasError: false, message: \'\' };\\n  }\\n\\n  static getDerivedStateFromError(error: Error): ErrorBoundaryState {\\n    return {\\n      hasError: true,\\n      message: error?.message || \'An unexpected application error occurred.\',\\n    };\\n  }\\n\\n  componentDidCatch(error: Error) {\\n    console.error(\'Application ErrorBoundary caught:\', error);\\n  }\\n\\n  render() {\\n    if (this.state.hasError) {\\n      let displayMessage = this.state.message;\\n      try {\\n        const parsed = JSON.parse(this.state.message);\\n        if (parsed && typeof parsed.error === \'string\') {\\n          displayMessage = `Data access error (${parsed.operationType} on ${parsed.path ?? \'collection\'}): ${parsed.error}`;\\n        }\\n      } catch {\\n        // Plain error message\\n      }\\n\\n      return (\\n        <div className=\\\"min-h-screen bg-[#F7F5F0] text-[#1C1917] flex items-center justify-center p-6\\\">\\n          <div className=\\\"max-w-lg w-full bg-white border border-stone-200 p-8\\\">\\n            <p className=\\\"text-xs font-mono tracking-wider text-[#8A5A2B] mb-2\\\">\\n              MY MUSEUM \302\267 RECOVERY\\n            </p>\\n            <h1 className=\\\"text-3xl font-editorial font-semibold text-stone-900 mb-3\\\">\\n              Something interrupted the gallery\\n            </h1>\\n            <p className=\\\"text-sm text-stone-600 leading-relaxed mb-6 break-words\\\">\\n              {displayMessage}\\n            </p>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                this.setState({ hasError: false, message: \'\' });\\n                window.location.reload();\\n              }}\\n              className=\\\"px-5 py-2.5 bg-[#1C1917] text-[#F7F5F0] text-sm font-medium hover:bg-stone-800 transition-colors cursor-pointer\\\"\\n            >\\n              Reload Gallery\\n            </button>\\n          </div>\\n        </div>\\n      );\\n    }\\n\\n    return this.props.children;\\n  }\\n}\\n\", \"Description\":\"Add React ErrorBoundary with structured Firestore error formatting and reload recovery\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ErrorBoundary.tsx\", \"toolAction\":\"Creating ErrorBoundary component\", \"toolSummary\":\"Create ErrorBoundary.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12219765034920329205"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useRef, useState } from \'react\';\\nimport * as THREE from \'three\';\\nimport { OrbitControls } from \'three/addons/controls/OrbitControls.js\';\\nimport { RoomEnvironment } from \'three/addons/environments/RoomEnvironment.js\';\\nimport { RotateCcw } from \'lucide-react\';\\nimport type { AvatarConfig } from \'../types/museum\';\\nimport { buildAvatarRig, type AvatarRig } from \'../three/avatarBuilder\';\\nimport { createAfterDrawScheduler, detectSoftwareGl } from \'../three/webglUtils\';\\n\\ninterface AvatarPreview3DProps {\\n  avatar: AvatarConfig;\\n}\\n\\nexport function AvatarPreview3D({ avatar }: AvatarPreview3DProps) {\\n  const mountRef = useRef<HTMLDivElement | null>(null);\\n  const avatarSlotRef = useRef<THREE.Group | null>(null);\\n  const currentRigRef = useRef<AvatarRig | null>(null);\\n  const requestRenderRef = useRef<(() => void) | null>(null);\\n  const resetCameraRef = useRef<(() => void) | null>(null);\\n  const [webglUnavailable, setWebglUnavailable] = useState(false);\\n\\n  // Mount Three.js studio turntable once\\n  useEffect(() => {\\n    const container = mountRef.current;\\n    if (!container) return;\\n\\n    const isSoftwareGl = detectSoftwareGl();\\n    let renderer: THREE.WebGLRenderer;\\n    try {\\n      renderer = new THREE.WebGLRenderer({\\n        antialias: !isSoftwareGl,\\n        powerPreference: \'high-performance\',\\n        alpha: false,\\n      });\\n    } catch {\\n      setWebglUnavailable(true);\\n      return;\\n    }\\n\\n    const width = Math.max(300, container.clientWidth);\\n    const height = Math.max(400, container.clientHeight);\\n    renderer.setSize(width, height);\\n    renderer.setPixelRatio(isSoftwareGl ? 1 : Math.min(window.devicePixelRatio, 2));\\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\\n    renderer.toneMappingExposure = 1.08;\\n    renderer.shadowMap.enabled = !isSoftwareGl;\\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\\n    renderer.domElement.style.display = \'block\';\\n    renderer.domElement.style.width = \'100%\';\\n    renderer.domElement.style.height = \'100%\';\\n    container.appendChild(renderer.domElement);\\n\\n    const scene = new THREE.Scene();\\n    scene.background = new THREE.Color(0xebe6dd);\\n    scene.fog = new THREE.Fog(0xebe6dd, 9, 22);\\n\\n    const pmrem = new THREE.PMREMGenerator(renderer);\\n    const envTexture = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;\\n    scene.environment = envTexture;\\n    pmrem.dispose();\\n\\n    const camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 40);\\n    camera.position.set(0.55, 1.48, 3.65);\\n\\n    const controls = new OrbitControls(camera, renderer.domElement);\\n    controls.target.set(0, 1.05, 0);\\n    controls.enablePan = false;\\n    controls.enableDamping = !isSoftwareGl;\\n    controls.dampingFactor = 0.08;\\n    controls.minDistance = 2.2;\\n    controls.maxDistance = 5.2;\\n    controls.minPolarAngle = Math.PI * 0.22;\\n    controls.maxPolarAngle = Math.PI * 0.56;\\n    controls.update();\\n\\n    // Warm/cool 3-point museum studio lighting\\n    const hemi = new THREE.HemisphereLight(0xf6f9ff, 0x8f7a64, 0.95);\\n    scene.add(hemi);\\n\\n    const keyLight = new THREE.DirectionalLight(0xfff1dc, 1.65);\\n    keyLight.position.set(3.2, 5.4, 3.8);\\n    keyLight.castShadow = !isSoftwareGl;\\n    keyLight.shadow.mapSize.set(1024, 1024);\\n    keyLight.shadow.camera.near = 0.5;\\n    keyLight.shadow.camera.far = 16;\\n    keyLight.shadow.camera.left = -2.5;\\n    keyLight.shadow.camera.right = 2.5;\\n    keyLight.shadow.camera.top = 2.5;\\n    keyLight.shadow.camera.bottom = -2.5;\\n    keyLight.shadow.bias = -0.0005;\\n    keyLight.shadow.normalBias = 0.02;\\n    scene.add(keyLight);\\n\\n    const rimLight = new THREE.DirectionalLight(0xdce8f8, 0.72);\\n    rimLight.position.set(-3.2, 3.4, -3.5);\\n    scene.add(rimLight);\\n\\n    // Sculpted Marble Exhibition Pedestal & Architectural Backdrop\\n    const pedestalGeo = new THREE.CylinderGeometry(0.82, 0.88, 0.18, 36);\\n    const pedestalMat = new THREE.MeshStandardMaterial({\\n      color: 0xf6f2ea,\\n      roughness: 0.34,\\n      metalness: 0.05,\\n    });\\n    const pedestal = new THREE.Mesh(pedestalGeo, pedestalMat);\\n    pedestal.position.y = -0.09;\\n    pedestal.receiveShadow = true;\\n    scene.add(pedestal);\\n\\n    const brassRingGeo = new THREE.TorusGeometry(0.84, 0.016, 12, 48);\\n    const brassRingMat = new THREE.MeshStandardMaterial({\\n      color: 0xc2975c,\\n      roughness: 0.24,\\n      metalness: 0.88,\\n    });\\n    const brassRing = new THREE.Mesh(brassRingGeo, brassRingMat);\\n    brassRing.rotation.x = Math.PI / 2;\\n    brassRing.position.y = -0.004;\\n    scene.add(brassRing);\\n\\n    const studioFloorGeo = new THREE.CircleGeometry(7, 36);\\n    const studioFloorMat = new THREE.MeshStandardMaterial({\\n      color: 0xe3ddd2,\\n      roughness: 0.52,\\n      metalness: 0.04,\\n    });\\n    const studioFloor = new THREE.Mesh(studioFloorGeo, studioFloorMat);\\n    studioFloor.rotation.x = -Math.PI / 2;\\n    studioFloor.position.y = -0.18;\\n    studioFloor.receiveShadow = true;\\n    scene.add(studioFloor);\\n\\n    // Subtle architectural curved gallery niche behind the avatar\\n    const nicheGeo = new THREE.CylinderGeometry(3.4, 3.4, 4.6, 32, 1, true, Math.PI * 0.65, Math.PI * 0.7);\\n    const nicheMat = new THREE.MeshStandardMaterial({\\n      color: 0xf2ede4,\\n      roughness: 0.88,\\n      metalness: 0.02,\\n      side: THREE.BackSide,\\n    });\\n    const niche = new THREE.Mesh(nicheGeo, nicheMat);\\n    niche.position.set(0, 2.1, -0.4);\\n    scene.add(niche);\\n\\n    const avatarSlot = new THREE.Group();\\n    scene.add(avatarSlot);\\n    avatarSlotRef.current = avatarSlot;\\n\\n    // On-demand coalesced rendering (safe on Software WebGL & GPU)\\n    let frameId = 0;\\n    let renderBusy = false;\\n    let renderDirty = false;\\n    let disposed = false;\\n\\n    const afterDraw = createAfterDrawScheduler(renderer, (id) => {\\n      frameId = id;\\n    });\\n\\n    const requestRender = () => {\\n      if (disposed) return;\\n      if (renderBusy) {\\n        renderDirty = true;\\n        return;\\n      }\\n      renderBusy = true;\\n      frameId = requestAnimationFrame(() => {\\n        if (disposed) return;\\n        renderDirty = false;\\n        controls.update();\\n        renderer.render(scene, camera);\\n        const done = () => {\\n          renderBusy = false;\\n          if (renderDirty && !disposed) requestRender();\\n        };\\n        if (isSoftwareGl) afterDraw(done);\\n        else done();\\n      });\\n    };\\n\\n    requestRenderRef.current = requestRender;\\n    resetCameraRef.current = () => {\\n      camera.position.set(0.55, 1.48, 3.65);\\n      controls.target.set(0, 1.05, 0);\\n      controls.update();\\n      requestRender();\\n    };\\n\\n    const onControlChange = () => requestRender();\\n    controls.addEventListener(\'change\', onControlChange);\\n\\n    const onContextLost = (e: Event) => {\\n      e.preventDefault();\\n    };\\n    const onContextRestored = () => {\\n      requestRender();\\n    };\\n    renderer.domElement.addEventListener(\'webglcontextlost\', onContextLost);\\n    renderer.domElement.addEventListener(\'webglcontextrestored\', onContextRestored);\\n\\n    const handleResize = () => {\\n      if (!container || disposed) return;\\n      const w = Math.max(280, container.clientWidth);\\n      const h = Math.max(360, container.clientHeight);\\n      camera.aspect = w / h;\\n      camera.updateProjectionMatrix();\\n      renderer.setSize(w, h);\\n      requestRender();\\n    };\\n\\n    const resizeObserver = new ResizeObserver(handleResize);\\n    resizeObserver.observe(container);\\n\\n    // Build initial rig right after mount\\n    const initialRig = buildAvatarRig(avatar, { showNameplate: false, showContactShadow: true });\\n    avatarSlot.add(initialRig.root);\\n    currentRigRef.current = initialRig;\\n    if (!isSoftwareGl) {\\n      renderer.compile(scene, camera);\\n    }\\n    requestRender();\\n\\n    return () => {\\n      disposed = true;\\n      cancelAnimationFrame(frameId);\\n      clearTimeout(frameId);\\n      resizeObserver.disconnect();\\n      controls.removeEventListener(\'change\', onControlChange);\\n      controls.dispose();\\n      renderer.domElement.removeEventListener(\'webglcontextlost\', onContextLost);\\n      renderer.domElement.removeEventListener(\'webglcontextrestored\', onContextRestored);\\n      currentRigRef.current?.dispose();\\n      currentRigRef.current = null;\\n      avatarSlotRef.current = null;\\n      requestRenderRef.current = null;\\n      resetCameraRef.current = null;\\n      pedestalGeo.dispose();\\n      pedestalMat.dispose();\\n      brassRingGeo.dispose();\\n      brassRingMat.dispose();\\n      studioFloorGeo.dispose();\\n      studioFloorMat.dispose();\\n      nicheGeo.dispose();\\n      nicheMat.dispose();\\n      envTexture.dispose();\\n      renderer.dispose();\\n      if (renderer.domElement.parentNode === container) {\\n        container.removeChild(renderer.domElement);\\n      }\\n    };\\n  }, []);\\n\\n  // Hot-swap sculpted 3D avatar when customization changes without tearing down WebGL\\n  useEffect(() => {\\n    const slot = avatarSlotRef.current;\\n    if (!slot) return;\\n    if (currentRigRef.current) {\\n      slot.remove(currentRigRef.current.root);\\n      currentRigRef.current.dispose();\\n    }\\n    const nextRig = buildAvatarRig(avatar, { showNameplate: false, showContactShadow: true });\\n    slot.add(nextRig.root);\\n    currentRigRef.current = nextRig;\\n    requestRenderRef.current?.();\\n  }, [avatar]);\\n\\n  if (webglUnavailable) {\\n    return (\\n      <div className=\\\"w-full h-full min-h-[460px] bg-[#EBE6DD] border border-stone-200 flex flex-col items-center justify-center p-8 text-center\\\">\\n        <p className=\\\"font-editorial text-2xl text-stone-900 mb-2\\\">\\n          {avatar.displayName} ({avatar.gender === \'woman\' ? \'Woman\' : \'Man\'})\\n        </p>\\n        <p className=\\\"text-sm text-stone-600\\\">\\n          3D preview requires WebGL. Your avatar selections are saved and ready for the museum.\\n        </p>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div\\n      className=\\\"relative w-full h-full min-h-[440px] lg:min-h-[580px] bg-[#EBE6DD] border border-stone-200 overflow-hidden\\\"\\n      data-testid=\\\"avatar-preview-stage\\\"\\n      data-gender={avatar.gender}\\n      data-outfit={avatar.outfitStyle}\\n    >\\n      <div ref={mountRef} className=\\\"w-full h-full\\\" />\\n\\n      <div className=\\\"absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none\\\">\\n        <div className=\\\"bg-[#1C1917]/85 text-[#F7F5F0] px-3 py-1.5 text-xs tracking-wide\\\">\\n          <span>{avatar.displayName || \'Curator\'}</span>\\n          <span className=\\\"mx-2 text-stone-400\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n          <span className=\\\"text-[#D4B282]\\\">\\n            {avatar.gender === \'woman\' ? \'Woman 3D Model\' : \'Man 3D Model\'}\\n          </span>\\n        </div>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => resetCameraRef.current?.()}\\n          aria-label=\\\"Reset 3D avatar camera view\\\"\\n          className=\\\"pointer-events-auto inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#F7F5F0]/95 text-stone-800 border border-stone-300 text-xs font-medium hover:bg-white transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n        >\\n          <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n          Reset View\\n        </button>\\n      </div>\\n\\n      <div className=\\\"absolute bottom-4 left-4 pointer-events-none text-xs text-stone-600 bg-[#F7F5F0]/90 px-3 py-1.5 border border-stone-300/80\\\">\\n        Drag to rotate 360\302\260 \302\267 Scroll to zoom\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Build interactive 3D Avatar Studio turntable with OrbitControls, marble plinth, and hot-swapping customization\", \"Overwrite\":true, \"TargetFile\":\"/src/components/AvatarPreview3D.tsx\", \"toolAction\":\"Creating AvatarPreview3D component\", \"toolSummary\":\"Create AvatarPreview3D.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12219765034920328364"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useMemo, useState } from \'react\';\\nimport {\\n  ArrowDownUp,\\n  Calendar,\\n  Compass,\\n  Eye,\\n  Grid2x2,\\n  List,\\n  Plus,\\n  Search,\\n  Trash2,\\n  X,\\n} from \'lucide-react\';\\nimport type { ArtworkItem, DateSortOrder } from \'../types/museum\';\\nimport {\\n  formatAccessionNumber,\\n  formatArchivalDate,\\n  getArtworkPlacement,\\n  groupArtworksByDate,\\n  sortArtworksByDate,\\n} from \'../museum/layout\';\\n\\ninterface CatalogDrawerProps {\\n  open: boolean;\\n  onClose: () => void;\\n  artworks: ArtworkItem[];\\n  canCurate: boolean;\\n  onWalkToArtwork?: (artworkId: string) => void;\\n  onInspectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\\n  onDeleteArtwork: (artworkId: string) => void;\\n  onOpenUpload: () => void;\\n}\\n\\nexport function CatalogDrawer({\\n  open,\\n  onClose,\\n  artworks,\\n  canCurate,\\n  onWalkToArtwork,\\n  onInspectArtwork,\\n  onDeleteArtwork,\\n  onOpenUpload,\\n}: CatalogDrawerProps) {\\n  const [sortOrder, setSortOrder] = useState<DateSortOrder>(\'newest\');\\n  const [viewMode, setViewMode] = useState<\'timeline\' | \'grid\'>(\'timeline\');\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n\\n  const slotIndexMap = useMemo(() => {\\n    const map = new Map<string, number>();\\n    artworks.forEach((a, idx) => map.set(a.id, idx));\\n    return map;\\n  }, [artworks]);\\n\\n  const filteredArtworks = useMemo(() => {\\n    const q = searchQuery.trim().toLowerCase();\\n    if (!q) return artworks;\\n    return artworks.filter(\\n      (a) =>\\n        a.title.toLowerCase().includes(q) ||\\n        a.artist.toLowerCase().includes(q) ||\\n        a.dateCaptured.includes(q) ||\\n        a.notes.toLowerCase().includes(q)\\n    );\\n  }, [artworks, searchQuery]);\\n\\n  const sortedFlat = useMemo(\\n    () => sortArtworksByDate(filteredArtworks, sortOrder),\\n    [filteredArtworks, sortOrder]\\n  );\\n\\n  const groupedByDate = useMemo(\\n    () => groupArtworksByDate(filteredArtworks, sortOrder),\\n    [filteredArtworks, sortOrder]\\n  );\\n\\n  if (!open) return null;\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 flex justify-end bg-stone-950/60\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label=\\\"Museum Exhibition Catalog\\\"\\n    >\\n      <div className=\\\"w-full max-w-2xl bg-[#F7F5F0] text-[#1C1917] h-full flex flex-col border-l border-stone-300 shadow-2xl\\\">\\n        {/* Header */}\\n        <div className=\\\"px-6 py-5 border-b border-stone-200 flex items-center justify-between gap-4 bg-[#FAF8F4]\\\">\\n          <div>\\n            <p className=\\\"text-xs font-mono text-[#8A5A2B] tracking-wider mb-1 tabular-nums\\\">\\n              EXHIBITION ARCHIVE \302\267 {artworks.length} {artworks.length === 1 ? \'WORK\' : \'WORKS\'}\\n            </p>\\n            <h2 className=\\\"text-2xl font-editorial font-semibold text-stone-900\\\">\\n              Complete Collection by Date\\n            </h2>\\n          </div>\\n          <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n            {canCurate && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onOpenUpload}\\n                className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#8A5A2B] text-white text-xs font-medium hover:bg-[#734922] transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n              >\\n                <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                Add Artwork\\n              </button>\\n            )}\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onClose}\\n              aria-label=\\\"Close catalog drawer\\\"\\n              className=\\\"p-2 text-stone-600 hover:text-stone-900 hover:bg-stone-200/70 transition-colors cursor-pointer\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Sort & Filter Toolbar */}\\n        <div className=\\\"px-6 py-4 border-b border-stone-200 bg-[#F4F1EA] flex flex-wrap items-center justify-between gap-3\\\">\\n          <div className=\\\"relative flex-1 min-w-[200px]\\\">\\n            <Search className=\\\"w-4 h-4 text-stone-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\\\" />\\n            <input\\n              type=\\\"text\\\"\\n              value={searchQuery}\\n              onChange={(e) => setSearchQuery(e.target.value)}\\n              placeholder=\\\"Search title, creator, or date...\\\"\\n              aria-label=\\\"Search museum catalog\\\"\\n              className=\\\"w-full pl-9 pr-3 py-2 bg-white border border-stone-300 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:border-[#8A5A2B]\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2\\\">\\n            {/* Explicit Date Sorting Segmented Control */}\\n            <div\\n              className=\\\"flex items-center bg-stone-200/80 p-0.5 border border-stone-300\\\"\\n              role=\\\"group\\\"\\n              aria-label=\\\"Sort collection by date\\\"\\n            >\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setSortOrder(\'newest\')}\\n                className={`inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\\n                  sortOrder === \'newest\'\\n                    ? \'bg-white text-stone-900 shadow-xs\'\\n                    : \'text-stone-600 hover:text-stone-900\'\\n                }`}\\n              >\\n                <ArrowDownUp className=\\\"w-3.5 h-3.5\\\" />\\n                Newest First\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setSortOrder(\'oldest\')}\\n                className={`px-3 py-1.5 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\\n                  sortOrder === \'oldest\'\\n                    ? \'bg-white text-stone-900 shadow-xs\'\\n                    : \'text-stone-600 hover:text-stone-900\'\\n                }`}\\n              >\\n                Oldest First\\n              </button>\\n            </div>\\n\\n            {/* View Toggle */}\\n            <div className=\\\"flex items-center bg-stone-200/80 p-0.5 border border-stone-300\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setViewMode(\'timeline\')}\\n                aria-label=\\\"Chronological timeline view\\\"\\n                className={`p-1.5 transition-colors cursor-pointer ${\\n                  viewMode === \'timeline\'\\n                    ? \'bg-white text-stone-900\'\\n                    : \'text-stone-600 hover:text-stone-900\'\\n                }`}\\n              >\\n                <List className=\\\"w-4 h-4\\\" />\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setViewMode(\'grid\')}\\n                aria-label=\\\"Archival grid view\\\"\\n                className={`p-1.5 transition-colors cursor-pointer ${\\n                  viewMode === \'grid\'\\n                    ? \'bg-white text-stone-900\'\\n                    : \'text-stone-600 hover:text-stone-900\'\\n                }`}\\n              >\\n                <Grid2x2 className=\\\"w-4 h-4\\\" />\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Content */}\\n        <div className=\\\"flex-1 overflow-y-auto px-6 py-5\\\" data-testid=\\\"catalog-list\\\">\\n          {filteredArtworks.length === 0 ? (\\n            <div className=\\\"py-16 text-center\\\">\\n              <p className=\\\"font-editorial text-2xl text-stone-800 mb-2\\\">\\n                {artworks.length === 0\\n                  ? \'Your gallery walls are ready\'\\n                  : \'No artworks match your search\'}\\n              </p>\\n              <p className=\\\"text-sm text-stone-500 mb-6\\\">\\n                {artworks.length === 0\\n                  ? \'Upload your first photograph or painting. New walls expand automatically as your collection grows.\'\\n                  : \'Try another title, artist name, or clear the search field.\'}\\n              </p>\\n              {canCurate && artworks.length === 0 && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onOpenUpload}\\n                  className=\\\"px-5 py-2.5 bg-[#1C1917] text-white text-sm font-medium hover:bg-stone-800 transition-colors cursor-pointer\\\"\\n                >\\n                  Upload First Artwork\\n                </button>\\n              )}\\n            </div>\\n          ) : viewMode === \'timeline\' ? (\\n            <div className=\\\"space-y-8\\\">\\n              {groupedByDate.map((group) => (\\n                <section key={group.dateKey}>\\n                  <div className=\\\"flex items-center justify-between pb-2 mb-4 border-b border-stone-300\\\">\\n                    <div className=\\\"flex items-center gap-2 text-xs font-mono text-stone-700 tabular-nums\\\">\\n                      <Calendar className=\\\"w-3.5 h-3.5 text-[#8A5A2B]\\\" />\\n                      <span>{group.label}</span>\\n                      <span className=\\\"text-stone-400\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n                      <span className=\\\"text-stone-500\\\">{group.dateKey}</span>\\n                    </div>\\n                    <span className=\\\"text-xs text-stone-500 tabular-nums\\\">\\n                      {group.items.length} {group.items.length === 1 ? \'work\' : \'works\'}\\n                    </span>\\n                  </div>\\n\\n                  <div className=\\\"space-y-4\\\">\\n                    {group.items.map((item) => {\\n                      const slotIdx = slotIndexMap.get(item.id) ?? 0;\\n                      const placement = getArtworkPlacement(slotIdx);\\n                      const accession = formatAccessionNumber(item.dateCaptured, slotIdx);\\n                      return (\\n                        <article\\n                          key={item.id}\\n                          className=\\\"flex gap-4 bg-white border border-stone-200 p-4 hover:border-stone-400 transition-colors\\\"\\n                          data-artwork-date={item.dateCaptured}\\n                        >\\n                          <div className=\\\"w-28 h-24 shrink-0 bg-stone-200 overflow-hidden\\\">\\n                            <img\\n                              src={item.imageUrl}\\n                              alt={item.title}\\n                              referrerPolicy=\\\"no-referrer\\\"\\n                              className=\\\"w-full h-full object-cover\\\"\\n                            />\\n                          </div>\\n                          <div className=\\\"flex-1 min-w-0\\\">\\n                            <p className=\\\"text-xs font-mono text-stone-500 tabular-nums mb-1\\\">\\n                              {accession} \302\267 {placement.wingLabel} ({placement.wallSide === \'west\' ? \'West Wall\' : \'East Wall\'})\\n                            </p>\\n                            <h3 className=\\\"font-editorial text-xl font-semibold text-stone-900 truncate\\\">\\n                              {item.title}\\n                            </h3>\\n                            <p className=\\\"text-xs text-stone-600 mt-0.5\\\">\\n                              {item.artist} \302\267 {formatArchivalDate(item.dateCaptured)}\\n                            </p>\\n                            {item.notes && (\\n                              <p className=\\\"text-xs text-stone-500 mt-2 line-clamp-2 leading-relaxed\\\">\\n                                {item.notes}\\n                              </p>\\n                            )}\\n                            <div className=\\\"mt-3 flex flex-wrap items-center gap-3\\\">\\n                              {onWalkToArtwork && (\\n                                <button\\n                                  type=\\\"button\\\"\\n                                  onClick={() => {\\n                                    onWalkToArtwork(item.id);\\n                                    onClose();\\n                                  }}\\n                                  className=\\\"inline-flex items-center gap-1.5 text-xs font-medium text-[#8A5A2B] hover:text-[#66401B] cursor-pointer\\\"\\n                                >\\n                                  <Compass className=\\\"w-3.5 h-3.5\\\" />\\n                                  Walk To Wall\\n                                </button>\\n                              )}\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => onInspectArtwork(item, slotIdx)}\\n                                className=\\\"inline-flex items-center gap-1.5 text-xs font-medium text-stone-700 hover:text-stone-950 cursor-pointer\\\"\\n                              >\\n                                <Eye className=\\\"w-3.5 h-3.5\\\" />\\n                                Inspect\\n                              </button>\\n                              {canCurate && (\\n                                <button\\n                                  type=\\\"button\\\"\\n                                  onClick={() => onDeleteArtwork(item.id)}\\n                                  aria-label={`Remove \'${item.title}\'`}\\n                                  className=\\\"inline-flex items-center gap-1 text-xs font-medium text-stone-500 hover:text-red-700 cursor-pointer ml-auto\\\"\\n                                >\\n                                  <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                                  Remove\\n                                </button>\\n                              )}\\n                            </div>\\n                          </div>\\n                        </article>\\n                      );\\n                    })}\\n                  </div>\\n                </section>\\n              ))}\\n            </div>\\n          ) : (\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n              {sortedFlat.map((item) => {\\n                const slotIdx = slotIndexMap.get(item.id) ?? 0;\\n                const placement = getArtworkPlacement(slotIdx);\\n                return (\\n                  <article\\n                    key={item.id}\\n                    className=\\\"bg-white border border-stone-200 overflow-hidden flex flex-col\\\"\\n                    data-artwork-date={item.dateCaptured}\\n                  >\\n                    <div className=\\\"aspect-[4/3] bg-stone-200 overflow-hidden\\\">\\n                      <img\\n                        src={item.imageUrl}\\n                        alt={item.title}\\n                        referrerPolicy=\\\"no-referrer\\\"\\n                        className=\\\"w-full h-full object-cover\\\"\\n                      />\\n                    </div>\\n                    <div className=\\\"p-4 flex-1 flex flex-col\\\">\\n                      <p className=\\\"text-xs font-mono text-stone-500 tabular-nums mb-1\\\">\\n                        {item.dateCaptured} \302\267 {placement.wingLabel}\\n                      </p>\\n                      <h3 className=\\\"font-editorial text-lg font-semibold text-stone-900 truncate\\\">\\n                        {item.title}\\n                      </h3>\\n                      <p className=\\\"text-xs text-stone-600 mb-3\\\">{item.artist}</p>\\n                      <div className=\\\"mt-auto pt-2 border-t border-stone-100 flex items-center justify-between gap-2\\\">\\n                        {onWalkToArtwork ? (\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() => {\\n                              onWalkToArtwork(item.id);\\n                              onClose();\\n                            }}\\n                            className=\\\"text-xs font-medium text-[#8A5A2B] hover:text-[#66401B] cursor-pointer\\\"\\n                          >\\n                            Walk To Wall\\n                          </button>\\n                        ) : (\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() => onInspectArtwork(item, slotIdx)}\\n                            className=\\\"text-xs font-medium text-stone-800 hover:text-stone-950 cursor-pointer\\\"\\n                          >\\n                            Inspect\\n                          </button>\\n                        )}\\n                        {canCurate && (\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() => onDeleteArtwork(item.id)}\\n                            aria-label={`Remove \'${item.title}\'`}\\n                            className=\\\"text-xs text-stone-500 hover:text-red-700 cursor-pointer\\\"\\n                          >\\n                            Remove\\n                          </button>\\n                        )}\\n                      </div>\\n                    </div>\\n                  </article>\\n                );\\n              })}\\n            </div>\\n          )}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create Date-Sorted Museum Archival Catalog drawer with timeline/grid views and Walk To Wall teleportation\", \"Overwrite\":true, \"TargetFile\":\"/src/components/CatalogDrawer.tsx\", \"toolAction\":\"Creating CatalogDrawer component\", \"toolSummary\":\"Create CatalogDrawer.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12219765034920327523"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { ImagePlus, Upload, X } from \'lucide-react\';\\nimport type { AspectRatioType, FrameStyle } from \'../types/museum\';\\nimport { CURATED_SAMPLES } from \'../data/seedMuseum\';\\nimport { calculateMuseumLayout, validateArtworkInput } from \'../museum/layout\';\\nimport { compressUploadedImage } from \'../three/webglUtils\';\\n\\ninterface UploadArtworkModalProps {\\n  open: boolean;\\n  onClose: () => void;\\n  currentArtworkCount: number;\\n  defaultArtist: string;\\n  onSubmitArtwork: (payload: {\\n    title: string;\\n    artist: string;\\n    dateCaptured: string;\\n    notes: string;\\n    imageUrl: string;\\n    aspectRatio: AspectRatioType;\\n    frameStyle: FrameStyle;\\n  }) => Promise<void> | void;\\n}\\n\\nconst FRAME_OPTIONS: { id: FrameStyle; label: string; swatch: string }[] = [\\n  { id: \'bronze\', label: \'Gilded Bronze\', swatch: \'#A67C46\' },\\n  { id: \'walnut\', label: \'Walnut Wood\', swatch: \'#4B3121\' },\\n  { id: \'obsidian\', label: \'Gallery Black\', swatch: \'#1E1C1A\' },\\n  { id: \'alabaster\', label: \'Alabaster\', swatch: \'#E8E3DA\' },\\n];\\n\\nexport function UploadArtworkModal({\\n  open,\\n  onClose,\\n  currentArtworkCount,\\n  defaultArtist,\\n  onSubmitArtwork,\\n}: UploadArtworkModalProps) {\\n  const today = new Date().toISOString().slice(0, 10);\\n  const [title, setTitle] = useState(\'\');\\n  const [artist, setArtist] = useState(defaultArtist || \'\');\\n  const [dateCaptured, setDateCaptured] = useState(today);\\n  const [notes, setNotes] = useState(\'\');\\n  const [imageUrl, setImageUrl] = useState(\'\');\\n  const [aspectRatio, setAspectRatio] = useState<AspectRatioType>(\'4:3\');\\n  const [frameStyle, setFrameStyle] = useState<FrameStyle>(\'bronze\');\\n  const [errors, setErrors] = useState<Record<string, string>>({});\\n  const [busy, setBusy] = useState(false);\\n\\n  if (!open) return null;\\n\\n  const currentLayout = calculateMuseumLayout(currentArtworkCount);\\n  const nextLayout = calculateMuseumLayout(currentArtworkCount + 1);\\n  const willExpandHall = nextLayout.bayCount > currentLayout.bayCount;\\n\\n  const handleFileChange = async (e: React.ChangeEvent<HTMLInputElement>) => {\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n    setBusy(true);\\n    try {\\n      const result = await compressUploadedImage(file);\\n      setImageUrl(result.dataUrl);\\n      setAspectRatio(result.aspectRatio);\\n      if (!title.trim()) {\\n        const cleanName = file.name.replace(/\\\\.[^.]+$/, \'\').replace(/[-_]+/g, \' \').trim();\\n        if (cleanName) setTitle(cleanName.slice(0, 80));\\n      }\\n      setErrors((prev) => {\\n        const copy = { ...prev };\\n        delete copy.imageUrl;\\n        return copy;\\n      });\\n    } catch (err) {\\n      setErrors((prev) => ({\\n        ...prev,\\n        imageUrl: err instanceof Error ? err.message : \'Unable to process image.\',\\n      }));\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  const handleSelectSample = (sample: (typeof CURATED_SAMPLES)[number]) => {\\n    setImageUrl(sample.imageUrl);\\n    setAspectRatio(sample.aspectRatio);\\n    setFrameStyle(sample.frameStyle);\\n    if (!title.trim()) setTitle(sample.title);\\n    if (!artist.trim()) setArtist(sample.artist);\\n    if (!notes.trim()) setNotes(sample.notes);\\n    setErrors((prev) => {\\n      const copy = { ...prev };\\n      delete copy.imageUrl;\\n      return copy;\\n    });\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const validation = validateArtworkInput({\\n      title,\\n      artist,\\n      dateCaptured,\\n      imageUrl,\\n      notes,\\n    });\\n    if (!validation.valid) {\\n      setErrors(validation.errors);\\n      return;\\n    }\\n\\n    setBusy(true);\\n    try {\\n      await onSubmitArtwork({\\n        title: title.trim(),\\n        artist: artist.trim(),\\n        dateCaptured,\\n        notes: notes.trim(),\\n        imageUrl,\\n        aspectRatio,\\n        frameStyle,\\n      });\\n      setTitle(\'\');\\n      setNotes(\'\');\\n      setImageUrl(\'\');\\n      setErrors({});\\n      onClose();\\n    } catch (err) {\\n      setErrors({\\n        form: err instanceof Error ? err.message : \'Failed to save artwork.\',\\n      });\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-stone-950/65\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label=\\\"Add Artwork to Museum Wall\\\"\\n    >\\n      <div className=\\\"bg-[#FAF8F4] text-[#1C1917] w-full max-w-2xl max-h-[92vh] overflow-y-auto border border-stone-300 shadow-2xl\\\">\\n        <div className=\\\"px-6 py-5 border-b border-stone-200 flex items-center justify-between\\\">\\n          <div>\\n            <p className=\\\"text-xs font-mono text-[#8A5A2B] tracking-wider mb-1 tabular-nums\\\">\\n              {willExpandHall\\n                ? `AUTOMATIC EXPANSION \302\267 CREATES WING ${nextLayout.bayCount}`\\n                : `WALL SLOT ${currentArtworkCount + 1} OF ${currentLayout.totalWallSlots}`}\\n            </p>\\n            <h2 className=\\\"text-2xl font-editorial font-semibold text-stone-900\\\">\\n              Hang New Artwork\\n            </h2>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            aria-label=\\\"Close add artwork dialog\\\"\\n            className=\\\"p-2 text-stone-500 hover:text-stone-900 cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        <form onSubmit={handleSubmit} className=\\\"p-6 space-y-5\\\" noValidate>\\n          {willExpandHall && (\\n            <div className=\\\"p-3.5 bg-[#EFEAE0] border border-stone-300 text-xs text-stone-800 leading-relaxed\\\">\\n              Current gallery wings are full ({currentArtworkCount}/{currentLayout.totalWallSlots} slots).\\n              Adding this artwork will automatically extend the 3D museum corridor and construct a new gallery wing.\\n            </div>\\n          )}\\n\\n          {errors.form && (\\n            <div className=\\\"p-3 bg-red-50 border border-red-200 text-xs text-red-800\\\" role=\\\"alert\\\">\\n              {errors.form}\\n            </div>\\n          )}\\n\\n          {/* Image Upload & Quick Samples */}\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-stone-700 mb-2\\\">\\n              Photograph or Artwork Image\\n            </label>\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4 items-stretch\\\">\\n              <label className=\\\"flex flex-col items-center justify-center border border-dashed border-stone-400 bg-white hover:bg-stone-50 p-5 cursor-pointer transition-colors min-h-[150px] text-center\\\">\\n                <Upload className=\\\"w-5 h-5 text-[#8A5A2B] mb-2\\\" />\\n                <span className=\\\"text-sm font-medium text-stone-800\\\">\\n                  Upload from Device\\n                </span>\\n                <span className=\\\"text-xs text-stone-500 mt-1\\\">\\n                  JPG, PNG, or WebP \302\267 Auto-framed for 3D wall\\n                </span>\\n                <input\\n                  type=\\\"file\\\"\\n                  accept=\\\"image/*\\\"\\n                  onChange={handleFileChange}\\n                  className=\\\"sr-only\\\"\\n                />\\n              </label>\\n\\n              <div className=\\\"bg-stone-100 border border-stone-200 flex items-center justify-center overflow-hidden min-h-[150px]\\\">\\n                {imageUrl ? (\\n                  <img\\n                    src={imageUrl}\\n                    alt=\\\"Artwork preview\\\"\\n                    referrerPolicy=\\\"no-referrer\\\"\\n                    className=\\\"w-full h-40 object-cover\\\"\\n                  />\\n                ) : (\\n                  <div className=\\\"text-center p-4 text-stone-400\\\">\\n                    <ImagePlus className=\\\"w-6 h-6 mx-auto mb-1.5\\\" />\\n                    <span className=\\\"text-xs\\\">Preview appears here</span>\\n                  </div>\\n                )}\\n              </div>\\n            </div>\\n            {errors.imageUrl && (\\n              <p className=\\\"text-xs text-red-700 mt-1.5\\\" role=\\\"alert\\\">\\n                {errors.imageUrl}\\n              </p>\\n            )}\\n\\n            {/* Quick Museum Archive Samples for effortless testing/curation */}\\n            <div className=\\\"mt-3\\\">\\n              <p className=\\\"text-xs text-stone-500 mb-2\\\">\\n                Or select a curated studio photograph:\\n              </p>\\n              <div className=\\\"grid grid-cols-5 gap-2\\\">\\n                {CURATED_SAMPLES.map((s) => (\\n                  <button\\n                    key={s.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => handleSelectSample(s)}\\n                    aria-label={`Use sample artwork ${s.title}`}\\n                    className={`aspect-[4/3] overflow-hidden border transition-all cursor-pointer ${\\n                      imageUrl === s.imageUrl\\n                        ? \'border-[#8A5A2B] ring-2 ring-[#8A5A2B]/30\'\\n                        : \'border-stone-300 hover:border-stone-500\'\\n                    }`}\\n                  >\\n                    <img\\n                      src={s.imageUrl}\\n                      alt={s.title}\\n                      referrerPolicy=\\\"no-referrer\\\"\\n                      className=\\\"w-full h-full object-cover\\\"\\n                    />\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <div>\\n              <label htmlFor=\\\"artwork-title\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1.5\\\">\\n                Artwork Title\\n              </label>\\n              <input\\n                id=\\\"artwork-title\\\"\\n                type=\\\"text\\\"\\n                value={title}\\n                onChange={(e) => setTitle(e.target.value)}\\n                placeholder=\\\"e.g., Sunset Over Cox\'s Bazar\\\"\\n                className=\\\"w-full px-3 py-2 bg-white border border-stone-300 text-sm text-stone-900 focus:outline-none focus:border-[#8A5A2B]\\\"\\n              />\\n              {errors.title && (\\n                <p className=\\\"text-xs text-red-700 mt-1\\\" role=\\\"alert\\\">\\n                  {errors.title}\\n                </p>\\n              )}\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"artwork-artist\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1.5\\\">\\n                Creator / Photographer\\n              </label>\\n              <input\\n                id=\\\"artwork-artist\\\"\\n                type=\\\"text\\\"\\n                value={artist}\\n                onChange={(e) => setArtist(e.target.value)}\\n                placeholder=\\\"Your name or artist\\\"\\n                className=\\\"w-full px-3 py-2 bg-white border border-stone-300 text-sm text-stone-900 focus:outline-none focus:border-[#8A5A2B]\\\"\\n              />\\n              {errors.artist && (\\n                <p className=\\\"text-xs text-red-700 mt-1\\\" role=\\\"alert\\\">\\n                  {errors.artist}\\n                </p>\\n              )}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <div>\\n              <label htmlFor=\\\"artwork-date\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1.5\\\">\\n                Archival Date (used for Date Sorting)\\n              </label>\\n              <input\\n                id=\\\"artwork-date\\\"\\n                type=\\\"date\\\"\\n                value={dateCaptured}\\n                onChange={(e) => setDateCaptured(e.target.value)}\\n                className=\\\"w-full px-3 py-2 bg-white border border-stone-300 text-sm text-stone-900 font-mono tabular-nums focus:outline-none focus:border-[#8A5A2B]\\\"\\n              />\\n              {errors.dateCaptured && (\\n                <p className=\\\"text-xs text-red-700 mt-1\\\" role=\\\"alert\\\">\\n                  {errors.dateCaptured}\\n                </p>\\n              )}\\n            </div>\\n\\n            <div>\\n              <span className=\\\"block text-xs font-medium text-stone-700 mb-1.5\\\">\\n                Frame Molding Finish\\n              </span>\\n              <div className=\\\"grid grid-cols-2 gap-2\\\">\\n                {FRAME_OPTIONS.map((f) => (\\n                  <button\\n                    key={f.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setFrameStyle(f.id)}\\n                    className={`flex items-center gap-2 px-2.5 py-2 text-xs border text-left cursor-pointer transition-colors ${\\n                      frameStyle === f.id\\n                        ? \'border-[#8A5A2B] bg-[#F3ECE2] text-stone-900 font-medium\'\\n                        : \'border-stone-300 bg-white text-stone-700 hover:border-stone-400\'\\n                    }`}\\n                  >\\n                    <span\\n                      className=\\\"w-3.5 h-3.5 border border-stone-400 shrink-0\\\"\\n                      style={{ backgroundColor: f.swatch }}\\n                    />\\n                    <span className=\\\"truncate\\\">{f.label}</span>\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label htmlFor=\\\"artwork-notes\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1.5\\\">\\n              Curatorial Note (Optional)\\n            </label>\\n            <textarea\\n              id=\\\"artwork-notes\\\"\\n              rows={2}\\n              value={notes}\\n              onChange={(e) => setNotes(e.target.value)}\\n              placeholder=\\\"Story, location, medium, or memory attached to this piece...\\\"\\n              className=\\\"w-full px-3 py-2 bg-white border border-stone-300 text-sm text-stone-900 focus:outline-none focus:border-[#8A5A2B]\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"pt-3 border-t border-stone-200 flex items-center justify-end gap-3\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onClose}\\n              className=\\\"px-4 py-2 text-sm text-stone-700 hover:text-stone-900 cursor-pointer\\\"\\n            >\\n              Cancel\\n            </button>\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={busy}\\n              className=\\\"px-5 py-2.5 bg-[#1C1917] text-[#F7F5F0] text-sm font-medium hover:bg-stone-800 disabled:opacity-50 transition-colors cursor-pointer\\\"\\n            >\\n              {busy ? \'Hanging Artwork...\' : \'Hang on Museum Wall\'}\\n            </button>\\n          </div>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create UploadArtworkModal with image compression, date picker, frame finish selector, and strict validation\", \"Overwrite\":true, \"TargetFile\":\"/src/components/UploadArtworkModal.tsx\", \"toolAction\":\"Creating UploadArtworkModal component\", \"toolSummary\":\"Create UploadArtworkModal.tsx\"}"
      original_name: "write_to_file"
    }
