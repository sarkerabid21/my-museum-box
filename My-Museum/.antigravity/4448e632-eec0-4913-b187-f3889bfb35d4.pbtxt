      thinking_signature: "\022\241\016\n\236\016\001i\024}\023\306J\341!/c.\340B*\\\262\263\265\220\253\023\221<\224\212\a\346\324\f\274g\270we&\376\367\f`V\263(YI\360\207,=\277\213\226\322R\256\261i\177\032\271\222A\'\305\323\322,c\201\035h\206\003\311\231\246\220]2\336\375\320\233j\026\t0\211\201\"\344\037\022\355|3\b0\235\267\355\212,\356D!l\215B\3245\347\341\342\250v(\261i \372\354\261\234u\205\350\276\265\350\263QXd\323L\"\017UTY\002\002z\301\222m\035\340gW.\272\321\205\375q,\210\021\310\371\246G9\214g?\375\000\312\344*B\2372G\r6{\327n\202\302\275\357\022\226h\260\0257\274]q4wt\301c\261\231\227\345\366I*b\032\222\314\005\t\254(7\347\242\2727\004\bo\025s\"\372\244q\275=|-\274\004\f\r\025\332\275?\222\275\006\245\330\203.2\316\325\211\026W\230\3379\206\357\236QL\230\204\376\310XK\030\377]B\2616\a#e^~\233\333\234\265\r\376\203\203\225\300\307<\256K\033\333\027\2049\350\215\023\030\264\222\231\305~\221\217\021\210\237\roO\202\236\375\311r%j\357FQ\376ba-\vx\\\352\241\323\032\256/&\316\225\0338ove\346(S\006\027u\r=IQ\204:O\200lA\375\006\225\004\204\230\276\031r=\r\307\224\f\036\202h\333\337\222X*\210\312\243bp\006\217$\322\340\272\266;D\222H\347\334\307\023\316\253#\274h=OO<\f\250o\210\260i\210\177\360m\305\274\026w\275\2018\223b!\321\205\271m\t-3\364\374\017\257\f\325\235\352\325\274H\016\374U\236I\003\263\350~\202z\002s)\366,!s@T\327\031.\v\002\245to}\002\\\"\251S)\026g(\222JH\035\317\201\031@\r\001s\235\217\025\224\222\036\027/-\225L\226\230\317\242\325\2409\304\363\036\362\360(y\017\367\024\257=\270\352L\222\223\255+\301~$\337\273y\333\342\337\3500\322\204\340\252\321\025\244\327;\300{\'7\231\344B\371\312N\307\332G\363k\343gx\335\262\204$\t\2255\354\267\305\034fWr\'A\034\243\315\212k\2575\"y\305\377\266\364O\331y\265qS\330\212\243\267\'\t\251\307\004t\336_@7uX\316\361U\320l8\253\242\300\033\217\245\tr\002\177c]\016\300\227\273\036UI\031y\266\'d\277\365_W\3462.V\366\366\231\264\271\002\235\035X\206\205$\203\367\245q\306P\035\272\340\305\346\236`\315\244\374\222\0