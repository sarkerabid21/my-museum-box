            }
            lines {
              text: "      stem.position.set(tipX * 0.5, vaseBaseY + 1.14 + h * 0.45, tipZ * 0.5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      stem.rotation.z = -tipX * 0.9;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      stem.rotation.x = tipZ * 0.9;"
