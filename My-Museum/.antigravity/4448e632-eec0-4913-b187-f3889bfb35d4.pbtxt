    tool_calls {
      id: "call_14649775009512154224"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import test from \'node:test\';\\nimport assert from \'node:assert/strict\';\\nimport {\\n  computeForwardYaw,\\n  normalizeAngle,\\n  shortestAngleDelta,\\n  stepPlayerSteering,\\n} from \'./cameraSteering\';\\n\\ntest(\'normalizeAngle wraps large angles cleanly into [-PI, PI]\', () => {\\n  const a = normalizeAngle(Math.PI * 3.5);\\n  assert.ok(a >= -Math.PI && a <= Math.PI);\\n  assert.ok(Math.abs(a - -Math.PI / 2) < 1e-6);\\n});\\n\\ntest(\'shortestAngleDelta crosses PI boundary without 360-degree spin\', () => {\\n  const delta = shortestAngleDelta(Math.PI - 0.1, -Math.PI + 0.1);\\n  assert.ok(Math.abs(delta - 0.2) < 1e-6);\\n});\\n\\ntest(\'turning left rotates both camera yaw and 3D avatar yaw smoothly left\', () => {\\n  let state = { camYaw: 0, avatarYaw: computeForwardYaw(0) };\\n  for (let i = 0; i < 15; i++) {\\n    const res = stepPlayerSteering({ forward: 0, turn: 1, sprint: false }, state, 0.05);\\n    state = { camYaw: res.camYaw, avatarYaw: res.avatarYaw };\\n    assert.ok(res.animSpeed > 0, \'turning in place should trigger natural pivot step animation\');\\n  }\\n  assert.ok(state.camYaw > 1.0, \'camera yaw should rotate left (positive)\');\\n  const expectedAvatarYaw = computeForwardYaw(state.camYaw);\\n  assert.ok(\\n    Math.abs(shortestAngleDelta(state.avatarYaw, expectedAvatarYaw)) < 0.25,\\n    \'avatar heading should follow rotated camera heading\'\\n  );\\n});\\n\\ntest(\'turning right while walking forward curves both camera and movement vector right\', () => {\\n  const initial = { camYaw: 0, avatarYaw: computeForwardYaw(0) };\\n  const step = stepPlayerSteering({ forward: 1, turn: -1, sprint: false }, initial, 0.1);\\n  assert.ok(step.camYaw < 0, \'camera yaw should rotate right (negative)\');\\n  assert.ok(step.moveDirX > 0, \'walking forward while turning right should curve toward +X\');\\n  assert.ok(step.moveDirZ < 0, \'walking forward should still advance toward -Z\');\\n  assert.equal(step.isMoving, true);\\n  assert.equal(step.isTurning, true);\\n});\\n\\ntest(\'no input leaves camera and avatar heading unchanged (preserves manual mouse orbit)\', () => {\\n  const state = { camYaw: 1.2, avatarYaw: -0.4 };\\n  const step = stepPlayerSteering({ forward: 0, turn: 0, sprint: false }, state, 0.05);\\n  assert.equal(step.camYaw, 1.2);\\n  assert.equal(step.avatarYaw, -0.4);\\n  assert.equal(step.walkSpeed, 0);\\n  assert.equal(step.animSpeed, 0);\\n});\\n\", \"Description\":\"Add unit tests for camera and 3D avatar synchronized left/right rotation steering\", \"Overwrite\":true, \"TargetFile\":\"/src/museum/cameraSteering.test.ts\", \"toolAction\":\"Creating camera steering tests\", \"toolSummary\":\"Create cameraSteering.test.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_14649775009512155365"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  DEFAULT_AVATAR_BY_GENDER,\\n  type AvatarConfig,\\n  type Gender,\\n  type MemberRole,\\n  type MuseumMember,\\n  type MuseumMeta,\\n  type VisitorPresence,\\n} from \'../types/museum\';\\nimport {\\n  EXCLUSIVE_ABID_EMAIL,\\n  getAbidSignatureAvatar,\\n  isExclusiveAbidAccount,\\n} from \'./exclusiveAvatar\';\\n\\nexport const ABID_PRIMARY_OWNER_UID = \'CwufCmYF1kOQRybSTFLoktJuo8b2\';\\nexport const ABID_PRIMARY_MUSEUM_ID = `museum_${ABID_PRIMARY_OWNER_UID}`;\\nexport const PRESENCE_ACTIVE_WINDOW_MS = 28_000;\\n\\nexport interface TrustedMemberSeed {\\n  id: string;\\n  email: string;\\n  displayName: string;\\n  gender: Gender;\\n  role: MemberRole;\\n  standbyX: number;\\n  standbyZ: number;\\n  standbyYaw: number;\\n  outfitColor: string;\\n}\\n\\n/**\\n * Pre-authorized trusted circle for Abid\'s museum (abidsarker213@gmail.com).\\n * These accounts automatically have access to Abid\'s museum, see all artworks added,\\n * stand calmly in place when offline, and become live/active 3D avatars when signed in.\\n */\\nexport const ABID_TRUSTED_MEMBERS: readonly TrustedMemberSeed[] = [\\n  {\\n    id: \'mem_trusted_suraia475\',\\n    email: \'suraia475@gmail.com\',\\n    displayName: \'Suraia\',\\n    gender: \'woman\',\\n    role: \'visitor\',\\n    standbyX: -2.85,\\n    standbyZ: 1.8,\\n    standbyYaw: 0.45,\\n    outfitColor: \'#6E2E36\',\\n  },\\n  {\\n    id: \'mem_trusted_abidsarker098\',\\n    email: \'abidsarker098@gmail.com\',\\n    displayName: \'Abid (Guest)\',\\n    gender: \'man\',\\n    role: \'visitor\',\\n    standbyX: 2.85,\\n    standbyZ: 1.8,\\n    standbyYaw: -0.45,\\n    outfitColor: \'#2D4739\',\\n  },\\n] as const;\\n\\nexport const ABID_TRUSTED_VISITOR_EMAILS: readonly string[] = ABID_TRUSTED_MEMBERS.map(\\n  (m) => m.email\\n);\\n\\n/**\\n * Deterministic non-PII key derived from a normalized email address.\\n * Stored on Firestore presence docs so we can cleanly match a live/offline presence record\\n * to an invited member without exposing raw email addresses in shared presence documents.\\n */\\nexport function computeMemberKey(email?: string | null): string {\\n  const normalized = (email ?? \'\').trim().toLowerCase();\\n  if (!normalized) return \'\';\\n  let hash = 0x811c9dc5;\\n  for (let i = 0; i < normalized.length; i++) {\\n    hash ^= normalized.charCodeAt(i);\\n    hash = Math.imul(hash, 0x01000193);\\n  }\\n  return `mk_${(hash >>> 0).toString(16).padStart(8, \'0\')}`;\\n}\\n\\nexport function isTrustedAbidVisitorEmail(email?: string | null): boolean {\\n  if (!email) return false;\\n  const normalized = email.trim().toLowerCase();\\n  return ABID_TRUSTED_VISITOR_EMAILS.includes(normalized);\\n}\\n\\nexport function isAbidMuseum(museum: Pick<MuseumMeta, \'id\' | \'ownerId\'>): boolean {\\n  return museum.id === ABID_PRIMARY_MUSEUM_ID || museum.ownerId === ABID_PRIMARY_OWNER_UID;\\n}\\n\\nexport function getDefaultTrustedMembersForOwner(ownerEmail?: string | null): readonly TrustedMemberSeed[] {\\n  return isExclusiveAbidAccount(ownerEmail) ? ABID_TRUSTED_MEMBERS : [];\\n}\\n\\n/**\\n * Determines whether a Firestore presence record is currently live & actively inside the museum.\\n */\\nexport function isPresenceActive(\\n  presence: Pick<VisitorPresence, \'isOnline\' | \'updatedAt\'>,\\n  nowMs = Date.now()\\n): boolean {\\n  if (presence.isOnline === false) return false;\\n  if (typeof presence.updatedAt === \'number\' && presence.updatedAt > 0) {\\n    return nowMs - presence.updatedAt <= PRESENCE_ACTIVE_WINDOW_MS;\\n  }\\n  return presence.isOnline === true;\\n}\\n\\n/**\\n * Picks the best default museum upon sign-in:\\n * - For Abid\'s trusted visitors (suraia475@gmail.com, abidsarker098@gmail.com),\\n *   automatically lands directly in Abid\'s shared museum so they see his artworks immediately.\\n * - For the owner and all other accounts, lands in their own personal museum.\\n */\\nexport function pickPreferredInitialMuseumId(\\n  museums: MuseumMeta[],\\n  userUid: string,\\n  userEmail?: string | null\\n): string {\\n  if (museums.length === 0) return \'\';\\n\\n  if (isTrustedAbidVisitorEmail(userEmail)) {\\n    const abidMuseum =\\n      museums.find((m) => isAbidMuseum(m)) ??\\n      museums.find((m) => m.ownerId !== userUid);\\n    if (abidMuseum) return abidMuseum.id;\\n  }\\n\\n  const personal = museums.find((m) => m.ownerId === userUid);\\n  return personal ? personal.id : museums[0].id;\\n}\\n\\nexport interface CompanionAvatarEntry extends VisitorPresence {\\n  isActive: boolean;\\n}\\n\\nfunction buildStandbyAvatarFromMember(\\n  museum: Pick<MuseumMeta, \'id\' | \'ownerId\'>,\\n  member: Pick<MuseumMember, \'id\' | \'email\' | \'displayName\' | \'gender\'>,\\n  index: number\\n): CompanionAvatarEntry {\\n  const emailLower = member.email.trim().toLowerCase();\\n  const trustedSeed = ABID_TRUSTED_MEMBERS.find((t) => t.email === emailLower);\\n  const preset: AvatarConfig = DEFAULT_AVATAR_BY_GENDER[member.gender];\\n\\n  const fallbackX = index % 2 === 0 ? -3.1 : 3.1;\\n  const fallbackZ = 1.6 - Math.floor(index / 2) * 2.2;\\n  const fallbackYaw = index % 2 === 0 ? 0.45 : -0.45;\\n\\n  return {\\n    uid: `standby-${member.id}`,\\n    museumId: museum.id,\\n    ownerId: museum.ownerId,\\n    memberKey: computeMemberKey(emailLower),\\n    displayName: member.displayName,\\n    gender: member.gender,\\n    skinTone: preset.skinTone,\\n    hairStyle: preset.hairStyle,\\n    hairColor: preset.hairColor,\\n    outfitStyle: preset.outfitStyle,\\n    outfitColor: trustedSeed?.outfitColor ?? (member.gender === \'woman\' ? \'#6E2E36\' : \'#2D4739\'),\\n    accentColor: preset.accentColor,\\n    accessory: preset.accessory,\\n    x: trustedSeed?.standbyX ?? fallbackX,\\n    z: trustedSeed?.standbyZ ?? Math.max(-5.5, Math.min(4.2, fallbackZ)),\\n    yaw: trustedSeed?.standbyYaw ?? fallbackYaw,\\n    isOnline: false,\\n    isActive: false,\\n  };\\n}\\n\\n/**\\n * Resolves the exact set of other 3D avatars shown inside the museum:\\n * 1. Every other user who has a real Firestore presence record appears at their exact coordinates\\n *    (live/active & walking when isOnline + fresh heartbeat; standing straight in place when offline).\\n * 2. Any invited / trusted member (and the museum owner when visited by a guest) who has not\\n *    entered yet stands calmly in a neat Room 1 welcome spot with `isActive: false` (no fake patrolling).\\n * 3. Strictly deduplicated by `uid` and non-PII `memberKey` so nobody ever spawns twice.\\n */\\nexport function resolveMuseumCompanionAvatars(params: {\\n  museum: MuseumMeta;\\n  liveVisitors: VisitorPresence[];\\n  members: MuseumMember[];\\n  showInvitedIn3D: boolean;\\n  selfUid?: string | null;\\n  selfEmail?: string | null;\\n  nowMs?: number;\\n}): CompanionAvatarEntry[] {\\n  const {\\n    museum,\\n    liveVisitors,\\n    members,\\n    showInvitedIn3D,\\n    selfUid,\\n    selfEmail,\\n    nowMs = Date.now(),\\n  } = params;\\n\\n  const selfKey = computeMemberKey(selfEmail);\\n  const result: CompanionAvatarEntry[] = [];\\n  const seenUids = new Set<string>();\\n  const seenKeys = new Set<string>();\\n  const seenNames = new Set<string>();\\n\\n  if (selfUid) seenUids.add(selfUid);\\n  if (selfKey) seenKeys.add(selfKey);\\n\\n  // 1. Add real Firestore presence records (both live active visitors & offline standing visitors)\\n  for (const v of liveVisitors) {\\n    if (seenUids.has(v.uid)) continue;\\n    if (v.memberKey && seenKeys.has(v.memberKey)) continue;\\n\\n    seenUids.add(v.uid);\\n    if (v.memberKey) seenKeys.add(v.memberKey);\\n    seenNames.add(v.displayName.trim().toLowerCase());\\n\\n    result.push({\\n      ...v,\\n      isActive: isPresenceActive(v, nowMs),\\n    });\\n  }\\n\\n  if (!showInvitedIn3D) {\\n    return result;\\n  }\\n\\n  // 2. If a visitor is inside Abid\'s museum while Abid himself has no presence doc yet,\\n  //    render Abid\'s own signature 3D model standing calmly as the museum host.\\n  const abidOwnerKey = computeMemberKey(EXCLUSIVE_ABID_EMAIL);\\n  if (\\n    isAbidMuseum(museum) &&\\n    selfUid !== museum.ownerId &&\\n    !seenUids.has(museum.ownerId) &&\\n    !seenKeys.has(abidOwnerKey)\\n  ) {\\n    const abidHost = getAbidSignatureAvatar(museum.ownerName || \'Ashfaq Sarker Abid\');\\n    seenUids.add(museum.ownerId);\\n    seenKeys.add(abidOwnerKey);\\n    seenNames.add(abidHost.displayName.trim().toLowerCase());\\n\\n    result.push({\\n      uid: `standby-owner-${museum.ownerId}`,\\n      museumId: museum.id,\\n      ownerId: museum.ownerId,\\n      memberKey: abidOwnerKey,\\n      displayName: abidHost.displayName,\\n      gender: abidHost.gender,\\n      skinTone: abidHost.skinTone,\\n      hairStyle: abidHost.hairStyle,\\n      hairColor: abidHost.hairColor,\\n      outfitStyle: abidHost.outfitStyle,\\n      outfitColor: abidHost.outfitColor,\\n      accentColor: abidHost.accentColor,\\n      accessory: abidHost.accessory,\\n      x: 0,\\n      z: -1.8,\\n      yaw: 0,\\n      isOnline: false,\\n      isActive: false,\\n    });\\n  }\\n\\n  // 3. Merge Firestore invited members + Abid\'s trusted circle seeds (deduplicated by memberKey)\\n  const standbyRoster: Pick<MuseumMember, \'id\' | \'email\' | \'displayName\' | \'gender\'>[] = [...members];\\n\\n  if (isAbidMuseum(museum) || isExclusiveAbidAccount(selfEmail)) {\\n    const rosterKeys = new Set(standbyRoster.map((m) => computeMemberKey(m.email)));\\n    for (const seed of ABID_TRUSTED_MEMBERS) {\\n      const k = computeMemberKey(seed.email);\\n      if (!rosterKeys.has(k)) {\\n        rosterKeys.add(k);\\n        standbyRoster.push({\\n          id: seed.id,\\n          email: seed.email,\\n          displayName: seed.displayName,\\n          gender: seed.gender,\\n        });\\n      }\\n    }\\n  }\\n\\n  let standbyIdx = 0;\\n  for (const member of standbyRoster) {\\n    const key = computeMemberKey(member.email);\\n    const nameLower = member.displayName.trim().toLowerCase();\\n    if ((key && seenKeys.has(key)) || (!key && seenNames.has(nameLower))) {\\n      continue;\\n    }\\n    if (key) seenKeys.add(key);\\n    seenNames.add(nameLower);\\n    result.push(buildStandbyAvatarFromMember(museum, member, standbyIdx));\\n    standbyIdx++;\\n  }\\n\\n  return result;\\n}\\n\", \"Description\":\"Add trusted museum circle, active/offline standing presence resolver, and preferred museum selector\", \"Overwrite\":true, \"TargetFile\":\"/src/museum/trustedCircle.ts\", \"toolAction\":\"Creating trusted circle module\", \"toolSummary\":\"Create src/museum/trustedCircle.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_14649775009512156506"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import test from \'node:test\';\\nimport assert from \'node:assert/strict\';\\nimport type { MuseumMeta, VisitorPresence } from \'../types/museum\';\\nimport {\\n  ABID_PRIMARY_MUSEUM_ID,\\n  ABID_PRIMARY_OWNER_UID,\\n  computeMemberKey,\\n  isPresenceActive,\\n  isTrustedAbidVisitorEmail,\\n  pickPreferredInitialMuseumId,\\n  resolveMuseumCompanionAvatars,\\n} from \'./trustedCircle\';\\nimport { ABID_SIGNATURE_STYLE, EXCLUSIVE_ABID_EMAIL } from \'./exclusiveAvatar\';\\n\\nconst abidMuseum: MuseumMeta = {\\n  id: ABID_PRIMARY_MUSEUM_ID,\\n  ownerId: ABID_PRIMARY_OWNER_UID,\\n  ownerName: \'Ashfaq Sarker Abid\',\\n  title: \\\"Ashfaq\'s Museum\\\",\\n  description: \'Personal 3D gallery\',\\n  accessCode: \'MUS-ABID\',\\n  wallTheme: \'alabaster\',\\n  isOpenByCode: false,\\n  memberEmails: [\'suraia475@gmail.com\', \'abidsarker098@gmail.com\'],\\n  curatorEmails: [],\\n  artworkCount: 4,\\n};\\n\\nconst suraiaPersonalMuseum: MuseumMeta = {\\n  id: \'museum_suraia_uid\',\\n  ownerId: \'suraia_uid\',\\n  ownerName: \'Suraia\',\\n  title: \\\"Suraia\'s Museum\\\",\\n  description: \'Personal 3D gallery\',\\n  accessCode: \'MUS-SUR1\',\\n  wallTheme: \'alabaster\',\\n  isOpenByCode: false,\\n  memberEmails: [],\\n  curatorEmails: [],\\n  artworkCount: 0,\\n};\\n\\ntest(\'recognizes pre-authorized trusted visitor emails case-insensitively\', () => {\\n  assert.equal(isTrustedAbidVisitorEmail(\'suraia475@gmail.com\'), true);\\n  assert.equal(isTrustedAbidVisitorEmail(\'  ABIDSARKER098@GMAIL.COM \'), true);\\n  assert.equal(isTrustedAbidVisitorEmail(\'random@example.com\'), false);\\n});\\n\\ntest(\'selects Abid museum first for suraia475 and abidsarker098, and personal museum for owner\', () => {\\n  const list = [suraiaPersonalMuseum, abidMuseum];\\n  assert.equal(\\n    pickPreferredInitialMuseumId(list, \'suraia_uid\', \'suraia475@gmail.com\'),\\n    ABID_PRIMARY_MUSEUM_ID\\n  );\\n  assert.equal(\\n    pickPreferredInitialMuseumId(list, \'abid098_uid\', \'abidsarker098@gmail.com\'),\\n    ABID_PRIMARY_MUSEUM_ID\\n  );\\n  assert.equal(\\n    pickPreferredInitialMuseumId(list, ABID_PRIMARY_OWNER_UID, EXCLUSIVE_ABID_EMAIL),\\n    ABID_PRIMARY_MUSEUM_ID\\n  );\\n  assert.equal(\\n    pickPreferredInitialMuseumId(list, \'suraia_uid\', \'someoneelse@gmail.com\'),\\n    suraiaPersonalMuseum.id\\n  );\\n});\\n\\ntest(\'deduplicates active Suraia presence by memberKey even if Google display name differs\', () => {\\n  const now = 1_700_000_000_000;\\n  const suraiaLive: VisitorPresence = {\\n    uid: \'suraia_uid\',\\n    museumId: abidMuseum.id,\\n    ownerId: abidMuseum.ownerId,\\n    memberKey: computeMemberKey(\'suraia475@gmail.com\'),\\n    displayName: \'Suraia Akter\',\\n    gender: \'woman\',\\n    skinTone: \'#E6BC9A\',\\n    hairStyle: \'flowing\',\\n    hairColor: \'#4A3423\',\\n    outfitStyle: \'dress\',\\n    outfitColor: \'#6E2E36\',\\n    accentColor: \'#C49A6C\',\\n    accessory: \'scarf\',\\n    x: 1.5,\\n    z: -2.4,\\n    yaw: 0.7,\\n    isOnline: true,\\n    updatedAt: now - 2000,\\n  };\\n\\n  const companions = resolveMuseumCompanionAvatars({\\n    museum: abidMuseum,\\n    liveVisitors: [suraiaLive],\\n    members: [],\\n    showInvitedIn3D: true,\\n    selfUid: ABID_PRIMARY_OWNER_UID,\\n    selfEmail: EXCLUSIVE_ABID_EMAIL,\\n    nowMs: now,\\n  });\\n\\n  // Should contain Suraia (active) and Abid Guest (standing offline), NO duplicate Suraia!\\n  assert.equal(companions.length, 2);\\n  const suraia = companions.find((c) => c.uid === \'suraia_uid\');\\n  const abid098 = companions.find((c) => c.memberKey === computeMemberKey(\'abidsarker098@gmail.com\'));\\n  assert.ok(suraia);\\n  assert.equal(suraia.isActive, true);\\n  assert.equal(suraia.x, 1.5);\\n  assert.ok(abid098);\\n  assert.equal(abid098.isActive, false);\\n});\\n\\ntest(\'marks visitor as standing offline when isOnline is false or heartbeat is stale\', () => {\\n  const now = 1_700_000_000_000;\\n  assert.equal(isPresenceActive({ isOnline: true, updatedAt: now - 5_000 }, now), true);\\n  assert.equal(isPresenceActive({ isOnline: false, updatedAt: now - 1_000 }, now), false);\\n  assert.equal(isPresenceActive({ isOnline: true, updatedAt: now - 60_000 }, now), false);\\n});\\n\\ntest(\'when Suraia visits Abid museum while Abid is offline, Abid stands in place with his host model\', () => {\\n  const companions = resolveMuseumCompanionAvatars({\\n    museum: abidMuseum,\\n    liveVisitors: [],\\n    members: [],\\n    showInvitedIn3D: true,\\n    selfUid: \'suraia_uid\',\\n    selfEmail: \'suraia475@gmail.com\',\\n    nowMs: 1_700_000_000_000,\\n  });\\n\\n  // Should show Abid (host standing) and abidsarker098 (standing), never Suraia herself\\n  assert.equal(companions.length, 2);\\n  const host = companions.find((c) => c.memberKey === computeMemberKey(EXCLUSIVE_ABID_EMAIL));\\n  assert.ok(host);\\n  assert.equal(host.isActive, false);\\n  assert.equal(host.outfitStyle, ABID_SIGNATURE_STYLE);\\n  assert.equal(\\n    companions.some((c) => c.memberKey === computeMemberKey(\'suraia475@gmail.com\')),\\n    false\\n  );\\n});\\n\", \"Description\":\"Add unit tests for trusted circle access, deduplication, and active/standing presence resolution\", \"Overwrite\":true, \"TargetFile\":\"/src/museum/trustedCircle.test.ts\", \"toolAction\":\"Creating trusted circle tests\", \"toolSummary\":\"Create trustedCircle.test.ts\"}"
      original_name: "write_to_file"
    }
