              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  collar.rotation.x = Math.PI / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  collar.position.y = 5.45;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  grp.add(collar);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Curved overhanging arm pointing over the asphalt road"
