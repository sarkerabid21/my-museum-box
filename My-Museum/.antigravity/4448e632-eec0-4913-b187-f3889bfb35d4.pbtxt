wn(\\\"KeyW\\\");\n  await page.waitForTimeout(900);\n  await page.keyboard.up(\\\"KeyW\\\");\n  await page.keyboard.up(\\\"ShiftLeft\\\");\n  await page.waitForTimeout(400);\n\n  const atDoor = {\n    roomsAfter9,\n    currentRoom: await view.getAttribute(\\\"data-current-room\\\"),\n    openDoors: await view.getAttribute(\\\"data-open-doors\\\"),\n    playerX: await mount.getAttribute(\\\"data-player-x\\\"),\n    playerZ: await mount.getAttribute(\\\"data-player-z\\\"),\n    promptVisible: await page.locator(\\\"[data-testid=door-prompt]\\\").isVisible(),\n  };\n\n  // 3. Press F to open the door!\n  await page.keyboard.press(\\\"KeyF\\\");\n  await page.waitForTimeout(900);\n  const afterOpen = await view.getAttribute(\\\"data-open-doors\\\");\n  await page.screenshot({ path: \\\".playwright-cli/03_door_open.png\\\", timeout: 30000 });\n\n  // 4. Walk straight through the open doorway into Room II!\n  await page.keyboard.down(\\\"ShiftLeft\\\");\n  await page.keyboard.down(\\\"KeyW\\\");\n  for (let step = 0; step < 16; step++) {\n    await page.waitForTimeout(350);\n    const z = Number(await mount.getAttribute(\\\"data-player-z\\\") || \\\"0\\\");\n    if (z <= -13.5) break;\n  }\n  await page.keyboard.up(\\\"KeyW\\\");\n  await page.keyboard.up(\\\"ShiftLeft\\\");\n  await page.waitForTimeout(500);\n\n  const inRoom2 = {\n    currentRoom: await view.getAttribute(\\\"data-current-room\\\"),\n    playerZ: await mount.getAttribute(\\\"data-player-z\\\"),\n    heading: await page.locator(\\\"h1\\\").innerText(),\n  };\n  await page.screenshot({ path: \\\".playwright-cli/04_room2_atrium.png\\\", timeout: 30000 });\n\n  // 5. Rename Room II to Botanical Sanctuary\n  await page.getByRole(\\\"button\\\", { name: \\\"Rename Room II\\\" }).click();\n  await page.waitForSelector(\\\"#room-signboard-name\\\");\n  await page.fill(\\\"#room-signboard-name\\\", \\\"Botanical Sanctuary\\\");\n  await page.getByRole(\\\"button\\\", { name: \\\"Save Room Name\\\" }).click();\n 