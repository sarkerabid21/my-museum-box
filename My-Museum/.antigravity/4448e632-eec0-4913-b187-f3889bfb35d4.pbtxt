            }
            lines {
              text: "      const handle = new THREE.Mesh("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        trackGeo(new THREE.TorusGeometry(0.18, 0.024, 8, 18, Math.PI * 1.15)),"
