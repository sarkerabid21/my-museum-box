              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // Orient camera and avatar toward the artwork wall"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const lookYaw = placement.wallSide === \'west\' ? Math.PI / 2 : -Math.PI / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      playerStateRef.current.camYaw = lookYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
