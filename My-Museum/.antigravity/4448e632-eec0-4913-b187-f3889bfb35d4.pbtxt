        use_fast_apply: true
        replacement_chunks {
          target_content: "/**\n * Composite multi-part tropical Bangladeshi trees:\n * - \'krishnachura\': Wide umbrella crown with vibrant vermilion-orange flame blossoms\n * - \'mango\': Lush layered deep emerald tropical shade tree\n * - \'palm\': Tall ringed trunk with arching coconut/royal palm fronds\n */\nfunction buildCompositeTree(\n  style: \'krishnachura\' | \'mango\' | \'palm\',\n  scale: number,\n  trackGeo: <T extends THREE.BufferGeometry>(g: T) => T,\n  trackMat: <T extends THREE.Material>(m: T) => T,\n  barkMat: THREE.Material\n): THREE.Group {\n  const grp = new THREE.Group();\n\n  if (style === \'palm\') {\n    const trunkH = 6.2;\n    const segs = 4;\n    for (let i = 0; i < segs; i++) {\n      const seg = new THREE.Mesh(\n        trackGeo(new THREE.CylinderGeometry(0.18 - i * 0.02, 0.24 - i * 0.02, trunkH / segs, 10)),\n        barkMat\n      );\n      seg.position.set(i * 0.08, (i + 0.5) * (trunkH / segs), 0);\n      seg.rotation.z = -0.05 * i;\n      grp.add(seg);\n    }\n    const frondMat = trackMat(\n      new THREE.MeshStandardMaterial({ color: 0x3b7a3e, roughness: 0.72, metalness: 0.02 })\n    );\n    const frondGeo = trackGeo(new THREE.BoxGeometry(0.34, 0.06, 2.65));\n    const crownX = 0.24;\n    const crownY = trunkH + 0.05;\n    for (let i = 0; i < 8; i++) {\n      const a = (i / 8) * Math.PI * 2;\n      const frondPivot = new THREE.Group();\n      frondPivot.position.set(crownX, crownY, 0);\n      frondPivot.rotation.y = a;\n      const frond = new THREE.Mesh(frondGeo, frondMat);\n      frond.position.set(0, -0.18, 1.35);\n      frond.rotation.x = 0.28 + (i % 2) * 0.14;\n      frondPivot.add(frond);\n      grp.add(frondPivot);\n    }\n    // Coconut cluster under fronds\n    const nutMat = trackMat(new THREE.MeshStandardMaterial({ color: 0x6b4423, roughness: 0.68 }));\n    const nutGeo = trackGeo(new THREE.SphereGeometry(0.14, 8, 6));\n    for (let c = 0; c < 4; c++) {\n      const ca = (c / 4) * Math.PI * 2;\n      const nut = new THREE.Mesh(nutGeo, nutMat);\n      nut.position.set(crownX + Math.cos(ca) * 0.2, crownY - 0.24, Math.sin(ca) * 0.2);\n      grp.add(nut);\n    }\n  } else {\n    // Tapered root-flared trunk + primary limbs\n    const trunk = new THREE.Mesh(\n      trackGeo(new THREE.CylinderGeometry(0.24, 0.42, 2.8, 10)),\n      barkMat\n    );\n    trunk.position.y = 1.4;\n    trunk.castShadow = true;\n    grp.add(trunk);\n\n    const branchGeo = trackGeo(new THREE.CylinderGeometry(0.11, 0.19, 1.8, 8));\n    for (let b = 0; b < 3; b++) {\n      const ba = (b / 3) * Math.PI * 2 + 0.4;\n      const branch = new THREE.Mesh(branchGeo, barkMat);\n      branch.position.set(Math.cos(ba) * 0.45, 2.75, Math.sin(ba) * 0.45);\n      branch.rotation.z = -Math.cos(ba) * 0.55;\n      branch.rotation.x = Math.sin(ba) * 0.55;\n      grp.add(branch);\n    }\n\n    const leafColor = style === \'krishnachura\' ? 0x3b7236 : 0x2f6834;\n    const leafMat = trackMat(\n      new THREE.MeshStandardMaterial({ color: leafColor, roughness: 0.82, metalness: 0.0 })\n    );\n    const crownSpecs: Array<[number, number, number, number, number]> = [\n      [0, 4.2, 0, 1.75, 1.15],\n      [1.25, 3.65, 0.7, 1.32, 0.92],\n      [-1.25, 3.7, 0.55, 1.35, 0.95],\n      [0.2, 3.85, -1.15, 1.3, 0.92],\n      [-0.4, 4.75, -0.2, 1.25, 0.9],\n    ];\n    for (const [cx, cy, cz, r, sy] of crownSpecs) {\n      const puff = new THREE.Mesh(trackGeo(new THREE.DodecahedronGeometry(r, 1)), leafMat);\n      puff.position.set(cx, cy, cz);\n      puff.scale.set(1.12, sy, 1.12);\n      puff.castShadow = true;\n      grp.add(puff);\n    }\n\n    // Flame-orange Krishnachura floral canopy clusters\n    if (style === \'krishnachura\') {\n      const flameMat = trackMat(\n        new THREE.MeshStandardMaterial({ color: 0xe64a19, roughness: 0.64, metalness: 0.02 })\n      );\n      const goldFlameMat = trackMat(\n        new THREE.MeshStandardMaterial({ color: 0xf57c00, roughness: 0.64, metalness: 0.02 })\n      );\n      const bloomSpecs: Array<[number, number, number, number]> = [\n        [0.85, 4.45, 0.9, 0.86],\n        [-0.95, 4.35, 0.85, 0.84],\n        [0.1, 5.1, 0.15, 0.92],\n        [-0.7, 4.15, -0.95, 0.78],\n        [1.15, 4.0, -0.6, 0.82],\n      ];\n      bloomSpecs.forEach(([bx, by, bz, br], i) => {\n        const bloom = new THREE.Mesh(\n          trackGeo(new THREE.DodecahedronGeometry(br, 1)),\n          i % 2 === 0 ? flameMat : goldFlameMat\n        );\n        bloom.position.set(bx, by, bz);\n        bloom.scale.set(1.18, 0.62, 1.18);\n        grp.add(bloom);\n      });\n    }\n  }\n\n  grp.scale.setScalar(scale);\n  return grp;\n}\n\n/**\n * Composite Street Lamp Post (grounded bottom-center at y=0)\n */\nfunction buildStreetLampPost(\n  x: number,\n  z: number,\n  facingRoadSign: 1 | -1,\n  trackGeo: <T extends THREE.BufferGeometry>(g: T) => T,\n  poleMat: THREE.Material,\n  glowMat: THREE.Material\n): THREE.Group {\n  const grp = new THREE.Group();\n  grp.position.set(x, 0.14, z);\n\n  // Stepped cast-iron plinth\n  const base = new THREE.Mesh(trackGeo(new THREE.CylinderGeometry(0.16, 0.24, 0.55, 10)), poleMat);\n  base.position.y = 0.275;\n  grp.add(base);\n\n  // Tapered main shaft\n  const shaft = new THREE.Mesh(trackGeo(new THREE.CylinderGeometry(0.065, 0.11, 5.2, 10)), poleMat);\n  shaft.position.y = 3.1;\n  grp.add(shaft);\n\n  // Decorative collar ring\n  const collar = new THREE.Mesh(trackGeo(new THREE.TorusGeometry(0.11, 0.025, 8, 14)), poleMat);\n  collar.rotation.x = Math.PI / 2;\n  collar.position.y = 5.45;\n  grp.add(collar);\n\n  // Curved overhanging arm pointing over the asphalt road\n  const arm = new THREE.Mesh(trackGeo(new THREE.BoxGeometry(0.08, 0.08, 1.35)), poleMat);\n  arm.position.set(0, 5.65, facingRoadSign * 0.65);\n  arm.rotation.x = -facingRoadSign * 0.1;\n  grp.add(arm);\n\n  // Lantern hood & glowing warm LED luminaire\n  const hood = new THREE.Mesh(trackGeo(new THREE.ConeGeometry(0.28, 0.18, 12)), poleMat);\n  hood.position.set(0, 5.72, facingRoadSign * 1.25);\n  grp.add(hood);\n\n  const lamp = new THREE.Mesh(trackGeo(new THREE.SphereGeometry(0.19, 10, 8)), glowMat);\n  lamp.scale.set(1.1, 0.68, 1.1);\n  lamp.position.set(0, 5.56, facingRoadSign * 1.25);\n  grp.add(lamp);\n\n  return grp;\n}"
          replacement_content: "const _instDummy = new THREE.Object3D();\nconst _instColor = new THREE.Color();\n\n/**\n * Populates tropical Bangladeshi trees (Krishnachura flame trees, lush Mango shade trees,\n * and coastal Royal Palms) using batched InstancedMesh layers with per-instance color tinting\n * and grounded bottom-center pivots \342\200\224 preserving rich multi-part silhouettes at minimal draw calls.\n */\nfunction buildInstancedTrees(\n  specs: ReadonlyArray<{ x: number; z: number; style: \'krishnachura\' | \'mango\' | \'palm\'; scale: number }>,\n  trackGeo: <T extends THREE.BufferGeometry>(g: T) => T,\n  trackMat: <T extends THREE.Material>(m: T) => T,\n  barkMat: THREE.Material\n): THREE.Group {\n  const grp = new THREE.Group();\n\n  const nonPalms = specs.filter((s) => s.style !== \'palm\');\n  const krishnas = specs.filter((s) => s.style === \'krishnachura\');\n  const palms = specs.filter((s) => s.style === \'palm\');\n\n  // 1. Non-palm trunks + root flares (1 draw call)\n  if (nonPalms.length > 0) {\n    const trunkMesh = new THREE.InstancedMesh(\n      trackGeo(new THREE.CylinderGeometry(0.24, 0.44, 2.9, 8)),\n      barkMat,\n      nonPalms.length\n    );\n    nonPalms.forEach((t, i) => {\n      _instDummy.position.set(t.x, 1.45 * t.scale, t.z);\n      _instDummy.rotation.set(0, (i * 1.1) % Math.PI, 0);\n      _instDummy.scale.set(t.scale, t.scale, t.scale);\n      _instDummy.updateMatrix();\n      trunkMesh.setMatrixAt(i, _instDummy.matrix);\n    });\n    trunkMesh.instanceMatrix.needsUpdate = true;\n    trunkMesh.computeBoundingSphere();\n    grp.add(trunkMesh);\n\n    // 2. Multi-cluster leafy green crowns (4 clusters per tree, 1 draw call total!)\n    const leafGeo = trackGeo(new THREE.DodecahedronGeometry(1.5, 1));\n    const leafMat = trackMat(\n      new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.82, metalness: 0.0 })\n    );\n    const crownOffsets: Array<[number, number, number, number, number]> = [\n      [0, 4.15, 0, 1.2, 0.82],\n      [1.15, 3.65, 0.6, 0.9, 0.68],\n      [-1.15, 3.7, 0.5, 0.92, 0.7],\n      [0.1, 3.85, -1.05, 0.88, 0.68],\n    ];\n    const leafMesh = new THREE.InstancedMesh(leafGeo, leafMat, nonPalms.length * crownOffsets.length);\n    let idx = 0;\n    const leafGreens = [0x2f6834, 0x3b7638, 0x2a5f30, 0x44803d];\n    nonPalms.forEach((t, ti) => {\n      crownOffsets.forEach(([ox, oy, oz, rScale, sy], ci) => {\n        _instDummy.position.set(t.x + ox * t.scale, oy * t.scale, t.z + oz * t.scale);\n        _instDummy.rotation.set(0, (ti + ci) * 0.7, 0);\n        _instDummy.scale.set(rScale * t.scale, sy * t.scale, rScale * t.scale);\n        _instDummy.updateMatrix();\n        leafMesh.setMatrixAt(idx, _instDummy.matrix);\n        _instColor.setHex(leafGreens[(ti + ci) % leafGreens.length]);\n        leafMesh.setColorAt(idx, _instColor);\n        idx++;\n      });\n    });\n    leafMesh.instanceMatrix.needsUpdate = true;\n    if (leafMesh.instanceColor) leafMesh.instanceColor.needsUpdate = true;\n    leafMesh.computeBoundingSphere();\n    grp.add(leafMesh);\n  }\n\n  // 3. Flame-orange Krishnachura blossom clusters (1 draw call)\n  if (krishnas.length > 0) {\n    const bloomGeo = trackGeo(new THREE.DodecahedronGeometry(0.95, 0));\n    const bloomMat = trackMat(\n      new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.64, metalness: 0.02 })\n    );\n    const bOffsets: Array<[number, number, number]> = [\n      [0.85, 4.5, 0.8],\n      [-0.9, 4.4, 0.75],\n      [0.05, 5.05, 0.1],\n      [0.95, 4.1, -0.65],\n    ];\n    const bloomMesh = new THREE.InstancedMesh(bloomGeo, bloomMat, krishnas.length * bOffsets.length);\n    let bIdx = 0;\n    const flameColors = [0xe64a19, 0xf57c00, 0xd84315, 0xff7043];\n    krishnas.forEach((t, ti) => {\n      bOffsets.forEach(([ox, oy, oz], bi) => {\n        _instDummy.position.set(t.x + ox * t.scale, oy * t.scale, t.z + oz * t.scale);\n        _instDummy.rotation.set(0, (ti + bi) * 0.8, 0);\n        _instDummy.scale.set(1.2 * t.scale, 0.58 * t.scale, 1.2 * t.scale);\n        _instDummy.updateMatrix();\n        bloomMesh.setMatrixAt(bIdx, _instDummy.matrix);\n        _instColor.setHex(flameColors[(ti + bi) % flameColors.length]);\n        bloomMesh.setColorAt(bIdx, _instColor);\n        bIdx++;\n      });\n    });\n    bloomMesh.instanceMatrix.needsUpdate = true;\n    if (bloomMesh.instanceColor) bloomMesh.instanceColor.needsUpdate = true;\n    bloomMesh.computeBoundingSphere();\n    grp.add(bloomMesh);\n  }\n\n  // 4. Coastal Royal Palms: slender trunks + arching fronds (2 draw calls total)\n  if (palms.length > 0) {\n    const pTrunk = new THREE.InstancedMesh(\n      trackGeo(new THREE.CylinderGeometry(0.15, 0.27, 6.2, 8)),\n      barkMat,\n      palms.length\n    );\n    const frondMat = trackMat(\n      new THREE.MeshStandardMaterial({ color: 0x3b7a3e, roughness: 0.72, metalness: 0.02 })\n    );\n    const pFrond = new THREE.InstancedMesh(\n      trackGeo(new THREE.BoxGeometry(0.36, 0.07, 2.75)),\n      frondMat,\n      palms.length * 6\n    );\n    let fIdx = 0;\n    palms.forEach((t, ti) => {\n      _instDummy.position.set(t.x, 3.1 * t.scale, t.z);\n      _instDummy.rotation.set(0, 0, -0.04);\n      _instDummy.scale.set(t.scale, t.scale, t.scale);\n      _instDummy.updateMatrix();\n      pTrunk.setMatrixAt(ti, _instDummy.matrix);\n\n      const crownY = 6.1 * t.scale;\n      for (let f = 0; f < 6; f++) {\n        const a = (f / 6) * Math.PI * 2 + ti * 0.4;\n        const reach = 1.35 * t.scale;\n        _instDummy.position.set(\n          t.x + Math.sin(a) * reach,\n          crownY - 0.15 * t.scale,\n          t.z + Math.cos(a) * reach\n        );\n        _instDummy.rotation.set(0.28, a, 0);\n        _instDummy.scale.set(t.scale, t.scale, t.scale);\n        _instDummy.updateMatrix();\n        pFrond.setMatrixAt(fIdx++, _instDummy.matrix);\n      }\n    });\n    pTrunk.instanceMatrix.needsUpdate = true;\n    pTrunk.computeBoundingSphere();\n    pFrond.instanceMatrix.needsUpdate = true;\n    pFrond.computeBoundingSphere();\n    grp.add(pTrunk);\n    grp.add(pFrond);\n  }\n\n  return grp;\n}\n\n/**\n * Batched Street Lamp Posts along both sides of the highway (3 InstancedMesh draw calls total!)\n */\nfunction buildInstancedLampPosts(\n  specs: ReadonlyArray<{ x: number; z: number; facingRoadSign: 1 | -1 }>,\n  trackGeo: <T extends THREE.BufferGeometry>(g: T) => T,\n  poleMat: THREE.Material,\n  glowMat: THREE.Material\n): THREE.Group {\n  const grp = new THREE.Group();\n  const count = specs.length;\n  if (count === 0) return grp;\n\n  const shafts = new THREE.InstancedMesh(\n    trackGeo(new THREE.CylinderGeometry(0.07, 0.14, 5.5, 8)),\n    poleMat,\n    count\n  );\n  const arms = new THREE.InstancedMesh(\n    trackGeo(new THREE.BoxGeometry(0.09, 0.09, 1.38)),\n    poleMat,\n    count\n  );\n  const lamps = new THREE.InstancedMesh(\n    trackGeo(new THREE.SphereGeometry(0.2, 8, 6)),\n    glowMat,\n    count\n  );\n\n  specs.forEach((s, i) => {\n    _instDummy.position.set(s.x, 2.89, s.z);\n    _instDummy.rotation.set(0, 0, 0);\n    _instDummy.scale.set(1, 1, 1);\n    _instDummy.updateMatrix();\n    shafts.setMatrixAt(i, _instDummy.matrix);\n\n    _instDummy.position.set(s.x, 5.68, s.z + s.facingRoadSign * 0.65);\n    _instDummy.rotation.set(-s.facingRoadSign * 0.08, 0, 0);\n    _instDummy.scale.set(1, 1, 1);\n    _instDummy.updateMatrix();\n    arms.setMatrixAt(i, _instDummy.matrix);\n\n    _instDummy.position.set(s.x, 5.56, s.z + s.facingRoadSign * 1.25);\n    _instDummy.rotation.set(0, 0, 0);\n    _instDummy.scale.set(1.15, 0.68, 1.15);\n    _instDummy.updateMatrix();\n    lamps.setMatrixAt(i, _instDummy.matrix);\n  });\n\n  shafts.instanceMatrix.needsUpdate = true;\n  shafts.computeBoundingSphere();\n  arms.instanceMatrix.needsUpdate = true;\n  arms.computeBoundingSphere();\n  lamps.instanceMatrix.needsUpdate = true;\n  lamps.computeBoundingSphere();\n\n  grp.add(shafts, arms, lamps);\n  return grp;\n}"
          start_line: 230
          end_line: 392
        }
      }
    }
