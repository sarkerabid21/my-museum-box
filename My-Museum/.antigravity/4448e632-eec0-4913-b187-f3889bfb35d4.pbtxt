            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // --- 1. EXPANSIVE OUTDOOR GROUND & NATURAL HORIZON TERRAIN ---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const grassTex = trackTex(createGrassTexture(maxAnisotropy));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const grassMat = trackMat("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
