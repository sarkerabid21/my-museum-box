            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Animate co-visitors (live Firestore interpolation + gentle strolling for invited companions)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      let companionIdx = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      companionRigsRef.current.forEach((entry) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (entry.visitor.isSimulated) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const baseZ = Math.min(-2.5, -(companionIdx * 4.2 + 3.2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const patrolZ = baseZ + Math.sin(elapsed * 0.35 + companionIdx * 1.9) * 2.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const patrolX = (companionIdx % 2 === 0 ? -2.6 : 2.6) + Math.cos(elapsed * 0.25 + companionIdx) * 0.4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dz = patrolZ - entry.rig.root.position.z;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dx = patrolX - entry.rig.root.position.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          entry.rig.root.position.x += dx * (1 - Math.exp(-3 * delta));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          entry.rig.root.position.z += dz * (1 - Math.exp(-3 * delta));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const moveSpeed = Math.hypot(dx, dz) / Math.max(delta, 0.016);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (moveSpeed > 0.15) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            entry.rig.root.rotation.y = Math.atan2(dx, dz);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          animateAvatarRig(entry.rig, Math.min(2.1, moveSpeed * 0.6), elapsed + companionIdx, delta);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const lerpAlpha = 1 - Math.exp(-7 * delta);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dx = entry.targetX - entry.rig.root.position.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dz = entry.targetZ - entry.rig.root.position.z;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          entry.rig.root.position.x += dx * lerpAlpha;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          entry.rig.root.position.z += dz * lerpAlpha;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          entry.rig.root.rotation.y += (entry.targetYaw - entry.rig.root.rotation.y) * lerpAlpha;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const distSpeed = Math.hypot(dx, dz) * 3.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          animateAvatarRig(entry.rig, distSpeed, elapsed + companionIdx, delta);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        companionIdx++;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
