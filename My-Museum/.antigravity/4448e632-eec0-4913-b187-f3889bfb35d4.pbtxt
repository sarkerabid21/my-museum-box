      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add quick museum selector in HomeStudio utility ribbon whenever user has access to shared museums\", \"EndLine\":237, \"Instruction\":\"Render a clean inline museum switcher select when accessibleMuseums has more than 1 museum\", \"ReplacementContent\":\"            <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n              {accessibleMuseums.length > 1 ? (\\n                <label className=\\\"inline-flex items-center gap-1.5\\\">\\n                  <span className=\\\"sr-only\\\">Active museum</span>\\n                  <select\\n                    aria-label=\\\"Switch active museum\\\"\\n                    value={museum.id}\\n                    onChange={(e) => onSwitchMuseum(e.target.value)}\\n                    className=\\\"font-medium text-stone-900 bg-white border border-stone-300 px-2 py-0.5 text-xs focus:outline-none focus:border-stone-900 cursor-pointer\\\"\\n                  >\\n                    {accessibleMuseums.map((m) => (\\n                      <option key={m.id} value={m.id}>\\n                        {m.title}\\n                        {user && m.ownerId !== user.uid ? \' (Shared)\' : \' (Yours)\'}\\n                      </option>\\n                    ))}\\n                  </select>\\n                </label>\\n              ) : (\\n                <span className=\\\"font-medium text-stone-900\\\">{museum.title}</span>\\n              )}\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {artworks.length} Artworks \302\267 {layout.roomCount}{\' \'}\\n                {layout.roomCount === 1 ? \'Room\' : \'Rooms\'} ({layout.totalWallSlots} Walls)\\n              </span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span className=\\\"font-mono tabular-nums\\\">Code {museum.accessCode}</span>\\n            </div>\", \"StartLine\":225, \"TargetContent\":\"            <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n              <span className=\\\"font-medium text-stone-900\\\">{museum.title}</span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {artworks.length} Artworks \302\267 {layout.roomCount}{\' \'}\\n                {layout.roomCount === 1 ? \'Room\' : \'Rooms\'} ({layout.totalWallSlots} Walls)\\n              </span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span className=\\\"font-mono tabular-nums\\\">Code {museum.accessCode}</span>\\n            </div>\", \"TargetFile\":\"/src/components/HomeStudio.tsx\", \"toolAction\":\"Adding museum switcher to HomeStudio utility ribbon\", \"toolSummary\":\"Add museum switcher to HomeStudio\"}"
