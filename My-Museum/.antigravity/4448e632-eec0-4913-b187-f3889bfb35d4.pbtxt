              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Composite multi-part tropical Bangladeshi trees:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - \'krishnachura\': Wide umbrella crown with vibrant vermilion-orange flame blossoms"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - \'mango\': Lush layered deep emerald tropical shade tree"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - \'palm\': Tall ringed trunk with arching coconut/royal palm fronds"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function buildCompositeTree("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  style: \'krishnachura\' | \'mango\' | \'palm\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  scale: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  trackGeo: <T extends THREE.BufferGeometry>(g: T) => T,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  trackMat: <T extends THREE.Material>(m: T) => T,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  barkMat: THREE.Material"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): THREE.Group {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const grp = new THREE.Group();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (style === \'palm\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const trunkH = 6.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const segs = 4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let i = 0; i < segs; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const seg = new THREE.Mesh("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        trackGeo(new THREE.CylinderGeometry(0.18 - i * 0.02, 0.24 - i * 0.02, trunkH / segs, 10)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        barkMat"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      seg.position.set(i * 0.08, (i + 0.5) * (trunkH / segs), 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      seg.rotation.z = -0.05 * i;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      grp.add(seg);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const frondMat = trackMat("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      new THREE.MeshStandardMaterial({ color: 0x3b7a3e, roughness: 0.72, metalness: 0.02 })"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const frondGeo = trackGeo(new THREE.BoxGeometry(0.34, 0.06, 2.65));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const crownX = 0.24;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const crownY = trunkH + 0.05;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let i = 0; i < 8; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const a = (i / 8) * Math.PI * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const frondPivot = new THREE.Group();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      frondPivot.position.set(crownX, crownY, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      frondPivot.rotation.y = a;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const frond = new THREE.Mesh(frondGeo, frondMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      frond.position.set(0, -0.18, 1.35);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      frond.rotation.x = 0.28 + (i % 2) * 0.14;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      frondPivot.add(frond);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      grp.add(frondPivot);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Coconut cluster under fronds"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const nutMat = trackMat(new THREE.MeshStandardMaterial({ color: 0x6b4423, roughness: 0.68 }));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const nutGeo = trackGeo(new THREE.SphereGeometry(0.14, 8, 6));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let c = 0; c < 4; c++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const ca = (c / 4) * Math.PI * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const nut = new THREE.Mesh(nutGeo, nutMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      nut.position.set(crownX + Math.cos(ca) * 0.2, crownY - 0.24, Math.sin(ca) * 0.2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      grp.add(nut);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Tapered root-flared trunk + primary limbs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const trunk = new THREE.Mesh("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      trackGeo(new THREE.CylinderGeometry(0.24, 0.42, 2.8, 10)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      barkMat"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    trunk.position.y = 1.4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    trunk.castShadow = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grp.add(trunk);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const branchGeo = trackGeo(new THREE.CylinderGeometry(0.11, 0.19, 1.8, 8));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let b = 0; b < 3; b++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const ba = (b / 3) * Math.PI * 2 + 0.4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const branch = new THREE.Mesh(branchGeo, barkMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      branch.position.set(Math.cos(ba) * 0.45, 2.75, Math.sin(ba) * 0.45);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      branch.rotation.z = -Math.cos(ba) * 0.55;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      branch.rotation.x = Math.sin(ba) * 0.55;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      grp.add(branch);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const leafColor = style === \'krishnachura\' ? 0x3b7236 : 0x2f6834;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const leafMat = trackMat("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      new THREE.MeshStandardMaterial({ color: leafColor, roughness: 0.82, metalness: 0.0 })"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const crownSpecs: Array<[number, number, number, number, number]> = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      [0, 4.2, 0, 1.75, 1.15],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      [1.25, 3.65, 0.7, 1.32, 0.92],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      [-1.25, 3.7, 0.55, 1.35, 0.95],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      [0.2, 3.85, -1.15, 1.3, 0.92],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      [-0.4, 4.75, -0.2, 1.25, 0.9],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (const [cx, cy, cz, r, sy] of crownSpecs) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const puff = new THREE.Mesh(trackGeo(new THREE.DodecahedronGeometry(r, 1)), leafMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      puff.position.set(cx, cy, cz);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      puff.scale.set(1.12, sy, 1.12);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      puff.castShadow = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      grp.add(puff);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Flame-orange Krishnachura floral canopy clusters"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (style === \'krishnachura\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const flameMat = trackMat("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        new THREE.MeshStandardMaterial({ color: 0xe64a19, roughness: 0.64, metalness: 0.02 })"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const goldFlameMat = trackMat("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        new THREE.MeshStandardMaterial({ color: 0xf57c00, roughness: 0.64, metalness: 0.02 })"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const bloomSpecs: Array<[number, number, number, number]> = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        [0.85, 4.45, 0.9, 0.86],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        [-0.95, 4.35, 0.85, 0.84],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        [0.1, 5.1, 0.15, 0.92],"
