              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            camYaw: ps.camYaw,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            avatarYaw: ps.yaw,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          delta"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ps.camYaw = steering.camYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ps.yaw = steering.avatarYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (steering.isMoving) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const tryX = ps.x + steering.moveDirX * steering.walkSpeed * delta;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const tryZ = ps.z + steering.moveDirZ * steering.walkSpeed * delta;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          let nextPos = clampWorldPosition(tryX, tryZ, curLayout, openDoors, ps.z, ps.x, false);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Smoothly glide around central floral vase plinth if walking straight into it indoors"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (ps.z < curLayout.southWallZ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const nearPedestal = curLayout.pedestals.some("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              (p) => Math.hypot(tryX - p.x, tryZ - p.z) < p.radius + 0.15"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const movedDist = Math.hypot(nextPos.x - ps.x, nextPos.z - ps.z);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (nearPedestal && movedDist < steering.walkSpeed * delta * 0.35 && !steering.isTurning) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const slideDir = ps.x >= 0 ? 1 : -1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              nextPos = clampWorldPosition("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                ps.x + slideDir * steering.walkSpeed * 0.9 * delta,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                tryZ,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                curLayout,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                openDoors,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                ps.z,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                ps.x,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                false"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ps.x = nextPos.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ps.z = nextPos.z;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ps.speed = steering.animSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Update player avatar rig transform & stride animation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (playerRig) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const groundY ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ps.z >= 24.5 && ps.z <= 28.0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              ? 0.14"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              : ps.z >= 42.0 && ps.z <= 45.5"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                ? 0.14"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          playerRig.root.position.set(ps.x, groundY, ps.z);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          playerRig.root.rotation.y = ps.yaw;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          playerRig.root.visible = cameraModeRef.current === \'third\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          animateAvatarRig(playerRig, ps.speed, elapsed, delta);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Advance autonomous highway traffic (Rickshaws, Motorbikes, Cars) with lane spacing"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const vehicles = trafficVehiclesRef.current;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = 0; i < vehicles.length; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const v = vehicles[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (v.status === \'player_driving\') continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        let targetSpeed = v.status === \'stopped_talking\' ? 0 : v.cruiseSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (v.status === \'cruising\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Maintain safe gap behind any slower/stopped vehicle in the same lane"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          for (let j = 0; j < vehicles.length; j++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (i === j) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const other = vehicles[j];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (Math.abs(other.z - v.z) > 2.2) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const aheadDist = (other.x - v.x) * v.dir;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (aheadDist > 0 && aheadDist < 9.5) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              targetSpeed = Math.min(targetSpeed, aheadDist < 5.5 ? 0 : other.currentSpeed * 0.6);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        v.currentSpeed += (targetSpeed - v.currentSpeed) * (1 - Math.exp(-5 * delta));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        v.x += v.dir * v.currentSpeed * delta;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        v.z += (v.laneZ - v.z) * (1 - Math.exp(-3 * delta));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const desiredYaw = v.dir === 1 ? Math.PI / 2 : -Math.PI / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        v.yaw = normalizeAngle(v.yaw + shortestAngleDelta(v.yaw, desiredYaw) * (1 - Math.exp(-6 * delta)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (v.dir === 1 && v.x > WORLD_MAX_X + 6) v.x = WORLD_MIN_X - 6;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (v.dir === -1 && v.x < WORLD_MIN_X - 6) v.x = WORLD_MAX_X + 6;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const rig = outdoor?.vehicleRigs.get(v.id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (rig) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          rig.root.position.set(v.x, 0.02, v.z);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          rig.root.rotation.y = v.yaw;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const spin = v.currentSpeed * delta * 2.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          for (const w of rig.wheels) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            w.rotation.x += spin;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Advance walking footpath pedestrians & any ejected driver waving on the footpath"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (outdoor) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for (const ped of outdoor.pedestrians) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ped.x += ped.dir * ped.speed * delta;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (ped.x > ped.maxX) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ped.x = ped.maxX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ped.dir = -1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          } else if (ped.x < ped.minX) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ped.x = ped.minX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ped.dir = 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ped.root.position.set(ped.x, 0.14, ped.sidewalkZ);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ped.root.rotation.y = ped.dir === 1 ? Math.PI / 2 : -Math.PI / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const stride = Math.sin(elapsed * ped.speed * 3.4 + ped.phase);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ped.leftLeg.rotation.x = stride * 0.45;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ped.rightLeg.rotation.x = -stride * 0.45;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ped.leftArm.rotation.x = -stride * 0.34;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ped.rightArm.rotation.x = stride * 0.34;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (ejectedDriverTimerRef.current > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ejectedDriverTimerRef.current = Math.max(0, ejectedDriverTimerRef.current - delta);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const ed = outdoor.ejectedDriverRig;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const wave = Math.sin(elapsed * 12);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
