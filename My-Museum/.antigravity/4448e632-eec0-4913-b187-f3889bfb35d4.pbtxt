            }
            lines {
              text: "    rig.stridePhase += delta * Math.min(11, 5.2 + speed * 1.15);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const swing = Math.sin(rig.stridePhase) * 0.52;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const armSwing = Math.sin(rig.stridePhase) * 0.42;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const bob = Math.abs(Math.cos(rig.stridePhase)) * 0.032;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rig.leftLegPivot.rotation.x += (swing - rig.leftLegPivot.rotation.x) * damping;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rig.rightLegPivot.rotation.x += (-swing - rig.rightLegPivot.rotation.x) * damping;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rig.leftArmPivot.rotation.x += (-armSwing - rig.leftArmPivot.rotation.x) * damping;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rig.rightArmPivot.rotation.x += (armSwing - rig.rightArmPivot.rotation.x) * damping;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rig.bodyGroup.position.y += (bob - rig.bodyGroup.position.y) * damping;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const breathe = Math.sin(elapsed * 2.1) * 0.008;"
