            lines {
              text: "        blossom.scale.set(1.3, 0.85, 0.45);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        blossom.position.set(ox, oy, oz);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        blossom.rotation.y = angle;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
