      original_chunk {
        target_content: "  // Rebuild player 3D avatar when user\'s avatar configuration changes\n  useEffect(() => {\n    const slot = playerSlotRef.current;\n    if (!slot) return;\n    if (playerRigRef.current) {\n      slot.remove(playerRigRef.current.root);\n      playerRigRef.current.dispose();\n    }\n    const rig = buildAvatarRig(avatar, { showNameplate: true, showContactShadow: true });\n    rig.root.position.set(playerStateRef.current.x, 0, playerStateRef.current.z);\n    rig.root.rotation.y = playerStateRef.current.yaw;\n    slot.add(rig.root);\n    playerRigRef.current = rig;\n    renderOnceRef.current?.();\n  }, [avatar]);"
        replacement_content: "  // Rebuild player 3D avatar when user\'s avatar configuration or exclusive GLB changes\n  useEffect(() => {\n    const slot = playerSlotRef.current;\n    if (!slot) return;\n    let cancelled = false;\n\n    const mountRig = (rig: AvatarRig) => {\n      if (cancelled) {\n        rig.dispose();\n        return;\n      }\n      if (playerRigRef.current) {\n        slot.remove(playerRigRef.current.root);\n        playerRigRef.current.dispose();\n      }\n      rig.root.position.set(playerStateRef.current.x, 0, playerStateRef.current.z);\n      rig.root.rotation.y = playerStateRef.current.yaw;\n      slot.add(rig.root);\n      playerRigRef.current = rig;\n      renderOnceRef.current?.();\n    };\n\n    if (customGlbBuffer) {\n      void buildCustomGlbAvatarRig(customGlbBuffer, avatar, {\n        showNameplate: true,\n        showContactShadow: true,\n      })\n        .then(mountRig)\n        .catch(() => {\n          mountRig(buildAvatarRig(avatar, { showNameplate: true, showContactShadow: true }));\n        });\n    } else {\n      mountRig(buildAvatarRig(avatar, { showNameplate: true, showContactShadow: true }));\n    }\n\n    return () => {\n      cancelled = true;\n    };\n  }, [avatar, customGlbBuffer]);"
