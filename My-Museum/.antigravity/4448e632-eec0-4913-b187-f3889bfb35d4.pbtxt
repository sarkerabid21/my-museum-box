              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const hairMat = trackMat(new THREE.MeshStandardMaterial({ color: 0x171412, roughness: 0.85 }));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const makeWheel = (radius: number, width: number, x: number, y: number, z: number) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const wGrp = new THREE.Group();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    wGrp.position.set(x, y, z);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const tire = new THREE.Mesh("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      trackGeo(new THREE.CylinderGeometry(radius, radius, width, 16)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      tireMat"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tire.rotation.z = Math.PI / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    wGrp.add(tire);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const rim = new THREE.Mesh("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      trackGeo(new THREE.CylinderGeometry(radius * 0.56, radius * 0.56, width + 0.02, 12)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      rimMat"
