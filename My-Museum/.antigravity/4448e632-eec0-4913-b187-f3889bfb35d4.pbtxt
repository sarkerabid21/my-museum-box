          replacement_content: "import {\n  ArrowRight,\n  Calendar,\n  FolderKanban,\n  LogOut,\n  Mail,\n  Plus,\n  Users,\n  X,\n} from \'lucide-react\';\nimport type { PendingMuseumInvite } from \'../services/gmailService\';"
          start_line: 2
