              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        Your data is used exclusively to run your virtual museum experience. We do not sell, rent, or"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        share your personal information with third-party advertisers. All museum records are protected"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        by Firebase Authentication and Firestore security rules."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <h2>4. Your Choices &amp; Deletion</h2>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        You may delete uploaded artworks, revoke guest access, or sign out at any time within the App."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        You may also revoke Google OAuth permissions at any time from your"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <a href=\"https://myaccount.google.com/permissions\" target=\"_blank\" rel=\"noopener noreferrer\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          >Google Account Permissions</a"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        >"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        page."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <h2>5. Contact</h2>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        If you have questions about this Privacy Policy or want to request account data deletion, please"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        contact the developer at <a href=\"mailto:abidsarker213@gmail.com\">abidsarker213@gmail.com</a>."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <div class=\"footer\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <span>My Museum &middot; Ashfaq Sarker Abid&rsquo;s Apps</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <a class=\"back-link\" href=\"/\">Return to My Museum</a>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    </main>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  </body>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "</html>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///public/privacy.html"
        create_file: true
      }
    }
    use_fast_apply: true
    description: "Add a standalone static Privacy Policy page at /privacy.html for Google Auth Platform OAuth branding and production publishing"
    diff_stats {
      additions: 186
    }
  }
}
