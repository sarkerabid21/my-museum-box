            }
            lines {
              text: "export function getArtworkPlacement(index: number): ArtworkPlacement {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const safeIndex = Math.max(0, Math.floor(index));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const roomIndex = Math.floor(safeIndex / ARTWORKS_PER_ROOM);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const slotInRoom = safeIndex % ARTWORKS_PER_ROOM;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const centerZ = -roomIndex * ROOM_DEPTH;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const northZ = centerZ - ROOM_HALF_DEPTH;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
