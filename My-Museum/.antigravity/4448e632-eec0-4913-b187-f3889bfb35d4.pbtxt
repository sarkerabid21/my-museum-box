      arguments_json: "{\"Description\":\"Support customGlbBuffer in Museum3DView for Abid\'s exclusive 3D character\", \"Instruction\":\"Import buildCustomGlbAvatarRig, add customGlbBuffer prop, and handle async GLB rig swapping safely\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":68, \"ReplacementContent\":\"import {\\n  animateAvatarRig,\\n  buildAvatarRig,\\n  buildCustomGlbAvatarRig,\\n  type AvatarRig,\\n} from \'../three/avatarBuilder\';\\nimport { buildMuseumArchitecture, type BuiltMuseum, type DoorRig } from \'../three/museumBuilder\';\\nimport { createAfterDrawScheduler, detectSoftwareGl } from \'../three/webglUtils\';\\n\\ninterface Museum3DViewProps {\\n  museum: MuseumMeta;\\n  avatar: AvatarConfig;\\n  customGlbBuffer?: ArrayBuffer | null;\\n  artworks: ArtworkItem[];\\n  members: MuseumMember[];\\n  liveVisitors: VisitorPresence[];\\n  showInvitedIn3D: boolean;\\n  canCurate: boolean;\\n  canRenameRooms: boolean;\\n  teleportTargetId: string | null;\\n  onClearTeleport: () => void;\\n  onSelectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\\n  onRequestRenameRoom: (roomIndex: number) => void;\\n  onNotify?: (msg: string) => void;\\n  onOpenCatalog: () => void;\\n  onOpenUpload: () => void;\\n  onOpenAccess: () => void;\\n  onReturnHome: () => void;\\n  onChangeWallTheme: (theme: WallTheme) => void;\\n  onPositionBroadcast?: (x: number, z: number, yaw: number) => void;\\n  isPaused?: boolean;\\n}\", \"StartLine\":42, \"TargetContent\":\"import { animateAvatarRig, buildAvatarRig, type AvatarRig } from \'../three/avatarBuilder\';\\nimport { buildMuseumArchitecture, type BuiltMuseum, type DoorRig } from \'../three/museumBuilder\';\\nimport { createAfterDrawScheduler, detectSoftwareGl } from \'../three/webglUtils\';\\n\\ninterface Museum3DViewProps {\\n  museum: MuseumMeta;\\n  avatar: AvatarConfig;\\n  artworks: ArtworkItem[];\\n  members: MuseumMember[];\\n  liveVisitors: VisitorPresence[];\\n  showInvitedIn3D: boolean;\\n  canCurate: boolean;\\n  canRenameRooms: boolean;\\n  teleportTargetId: string | null;\\n  onClearTeleport: () => void;\\n  onSelectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\\n  onRequestRenameRoom: (roomIndex: number) => void;\\n  onNotify?: (msg: string) => void;\\n  onOpenCatalog: () => void;\\n  onOpenUpload: () => void;\\n  onOpenAccess: () => void;\\n  onReturnHome: () => void;\\n  onChangeWallTheme: (theme: WallTheme) => void;\\n  onPositionBroadcast?: (x: number, z: number, yaw: number) => void;\\n  isPaused?: boolean;\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":93, \"ReplacementContent\":\"export function Museum3DView({\\n  museum,\\n  avatar,\\n  customGlbBuffer = null,\\n  artworks,\", \"StartLine\":87, \"TargetContent\":\"export function Museum3DView({\\n  museum,\\n  avatar,\\n  artworks,\"}, {\"AllowMultiple\":false, \"EndLine\":898, \"ReplacementContent\":\"  // Rebuild player 3D avatar when user\'s avatar configuration or exclusive GLB changes\\n  useEffect(() => {\\n    const slot = playerSlotRef.current;\\n    if (!slot) return;\\n    let cancelled = false;\\n\\n    const mountRig = (rig: AvatarRig) => {\\n      if (cancelled) {\\n        rig.dispose();\\n        return;\\n      }\\n      if (playerRigRef.current) {\\n        slot.remove(playerRigRef.current.root);\\n        playerRigRef.current.dispose();\\n      }\\n      rig.root.position.set(playerStateRef.current.x, 0, playerStateRef.current.z);\\n      rig.root.rotation.y = playerStateRef.current.yaw;\\n      slot.add(rig.root);\\n      playerRigRef.current = rig;\\n      renderOnceRef.current?.();\\n    };\\n\\n    if (customGlbBuffer) {\\n      void buildCustomGlbAvatarRig(customGlbBuffer, avatar, {\\n        showNameplate: true,\\n        showContactShadow: true,\\n      })\\n        .then(mountRig)\\n        .catch(() => {\\n          mountRig(buildAvatarRig(avatar, { showNameplate: true, showContactShadow: true }));\\n        });\\n    } else {\\n      mountRig(buildAvatarRig(avatar, { showNameplate: true, showContactShadow: true }));\\n    }\\n\\n    return () => {\\n      cancelled = true;\\n    };\\n  }, [avatar, customGlbBuffer]);\", \"StartLine\":883, \"TargetContent\":\"  // Rebuild player 3D avatar when user\'s avatar configuration changes\\n  useEffect(() => {\\n    const slot = playerSlotRef.current;\\n    if (!slot) return;\\n    if (playerRigRef.current) {\\n      slot.remove(playerRigRef.current.root);\\n      playerRigRef.current.dispose();\\n    }\\n    const rig = buildAvatarRig(avatar, { showNameplate: true, showContactShadow: true });\\n    rig.root.position.set(playerStateRef.current.x, 0, playerStateRef.current.z);\\n    rig.root.rotation.y = playerStateRef.current.yaw;\\n    slot.add(rig.root);\\n    playerRigRef.current = rig;\\n    renderOnceRef.current?.();\\n  }, [avatar]);\"}], \"TargetFile\":\"/src/components/Museum3DView.tsx\", \"toolAction\":\"Updating Museum3DView for exclusive GLB support\", \"toolSummary\":\"Update Museum3DView.tsx\"}"
      original_name: "multi_replace_file_content"
    }
