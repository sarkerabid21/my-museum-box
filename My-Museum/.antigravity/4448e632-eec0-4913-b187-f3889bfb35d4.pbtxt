            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const steering = stepPlayerSteering("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            forward: forwardIn,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            turn: turnIn,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
