ySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"] p\')?.textContent,\\n  };\\n})()\\\"\\n\\necho \\\"=== CHECK UPLOAD MODAL STORAGE NOTICE ===\\\"\\nplaywright-cli eval \\\"(() => {\\n  Array.from(document.querySelectorAll(\'button\')).find(b => b.textContent.trim() === \'Add Artwork\').click();\\n})()\\\"\\nsleep 0.4\\nplaywright-cli eval \\\"(() => {\\n  const modal = document.querySelector(\'[aria-label=\\\\\\\"Add Artwork to Museum Wall\\\\\\\"]\');\\n  return { hasStorageNotice: modal?.innerText.includes(\'Storage:\') && modal?.innerText.includes(\'Firebase Cloud\') };\\n})()\\\"\\nplaywright-cli console error\\n\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Testing full-museum keyboard walking in browser\", \"toolSummary\":\"Test full-museum keyboard walking\"}"
