      thinking_signature: "\022\366\024\n\363\024\001i\024}\023\315\205\020XEzBz\223\230\351H\225CU\310T!\307\207Aq\343\3249\377h\302\203\033\265\213c\331\231\225:mE\266[\352\001\301j\356L\373\317?\035\204\341\366\004\236$\f\201\017\207\215A\n\026C\301\221\326\";\322\322n\241\340r\2634\330\326\017k\2768\rC\031\363E\322dy4)\344\266b\207\017a\024!Y\274\235\f?\002\376\356\247\0255<\305v\256\206\343f\263\004\307(\214\034\224\222\004\250\rj\322\021\021\316\323|\223\002\344\022Wb\252@\371E\"i6\244\354\034\230V\035\226\030l{\270WlYX\264p\313\305\b\347\200\241\210\030*+0\017+w\251\335oS\264\006\314La\267s\001.\201F\3057\304\336\273\237z\202o\206\307\343|\232\f\244\354\302\030!\346\246aS\251\n\3401\vSY:\215G\233\027Hwu8\342\262\206Co}\276\366[\177\335\202L\024\334\3532\242\325=\263\241R\341Q!\324J5fU\244\230\b\371\376W)c\000\'\277\224\262\234O\022\223%T\277\267F^P\004 \347=\247\027F\305\246\234\362\267\25198\214S\037\345\246\273-\232r&\305\302\222V\200\205\267\312m\t\310\rs\3772\327,\21227?mG\2169D\214\362\345\t\337B\332Yi\345\362\276\030g\003\205|y\333\371\237k\310\335\036\3564S\267\027c\n\270RkN\000\360i\020\022\342$\260\025\375\024\247\334\f\006\2539\366\370\350\0053s\f\203\271eM\237\243a\aI\367\206\230\246\342\347\003\006\r~\234\330[\341\341+{\2574\nX\2154j\325\026\"\033\344\307\302\003\001/\212$\031\fQ\307\210\212\272\353#\313\341K\221\265V\245\321\v\364:\224\322`[\022\305]\335g\206\r\243eV\016\031C\326W\366\331\325t\327Y/_6\322sA\233\361\245s\251\370\025\304WU\216\211\276\267($\216\277\254\353\313\202H\006\252\353\207\307:\236\307k\345\a&\a\351\232\005{\332\264\302J\363)J\216Y\024z~\036\342A\346V0H\24525\257\300\331@\017\005]cbD\250\342v\231\r\267\3731T\206\365\275\201\274|\232;\fn&\306\370\276\177\017\324e\r1\t\a\337\254Y\3332]\325\021?iE?z\201\"\327\256[m\275\t\256\256\216\202\215H\261V\321L%\316\334\331#q8w\340\350\362\335\"\270\232-\274\325\346\\\225\327\v\306\t\342&=\343\335\016\004-\355B\365\345\320\211*_\300~9\310*\372\313\357\304`\004\275`\305Q\211\324\037\252\