              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): VehicleRig {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const root = new THREE.Group();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const wheels: THREE.Object3D[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const driverGroup = new THREE.Group();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const bodyMat = trackMat("
