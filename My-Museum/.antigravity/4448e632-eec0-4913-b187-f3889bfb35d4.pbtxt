    end_line: 332
    content: "import type { ArtworkItem, DateSortOrder, Gender, MemberRole } from \'../types/museum\';\n\nexport const HALL_WIDTH = 13.6;\nexport const HALL_HALF_WIDTH = HALL_WIDTH / 2;\nexport const HALL_HEIGHT = 6.2;\nexport const BAY_LENGTH = 7.6;\nexport const FOYER_DEPTH = 6.5; // extends toward +Z from z = 0 to z = +6.5\nexport const ARTWORKS_PER_BAY = 2; // 1 West wall, 1 East wall per architectural bay\nexport const MIN_BAYS = 2;\nexport const WALL_COLLISION_MARGIN = 1.05;\n\nexport interface BenchBounds {\n  minX: number;\n  maxX: number;\n  minZ: number;\n  maxZ: number;\n  centerZ: number;\n}\n\nexport interface MuseumLayout {\n  artworkCount: number;\n  bayCount: number;\n  totalWallSlots: number;\n  hallWidth: number;\n  hallHeight: number;\n  bayLength: number;\n  southWallZ: number;\n  northWallZ: number;\n  totalLength: number;\n  benches: BenchBounds[];\n}\n\nexport interface ArtworkPlacement {\n  index: number;\n  bayIndex: number;\n  wingNumber: number;\n  wingLabel: string;\n  wallSide: \'west\' | \'east\';\n  x: number;\n  y: number;\n  z: number;\n  rotY: number;\n  standPoint: {\n    x: number;\n    z: number;\n    yaw: number;\n  };\n}\n\nexport interface DateGroup {\n  dateKey: string; // YYYY-MM-DD\n  label: string;\n  items: ArtworkItem[];\n}\n\nexport interface ValidationResult {\n  valid: boolean;\n  errors: Record<string, string>;\n}\n\nconst ROMAN_NUMERALS = [\n  \'I\', \'II\', \'III\', \'IV\', \'V\', \'VI\', \'VII\', \'VIII\', \'IX\', \'X\',\n  \'XI\', \'XII\', \'XIII\', \'XIV\', \'XV\', \'XVI\', \'XVII\', \'XVIII\', \'XIX\', \'XX\',\n];\n\nexport function toWingLabel(wingNumber: number): string {\n  const numeral = ROMAN_NUMERALS[wingNumber - 1] ?? String(wingNumber);\n  return `Wing ${numeral}`;\n}\n\n/**\n * Pure procedural calculation for the dynamically expanding 3D museum hall.\n * Every 2 artworks occupy 1 architectural bay (West + East gallery walls).\n * Adding images automatically expands bayCount, corridor length, and wall slots.\n */\nexport function calculateMuseumLayout(artworkCount: number): MuseumLayout {\n  const safeCount = Math.max(0, Math.floor(artworkCount));\n  const bayCount = Math.max(MIN_BAYS, Math.ceil(safeCount / ARTWORKS_PER_BAY));\n  const totalWallSlots = bayCount * ARTWORKS_PER_BAY;\n  const southWallZ = FOYER_DEPTH;\n  const northWallZ = -(bayCount * BAY_LENGTH + 2.2);\n  const totalLength = southWallZ - northWallZ;\n\n  // Place velvet gallery benches centered in the corridor on every odd bay (0, 2, 4...)\n  const benches: BenchBounds[] = [];\n  for (let b = 0; b < bayCount; b += 2) {\n    const centerZ = -(b * BAY_LENGTH + BAY_LENGTH * 0.5);\n    benches.push({\n      centerZ,\n      minX: -1.35,\n      maxX: 1.35,\n      minZ: centerZ - 1.55,\n      maxZ: centerZ + 1.55,\n    });\n  }\n\n  return {\n    artworkCount: safeCount,\n    bayCount,\n    totalWallSlots,\n    hallWidth: HALL_WIDTH,\n    hallHeight: HALL_HEIGHT,\n    bayLength: BAY_LENGTH,\n    southWallZ,\n    northWallZ,\n    totalLength,\n    benches,\n  };\n}\n\n/**\n * Computes exact 3D wall placement and optimal viewing stand point for artwork index.\n */\nexport function getArtworkPlacement(index: number): ArtworkPlacement {\n  const bayIndex = Math.floor(index / ARTWORKS_PER_BAY);\n  const isWest = index % 2 === 0;\n  const wallSide: \'west\' | \'east\' = isWest ? \'west\' : \'east\';\n  const z = -(bayIndex * BAY_LENGTH + BAY_LENGTH * 0.5);\n  const wallOffset = HALL_HALF_WIDTH - 0.14;\n  const x = isWest ? -wallOffset : wallOffset;\n  const rotY = isWest ? Math.PI / 2 : -Math.PI / 2;\n\n  // Avatar stand position 3.1m in front of the painting, facing directly at it\n  const standX = isWest ? -wallOffset + 3.1 : wallOffset - 3.1;\n  // In our avatar coordinate frame, yaw = 0 faces -Z; +PI/2 faces -X (West); -PI/2 faces +X (East)\n  const standYaw = isWest ? Math.PI / 2 : -Math.PI / 2;\n\n  const wingNumber = bayIndex + 1;\n  return {\n    index,\n    bayIndex,\n    wingNumber,\n    wingLabel: toWingLabel(wingNumber),\n    wallSide,\n    x,\n    y: 2.55,\n    z,\n    rotY,\n    standPoint: {\n      x: standX,\n      z,\n      yaw: standYaw,\n    },\n  };\n}\n\n/**\n * Clamps avatar position strictly within the dynamic corridor walls and around benches.\n */\nexport function clampPlayerPosition(\n  x: number,\n  z: number,\n  layout: MuseumLayout\n): { x: number; z: number } {\n  const minX = -HALL_HALF_WIDTH + WALL_COLLISION_MARGIN;\n  const maxX = HALL_HALF_WIDTH - WALL_COLLISION_MARGIN;\n  const minZ = layout.northWallZ + WALL_COLLISION_MARGIN + 0.5;\n  const maxZ = layout.southWallZ - WALL_COLLISION_MARGIN - 0.4;\n\n  let cx = Math.min(maxX, Math.max(minX, x));\n  let cz = Math.min(maxZ, Math.max(minZ, z));\n\n  // Push smoothly out of central gallery benches\n  for (const bench of layout.benches) {\n    if (cx > bench.minX && cx < bench.maxX && cz > bench.minZ && cz < bench.maxZ) {\n      const distLeft = Math.abs(cx - bench.minX);\n      const distRight = Math.abs(bench.maxX - cx);\n      const distNorth = Math.abs(cz - bench.minZ);\n      const distSouth = Math.abs(bench.maxZ - cz);\n      const minDist = Math.min(distLeft, distRight, distNorth, distSouth);\n\n      if (minDist === distLeft) cx = bench.minX;\n      else if (minDist === distRight) cx = bench.maxX;\n      else if (minDist === distNorth) cz = bench.minZ;\n      else cz = bench.maxZ;\n    }\n  }\n\n  return { x: cx, z: cz };\n}\n\n/**\n * Deterministically sorts artworks chronologically by dateCaptured (YYYY-MM-DD).\n */\nexport function sortArtworksByDate(\n  artworks: ArtworkItem[],\n  order: DateSortOrder = \'newest\'\n): ArtworkItem[] {\n  return [...artworks].sort((a, b) => {\n    const dateCmp = a.dateCaptured.localeCompare(b.dateCaptured);\n    if (dateCmp !== 0) {\n      return order === \'newest\' ? -dateCmp : dateCmp;\n    }\n    return a.title.localeCompare(b.title);\n  });\n}\n\nexport function formatArchivalDate(isoDate: string): string {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(isoDate)) return isoDate;\n  const [year, month, day] = isoDate.split(\'-\').map(Number);\n  const date = new Date(Date.UTC(year, month - 1, day));\n  return date.toLocaleDateString(\'en-US\', {\n    year: \'numeric\',\n    month: \'long\',\n    day: \'numeric\',\n    timeZone: \'UTC\',\n  });\n}\n\nexport function formatAccessionNumber(isoDate: string, index: number): string {\n  const clean = isoDate.replace(/-/g, \'.\');\n  const seq = String(index + 1).padStart(2, \'0\');\n  return `ACC. ${clean}.${seq}`;\n}\n\n/**\n * Groups sorted artworks by their exact date for the chronological archive view.\n */\nexport function groupArtworksByDate(\n  artworks: ArtworkItem[],\n  order: DateSortOrder = \'newest\'\n): DateGroup[] {\n  const sorted = sortArtworksByDate(artworks, order);\n  const map = new Map<string, ArtworkItem[]>();\n\n  for (const item of sorted) {\n    const existing = map.get(item.dateCaptured);\n    if (existing) {\n      existing.push(item);\n    } else {\n      map.set(item.dateCaptured, [item]);\n    }\n  }\n\n  return Array.from(map.entries()).map(([dateKey, items]) => ({\n    dateKey,\n    label: formatArchivalDate(dateKey),\n    items,\n  }));\n}\n\nexport function validateArtworkInput(input: {\n  title: string;\n  artist: string;\n  dateCaptured: string;\n  imageUrl: string;\n  notes: string;\n}): ValidationResult {\n  const errors: Record<string, string> = {};\n  const title = input.title.trim();\n  const artist = input.artist.trim();\n\n  if (!title) {\n    errors.title = \'Please enter an artwork title.\';\n  } else if (title.length > 120) {\n    errors.title = \'Title must be 120 characters or fewer.\';\n  }\n\n  if (!artist) {\n    errors.artist = \'Please enter the creator or photographer name.\';\n  } else if (artist.length > 100) {\n    errors.artist = \'Creator name must be 100 characters or fewer.\';\n  }\n\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(input.dateCaptured)) {\n    errors.dateCaptured = \'Choose a valid archival date (YYYY-MM-DD).\';\n  }\n\n  if (!input.imageUrl || input.imageUrl.trim().length < 5) {\n    errors.imageUrl = \'Please upload an image or choose a gallery sample.\';\n  } else if (input.imageUrl.length > 440000) {\n    errors.imageUrl = \'Image payload is too large. Please choose a smaller photo.\';\n  }\n\n  if (input.notes.length > 500) {\n    errors.notes = \'Curatorial notes must be 500 characters or fewer.\';\n  }\n\n  return { valid: Object.keys(errors).length === 0, errors };\n}\n\nexport function validateAccessGrant(input: {\n  email: string;\n  displayName: string;\n  role: MemberRole;\n  gender: Gender;\n  existingEmails: string[];\n}): ValidationResult {\n  const errors: Record<string, string> = {};\n  const email = input.email.trim().toLowerCase();\n  const displayName = input.displayName.trim();\n\n  if (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n    errors.email = \'Enter a valid email address.\';\n  } else if (input.existingEmails.map((e) => e.toLowerCase()).includes(email)) {\n    errors.email = \'This person already has access to your museum.\';\n  } else if (input.existingEmails.length >= 10) {\n    errors.email = \'Maximum 10 invited visitors reached for this museum.\';\n  }\n\n  if (!displayName) {\n    errors.displayName = \'Enter the visitor name.\';\n  } else if (displayName.length > 80) {\n    errors.displayName = \'Name must be 80 characters or fewer.\';\n  }\n\n  if (input.role !== \'visitor\' && input.role !== \'curator\') {\n    errors.role = \'Invalid role selected.\';\n  }\n\n  if (input.gender !== \'man\' && input.gender !== \'woman\') {\n    errors.gender = \'Select Man or Woman for visitor avatar.\';\n  }\n\n  return { valid: Object.keys(errors).length === 0, errors };\n}\n\nexport function generateAccessCode(seed = \'\'): string {\n  const alphabet = \'ABCDEFGHJKLMNPQRSTUVWXYZ23456789\';\n  let suffix = \'\';\n  const source = seed || `${Date.now()}-${Math.random()}`;\n  let hash = 2166136261;\n  for (let i = 0; i < source.length; i++) {\n    hash ^= source.charCodeAt(i);\n    hash = Math.imul(hash, 16777619);\n  }\n  for (let i = 0; i < 4; i++) {\n    const idx = Math.abs((hash >>> (i * 7)) % alphabet.length);\n    suffix += alphabet[idx];\n  }\n  return `MUS-${suffix}`;\n}\n"
    num_lines: 333
    num_bytes: 9780
    line_range_bytes: 9780
  }
}
