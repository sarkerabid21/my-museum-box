      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add fetchInvitedMuseum helper to load a shared museum directly from an invite link\", \"EndLine\":294, \"Instruction\":\"Add fetchInvitedMuseum function right after findMuseumByAccessCode in museumService.ts\", \"ReplacementContent\":\"export async function findMuseumByAccessCode(rawCode: string): Promise<MuseumMeta | null> {\\n  const code = rawCode.trim().toUpperCase().replace(/[^A-Z0-9-]/g, \'\');\\n  if (code.length < 4 || code.length > 20) return null;\\n  const codePath = `museumCodes/${code}`;\\n  try {\\n    const codeSnap = await getDoc(doc(db, \'museumCodes\', code));\\n    if (!codeSnap.exists()) return null;\\n    const museumId = String(codeSnap.data().museumId ?? \'\');\\n    if (!museumId) return null;\\n    const museumSnap = await getDoc(doc(db, \'museums\', museumId));\\n    if (!museumSnap.exists()) return null;\\n    return mapMuseumDoc(museumSnap.id, museumSnap.data());\\n  } catch (error) {\\n    handleFirestoreError(error, OperationType.GET, codePath);\\n  }\\n}\\n\\nexport async function fetchInvitedMuseum(\\n  museumId: string,\\n  accessCode?: string\\n): Promise<MuseumMeta | null> {\\n  const safeId = sanitizeId(museumId);\\n  try {\\n    const museumSnap = await getDoc(doc(db, \'museums\', safeId));\\n    if (museumSnap.exists()) {\\n      return mapMuseumDoc(museumSnap.id, museumSnap.data());\\n    }\\n  } catch {\\n    // Fall through to code lookup if direct ID get was denied or missing\\n  }\\n  if (accessCode && accessCode.trim().length >= 4) {\\n    try {\\n      return await findMuseumByAccessCode(accessCode);\\n    } catch {\\n      return null;\\n    }\\n  }\\n  return null;\\n}\", \"StartLine\":250, \"TargetContent\":\"export async function findMuseumByAccessCode(rawCode: string): Promise<MuseumMeta | null> {\\n  const code = rawCode.trim().toUpperCase().replace(/[^A-Z0-9-]/g, \'\');\\n  if (code.length < 4 || code.length > 20) return null;\\n  const codePath = `museumCodes/${code}`;\\n  try {\\n    const codeSnap = await getDoc(doc(db, \'museumCodes\', code));\\n    if (!codeSnap.exists()) return null;\\n    const museumId = String(codeSnap.data().museumId ?? \'\');\\n    if (!museumId) return null;\\n    const museumSnap = await getDoc(doc(db, \'museums\', museumId));\\n    if (!museumSnap.exists()) return null;\\n    return mapMuseumDoc(museumSnap.id, museumSnap.data());\\n  } catch (error) {\\n    handleFirestoreError(error, OperationType.GET, codePath);\\n  }\\n}\", \"TargetFile\":\"/src/services/museumService.ts\", \"toolAction\":\"Adding direct invite link museum resolver to museumService.ts\", \"toolSummary\":\"Add fetchInvitedMuseum to museumService.ts\"}"
