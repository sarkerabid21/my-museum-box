    tool_calls {
      id: "call_12055140169970940250"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Auto-open Abid\'s museum for trusted circle emails, keep offline standing 3D models on exit/sign-out, and pass self identity to Museum3DView in App.tsx\", \"Instruction\":\"Update App.tsx imports, preferred initial museum selection for suraia475/abidsarker098, offline presence marking, and Museum3DView props\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":28, \"ReplacementContent\":\"  grantMuseumAccess,\\n  loadOrCreateUserProfile,\\n  markPresenceOffline,\\n  revokeMuseumAccess,\\n  saveUserProfile,\\n  subscribeAccessibleMuseums,\\n  subscribeArtworks,\\n  subscribeMembers,\\n  subscribePresence,\\n  updateMuseumRoomNames,\\n  updateMuseumSettings,\\n  upsertPresence,\\n} from \'./services/museumService\';\", \"StartLine\":15, \"TargetContent\":\"  grantMuseumAccess,\\n  loadOrCreateUserProfile,\\n  removePresence,\\n  revokeMuseumAccess,\\n  saveUserProfile,\\n  subscribeAccessibleMuseums,\\n  subscribeArtworks,\\n  subscribeMembers,\\n  subscribePresence,\\n  updateMuseumRoomNames,\\n  updateMuseumSettings,\\n  upsertPresence,\\n} from \'./services/museumService\';\"}, {\"AllowMultiple\":false, \"EndLine\":63, \"ReplacementContent\":\"import {\\n  enforceAccountAvatarPolicy,\\n  isAbidSignatureAvatar,\\n  isExclusiveAbidAccount,\\n} from \'./museum/exclusiveAvatar\';\\nimport {\\n  isAbidMuseum,\\n  isTrustedAbidVisitorEmail,\\n  pickPreferredInitialMuseumId,\\n} from \'./museum/trustedCircle\';\", \"StartLine\":57, \"TargetContent\":\"import {\\n  enforceAccountAvatarPolicy,\\n  isAbidSignatureAvatar,\\n  isExclusiveAbidAccount,\\n} from \'./museum/exclusiveAvatar\';\"}, {\"AllowMultiple\":false, \"EndLine\":196, \"ReplacementContent\":\"  const [inviteBannerMessage, setInviteBannerMessage] = useState<string | null>(null);\\n  const inviteResolvedRef = useRef<string | null>(null);\\n  const manualMuseumChoiceRef = useRef(false);\\n  const lastKnownPosRef = useRef({ x: 0, z: 4.5, yaw: Math.PI });\", \"StartLine\":192, \"TargetContent\":\"  const [inviteBannerMessage, setInviteBannerMessage] = useState<string | null>(null);\\n  const inviteResolvedRef = useRef<string | null>(null);\"}, {\"AllowMultiple\":false, \"EndLine\":245, \"ReplacementContent\":\"      setInspectState({ artwork: null, slotIndex: 0 });\\n      setRenameRoomIndex(null);\\n      manualMuseumChoiceRef.current = false;\\n\\n      setUser(nextUser);\", \"StartLine\":239, \"TargetContent\":\"      setInspectState({ artwork: null, slotIndex: 0 });\\n      setRenameRoomIndex(null);\\n\\n      setUser(nextUser);\"}, {\"AllowMultiple\":false, \"EndLine\":322, \"ReplacementContent\":\"          setCloudMuseums((prev) =>\\n            prev.some((m) => m.id === personal.id) ? prev : [personal, ...prev]\\n          );\\n          setActiveMuseumId((prev) => prev || personal.id);\\n          setCloudReady(true);\\n        } catch (err) {\\n          console.error(\'Error initializing private cloud museum:\', err);\\n          if (runId === activeRun) {\\n            showToast(\'Could not load your private cloud museum. Please check your connection and retry.\');\\n          }\\n        }\\n      } else {\\n        setAvatar((prev) => enforceAccountAvatarPolicy(prev, null));\\n      }\\n    });\\n    return () => {\\n      activeRun++;\\n      unsub();\\n    };\\n  }, [showToast]);\\n\\n  const activeMuseumIdRef = useRef(activeMuseumId);\\n  activeMuseumIdRef.current = activeMuseumId;\\n\\n  // Subscribe ONLY to museums owned by or explicitly shared with this authenticated user\\n  useEffect(() => {\\n    if (!user) return;\\n    const unsub = subscribeAccessibleMuseums(user, (list) => {\\n      setCloudMuseums((prev) => {\\n        // Keep any directly opened invited museum in the list alongside owned/member museums\\n        const byId = new Map<string, MuseumMeta>();\\n        for (const m of list) byId.set(m.id, m);\\n        const curActiveId = activeMuseumIdRef.current;\\n        for (const existing of prev) {\\n          if (existing.id === curActiveId && !byId.has(existing.id)) {\\n            byId.set(existing.id, existing);\\n          }\\n        }\\n        return Array.from(byId.values());\\n      });\\n      if (list.length > 0) {\\n        setCloudReady(true);\\n        setActiveMuseumId((prev) => {\\n          if (prev && inviteResolvedRef.current === `${user.uid}:${prev}`) return prev;\\n          // Auto-land Abid\'s trusted circle (suraia475, abidsarker098) directly in Abid\'s museum\\n          // unless they manually switched to another museum.\\n          if (!manualMuseumChoiceRef.current && isTrustedAbidVisitorEmail(user.email)) {\\n            const abidShared = list.find((m) => isAbidMuseum(m));\\n            if (abidShared) return abidShared.id;\\n          }\\n          if (prev && list.some((m) => m.id === prev)) return prev;\\n          return pickPreferredInitialMuseumId(list, user.uid, user.email);\\n        });\\n      }\\n    });\\n    return () => unsub();\\n  }, [user]);\", \"StartLine\":270, \"TargetContent\":\"          setCloudMuseums((prev) =>\\n            prev.some((m) => m.id === personal.id) ? prev : [personal, ...prev]\\n          );\\n          setActiveMuseumId(personal.id);\\n          setCloudReady(true);\\n        } catch (err) {\\n          console.error(\'Error initializing private cloud museum:\', err);\\n          if (runId === activeRun) {\\n            showToast(\'Could not load your private cloud museum. Please check your connection and retry.\');\\n          }\\n        }\\n      } else {\\n        setAvatar((prev) => enforceAccountAvatarPolicy(prev, null));\\n      }\\n    });\\n    return () => {\\n      activeRun++;\\n      unsub();\\n    };\\n  }, [showToast]);\\n\\n  const activeMuseumIdRef = useRef(activeMuseumId);\\n  activeMuseumIdRef.current = activeMuseumId;\\n\\n  // Subscribe ONLY to museums owned by or explicitly shared with this authenticated user\\n  useEffect(() => {\\n    if (!user) return;\\n    const unsub = subscribeAccessibleMuseums(user, (list) => {\\n      setCloudMuseums((prev) => {\\n        // Keep any directly opened invited museum in the list alongside owned/member museums\\n        const byId = new Map<string, MuseumMeta>();\\n        for (const m of list) byId.set(m.id, m);\\n        const curActiveId = activeMuseumIdRef.current;\\n        for (const existing of prev) {\\n          if (existing.id === curActiveId && !byId.has(existing.id)) {\\n            byId.set(existing.id, existing);\\n          }\\n        }\\n        return Array.from(byId.values());\\n      });\\n      if (list.length > 0) {\\n        setCloudReady(true);\\n        setActiveMuseumId((prev) => {\\n          if (prev && list.some((m) => m.id === prev)) return prev;\\n          if (prev && inviteResolvedRef.current === `${user.uid}:${prev}`) return prev;\\n          const personal = list.find((m) => m.ownerId === user.uid);\\n          return personal ? personal.id : list[0].id;\\n        });\\n      }\\n    });\\n    return () => unsub();\\n  }, [user]);\"}, {\"AllowMultiple\":false, \"EndLine\":476, \"ReplacementContent\":\"  // Mark visitor as standing offline (preserving last position) when leaving the 3D museum view\\n  useEffect(() => {\\n    if (view !== \'museum\' && user && cloudReady && activeMuseum.accessCode !== \'LOADING\') {\\n      const pos = lastKnownPosRef.current;\\n      void markPresenceOffline(\\n        activeMuseum,\\n        user,\\n        enforceAccountAvatarPolicy(avatarRef.current, user.email),\\n        pos.x,\\n        pos.z,\\n        pos.yaw\\n      );\\n    }\\n  }, [view, user, cloudReady, activeMuseum]);\\n\\n  const handleSignInGoogle = async () => {\\n    try {\\n      await signInWithGoogle();\\n      showToast(\'Signed in with Google. Loading your private museum database...\');\\n    } catch (err) {\\n      console.warn(\'Google sign-in cancelled or failed:\', err);\\n      showToast(\'Sign-in was cancelled. You can continue customizing in Guest Studio Mode.\');\\n    }\\n  };\\n\\n  const handleSignOut = async () => {\\n    if (user && cloudReady && activeMuseum.accessCode !== \'LOADING\') {\\n      const pos = lastKnownPosRef.current;\\n      await markPresenceOffline(\\n        activeMuseum,\\n        user,\\n        enforceAccountAvatarPolicy(avatarRef.current, user.email),\\n        pos.x,\\n        pos.z,\\n        pos.yaw\\n      );\\n    }\", \"StartLine\":451, \"TargetContent\":\"  // Clean up own presence when leaving the 3D museum view\\n  useEffect(() => {\\n    if (view !== \'museum\' && user && cloudReady && activeMuseum.id) {\\n      void removePresence(activeMuseum.id, user.uid);\\n    }\\n  }, [view, user, cloudReady, activeMuseum.id]);\\n\\n  const handleSignInGoogle = async () => {\\n    try {\\n      await signInWithGoogle();\\n      showToast(\'Signed in with Google. Loading your private museum database...\');\\n    } catch (err) {\\n      console.warn(\'Google sign-in cancelled or failed:\', err);\\n      showToast(\'Sign-in was cancelled. You can continue customizing in Guest Studio Mode.\');\\n    }\\n  };\\n\\n  const handleSignOut = async () => {\\n    if (user && cloudReady && activeMuseum.id) {\\n      await removePresence(activeMuseum.id, user.uid);\\n    }\"}, {\"AllowMultiple\":false, \"EndLine\":785, \"ReplacementContent\":\"  const handlePositionBroadcast = useCallback(\\n    (x: number, z: number, yaw: number) => {\\n      lastKnownPosRef.current = { x, z, yaw };\\n      if (!user || !cloudReady || activeMuseum.accessCode === \'LOADING\') return;\\n      void upsertPresence(\\n        activeMuseum,\\n        user,\\n        enforceAccountAvatarPolicy(avatar, user.email),\\n        x,\\n        z,\\n        yaw,\\n        true\\n      );\\n    },\\n    [user, cloudReady, activeMuseum, avatar]\\n  );\\n\\n  const handlePresenceOffline = useCallback(\\n    (x: number, z: number, yaw: number) => {\\n      lastKnownPosRef.current = { x, z, yaw };\\n      if (!user || !cloudReady || activeMuseum.accessCode === \'LOADING\') return;\\n      void markPresenceOffline(\\n        activeMuseum,\\n        user,\\n        enforceAccountAvatarPolicy(avatar, user.email),\\n        x,\\n        z,\\n        yaw\\n      );\\n    },\\n    [user, cloudReady, activeMuseum, avatar]\\n  );\", \"StartLine\":766, \"TargetContent\":\"  const handlePositionBroadcast = useCallback(\\n    (x: number, z: number, yaw: number) => {\\n      if (!user || !cloudReady || activeMuseum.accessCode === \'LOADING\') return;\\n      void upsertPresence(\\n        activeMuseum,\\n        user,\\n        enforceAccountAvatarPolicy(avatar, user.email),\\n        x,\\n        z,\\n        yaw\\n      );\\n    },\\n    [user, cloudReady, activeMuseum, avatar]\\n  );\"}, {\"AllowMultiple\":false, \"EndLine\":860, \"ReplacementContent\":\"          onSwitchMuseum={(id) => {\\n            manualMuseumChoiceRef.current = true;\\n            setActiveMuseumId(id);\\n            showToast(\'Switched active museum.\');\\n          }}\\n          onInspectArtwork={(artwork, slotIndex) =>\\n            setInspectState({ artwork, slotIndex })\\n          }\\n        />\\n      ) : (\\n        <Museum3DView\\n          museum={activeMuseum}\\n          avatar={safeAvatar}\\n          selfUid={user?.uid ?? null}\\n          selfEmail={user?.email ?? null}\\n          customGlbBuffer={isExclusiveAbid ? customGlbBuffer : null}\\n          artworks={artworks}\\n          members={members}\\n          liveVisitors={liveVisitors}\\n          showInvitedIn3D={showInvitedIn3D}\\n          canCurate={canCurate}\\n          canRenameRooms={isOwner}\\n          teleportTargetId={teleportTargetId}\\n          onClearTeleport={() => setTeleportTargetId(null)}\\n          onSelectArtwork={(artwork, slotIndex) =>\\n            setInspectState({ artwork, slotIndex })\\n          }\\n          onRequestRenameRoom={(idx) => setRenameRoomIndex(idx)}\\n          onNotify={showToast}\\n          onOpenCatalog={() => setCatalogOpen(true)}\\n          onOpenUpload={() => setUploadOpen(true)}\\n          onOpenAccess={() => setAccessOpen(true)}\\n          onReturnHome={() => setView(\'home\')}\\n          onChangeWallTheme={handleChangeWallTheme}\\n          onPositionBroadcast={handlePositionBroadcast}\\n          onPresenceOffline={handlePresenceOffline}\\n          isPaused={isAnyModalOpen}\\n        />\\n      )}\", \"StartLine\":825, \"TargetContent\":\"          onSwitchMuseum={(id) => {\\n            setActiveMuseumId(id);\\n            showToast(\'Switched active museum.\');\\n          }}\\n          onInspectArtwork={(artwork, slotIndex) =>\\n            setInspectState({ artwork, slotIndex })\\n          }\\n        />\\n      ) : (\\n        <Museum3DView\\n          museum={activeMuseum}\\n          avatar={safeAvatar}\\n          customGlbBuffer={isExclusiveAbid ? customGlbBuffer : null}\\n          artworks={artworks}\\n          members={members}\\n          liveVisitors={liveVisitors}\\n          showInvitedIn3D={showInvitedIn3D}\\n          canCurate={canCurate}\\n          canRenameRooms={isOwner}\\n          teleportTargetId={teleportTargetId}\\n          onClearTeleport={() => setTeleportTargetId(null)}\\n          onSelectArtwork={(artwork, slotIndex) =>\\n            setInspectState({ artwork, slotIndex })\\n          }\\n          onRequestRenameRoom={(idx) => setRenameRoomIndex(idx)}\\n          onNotify={showToast}\\n          onOpenCatalog={() => setCatalogOpen(true)}\\n          onOpenUpload={() => setUploadOpen(true)}\\n          onOpenAccess={() => setAccessOpen(true)}\\n          onReturnHome={() => setView(\'home\')}\\n          onChangeWallTheme={handleChangeWallTheme}\\n          onPositionBroadcast={handlePositionBroadcast}\\n          isPaused={isAnyModalOpen}\\n        />\\n      )}\"}, {\"AllowMultiple\":false, \"EndLine\":925, \"ReplacementContent\":\"        onSwitchMuseum={(id) => {\\n          manualMuseumChoiceRef.current 