            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Synchronize third-person camera behind the vehicle so turning left/right smoothly turns screen too!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Camera look vector is (-sin(camYaw), -cos(camYaw)); matching vehicle forward (sin(yaw), cos(yaw)) => camYaw = yaw + PI"
