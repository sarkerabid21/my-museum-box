            lines {
              text: "  const inlayMat = trackMat("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    new THREE.MeshStandardMaterial({"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      color: palette.inlay,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      roughness: 0.42,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      metalness: 0.06,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
