            }
            lines {
              text: "        [1.15, 4.0, -0.6, 0.82],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      bloomSpecs.forEach(([bx, by, bz, br], i) => {"
