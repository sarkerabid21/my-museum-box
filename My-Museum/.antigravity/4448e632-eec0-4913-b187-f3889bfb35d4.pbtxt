            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (_move.lengthSq() > 0.001) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _move.normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const nextPos = clampPlayerPosition("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ps.x + _move.x * walkSpeed * delta,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ps.z + _move.z * walkSpeed * delta,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          curLayout"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ps.x = nextPos.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ps.z = nextPos.z;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ps.speed = walkSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Smoothly orient avatar body toward direction of travel"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const desiredYaw = Math.atan2(_move.x, _move.z);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        let diff = desiredYaw - ps.yaw;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        while (diff > Math.PI) diff -= Math.PI * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        while (diff < -Math.PI) diff += Math.PI * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ps.yaw += diff * (1 - Math.exp(-12 * delta));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
