  planner_response {
    thinking: "**Developing Access Controls**\n\nI\'m currently focused on developing the modular `AccessModal.tsx` component. The aim is to build a robust system for managing shared museum access. This includes functionalities like granting access via email, name, role, and gender, as well as revoking access and enabling code entry. I\'m also including features to copy access codes, toggle live 3D companion previews, and facilitate joining a shared museum experience.\n\n\n**Expanding Museum Navigation**\n\nI\'ve been concentrating on `src/components/Museum3DView.tsx`. I\'m really making progress on the 3D museum experience. I\'ve got the camera controls (first/third-person, WASD, etc.) working and have incorporated dynamic hall rebuilds. I\'m also including real-time co-visitors and am working on raycasting for artwork inspection. Finally, I\'m working on the Bottom Control Dock.\n\n\n"
    message_id: "6MsBa7ijM871-8YP4bnqkQU"
    tool_calls {
      id: "call_4304158251172809685"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Check, Copy, KeyRound, Trash2, UserPlus, Users, X } from \'lucide-react\';\\nimport type { Gender, MemberRole, MuseumMember, MuseumMeta } from \'../types/museum\';\\nimport { validateAccessGrant } from \'../museum/layout\';\\n\\ninterface AccessModalProps {\\n  open: boolean;\\n  onClose: () => void;\\n  museum: MuseumMeta;\\n  isOwner: boolean;\\n  members: MuseumMember[];\\n  accessibleMuseums: MuseumMeta[];\\n  showInvitedIn3D: boolean;\\n  onToggleShowInvitedIn3D: (next: boolean) => void;\\n  onGrantAccess: (input: {\\n    email: string;\\n    displayName: string;\\n    role: MemberRole;\\n    gender: Gender;\\n  }) => Promise<void> | void;\\n  onRevokeAccess: (member: MuseumMember) => Promise<void> | void;\\n  onToggleOpenByCode: (isOpen: boolean) => Promise<void> | void;\\n  onJoinByCode: (code: string) => Promise<string | null>;\\n  onSwitchMuseum: (museumId: string) => void;\\n}\\n\\nexport function AccessModal({\\n  open,\\n  onClose,\\n  museum,\\n  isOwner,\\n  members,\\n  accessibleMuseums,\\n  showInvitedIn3D,\\n  onToggleShowInvitedIn3D,\\n  onGrantAccess,\\n  onRevokeAccess,\\n  onToggleOpenByCode,\\n  onJoinByCode,\\n  onSwitchMuseum,\\n}: AccessModalProps) {\\n  const [tab, setTab] = useState<\'share\' | \'join\'>(\'share\');\\n  const [email, setEmail] = useState(\'\');\\n  const [displayName, setDisplayName] = useState(\'\');\\n  const [role, setRole] = useState<MemberRole>(\'visitor\');\\n  const [gender, setGender] = useState<Gender>(\'woman\');\\n  const [errors, setErrors] = useState<Record<string, string>>({});\\n  const [joinCode, setJoinCode] = useState(\'\');\\n  const [joinError, setJoinError] = useState(\'\');\\n  const [copied, setCopied] = useState(false);\\n  const [busy, setBusy] = useState(false);\\n\\n  if (!open) return null;\\n\\n  const handleCopyCode = async () => {\\n    try {\\n      await navigator.clipboard.writeText(museum.accessCode);\\n      setCopied(true);\\n      setTimeout(() => setCopied(false), 1800);\\n    } catch {\\n      setCopied(true);\\n      setTimeout(() => setCopied(false), 1800);\\n    }\\n  };\\n\\n  const handleGrantSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const validation = validateAccessGrant({\\n      email,\\n      displayName,\\n      role,\\n      gender,\\n      existingEmails: members.map((m) => m.email),\\n    });\\n    if (!validation.valid) {\\n      setErrors(validation.errors);\\n      return;\\n    }\\n\\n    setBusy(true);\\n    try {\\n      await onGrantAccess({\\n        email: email.trim().toLowerCase(),\\n        displayName: displayName.trim(),\\n        role,\\n        gender,\\n      });\\n      setEmail(\'\');\\n      setDisplayName(\'\');\\n      setErrors({});\\n    } catch (err) {\\n      setErrors({\\n        form: err instanceof Error ? err.message : \'Unable to grant access.\',\\n      });\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  const handleJoinSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const cleaned = joinCode.trim().toUpperCase();\\n    if (cleaned.length < 4) {\\n      setJoinError(\'Enter a valid museum access code (e.g., MUS-742A).\');\\n      return;\\n    }\\n    setBusy(true);\\n    setJoinError(\'\');\\n    try {\\n      const errorMsg = await onJoinByCode(cleaned);\\n      if (errorMsg) {\\n        setJoinError(errorMsg);\\n      } else {\\n        setJoinCode(\'\');\\n        onClose();\\n      }\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-stone-950/65\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label=\\\"Museum Access and Shared Visitors\\\"\\n    >\\n      <div className=\\\"bg-[#FAF8F4] text-[#1C1917] w-full max-w-xl max-h-[92vh] overflow-y-auto border border-stone-300 shadow-2xl\\\">\\n        <div className=\\\"px-6 py-5 border-b border-stone-200 flex items-center justify-between\\\">\\n          <div>\\n            <p className=\\\"text-xs font-mono text-[#8A5A2B] tracking-wider mb-1\\\">\\n              MULTI-VISITOR ACCESS \302\267 GENDER AVATARS\\n            </p>\\n            <h2 className=\\\"text-2xl font-editorial font-semibold text-stone-900\\\">\\n              Share & Visit Museums\\n            </h2>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            aria-label=\\\"Close access dialog\\\"\\n            className=\\\"p-2 text-stone-500 hover:text-stone-900 cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Tab Bar */}\\n        <div className=\\\"px-6 pt-4 border-b border-stone-200 flex gap-6 bg-[#F4F1EA]\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setTab(\'share\')}\\n            className={`pb-3 text-sm font-medium border-b-2 transition-colors cursor-pointer whitespace-nowrap ${\\n              tab === \'share\'\\n                ? \'border-[#8A5A2B] text-stone-900\'\\n                : \'border-transparent text-stone-500 hover:text-stone-800\'\\n            }`}\\n          >\\n            Grant Museum Access\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setTab(\'join\')}\\n            className={`pb-3 text-sm font-medium border-b-2 transition-colors cursor-pointer whitespace-nowrap ${\\n              tab === \'join\'\\n                ? \'border-[#8A5A2B] text-stone-900\'\\n                : \'border-transparent text-stone-500 hover:text-stone-800\'\\n            }`}\\n          >\\n            Enter Shared Museum ({accessibleMuseums.length})\\n          </button>\\n        </div>\\n\\n        {tab === \'share\' ? (\\n          <div className=\\\"p-6 space-y-6\\\">\\n            {/* Access Code Box */}\\n            <div className=\\\"p-4 bg-white border border-stone-200 flex flex-wrap items-center justify-between gap-4\\\">\\n              <div>\\n                <p className=\\\"text-xs text-stone-500 mb-0.5\\\">Museum Access Code</p>\\n                <p className=\\\"text-lg font-mono font-semibold text-stone-900 tracking-widest tabular-nums\\\">\\n                  {museum.accessCode}\\n                </p>\\n              </div>\\n              <div className=\\\"flex items-center gap-3\\\">\\n                {isOwner && (\\n                  <label className=\\\"inline-flex items-center gap-2 text-xs text-stone-700 cursor-pointer\\\">\\n                    <input\\n                      type=\\\"checkbox\\\"\\n                      checked={museum.isOpenByCode}\\n                      onChange={(e) => onToggleOpenByCode(e.target.checked)}\\n                      className=\\\"accent-[#8A5A2B] w-4 h-4\\\"\\n                    />\\n                    Allow code entry\\n                  </label>\\n                )}\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleCopyCode}\\n                  className=\\\"inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#1C1917] text-[#F7F5F0] text-xs font-medium hover:bg-stone-800 transition-colors cursor-pointer\\\"\\n                >\\n                  {copied ? <Check className=\\\"w-3.5 h-3.5\\\" /> : <Copy className=\\\"w-3.5 h-3.5\\\" />}\\n                  {copied ? \'Copied\' : \'Copy Code\'}\\n                </button>\\n              </div>\\n            </div>\\n\\n            {/* Grant Direct Email Access Form */}\\n            {isOwner && (\\n              <form onSubmit={handleGrantSubmit} className=\\\"space-y-4\\\" noValidate>\\n                <div className=\\\"flex items-center gap-2 text-sm font-semibold text-stone-900\\\">\\n                  <UserPlus className=\\\"w-4 h-4 text-[#8A5A2B]\\\" />\\n                  <span>Invite Visitor by Email</span>\\n                </div>\\n                <p className=\\\"text-xs text-stone-600 leading-relaxed\\\">\\n                  Invited visitors enter with their customized 3D Man or Woman avatar and walk through your curated walls alongside you.\\n                </p>\\n\\n                {errors.form && (\\n                  <p className=\\\"text-xs text-red-700\\\" role=\\\"alert\\\">\\n                    {errors.form}\\n                  </p>\\n                )}\\n\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n                  <div>\\n                    <label htmlFor=\\\"grant-name\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                      Visitor Name\\n                    </label>\\n                    <input\\n                      id=\\\"grant-name\\\"\\n                      type=\\\"text\\\"\\n                      value={displayName}\\n                      onChange={(e) => setDisplayName(e.target.value)}\\n                      placeholder=\\\"e.g., Nadia Rahman\\\"\\n                      className=\\\"w-full px-3 py-2 bg-white border border-stone-300 text-sm focus:outline-none focus:border-[#8A5A2B]\\\"\\n                    />\\n                    {errors.displayName && (\\n                      <p className=\\\"text-xs text-red-700 mt-1\\\" role=\\\"alert\\\">\\n                        {errors.displayName}\\n                      </p>\\n                    )}\\n                  </div>\\n\\n                  <div>\\n                    <label htmlFor=\\\"grant-email\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                      Email Address\\n                    </label>\\n                    <input\\n                      id=\\\"grant-email\\\"\\n                      type=\\\"email\\\"\\n                      value={email}\\n                      onChange={(e) => setEmail(e.target.value)}\\n                      placeholder=\\\"visitor@example.com\\\"\\n                      className=\\\"w-full px-3 py-2 bg-white border border-stone-300 text-sm focus:outline-none focus:border-[#8A5A2B]\\\"\\n                    />\\n                    {errors.email && (\\n                      <p className=\\\"text-xs text-red-700 mt-1\\\" role=\\\"alert\\\">\\n                        {errors.email}\\n                      </p>\\n                    )}\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n                  <div>\\n                    <span className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                      3D Avatar Gender\\n                    </span>\\n                    <div className=\\\"grid grid-cols-2 gap-1.5\\\">\\n                      {([\'man\', \'woman\'] as Gender[]).map((g) => (\\n                        <button\\n                          key={g}\\n                          type=\\\"button\\\"\\n                          onClick={() => setGender(g)}\\n                          className={`py-2 text-xs font-medium border transition-colors cursor-pointer ${\\n                            gender === g\\n                              ? \'border-[#8A5A2B] bg-[#F3ECE2] text-stone-900\'\\n                              : \'border-stone-300 bg-white text-stone-600 hover:border-stone-400\'\\n                          }`}\\n                        >\\n                          {g === \'man\' ? \'Man Model\' : \'Woman Model\'}\\n                        </button>\\n                      ))}\\n                    </div>\\n                  </div>\\n\\n                  <div>\\n                    <span className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                      Permission Level\\n                    </span>\\n                    <div className=\\\"grid grid-cols-2 gap-1.5\\\">\\n                      {([\'visitor\', \'curator\'] as MemberRole[]).map((r) => (\\n                        <button\\n                          key={r}\\n                          type=\\\"button\\\"\\n                          onClick={() => setRole(r)}\\n                          className={`py-2 text-xs font-medium border transition-colors cursor-pointer ${\\n                            role === r\\n                              ? \'border-[#8A5A2B] bg-[#F3ECE2] text-stone-900\'\\n                              : \'border-stone-300 bg-white text-stone-600 hover:border-stone-400\'\\n                          }`}\\n                        >\\n                          {r === \'visitor\' ? \'Visitor (View)\' : \'Co-Curator (Add)\'}\\n                        </button>\\n                      ))}\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={busy}\\n                  className=\\\"w-full py-2.5 bg-[#8A5A2B] text-white text-sm font-medium hover:bg-[#734922] disabled:opacity-50 transition-colors cursor-pointer\\\"\\n                >\\n                  {busy ? \'Granting Access...\' : \'Grant Museum Access\'}\\n                </button>\\n              </form>\\n            )}\\n\\n            {/* Granted Visitors Roster */}\\n            <div className=\\\"pt-4 border-t border-stone-200 space-y-3\\\">\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                <div className=\\\"flex items-center gap-2 text-sm font-semibold text-stone-900\\\">\\n                  <Users className=\\\"w-4 h-4 text-[#8A5A2B]\\\" />\\n                  <span>Authorized Visitors ({members.length})</span>\\n                </div>\\n                <label className=\\\"inline-flex items-center gap-2 text-xs text-stone-700 cursor-pointer\\\">\\n                  <input\\n                    type=\\\"checkbox\\\"\\n                    checked={showInvitedIn3D}\\n                    onChange={(e) => onToggleShowInvitedIn3D(e.target.checked)}\\n                    className=\\\"accent-[#8A5A2B] w-4 h-4\\\"\\n                  />\\n                  Show invited avatars in 3D hall\\n                </label>\\n              </div>\\n\\n              {members.length === 0 ? (\\n                <p className=\\\"text-xs text-stone-500 py-3\\\">\\n                  No visitors invited yet. Invite someone above or share your access code so two people can explore together.\\n                </p>\\n              ) : (\\n                <ul className=\\\"divide-y divide-stone-200 border border-stone-200 bg-white\\\" data-testid=\\\"members-list\\\">\\n                  {members.map((m) => (\\n                    <li key={m.id} className=\\\"px-4 py-3 flex items-center justify-between gap-3\\\">\\n                      <div className=\\\"min-w-0\\\">\\n                        <p className=\\\"text-sm font-medium text-stone-900 truncate\\\">\\n                          {m.displayName}\\n                        </p>\\n                        <p className=\\\"text-xs text-stone-500 truncate\\\">\\n                          {m.email} \302\267 {m.gender === \'woman\' ? \'Woman 3D Avatar\' : \'Man 3D Avatar\'} \302\267{\' \'}\\n                          {m.role === \'curator\' ? \'Co-Curator\' : \'Visitor\'}\\n                        </p>\\n                      </div>\\n                      {isOwner && (\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => onRevokeAccess(m)}\\n                          aria-label={`Revoke access for ${m.displayName}`}\\n                          className=\\\"p-1.5 text-stone-400 hover:text-red-700 transition-colors cursor-pointer shrink-0\\\"\\n                        >\\n                          <Trash2 className=\\\"w-4 h-4\\\" />\\n                        </button>\\n                      )}\\n                    </li>\\n                  ))}\\n                </ul>\\n              )}\\n            </div>\\n          </div>\\n        ) : (\\n          <div className=\\\"p-6 space-y-6\\\">\\n            <form onSubmit={handleJoinSubmit} className=\\\"space-y-3\\\" noValidate>\\n              <label htmlFor=\\\"join-code\\\" className=\\\"block text-sm font-medium text-stone-900\\\">\\n                Enter a Friend&apos;s Museum Access Code\\n              </label>\\n              <div className=\\\"flex gap-2\\\">\\n                <div className=\\\"relative flex-1\\\">\\n                  <KeyRound className=\\\"w-4 h-4 text-stone-400 absolute left-3 top-1/2 -translate-y-1/2\\\" />\\n                  <input\\n                    id=\\\"join-code\\\"\\n                    type=\\\"text\\\"\\n                    value={joinCode}\\n                    onChange={(e) => setJoinCode(e.target.value.toUpperCase())}\\n                    placeholder=\\\"MUS-742A\\\"\\n                    className=\\\"w-full pl-9 pr-3 py-2 bg-white border border-stone-300 text-sm font-mono uppercase tracking-wider focus:outline-none focus:border-[#8A5A2B]\\\"\\n                  />\\n                </div>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={busy}\\n                  className=\\\"px-4 py-2 bg-[#1C1917] text-[#F7F5F0] text-sm font-medium hover:bg-stone-800 disabled:opacity-50 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  Enter Gallery\\n                </button>\\n              </div>\\n              {joinError && (\\n                <p className=\\\"text-xs text-red-700\\\" role=\\\"alert\\\">\\n                  {joinError}\\n                </p>\\n              )}\\n            </form>\\n\\n            <div className=\\\"pt-4 border-t border-stone-200 space-y-3\\\">\\n              <p className=\\\"text-sm font-semibold text-stone-900\\\">\\n                Your Museums & Shared Invitations\\n              </p>\\n              <div className=\\\"space-y-2\\\">\\n                {accessibleMuseums.map((m) => {\\n                  const active = m.id === museum.id;\\n                  return (\\n                    <button\\n                      key={m.id}\\n                      type=\\\"button\\\"\\n                      onClick={() => {\\n                        onSwitchMuseum(m.id);\\n                        onClose();\\n                      }}\\n                      className={`w-full text-left p-4 border transition-colors cursor-pointer flex items-center justify-between gap-3 ${\\n                        active\\n                          ? \'border-[#8A5A2B] bg-[#F3ECE2]\'\\n                          : \'border-stone-200 bg-white hover:border-stone-400\'\\n                      }`}\\n                    >\\n                      <div className=\\\"min-w-0\\\">\\n                        <p className=\\\"font-editorial text-lg font-semibold text-stone-900 truncate\\\">\\n                          {m.title}\\n                        </p>\\n                        <p className=\\\"text-xs text-stone-500\\\">\\n                          Curated by {m.ownerName} \302\267 Code {m.accessCode}\\n                        </p>\\n                      </div>\\n                      <span className=\\\"text-xs font-medium text-[#8A5A2B] shrink-0\\\">\\n                        {active ? \'Active\' : \'Visit\'}\\n                      </span>\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create AccessModal for granting visitor/curator access by email, sharing access codes, and switching museums\", \"Overwrite\":true, \"TargetFile\":\"/src/components/AccessModal.tsx\", \"toolAction\":\"Creating AccessModal component\", \"toolSummary\":\"Create AccessModal.tsx\"}"
      thinking_signature: "\022\241\016\n\236\016\001i\024}\023\306J\341!/c.\340B*\\\262\263\265\220\253\023\221<\224\212\a\346\324\f\274g\270we&\376\367\f`V\263(YI\360\207,=\277\213\226\322R\256\261i\177\032\271\222A\'\305\323\322,c\201\035h\206\003\311\231\246\220]2\336\375\320\233j\026\t0\211\201\"\344\037\022\355|3\b0\235\267\355\212,\356D!l\215B\3245\347\341\342\250v(\261i \372\354\261\234u\205\350\276\265\350\263QXd\323L\"\017UTY\002\002z\301\222m\035\340gW.\272\321\205\375q,\210\021\310\371\246G9\214g?\375\000\312\344*B\2372G\r6{\327n\202\302\275\357\022\226h\260\0257\274]q4wt\301c\261\231\227\345\366I*b\032\222\314\005\t\254(7\347\242\2727\004\bo\025s\"\372\244q\275=|-\274\004\f\r\025\332\275?\222\275\006\245\330\203.2\316\325\211\026W\230\3379\206\357\236QL\230\204\376\310XK\030\377]B\2616\a#e^~\233\333\234\265\r\376\203\203\225\300\307<\256K\033\333\027\2049\350\215\023\030\264\222\231\305~\221\217\021\210\237\roO\202\236\375\311r%j\357FQ\376ba-\vx\\\352\241\323\032\256/&\316\225\0338ove\346(S\006\027u\r=IQ\204:O\200lA\375\006\225\004\204\230\276\031r=\r\307\224\f\036\202h\333\337\222X*\210\312\243bp\006\217$\322\340\272\266;D\222H\347\334\307\023\316\253#\274h=OO<\f\250o\210\260i\210\177\360m\305\274\026w\275\2018\223b!\321\205\271m\t-3\364\374\017\257\f\325\235\352\325\274H\016\374U\236I\003\263\350~\202z\002s)\366,!s@T\327\031.\v\002\245to}\002\\\"\251S)\026g(\222JH\035\317\201\031@\r\001s\235\217\025\224\222\036\027/-\225L\226\230\317\242\325\2409\304\363\036\362\360(y\017\367\024\257=\270\352L\222\223\255+\301~$\337\273y\333\342\337\3500\322\204\340\252\321\025\244\327;\300{\'7\231\344B\371\312N\307\332G\363k\343gx\335\262\204$\t\2255\354\267\305\034fWr\'A\034\243\315\212k\2575\"y\305\377\266\364O\331y\265qS\330\212\243\267\'\t\251\307\004t\336_@7uX\316\361U\320l8\253\242\300\033\217\245\tr\002\177c]\016\300\227\273\036UI\031y\266\'d\277\365_W\3462.V\366\366\231\264\271\002\235\035X\206\205$\203\367\245q\306P\035\272\340\305\346\236`\315\244\374\222\035.\345\304t\243\347m\031:\243\370\360F\346\332%\231{\266\003\267\370\033C\031o\363\206\372l_.!>\307 \332\001\300\324\333\301\302/\342\327d\310\315\323\271\261_D7]x\220\035\004\304\356>+\036[a\375\317\310`\332I\204\255\222l\200S\332\227\346|\037RB\221\345.\352[\r\321\332\220|\020=\235\bt\324r\311\247e\371\304?K\235\036{\026\252z6;(\273\t{\032:wS%\276\031\022\tD\302.B\b\253\204X\016\372\271\034-21L\020\316\266\256\"\257 \2568\231\201\237\260\212L\231\314\310K3X\370\320P,\374\366\a\202\243\261\000)\226\350\243i\215$G\273\204A\275\032\245!\204Q\177\311g\305+\303\357\002\f\330\032?H\036\257\246\254\370k\001\245\027\316g\242\335\r\206\343\032\337\031\330\313\270\241\262\275\026F\a\255K\244\252*\251\332\351\311\205\377[\224\211\214Mw\030\325G\030\274_{5\245\a\00488\306\370\346Y\037\226j\223\267\207\360\223\312(\317\372\352k]\251\036Q\031\253j\342\212X\331+\231\t\367\264\022\216\225\367\330DH<\305\225\261\305:w\307\276\r\325\006\333\0003G\356\267\034\0059\220\t.7\323\305\213\372`[\254\016J\245\020}\226\016\260\275moz\301\210\370L\371H\003\253\264\0366\356\234$\362\021v\'\241\217Tv\2422d\205\263#\260\343\254\364\225#\310=!r\237\374\362+$a\334y*\236\375\tR\343\215\352O=e\340(\364\004\242\205!J\3333T\311I+\212\361*\302/%\373\305\t\241\204\216\2668\317q\211\273{\263\344\"U\332}\354\325\tFz\231m\341A\312\242\306\204\231+\214\275\220\025\213\264\275\361\203\217\310\r\230\345T\265@\177\271\343%b\272\f0\244\212\272\245\177 0PifQ\353\233tDp\222f&\2750\225\016\311\v\001\211N\334\343\333\271t\304\2062\372\312\271\341#\2670\323\246\331\207\232\033\300\270\376\334hg%\264O\346\fUr%\223\376\033\272\244\265\223\347\305\\7$S\3531\337h\021}\265j\222\200\271-Y\222]\311L_\022Ev\n\021\004\343\211q}\374\027\251n\335NS\\\235\034u\363\006\247\371f\312VvK\220\230\277\256\030\276\236\325\357\005\215\354\3556\006c\352\217\b\022\242\215\230T\023\344\260\300;\265\376\016CG\270\275<p%\316:Ij\341\3777\241\024<wJ\006N\365\206\026\020A\344\344gE\331\000\322]\325hO\215\331\340f\240k\234\364\201\363\"\234\233\325~\362)\264%a\225\310\206Z\274\327\000\340\352\242\253SH\264\030\256\204\341\335\022\326\314jik\247\261\243\274\002\310\347\256J\006\275u\245 9\300\324\022\210\200%\v\315H\"\355\306lv\213\315`\203F_\270\266\346\274\0051\036Z\336\203_\314A\270\305\223\263\210y\251\003\362\310I\215pfX+\342\363\265\036\315\230]\356G\212\\\251\250\266\236\353E\246\023\317\364-\035\271\317JvA.a-<\205\207\316X\350\334p\354\201?\002\260\263C\n\236}8fL\304\003ww/\023\023\357\213\376\'18\322\v\306\270CO\376\226!\331\037\244\025\f\024\035\325m\376(+\225\266qgv\240N\332\021/\306\215\370\243M.\2004\365a\004\252\264i\372\334\"\255G\240\322V\200\305\345o\227\ve\204WWE\371\006\f\373\"Sk_\325\334\224\003]Eq\273\004\231\335F\240\335\344\231\310w3)\264\237\030\206\004\233y\310\225\322\227\260A\201\360t\203,a\2150\214h\223\337V`\324q\347eE\377b_\253\300\371]\311\022\034\267L\324\027U\345\2713\212\304\350\036x\200]BE\021\303Y\252$\226\361\376? \234\025\003\0208H\241B\250\340\272\223\337\236Tu`\000\303a)\177(T\377\3321\244\351\361\212\255\246!\003\237zX\331\276\234\260,\023\337\362\352\'\270\323\252\230b\360\344\205e\253^\2262\213\370\aH\206l\324\335*\237>E\375K\n$\313,N8\266\020\223\245c\356\223\255\001\000\023\"\f\000\227\364\316\324Z\251\v\346\275<\264C\360b\231\315\006"
