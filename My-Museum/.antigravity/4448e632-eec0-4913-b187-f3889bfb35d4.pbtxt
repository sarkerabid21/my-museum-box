            }
            lines {
              text: "      leaf.scale.set(1.3, 0.35, 0.75);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      leaf.position.set(tipX * 0.72, vaseBaseY + 1.32 + (i % 2) * 0.15, tipZ * 0.72);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
