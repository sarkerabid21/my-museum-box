              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export async function sendMuseumInvitationEmail("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  accessToken: string,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
