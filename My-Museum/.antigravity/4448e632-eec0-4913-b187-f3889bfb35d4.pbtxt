      arguments_json: "{\"Description\":\"Throttle minimap HUD sync slightly and prevent top-left active/standing count from truncating on desktop\", \"Instruction\":\"Throttle HUD updates to 280ms and make top-left subtitle concise so Active & Standing counts display cleanly without ellipsis\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":992, \"ReplacementContent\":\"      // Throttled HUD room, zone, minimap, door & nearby vehicle indicator (~3.5Hz)\\n      if (nowMs - lastHudCheck > 280) {\", \"StartLine\":978, \"TargetContent\":\"      // Throttled HUD room, zone, minimap, door & nearby vehicle indicator (~5.5Hz)\\n      if (nowMs - lastHudCheck > 180) {\"}, {\"AllowMultiple\":false, \"EndLine\":1398, \"ReplacementContent\":\"            <p className=\\\"text-xs text-stone-300 font-mono tabular-nums mt-0.5 truncate\\\">\\n              {artworks.length}/{layout.totalWallSlots} Walls \302\267 {activeCompanionCount + 1} Active\\n              {companionVisitors.length > activeCompanionCount\\n                ? ` \302\267 ${companionVisitors.length - activeCompanionCount} Standing`\\n                : \'\'}\\n            </p>\", \"StartLine\":1380, \"TargetContent\":\"            <p className=\\\"text-xs text-stone-300 font-mono tabular-nums mt-0.5 truncate\\\">\\n              {museum.title} \302\267 {artworks.length}/{layout.totalWallSlots} Walls \302\267{\' \'}\\n              {activeCompanionCount + 1} Active\\n              {companionVisitors.length > activeCompanionCount\\n                ? ` \302\267 ${companionVisitors.length - activeCompanionCount} Standing`\\n                : \'\'}\\n            </p>\"}], \"TargetFile\":\"/src/components/Museum3DView.tsx\", \"toolAction\":\"Optimizing HUD throttle and placard typography\", \"toolSummary\":\"Refine Museum3DView HUD\"}"
