            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function buildStreetLampPost("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  x: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  z: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  facingRoadSign: 1 | -1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  trackGeo: <T extends THREE.BufferGeometry>(g: T) => T,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  poleMat: THREE.Material,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  glowMat: THREE.Material"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): THREE.Group {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const grp = new THREE.Group();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  grp.position.set(x, 0.14, z);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Stepped cast-iron plinth"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const base = new THREE.Mesh(trackGeo(new THREE.CylinderGeometry(0.16, 0.24, 0.55, 10)), poleMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  base.position.y = 0.275;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  grp.add(base);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Tapered main shaft"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const shaft = new THREE.Mesh(trackGeo(new THREE.CylinderGeometry(0.065, 0.11, 5.2, 10)), poleMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  shaft.position.y = 3.1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  grp.add(shaft);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Decorative collar ring"
