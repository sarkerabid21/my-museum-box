            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Smoothly animates walking stride or gentle idle breathing without allocating garbage."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "export function animateAvatarRig("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  rig: AvatarRig,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  speed: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  elapsed: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  delta: number"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "): void {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const isMoving = speed > 0.08;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const clampedDelta = Math.min(delta, 0.1);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const damping = 1 - Math.exp(-10 * clampedDelta);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (rig.isCustomGlb) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (rig.mixer) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      rig.mixer.update(isMoving ? clampedDelta * Math.max(0.85, speed * 0.32) : 0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (isMoving) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      rig.stridePhase += clampedDelta * Math.min(11, 5.5 + speed * 1.15);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const bob = Math.abs(Math.cos(rig.stridePhase)) * (rig.mixer ? 0.018 : 0.048);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const swayZ = Math.sin(rig.stridePhase) * (rig.mixer ? 0.018 : 0.042);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const leanX = rig.mixer ? 0.02 : 0.05;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      rig.bodyGroup.position.y += (bob - rig.bodyGroup.position.y) * damping;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      rig.bodyGroup.rotation.z += (swayZ - rig.bodyGroup.rotation.z) * damping;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      rig.bodyGroup.rotation.x += (leanX - rig.bodyGroup.rotation.x) * damping;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
