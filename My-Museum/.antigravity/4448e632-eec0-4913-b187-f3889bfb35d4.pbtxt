    content: "  artist: string,\n  dateCaptured: string,\n  accession: string,\n  maxAnisotropy: number\n): THREE.CanvasTexture {\n  const w = 512;\n  const h = 256;\n  const canvas = document.createElement(\'canvas\');\n  canvas.width = w;\n  canvas.height = h;\n  const ctx = canvas.getContext(\'2d\')!;\n\n  ctx.fillStyle = \'#FAF8F4\';\n  ctx.fillRect(0, 0, w, h);\n\n  ctx.strokeStyle = \'#C9BFA9\';\n  ctx.lineWidth = 4;\n  ctx.strokeRect(8, 8, w - 16, h - 16);\n\n  ctx.fillStyle = \'#8A5A2B\';\n  ctx.font = \'600 18px \"JetBrains Mono\", monospace\';\n  ctx.fillText(accession, 28, 46);\n\n  ctx.fillStyle = \'#1C1917\';\n  ctx.font = \'600 32px Georgia, serif\';\n  const cleanTitle = title.length > 26 ? `${title.slice(0, 25)}\342\200\246` : title;\n  ctx.fillText(cleanTitle, 28, 102);\n\n  ctx.fillStyle = \'#57534E\';\n  ctx.font = \'500 24px sans-serif\';\n  const cleanArtist = artist.length > 30 ? `${artist.slice(0, 29)}\342\200\246` : artist;\n  ctx.fillText(cleanArtist, 28, 152);\n\n  ctx.fillStyle = \'#78716C\';\n  ctx.font = \'400 20px sans-serif\';\n  ctx.fillText(formatArchivalDate(dateCaptured), 28, 206);\n\n  const texture = new THREE.CanvasTexture(canvas);\n  texture.colorSpace = THREE.SRGBColorSpace;\n  texture.anisotropy = maxAnisotropy;\n  return texture;\n}\n\nexport function createNameplateTexture(\n  displayName: string,\n  genderLabel: string\n): THREE.CanvasTexture {\n  const w = 384;\n  const h = 96;\n  const canvas = document.createElement(\'canvas\');\n  canvas.width = w;\n  canvas.height = h;\n  const ctx = canvas.getContext(\'2d\')!;\n\n  ctx.clearRect(0, 0, w, h);\n\n  // Clean museum obsidian label bar (sharp architectural corners)\n  ctx.fillStyle = \'rgba(24, 21, 18, 0.88)\';\n  ctx.fillRect(16, 12, w - 32, h - 24);\n  ctx.strokeStyle = \'rgba(201, 154, 91, 0.72)\';\n  ctx.lineWidth = 2;\n  ctx.strokeRect(16, 12, w - 32, h - 24);\n\n  ctx.textAlign = \'center\';\n  ctx.fillStyle = \'#F7F4EE\';\n  ctx.font = \'600 24px \"Plus Jakarta Sans\", sans-serif\';\n  const name = displayName.length > 18 ? `${displayName.slice(0, 17)}\342\200\246` : displayName;\n  ctx.fillText(name, w / 2, 47);\n\n  ctx.fillStyle = \'#D4B282\';\n  ctx.font = \'500 15px \"JetBrains Mono\", monospace\';\n  ctx.fillText(genderLabel.toUpperCase(), w / 2, 70);\n\n  const texture = new THREE.CanvasTexture(canvas);\n  texture.colorSpace = THREE.SRGBColorSpace;\n  return texture;\n}\n\nexport function createFallbackArtworkTexture(title: string): THREE.CanvasTexture {\n  const w = 512;\n  const h = 384;\n  const canvas = document.createElement(\'canvas\');\n  canvas.width = w;\n  canvas.height = h;\n  const ctx = canvas.getContext(\'2d\')!;\n\n  const grad = ctx.createLinearGradient(0, 0, w, h);\n  grad.addColorStop(0, \'#E8E2D6\');\n  grad.addColorStop(1, \'#CFC5B4\');\n  ctx.fillStyle = grad;\n  ctx.fillRect(0, 0, w, h);\n\n  ctx.strokeStyle = \'#8A5A2B\';\n  ctx.lineWidth = 3;\n  ctx.strokeRect(24, 24, w - 48, h - 48);\n\n  ctx.fillStyle = \'#292524\';\n  ctx.textAlign = \'center\';\n  ctx.font = \'600 28px Georgia, serif\';\n  ctx.fillText(title.slice(0, 26), w / 2, h / 2);\n\n  const texture = new THREE.CanvasTexture(canvas);\n  texture.colorSpace = THREE.SRGBColorSpace;\n  return texture;\n}\n\nexport function createDoorSignboardTexture(\n  roomNumberLabel: string,\n  roomName: string,\n  hintText: string,\n  maxAnisotropy: number\n): THREE.CanvasTexture {\n  const w = 1024;\n  const h = 256;\n  const canvas = document.createElement(\'canvas\');\n  canvas.width = w;\n  canvas.height = h;\n  const ctx = canvas.getContext(\'2d\')!;\n\n  // Rich architectural dark walnut & obsidian signboard background\n  const grad = ctx.createLinearGradient(0, 0, 0, h);"
