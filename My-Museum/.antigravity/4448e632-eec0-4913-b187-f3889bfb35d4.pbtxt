          target_content: "import { DEFAULT_AVATAR_BY_GENDER } from \'../types/museum\';\nimport {\n  calculateMuseumLayout,\n  clampPlayerPosition,\n  findNearbyDoor,\n  getArtworkPlacement,\n  getDoorId,\n  getResolvedRoomName,\n  getRoomIndexAtZ,\n  toRomanNumeral,\n  type DoorDefinition,\n  type MuseumLayout,\n} from \'../museum/layout\';\nimport {\n  animateAvatarRig,\n  buildAvatarRig,\n  buildCustomGlbAvatarRig,\n  type AvatarRig,\n} from \'../three/avatarBuilder\';\nimport { buildMuseumArchitecture, type BuiltMuseum, type DoorRig } from \'../three/museumBuilder\';\nimport { createAfterDrawScheduler, detectSoftwareGl } from \'../three/webglUtils\';\n\ninterface Museum3DViewProps {\n  museum: MuseumMeta;\n  avatar: AvatarConfig;\n  customGlbBuffer?: ArrayBuffer | null;\n  artworks: ArtworkItem[];\n  members: MuseumMember[];\n  liveVisitors: VisitorPresence[];\n  showInvitedIn3D: boolean;\n  canCurate: boolean;\n  canRenameRooms: boolean;\n  teleportTargetId: string | null;\n  onClearTeleport: () => void;\n  onSelectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\n  onRequestRenameRoom: (roomIndex: number) => void;\n  onNotify?: (msg: string) => void;\n  onOpenCatalog: () => void;\n  onOpenUpload: () => void;\n  onOpenAccess: () => void;\n  onReturnHome: () => void;\n  onChangeWallTheme: (theme: WallTheme) => void;\n  onPositionBroadcast?: (x: number, z: number, yaw: number) => void;\n  isPaused?: boolean;\n}"
          replacement_content: "import {\n  calculateMuseumLayout,\n  clampPlayerPosition,\n  findNearbyDoor,\n  getArtworkPlacement,\n  getDoorId,\n  getResolvedRoomName,\n  getRoomIndexAtZ,\n  toRomanNumeral,\n  type DoorDefinition,\n  type MuseumLayout,\n} from \'../museum/layout\';\nimport {\n  normalizeAngle,\n  shortestAngleDelta,\n  stepPlayerSteering,\n} from \'../museum/cameraSteering\';\nimport {\n  resolveMuseumCompanionAvatars,\n  type CompanionAvatarEntry,\n} from \'../museum/trustedCircle\';\nimport {\n  animateAvatarRig,\n  buildAvatarRig,\n  buildCustomGlbAvatarRig,\n  type AvatarRig,\n} from \'../three/avatarBuilder\';\nimport { buildMuseumArchitecture, type BuiltMuseum, type DoorRig } from \'../three/museumBuilder\';\nimport { createAfterDrawScheduler, detectSoftwareGl } from \'../three/webglUtils\';\n\ninterface Museum3DViewProps {\n  museum: MuseumMeta;\n  avatar: AvatarConfig;\n  selfUid?: string | null;\n  selfEmail?: string | null;\n  customGlbBuffer?: ArrayBuffer | null;\n  artworks: ArtworkItem[];\n  members: MuseumMember[];\n  liveVisitors: VisitorPresence[];\n  showInvitedIn3D: boolean;\n  canCurate: boolean;\n  canRenameRooms: boolean;\n  teleportTargetId: string | null;\n  onClearTeleport: () => void;\n  onSelectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\n  onRequestRenameRoom: (roomIndex: number) => void;\n  onNotify?: (msg: string) => void;\n  onOpenCatalog: () => void;\n  onOpenUpload: () => void;\n  onOpenAccess: () => void;\n  onReturnHome: () => void;\n  onChangeWallTheme: (theme: WallTheme) => void;\n  onPositionBroadcast?: (x: number, z: number, yaw: number) => void;\n  onPresenceOffline?: (x: number, z: number, yaw: number) => void;\n  isPaused?: boolean;\n}"
