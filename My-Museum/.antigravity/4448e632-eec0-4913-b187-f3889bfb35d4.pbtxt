      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add RoomShape type and optional roomNames map to MuseumMeta\", \"EndLine\":35, \"Instruction\":\"Add RoomShape type and roomNames field to MuseumMeta\", \"ReplacementContent\":\"export type DateSortOrder = \'newest\' | \'oldest\';\\nexport type RoomShape = \'rotunda\' | \'atrium\' | \'salon\' | \'pavilion\';\\n\\nexport interface AvatarConfig {\\n  displayName: string;\\n  gender: Gender;\\n  skinTone: string;\\n  hairStyle: string;\\n  hairColor: string;\\n  outfitStyle: string;\\n  outfitColor: string;\\n  accentColor: string;\\n  accessory: AccessoryType;\\n}\\n\\nexport interface MuseumMeta {\\n  id: string;\\n  ownerId: string;\\n  ownerName: string;\\n  title: string;\\n  description: string;\\n  accessCode: string;\\n  wallTheme: WallTheme;\\n  isOpenByCode: boolean;\\n  memberEmails: string[];\\n  curatorEmails: string[];\\n  artworkCount: number;\\n  roomNames?: Record<string, string>;\\n  createdAt?: string;\\n}\", \"StartLine\":7, \"TargetContent\":\"export type DateSortOrder = \'newest\' | \'oldest\';\\n\\nexport interface AvatarConfig {\\n  displayName: string;\\n  gender: Gender;\\n  skinTone: string;\\n  hairStyle: string;\\n  hairColor: string;\\n  outfitStyle: string;\\n  outfitColor: string;\\n  accentColor: string;\\n  accessory: AccessoryType;\\n}\\n\\nexport interface MuseumMeta {\\n  id: string;\\n  ownerId: string;\\n  ownerName: string;\\n  title: string;\\n  description: string;\\n  accessCode: string;\\n  wallTheme: WallTheme;\\n  isOpenByCode: boolean;\\n  memberEmails: string[];\\n  curatorEmails: string[];\\n  artworkCount: number;\\n  createdAt?: string;\\n}\", \"TargetFile\":\"/src/types/museum.ts\", \"toolAction\":\"Updating museum types\", \"toolSummary\":\"Update types/museum.ts\"}"
