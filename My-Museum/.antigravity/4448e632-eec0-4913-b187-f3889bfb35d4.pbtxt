            }
            lines {
              text: "        camera.position.lerp(_camDesired, camDamp);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _camLook.set("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ps.x - Math.sin(ps.camYaw) * 6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          1.66 - Math.sin(ps.camPitch) * 3.5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ps.z - Math.cos(ps.camYaw) * 6"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        camera.lookAt(_camLook);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const dist = 4.35;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const desiredX = ps.x + Math.sin(ps.camYaw) * dist;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const desiredZ = ps.z + Math.cos(ps.camYaw) * dist;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const clampedCam = clampPlayerPosition(desiredX, desiredZ, curLayout);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const desiredY = 2.15 + Math.sin(ps.camPitch) * 1.4;"
