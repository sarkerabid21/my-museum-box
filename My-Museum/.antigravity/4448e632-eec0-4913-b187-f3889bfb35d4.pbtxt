            }
            lines {
              text: "    doorRig = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      id: doorId,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
