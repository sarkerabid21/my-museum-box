            }
            lines {
              text: "  const isMoving = speed > 0.08;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const damping = 1 - Math.exp(-10 * Math.min(delta, 0.1));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (isMoving) {"
