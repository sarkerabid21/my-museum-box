            }
            lines {
              text: "      const tipX = Math.cos(angle) * spread;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const tipZ = Math.sin(angle) * spread;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const tipY = vaseBaseY + 1.18 + h;"
