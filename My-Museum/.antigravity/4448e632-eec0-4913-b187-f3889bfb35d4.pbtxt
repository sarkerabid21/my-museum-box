          target_content: "// Reusable scratch vectors allocated outside render loop (zero GC)\nconst _camDesired = new THREE.Vector3();\nconst _camLook = new THREE.Vector3();\n\nconst THEME_FOG_COLOR: Record<WallTheme, number> = {\n  alabaster: 0xeae4da,\n  travertine: 0xdfd5c7,\n  charcoal: 0x1e1c1a,\n};\n\ninterface HoverPrompt {\n  kind: \'artwork\' | \'door\' | \'signboard\' | \'expansion\';\n  label: string;\n}"
