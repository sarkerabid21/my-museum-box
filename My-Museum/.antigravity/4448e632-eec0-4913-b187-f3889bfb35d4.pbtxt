              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function projectWorldToMinimap("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  x: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
