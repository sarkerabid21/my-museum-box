  code_action {
    action_spec {
      command {
        instruction: "Import EXIT_DOOR_ID, remove solid southEndWall so the exit door opens cleanly to the outdoor world, make southPortal an interactive hinged doorway pushed into doors[], and label its interior signboard clearly"
        is_edit: true
        file {
          absolute_uri: "file:///src/three/museumBuilder.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "import {\n  createDoorSignboardTexture,\n  createFallbackArtworkTexture,\n  createMarbleFloorTextures,\n  createPlaqueTexture,\n  createPlasterWallTexture,\n} from \'./proceduralTextures\';"
          replacement_content: "import {\n  createDoorSignboardTexture,\n  createFallbackArtworkTexture,\n  createMarbleFloorTextures,\n  createPlaqueTexture,\n  createPlasterWallTexture,\n} from \'./proceduralTextures\';\nimport { EXIT_DOOR_ID } from \'../museum/outdoorWorld\';"
          start_line: 17
          end_line: 25
        }
        replacement_chunks {
          target_content: "    const signTex = trackTex(\n      createDoorSignboardTexture(\n        `Room ${toRomanNumeral(spec.roomIndex + 1)}`,\n        spec.roomName,\n        spec.hint,\n        maxAnisotropy\n      )\n    );\n    const signPlane = new THREE.Mesh(\n      trackGeo(new THREE.PlaneGeometry(signW, signH)),\n      trackMat(\n        new THREE.MeshStandardMaterial({\n          color: 0xffffff,\n          map: signTex,\n          emissive: new THREE.Color(0xffffff),\n          emissiveMap: signTex,\n          emissiveIntensity: 0.35,\n          roughness: 0.88,\n          metalness: 0.0,\n        })\n      )\n    );\n    signPlane.position.set(0, signY, signZ + (facing === \'south\' ? 0.025 : -0.025));\n    signPlane.rotation.y = rotY;\n    signPlane.userData.renameRoomIndex = spec.roomIndex;\n    signPlane.userData.renameRoomName = spec.roomName;\n    grp.add(signPlane);\n    interactables.push(signPlane);"
          replacement_content: "    const signTex = trackTex(\n      createDoorSignboardTexture(\n        spec.roomIndex < 0 ? \'OUTDOOR EXIT\' : `Room ${toRomanNumeral(spec.roomIndex + 1)}`,\n        spec.roomName,\n        spec.hint,\n        maxAnisotropy\n      )\n    );\n    const signPlane = new THREE.Mesh(\n      trackGeo(new THREE.PlaneGeometry(signW, signH)),\n      trackMat(\n        new THREE.MeshStandardMaterial({\n          color: 0xffffff,\n          map: signTex,\n          emissive: new THREE.Color(0xffffff),\n          emissiveMap: signTex,\n          emissiveIntensity: 0.35,\n          roughness: 0.88,\n          metalness: 0.0,\n        })\n      )\n    );\n    signPlane.position.set(0, signY, signZ + (facing === \'south\' ? 0.025 : -0.025));\n    signPlane.rotation.y = rotY;\n    if (spec.roomIndex < 0 && doorId) {\n      signPlane.userData.doorId = doorId;\n    } else {\n      signPlane.userData.renameRoomIndex = spec.roomIndex;\n      signPlane.userData.renameRoomName = spec.roomName;\n    }\n    grp.add(signPlane);\n    interactables.push(signPlane);"
          start_line: 698
          end_line: 730
        }
        replacement_chunks {
          target_content: "  const endWallGeo = trackGeo(new THREE.BoxGeometry(ROOM_WIDTH + 0.84, HALL_HEIGHT, 0.42));\n  const northEndWall = new THREE.Mesh(endWallGeo, wallMat);\n  northEndWall.position.set(0, HALL_HEIGHT / 2, layout.northWallZ - 0.21);\n  northEndWall.receiveShadow = true;\n  group.add(northEndWall);\n\n  const southEndWall = new THREE.Mesh(endWallGeo, wallMat);\n  southEndWall.position.set(0, HALL_HEIGHT / 2, layout.southWallZ + 0.21);\n  southEndWall.receiveShadow = true;\n  group.add(southEndWall);"
          replacement_content: "  const endWallGeo = trackGeo(new THREE.BoxGeometry(ROOM_WIDTH + 0.84, HALL_HEIGHT, 0.42));\n  const northEndWall = new THREE.Mesh(endWallGeo, wallMat);\n  northEndWall.position.set(0, HALL_HEIGHT / 2, layout.northWallZ - 0.21);\n  northEndWall.receiveShadow = true;\n  group.add(northEndWall);"
          start_line: 1124
          end_line: 1138
        }
        replacement_chunks {
          target_content: "  // --- ROOM 1 SOUTH ENTRANCE DOOR + CLICKABLE SIGNBOARD ---\n  const firstRoomName = getResolvedRoomName(0, roomNames);\n  const southPortal = buildDoorwayAssembly({\n    z: layout.southWallZ - 0.08,\n    isInteractivePassage: false,\n    northSign: {\n      roomIndex: 0,\n      roomName: firstRoomName,\n      hint: \'Main Entrance \302\267 Click Sign to Rename Room I\',\n    },\n    wallMat,\n    trimMat,\n    brassMat,\n    maxAnisotropy,\n    trackGeo,\n    trackMat,\n    trackTex,\n    interactables,\n  });\n  group.add(southPortal.group);"
          replacement_content: "  // --- ROOM 1 SOUTH EXIT DOOR TO OUTDOOR GARDEN & REAL-WORLD HIGHWAY ---\n  const firstRoomName = getResolvedRoomName(0, roomNames);\n  const southPortal = buildDoorwayAssembly({\n    z: layout.southWallZ,\n    isInteractivePassage: true,\n    doorId: EXIT_DOOR_ID,\n    fromRoomIndex: 0,\n    toRoomIndex: -1,\n    northSign: {\n      roomIndex: -1,\n      roomName: \'Garden & Highway Exit\',\n      hint: \'Press [F] or Click Door to Step Outside\',\n    },\n    southSign: {\n      roomIndex: 0,\n      roomName: firstRoomName,\n      hint: \'Press [F] or Click Door to Enter Museum\',\n    },\n    wallMat,\n    trimMat,\n    brassMat,\n    maxAnisotropy,\n    trackGeo,\n    trackMat,\n    trackTex,\n    interactables,\n  });\n  group.add(southPortal.group);\n  if (southPortal.doorRig) {\n    doors.push(southPortal.doorRig);\n  }"
          start_line: 1203
          end_line: 1226
        }
      }
    }
