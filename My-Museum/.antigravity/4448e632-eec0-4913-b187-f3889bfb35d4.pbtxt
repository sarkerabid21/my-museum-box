  code_action {
    action_spec {
      command {
        instruction: "Update WorldMinimap sizing, padding, typography, and optional hasCrossHall indicator for mobile responsiveness"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/WorldMinimap.tsx"
