              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      color: state.kind === \'rickshaw\' ? 0x1d4ed8 : state.kind === \'bike\' ? 0x1f2937 : 0xe2e8f0,"
