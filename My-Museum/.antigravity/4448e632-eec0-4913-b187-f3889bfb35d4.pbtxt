      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add safety poll ceiling to afterDraw fenceSync scheduler so software WebGL never stalls or deadlocks\", \"EndLine\":42, \"Instruction\":\"Update createAfterDrawScheduler in src/three/webglUtils.ts with a bounded poll count\", \"ReplacementContent\":\"export function createAfterDrawScheduler(\\n  renderer: THREE.WebGLRenderer,\\n  getTimerSetter: (id: number) => void\\n): (cb: () => void) => void {\\n  return (cb: () => void) => {\\n    const gl = renderer.getContext() as WebGL2RenderingContext;\\n    if (typeof gl.fenceSync !== \'function\') {\\n      getTimerSetter(window.setTimeout(cb, 80));\\n      return;\\n    }\\n    const sync = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0);\\n    gl.flush();\\n    let polls = 0;\\n    const poll = () => {\\n      polls++;\\n      const state = sync ? gl.getSyncParameter(sync, gl.SYNC_STATUS) : gl.SIGNALED;\\n      if (state === gl.UNSIGNALED && polls < 40) {\\n        getTimerSetter(window.setTimeout(poll, 5));\\n      } else {\\n        if (sync) gl.deleteSync(sync);\\n        getTimerSetter(window.setTimeout(cb, 80));\\n      }\\n    };\\n    getTimerSetter(window.setTimeout(poll, 5));\\n  };\\n}\", \"StartLine\":18, \"TargetContent\":\"export function createAfterDrawScheduler(\\n  renderer: THREE.WebGLRenderer,\\n  getTimerSetter: (id: number) => void\\n): (cb: () => void) => void {\\n  return (cb: () => void) => {\\n    const gl = renderer.getContext() as WebGL2RenderingContext;\\n    if (typeof gl.fenceSync !== \'function\') {\\n      getTimerSetter(window.setTimeout(cb, 80));\\n      return;\\n    }\\n    const sync = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0);\\n    gl.flush();\\n    const poll = () => {\\n      const state = sync ? gl.getSyncParameter(sync, gl.SYNC_STATUS) : gl.SIGNALED;\\n      if (state === gl.UNSIGNALED) {\\n        getTimerSetter(window.setTimeout(poll, 5));\\n      } else {\\n        if (sync) gl.deleteSync(sync);\\n        getTimerSetter(window.setTimeout(cb, 80));\\n      }\\n    };\\n    getTimerSetter(window.setTimeout(poll, 5));\\n  };\\n}\", \"TargetFile\":\"/src/three/webglUtils.ts\", \"toolAction\":\"Hardening afterDraw fenceSync scheduler\", \"toolSummary\":\"Harden afterDraw scheduler\"}"
