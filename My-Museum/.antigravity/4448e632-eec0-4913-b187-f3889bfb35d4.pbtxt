tRoom: await view.getAttribute(\\\"data-current-room\\\"),\n    playerZ: await view.locator(\\\"div\\\").first().getAttribute(\\\"data-player-z\\\"),\n    heading: await page.locator(\\\"h1\\\").innerText(),\n  }));\n}\"\nplaywright-cli screenshot --filename=.playwright-cli/04_room2_atrium.png\n\n# 5. Rename Room II via Rename Room dialog and verify HUD + signboard update\nplaywright-cli run-code \"async page => {\n  await page.getByRole(\\\"button\\\", { name: \\\"Rename Room II\\\" }).click();\n  await page.waitForSelector(\\\"#room-signboard-name\\\");\n  await page.fill(\\\"#room-signboard-name\\\", \\\"Botanical Sanctuary\\\");\n  await page.getByRole(\\\"button\\\", { name: \\\"Save Room Name\\\" }).click();\n  await page.waitForSelector(\\\"#room-signboard-name\\\", { state: \\\"hidden\\\" });\n  await page.waitForTimeout(500);\n  console.log(\\\"RENAMED_ROOM2:\\\", await page.locator(\\\"h1\\\").innerText());\n}\"\nplaywright-cli screenshot --filename=.playwright-cli/05_room2_renamed.png\n\n# 6. Check console errors\nplaywright-cli console error\n\'"
