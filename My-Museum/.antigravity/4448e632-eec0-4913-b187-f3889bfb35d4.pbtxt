      thinking_signature: "\022\334\a\n\331\a\001i\024}\023\312\313\"]\005\b\210)bp\243\212\214Ej\340P\a\260<F\311R\033\223\266\300Q\206\024\201 JD\377!\224\311\204\202a\227b\343\240u\225\355s\377\211\331\2776j\3171\347&\016*k=\3349\2014\273\371\237\270\"\372O\251\321I\320E$\356\022~\276\301\222Un\357\262\332\315\355\261?\260^\002\271\021lj\215\367/Jt\370\316()\306\212\210lv6\233\365 \237\027\365\353\307R[\334\211\255|\234\257\322\340\335O\024`\260\373\352\031\232\203)\025\266+\002\276v\256\251s\020\247>\2672\362U\353\371\213~\351E\305!\270\237\t\344\037\n\263m\312|\355\246#\002\373P\220Lx\0014\204b^\023\364\213\r\302\025W\332\315@\226\031\354\313/-\255\333\204\255\243\313\265$\377F\303d3fj\200M\365\263\037\366\352\227\'\221\373_\271\031L\211\213\213\177C<\223\214\225w\342\265 \240M\006\353\006/\365\332\300w\262S\341\216x\351\261\355\376l\372\024$\243\204\271\3503\223\317\0009\343\243\361\316\004|\036\365[\262\311D\214\321T,\314T\232\313\215\261C\361.\277S\r,\025!\016D\273\\\331Z\366c\224U\240*\366\276\362uAH\364\006?\035\v\271\037\2066\03477\037\315\216\002\305\037Q\377\376\230 G-:\2574Y\276\220\317\024o,x\276\375\341f\b\3500A\360\202\335\020q\264\002\237\261\360\334\254\244d\tN\240r\321]\031\266\263\243T\234\362\255\021`\ng\333=\210\tX\306{\361N\035G\024\3052\366h\277C%\257\346\003u\275\263\256\023D\277\264\375\270x\270\376E\230\021\221\201\023\255\0333\234\232\215\330|0\263\030Cc6g\200\255\230F7\2067\363\037\354E4\361\352#`\347\343\361\371\f\336t\254d\034\266\024[\020\360\006\242\323{\036K\305\000\312a7\0244\242\272\316\235\202y\224\221\022\2462\3322\254(K\346\242\207\'jQT\237*\aN{4\216\3421m,%\325gl\304\251C\354/\3114p\"\355- /\361\262\277\204\223b\035]\275\243\234\370)\277+\266:\343\\\303\220\032\371v\260&\264\256\320\365\307\220\256\377\216\336\a\263\340\253(\244\032\020\2238{[\201p\354\262\357E\355\'\204\026@\252\260\306\216V!\2765\336\374$\224\316^_\267-\2756\036\024\253\333\346\027\245s\242\323E\b\031\377D;P\335\203\306\336\246W]\251\000\2658\374z\321\200\2