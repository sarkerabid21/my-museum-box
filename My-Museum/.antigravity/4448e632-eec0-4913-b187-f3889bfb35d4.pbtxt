            lines {
              text: "    const idx = artworks.findIndex((a) => a.id === teleportTargetId);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (idx >= 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
