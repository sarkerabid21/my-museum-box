        replacement_chunks {
          target_content: "            <div>\n              <p className=\"text-xs text-stone-500\">Dynamic Gallery Wings</p>\n              <p className=\"font-editorial text-3xl font-semibold text-stone-900 tabular-nums mt-1\">\n                {layout.bayCount} Wings\n              </p>\n              <p className=\"text-xs text-stone-500 mt-0.5\">\n                {layout.totalWallSlots} total wall bays \302\267 expands automatically\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-stone-500\">Authorized Visitors</p>\n              <p className=\"font-editorial text-3xl font-semibold text-stone-900 tabular-nums mt-1\">\n                {members.length + 1}\n              </p>\n              <p className=\"text-xs text-stone-500 mt-0.5\">\n                Gender-matched 3D visitors in hall\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-stone-500\">Corridor Length</p>\n              <p className=\"font-editorial text-3xl font-semibold text-stone-900 tabular-nums mt-1\">\n                {Math.round(layout.totalLength)}m\n              </p>\n              <p className=\"text-xs text-stone-500 mt-0.5\">\n                Walkable neoclassical marble hall\n              </p>\n            </div>\n          </div>"
          replacement_content: "            <div>\n              <p className=\"text-xs text-stone-500\">Architectural Rooms</p>\n              <p className=\"font-editorial text-3xl font-semibold text-stone-900 tabular-nums mt-1\">\n                {layout.roomCount} {layout.roomCount === 1 ? \'Room\' : \'Rooms\'}\n              </p>\n              <p className=\"text-xs text-stone-500 mt-0.5\">\n                8 walls per room \302\267 new room spawns automatically\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-stone-500\">Authorized Visitors</p>\n              <p className=\"font-editorial text-3xl font-semibold text-stone-900 tabular-nums mt-1\">\n                {members.length + 1}\n              </p>\n              <p className=\"text-xs text-stone-500 mt-0.5\">\n                Private by default \302\267 gender-matched 3D avatars\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-stone-500\">Gallery Capacity</p>\n              <p className=\"font-editorial text-3xl font-semibold text-stone-900 tabular-nums mt-1\">\n                {layout.totalWallSlots} Walls\n              </p>\n              <p className=\"text-xs text-stone-500 mt-0.5\">\n                Unique room shapes, doors &amp; floral vases\n              </p>\n            </div>\n          </div>"
          start_line: 467
          end_line: 495
        }
        replacement_chunks {
          target_content: "            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n              {recentArtworks.map((work) => {\n                const slotIdx = artworks.findIndex((a) => a.id === work.id);\n                return (\n                  <article\n                    key={work.id}\n                    className=\"bg-white border border-stone-200 flex flex-col overflow-hidden\"\n                  >\n                    <button\n                      type=\"button\"\n                      onClick={() => onInspectArtwork(work, Math.max(0, slotIdx))}\n                      className=\"aspect-[4/3] bg-stone-200 overflow-hidden text-left cursor-pointer group\"\n                    >\n                      <img\n                        src={work.imageUrl}\n                        alt={work.title}\n                        referrerPolicy=\"no-referrer\"\n                        className=\"w-full h-full object-cover group-hover:scale-103 transition-transform duration-300\"\n                      />\n                    </button>\n                    <div className=\"p-4 flex-1 flex flex-col\">\n                      <p className=\"text-xs font-mono text-stone-500 tabular-nums flex items-center gap-1.5 mb-1\">\n                        <Calendar className=\"w-3 h-3 text-[#8A5A2B]\" />\n                        {formatArchivalDate(work.dateCaptured)}\n                      </p>\n                      <h3 className=\"font-editorial text-xl font-semibold text-stone-900 leading-snug\">\n                        {work.title}\n                      </h3>\n                      <p className=\"text-xs text-stone-600 mt-1\">{work.artist}</p>\n                    </div>\n                  </article>\n                );\n              })}\n            </div>\n          </div>\n        </section>"
          replacement_content: "            {recentArtworks.length === 0 ? (\n              <div className=\"bg-white border border-stone-200 p-10 text-center\">\n                <p className=\"font-editorial text-2xl font-semibold text-stone-900 mb-2\">\n                  Your private gallery is ready for your first artwork\n                </p>\n                <p className=\"text-sm text-stone-600 max-w-lg mx-auto mb-5\">\n                  Every signed-in account has its own private Firebase museum. Upload photos to fill Room I (8 walls) \342\200\224 adding a 9th artwork automatically builds Room II with a connecting door.\n                </p>\n                <button\n                  type=\"button\"\n                  onClick={onOpenUpload}\n                  className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#8A5A2B] text-white text-xs font-medium hover:bg-[#734922] transition-colors cursor-pointer\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" />\n                  Upload First Artwork\n                </button>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n                {recentArtworks.map((work) => {\n                  const slotIdx = artworks.findIndex((a) => a.id === work.id);\n                  return (\n                    <article\n                      key={work.id}\n                      className=\"bg-white border border-stone-200 flex flex-col overflow-hidden\"\n                    >\n                      <button\n                        type=\"button\"\n                        onClick={() => onInspectArtwork(work, Math.max(0, slotIdx))}\n                        className=\"aspect-[4/3] bg-stone-200 overflow-hidden text-left cursor-pointer group\"\n                      >\n                        <img\n                          src={work.imageUrl}\n                          alt={work.title}\n                          referrerPolicy=\"no-referrer\"\n                          className=\"w-full h-full object-cover group-hover:scale-103 transition-transform duration-300\"\n                        />\n                      </button>\n                      <div className=\"p-4 flex-1 flex flex-col\">\n                        <p className=\"text-xs font-mono text-stone-500 tabular-nums flex items-center gap-1.5 mb-1\">\n                          <Calendar className=\"w-3 h-3 text-[#8A5A2B]\" />\n                          {formatArchivalDate(work.dateCaptured)}\n                        </p>\n                        <h3 className=\"font-editorial text-xl font-semibold text-stone-900 leading-snug\">\n                          {work.title}\n                        </h3>\n                        <p className=\"text-xs text-stone-600 mt-1\">{work.artist}</p>\n                      </div>\n                    </article>\n                  );\n                })}\n              </div>\n            )}\n          </div>\n        </section>"
          start_line: 529
          end_line: 566
        }
        replacement_chunks {
          target_content: "            <div>\n              <p className=\"text-xs font-mono text-[#8A5A2B] mb-2\">01 \302\267 DYNAMIC ARCHITECTURE</p>\n              <h3 className=\"font-editorial text-2xl font-semibold text-stone-900 mb-2\">\n                Walls expand as you upload\n              </h3>\n              <p className=\"text-sm text-stone-600 leading-relaxed\">\n                Every gallery wing frames two featured works across opposing walls. Uploading new images automatically extends the 3D marble corridor, skylights, pilasters, and picture lights.\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs font-mono text-[#8A5A2B] mb-2\">02 \302\267 CHRONOLOGICAL CATALOG</p>\n              <h3 className=\"font-editorial text-2xl font-semibold text-stone-900 mb-2\">\n                Browse every work sorted by date\n              </h3>\n              <p className=\"text-sm text-stone-600 leading-relaxed\">\n                Open the exhibition catalog at any time to sort your entire museum newest-first or oldest-first, filter by keyword, and teleport your avatar directly in front of any frame.\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs font-mono text-[#8A5A2B] mb-2\">03 \302\267 WALKABLE 3D CONTROLS</p>\n              <h3 className=\"font-editorial text-2xl font-semibold text-stone-900 mb-2\">\n                Third-person & first-person exploration\n              </h3>\n              <p className=\"text-sm text-stone-600 leading-relaxed\">\n                Walk with WASD or Arrow keys, drag to orbit your view around your customized 3D avatar, press V to toggle first-person gallery view, and click any framed piece to inspect its provenance.\n              </p>\n            </div>\n          </div>"
          replacement_content: "            <div>\n              <p className=\"text-xs font-mono text-[#8A5A2B] mb-2\">01 \302\267 MULTI-ROOM ARCHITECTURE</p>\n              <h3 className=\"font-editorial text-2xl font-semibold text-stone-900 mb-2\">\n                8 walls per room, new rooms auto-built\n              </h3>\n              <p className=\"text-sm text-stone-600 leading-relaxed\">\n                Each museum room holds 8 framed walls with its own unique architectural shape and floral vase centerpiece. Exceeding 8 artworks automatically creates a new connected room.\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs font-mono text-[#8A5A2B] mb-2\">02 \302\267 DOORS &amp; CUSTOM SIGNBOARDS</p>\n              <h3 className=\"font-editorial text-2xl font-semibold text-stone-900 mb-2\">\n                Open doors &amp; name every room\n              </h3>\n              <p className=\"text-sm text-stone-600 leading-relaxed\">\n                Press F or Space (or click) near any connecting double door to swing it open and walk into the next room. Click the gilded signboard above any doorway to give that room a custom name.\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs font-mono text-[#8A5A2B] mb-2\">03 \302\267 PRIVATE CLOUD ISOLATION</p>\n              <h3 className=\"font-editorial text-2xl font-semibold text-stone-900 mb-2\">\n                Your own private gallery account\n              </h3>\n              <p className=\"text-sm text-stone-600 leading-relaxed\">\n                Sign in with Google so every uploaded artwork and room name saves strictly to your personal Firebase account. Nobody else sees your museum unless you invite them.\n              </p>\n            </div>\n          </div>"
          start_line: 644
          end_line: 672
        }
