hemi = new THREE.HemisphereLight(0xf6f9ff, 0x8f7a64, 1.15);\n    scene.add(hemi);\n    const key = new THREE.DirectionalLight(0xfff1dc, 1.75);\n    key.position.set(2.8, 4.8, 3.6);\n    scene.add(key);\n    const fill = new THREE.DirectionalLight(0xdce8f8, 0.85);\n    fill.position.set(-2.8, 3.0, -3.2);\n    scene.add(fill);\n\n    const ped = new THREE.Mesh(\n      new THREE.CylinderGeometry(0.82, 0.9, 0.16, 32),\n      new THREE.MeshStandardMaterial({ color: 0xf7f3eb, roughness: 0.35 })\n    );\n    ped.position.y = -0.08;\n    scene.add(ped);\n\n    const avatar = getAbidSignatureAvatar(\\\"Ashfaq Sarker Abid\\\");\n    const rig = buildAvatarRig(avatar, { showNameplate: false, showContactShadow: true });\n    scene.add(rig.root);\n\n    const camera = new THREE.PerspectiveCamera(35, w / h, 0.1, 30);\n    window.__abidVerify = { THREE, renderer, scene, camera, rig, animateAvatarRig, overlay };\n\n    // Front 3/4 view\n    camera.position.set(0.55, 1.25, 3.15);\n    camera.lookAt(0, 0.95, 0);\n    renderer.render(scene, camera);\n\n    const box = new THREE.Box3().setFromObject(rig.root);\n    return { minY: +box.min.y.toFixed(3), maxY: +box.max.y.toFixed(3), height: +(box.max.y - box.min.y).toFixed(3) };\n  });\n  await page.screenshot({ path: \\\".playwright-cli/verify-abid-front.png\\\" });\n\n  // Head & torso closeup\n  await page.evaluate(() => {\n    const { renderer, scene, camera } = window.__abidVerify;\n    camera.position.set(0.32, 1.56, 1.38);\n    camera.lookAt(0, 1.44, 0);\n    renderer.render(scene, camera);\n  });\n  await page.screenshot({ path: \\\".playwright-cli/verify-abid-closeup.png\\\" });\n\n  // Rear 3/4 view\n  await page.evaluate(() => {\n    const { renderer, scene, camera } = window.__abidVerify;\n    camera.position.set(-0.65, 1.3, -3.05);\n    camera.lookAt(0, 0.95, 0);\n    renderer.render(scene, camera);\n  });\n  await page.screenshot({ path: \\\".playwright-cli/verify-abid-rear.png\\\" });\n\n  // Mid-stride walking pose (side