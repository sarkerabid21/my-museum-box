      thinking_signature: "\022\331\021\n\326\021\001i\024}\023\345\302\254\362\360$\262.\214M\372\254\237\301\326q\252\at\275\231\321\261\267!P\026O+{\243l\245\267S\223\333\241\200a\227a\026\017_\231M\00489\244@\210\250a\243]\240\230\242\030\362\357\001Z\246\225\313\373\210\373\221i\323\223\372g\223\'\004\205\351k\301\335P^\301\000\221H\317\006\017\253?&\223\024\r}K\201\r\343e\332v\330\204\322\024\306:|\334\266U\320\244I\304\315\310\025\276\344{3\306\372\024\225I\346\367\251Hy\243\244\v\257\242\200\237\346xP\262\264\227\221\365\265\200\350\020\263\300\310O\243\016|nr%\022M\006\332M\305\t\226s\202\215\340\312\317,M\260\310\237\354a\221\271\016\351\316\030a\217\355\"m\347\242\343\033\342\334\024\003(?\226\037\271\347#a\217\316( V>pC\002\272T\320\"\363\302\273_\365Gz\200\272\004]MR\3322\365\211\235q\037/\356\225\246\\\371\254N\306\030+J\222\222\323\372\374\347|\240\352\333\023\306\022\322y\031\267\266\351\245\235\351\207\356\267D1\a\256YSE\203\240*\321(ug\241\020\255Rra~\253\343\037\275\202\360\3040\037\2022d\334\027\335M\004\277\265t\221\3664$\366\272 \347\335-z\320\271O\307\2720\256E\362Y\235\202R\223wt\210\347C\303\346QP\332{U6\304\216\351\337\206m\236U\0018\336k\341\340\r\320\241D\252\331\201\344\337B<_\016:\355\224N.\003\361\353i\037\311\337^\017c\375M!@jq\262\365\004\0207\371Y\216r7\3252\316fs\316b\304q\313+\267\005\"o3\261\3014\215)\327sU\375\300!,\235\314\201\217\240\362\276\033\235\345a\232\224-\230V\254\363\273\2564B+PC\3256\206\205R\206\337\377\243w\202\344{\255M\244\020\333}\373\232\257\031\005v\356\2644HR\201e)\244\233h\027Z\246&*\226\024a}\3233\261\221\027\326\036NYj\033\006\330M\376s\313U\376\256\270I\343\317\0019\354\301?\345\224\241e\366\311\2548\225a=\225XM\343\340y\333\020\t\n\203\355\275@h\343W\373X\337\205\307\017\225_;O\271\305\2255=\004\366}\260\377\372\207\332\314\251=\205\202\314\337\271\332\364\304\314\306\t5,7+\232\262\244\307\231W\003\256\223\333\265\r\336\236P\177\206\205\337\331\362,\367%\307\333\332\326\ntj/\022h\360x\245\316\a\005[ww\17