  code_action {
    action_spec {
      command {
        instruction: "Allow get on non-existent personal museum document (museum_<uid>) without dereferencing resource.data, and guard resource != null before reading existing().email in members allow get"
        is_edit: true
        file {
          absolute_uri: "file:///firestore.rules"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "    // --- Collection: /museums/{museumId} ---\n    match /museums/{museumId} {\n      allow get: if isSignedIn()\n        && isValidId(museumId)\n        && canAccessMuseumData(existing());"
          replacement_content: "    // --- Collection: /museums/{museumId} ---\n    match /museums/{museumId} {\n      allow get: if isSignedIn()\n        && isValidId(museumId)\n        && (\n          (resource == null && museumId == \'museum_\' + request.auth.uid) ||\n          (resource != null && canAccessMuseumData(existing()))\n        );"
          start_line: 256
          end_line: 262
        }
        replacement_chunks {
          target_content: "        allow get: if isSignedIn()\n          && isValidId(museumId)\n          && isValidId(memberId)\n          && museumExists(museumId)\n          && (\n            getMuseum(museumId).data.ownerId == request.auth.uid ||\n            (hasVerifiedEmail() && existing().email == request.auth.token.email)\n          );"
          replacement_content: "        allow get: if isSignedIn()\n          && isValidId(museumId)\n          && isValidId(memberId)\n          && museumExists(museumId)\n          && (\n            getMuseum(museumId).data.ownerId == request.auth.uid ||\n            (resource != null && hasVerifiedEmail() && existing().email == request.auth.token.email)\n          );"
          start_line: 348
          end_line: 357
        }
      }
    }
