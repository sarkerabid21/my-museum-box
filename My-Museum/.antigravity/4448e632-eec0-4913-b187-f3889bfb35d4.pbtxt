            }
            lines {
              text: "      Authorization: `Bearer ${accessToken}`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Content-Type\': \'application/json\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
