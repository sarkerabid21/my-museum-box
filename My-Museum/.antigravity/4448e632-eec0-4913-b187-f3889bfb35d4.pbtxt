            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Currently outside in the Garden / Road / CTG / COXS world"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  let cx = Math.min(WORLD_MAX_X, Math.max(WORLD_MIN_X, x));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  let cz = Math.min(WORLD_MAX_Z, z);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Prevent walking back through solid Museum exterior walls except via the open exit door"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const museumOuterHalfW = ROOM_HALF_WIDTH + 0.85;"
