            }
            lines {
              text: "    const blushMat = trackMat(new THREE.MeshStandardMaterial({ color: 0xecd2cb, roughness: 0.48 }));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const stamenMat = trackMat(new THREE.MeshStandardMaterial({ color: 0xd9a13b, roughness: 0.4 }));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const stemGeo = trackGeo(new THREE.CylinderGeometry(0.015, 0.022, 0.72, 6));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const leafGeo = trackGeo(new THREE.SphereGeometry(0.14, 8, 6));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const petalGeo = trackGeo(new THREE.SphereGeometry(0.09, 8, 6));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let i = 0; i < 8; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const angle = (i / 8) * Math.PI * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const spread = i < 2 ? 0.14 : 0.34 + (i % 3) * 0.08;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const h = 0.58 + (i % 3) * 0.16;"
