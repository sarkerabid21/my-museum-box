            lines {
              text: "  texture.colorSpace = THREE.SRGBColorSpace;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  texture.wrapS = THREE.RepeatWrapping;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
