  planner_response {
    response: "\340\246\217\340\246\237\340\246\277 \340\246\271\340\246\223\340\247\237\340\246\276\340\246\260 \340\246\256\340\247\202\340\246\262 \340\246\225\340\246\276\340\246\260\340\246\243 \340\246\271\340\246\262\340\247\213 **Google Cloud OAuth Consent Screen**-\340\246\217\340\246\260 **\"Testing\" status**, \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\252\340\247\207\340\246\260 \340\246\225\340\247\213\340\246\241\340\247\207\340\246\260 \340\246\225\340\247\213\340\246\250\340\247\213 bug \340\246\250\340\247\237\340\245\244\n\n### \340\246\225\340\247\207\340\246\250 \340\246\217\340\246\256\340\246\250 \340\246\271\340\246\232\340\247\215\340\246\233\340\247\207?\n1. \340\246\206\340\246\256\340\246\260\340\246\276 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\252\340\247\207 **Gmail \340\246\246\340\246\277\340\247\237\340\247\207 \340\246\270\340\246\260\340\246\276\340\246\270\340\246\260\340\246\277 Invitation Email \340\246\252\340\246\276\340\246\240\340\246\276\340\246\250\340\247\213\340\246\260** (`gmail.send`) \340\246\253\340\246\277\340\246\232\340\246\276\340\246\260 \340\246\257\340\247\213\340\246\227 \340\246\225\340\246\260\340\247\207\340\246\233\340\246\277\340\245\244 \340\246\217\340\246\237\340\246\277 Google-\340\246\217\340\246\260 \340\246\217\340\246\225\340\246\237\340\246\277 **Sensitive/Restricted permission**\340\245\244\n2. \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 Google Cloud \340\246\252\340\247\215\340\246\260\340\246\234\340\247\207\340\246\225\340\247\215\340\246\237\340\247\207 (`gen-lang-client-0648146997`) OAuth Consent Screen \340\246\217\340\246\226\340\246\250 **Testing mode**-\340\246\217 \340\246\206\340\246\233\340\247\207\340\245\244 Testing mode-\340\246\217 \340\246\245\340\246\276\340\246\225\340\246\262\340\247\207 \340\246\266\340\247\201\340\246\247\340\247\201 **developer-approved Test users** \340\246\244\340\246\276\340\246\262\340\246\277\340\246\225\340\246\276\340\246\255\340\247\201\340\246\225\340\247\215\340\246\244 Gmail \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\276\340\246\211\340\246\250\340\247\215\340\246\237\340\246\227\340\247\201\340\246\262\340\247\213\340\246\207 Sign-in \340\246\225\340\246\260\340\246\244\340\247\207 \340\246\252\340\246\276\340\246\260\340\247\207\342\200\224\340\246\205\340\246\250\340\247\215\340\246\257 \340\246\257\340\247\207\340\246\225\340\247\213\340\246\250\340\247\213 \340\246\254\340\246\250\340\247\215\340\246\247\340\247\201\340\246\225\340\247\207 \340\246\262\340\246\277\340\246\202\340\246\225 \340\246\246\340\246\277\340\246\262\340\247\207 Google \340\246\244\340\246\276\340\246\246\340\247\207\340\246\260 \340\246\217\340\246\207 \340\246\256\340\247\207\340\246\270\340\247\207\340\246\234 \340\246\246\340\247\207\340\246\226\340\246\277\340\247\237\340\247\207 \340\246\206\340\246\237\340\246\225\340\247\207 \340\246\246\340\247\207\340\247\237\340\245\244\n\n---\n\n### \340\246\205\340\247\215\340\246\257\340\246\276\340\246\252 Publish/Deploy \340\246\225\340\246\260\340\246\262\340\247\207\340\246\207 \340\246\225\340\246\277 \340\246\217\340\246\237\340\246\276 \340\246\240\340\246\277\340\246\225 \340\246\271\340\247\237\340\247\207 \340\246\257\340\246\276\340\246\254\340\247\207?\n**\340\246\250\340\246\276, \340\246\266\340\247\201\340\246\247\340\247\201 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\252 Publish \340\246\225\340\246\260\340\246\262\340\247\207 \340\246\217\340\246\237\340\246\276 \340\246\250\340\246\277\340\246\234\340\247\207 \340\246\245\340\247\207\340\246\225\340\247\207 \340\246\240\340\246\277\340\246\225 \340\246\271\340\246\254\340\247\207 \340\246\250\340\246\276\340\245\244** \340\246\217\340\246\237\340\246\277 \340\246\240\340\246\277\340\246\225 \340\246\225\340\246\260\340\246\244\340\247\207 \340\246\271\340\246\254\340\