      thinking_signature: "\022\232\f\n\227\f\001i\024}\023\332]\305D\362\tb\021\222\254\207 \2504\374\263\276\205\340\323\217\376p\017\"\342&\a\006\244\024\221\347y-\344\363#\201]6*\027\v|C\217\221\265\f<\212\236\201Hj>\365\036An\330\211\0270\256z(4X\321\322O\310\311\233\b\036\330\350w\v)66\2501:\251>V)\30035\233\027S:\356\034aH6\240\207\330py$\305\2567c&\271f\210O^\003\254\311\225\211\362it\225\312\203\2337\200\222\343\315\177\v,+bj3B\225\305<\026\235\v\305\235*\0324\306n\222\343=\253B4U\266\336^\313\271$\234\227\004\321(NB\263(Z\221\331\241\350F\204\341\027]\261\257r\177\350\332H\006\203]\264\006\333xW:,\275\277\316\215\206\371\312\301\020\003\304\177\'[\274\223i\217\035\335\306\263\365rI\006\323\366\362\263\341\221\243\251z\347Xo\346HA\025\035rcc,b\357a\355\364\"\201\317\177q\210\375\342\367H&\265\276;l\211\024\332s.~_\275<C9\203\316\2631*\324)\266\\\343\347\365N\213\364\2124fdO\3145u\370q\'8\201fc\2372\f\274oHCWf{X\271dO\030f\374a5\260tT4*x\356\272\204&\016\377\000\220\370\bY\n\214\214I[|dO\343.\264\212d\002H\\\347<\224\242G\245\256\340\376&&\351\023\356|b\273@\223\205]\321\275\321\224\271]\206,\232\311\261\001\231\016\250v\312\204L\022\206\004\267\316F\370\237u\244\005\341G]\221\214\232\023\214u\352\202W\375\321]\336\262\265\361fWi=e\177\211\265\301\206\323\255\n6\352\005\211\325\205]\363~T\315\a\235\360\260\'F\307n\001Xb\345\264\342\241;\346\317\tS\ve\224K\364\313z\306_\360\201\\\f\214\316Xs\022\207m!i\325\242\213\345\005#\310\375\316\352\377\307E\241\016\2179<*L\323\006E\337\276a\374,\301\373\300\272wQ%/a\215\\\225\334\266Bl\020#\261\254\3012\364\307\261\365\024EV3{&\033*/t/o\035\031\b\211\345{\252\204\354\033\3541\327\326\321~K\3279Pe~\373\247\r\210NU\261\245\230\336\255t\0370\355\246\216\245\307*\364\230\240\037\315\310\347<}B#\023\v!\303\362\275\275\335\214a\025\340\023\243\2642\212\213k\217\224~\2637\021\203\361\315\031I[pa\225\300b\214\300*M\'t\377~\346!\316\036T\215\330\363\031@\345$\177F\261\256G\353\'U\322\235U\213\020\023y\f>\257P\252\032\201\003N\v@H\265B[N=\226\035\216\265\373\\\203\302y\245\030\355\t\a\355\220\227\326~\b\214\031\242\263p.\333\211\251\031\252u\243\343\244\274\250\202\023\334a\023\3618#\306\371\337\246\203\232\233\226f;\024 \230P\352\222\375x\341H\336\204Z\003\331\376x\377\376\242u\330@\332\263\036\nW\302\326C\026\372=\262\244q_c(\331\355\240\2076\244\276\353\336?\316\217\020\272\224A\2267\262\027\270\354S\303\274\252A\006k\227$\267!\253*oy\003zb]\321@\372\304\002\222\024\226@\257\312V\303{\355-(\367\342\341<\032t\217@u\263@\255\316\343\341\244\247\243\a \365\017)\264\aP\355\212t\"\352\362Xs\344\204\020\177\235\343/3.3Q7Sw\324\367-\241\330\277\016&\247-M\257\354\t\335\307\207m7V\247\270\221\v\325{\213~\031\331\342\217\037Z\'\275\207\n\305\314\224F%p\301Wu\243\257`\367:\224\n\206\366R\200\314pv\253\2632:\'u\2232\251\264\265\310e9\257\273\247d\317\027\206x\230\221z\334\2669%\207]\227\313(O|g`\267y\311\256sj\375\327s\244\323\021\\\r2\023<\325\3607\025\371\265\026*\236\340_\2742d\306M\'\256\244{\313\254)\377\3314\270\034\275\202\2555m\b\326f\333\256&\272]\274\271=c:a`\004Y\305-Nd\332\235%\325<\027\266\r\351:\004>#\307\304\324KC\213\373\352\a\343bRO[\n\310\025\f\375&Y\365\265F\200\332\231\265\351\344\346?\223H\373\332\304\336\326\233Z<\376]\316wl\326\222\277\234\244h\311\325c\262p{\237\221\30405\245\315\235\2235\347\235\t\372\332;\nO\215;Q\353\323\256\2743\004\372\341\302\343\343}\362@\206n\356\213j\267\267\303\234\253\2053\230\340\332^\353\343\317\335\255\002t\267\241\253g\250\024\262\315\035\355\222\301@y\016\253y\217\n\265l\226#Lc\251O\345\362\363\v\206Y\220\263\210P<HP/\326\374\017\177\324#\3509]0O\331Q{0\326\fC\307\311N\000\306\2037&!7\334(\312\215\213|F\275B\327\272\217\220\221T\306\234\300\272\341/\220\307\262\223 \230\334\275H[\270d\253\033\206%;jo\361\204\362X:\274\240\220\031!Ib\207\234\354O\324\363\nf\272\375%k\230\327\251[\233\3539\270!\b\242\036\213\020:\371\304\254C\365\032\237#\252\374\314\002\177\245^\247\207\376\372\322\215\344T\353.\230\037qj\323\346\344+\353\333\273\265\373m\261\033\306vCm&\244{\346\304b\006\374\030<\317\263\030\246\'\325\243\226J\230&\251\224\366T\311\332\320=U\243Ljbc\340\235\021\217\322\366Bg\317BD\217j\3028\f\340\260\022\000\314,\\>\260\243\210\2141\213\2376\v#s\f\242\312\356\375L`)\313+\253\001\261\266\212\322\301\256\021P\354KK\351\241\\\237\'\251\376K\362\263\337%(\301\342\250=\356\225\275*/\260 7\t\327\213\314\034=\370\241\023\037\217\025\257\317\253\254\002\274\346\020\200\031.T\035P\270\322r\241\347\275"
