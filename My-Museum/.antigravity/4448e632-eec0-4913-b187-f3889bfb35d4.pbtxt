eshStandardMaterial({ color: 0xf7f3eb, roughness: 0.35 })    );    ped.position.y = -0.08;    scene.add(ped);    const rig = buildAvatarRig(getAbidSignatureAvatar(\"Ashfaq Sarker Abid\"), { showNameplate: false, showContactShadow: true });    scene.add(rig.root);    const camera = new THREE.PerspectiveCamera(35, w / h, 0.1, 30);    window.__abidV2 = { renderer, scene, camera, rig, animateAvatarRig, overlay };    // Front 3/4    camera.position.set(0.55, 1.25, 3.15);    camera.lookAt(0, 0.95, 0);    renderer.render(scene, camera);  });  await page.screenshot({ path: \".playwright-cli/v2-front.png\" });  // Head & torso closeup  await page.evaluate(() => {    const { renderer, scene, camera } = window.__abidV2;    camera.position.set(0.32, 1.54, 1.35);    camera.lookAt(0, 1.42, 0);    renderer.render(scene, camera);  });  await page.screenshot({ path: \".playwright-cli/v2-closeup.png\" });  // Peak stride walk side 3/4  const walkPeak = await page.evaluate(() => {    const { renderer, scene, camera, rig, animateAvatarRig } = window.__abidV2;    rig.stridePhase = Math.PI / 2 - 0.1;    for (let i = 0; i < 6; i++) {      animateAvatarRig(rig, 3.8, i * 0.016, 0.016);    }    camera.position.set(2.1, 1.15, 2.05);    camera.lookAt(0, 0.92, 0);    renderer.render(scene, camera);    return {      leftLegX: +rig.leftLegPivot.rotation.x.toFixed(3),      rightLegX: +rig.rightLegPivot.rotation.x.toFixed(3),      leftArmX: +rig.leftArmPivot.rotation.x.toFixed(3),      rightArmX: +rig.rightArmPivot.rotation.x.toFixed(3)    };  });  await page.screenshot({ path: \".playwright-cli/v2-walk.png\" });  // Clean up  await page.evaluate(() => {    const { rig, renderer, overlay } = window.__abidV2;    rig.dispose();    renderer.dispose();    overlay.remove();    delete window.__abidV2;  });  return walkPeak;})(page);```### Page- Page URL: http://localhost:3000/- Page Title: My Museum \342\200\224 3D Virtual Gallery & Curatorial Space- Console: 0 errors, 1 warnings### Events- New console e