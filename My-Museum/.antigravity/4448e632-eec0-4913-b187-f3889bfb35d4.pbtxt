      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Fix avatar hair forehead clearance, prevent woman dress leg clipping, refine shoulders, and proportion nameplate sprite\", \"Instruction\":\"Update AvatarRig interface, leg/skirt geometry, hair positioning, shoulder fit, nameplate scale, and stride swing in src/three/avatarBuilder.ts\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":16, \"ReplacementContent\":\"  leftLegPivot: THREE.Group;\\n  rightLegPivot: THREE.Group;\\n  stridePhase: number;\\n  maxLegSwing: number;\\n  dispose: () => void;\\n}\", \"StartLine\":10, \"TargetContent\":\"  leftLegPivot: THREE.Group;\\n  rightLegPivot: THREE.Group;\\n  stridePhase: number;\\n  dispose: () => void;\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":71, \"ReplacementContent\":\"  const outfitMat = trackMat(\\n    new THREE.MeshStandardMaterial({\\n      color: new THREE.Color(config.outfitColor),\\n      roughness: 0.82,\\n      metalness: 0.04,\\n      side: THREE.DoubleSide,\\n    })\\n  );\", \"StartLine\":62, \"TargetContent\":\"  const outfitMat = trackMat(\\n    new THREE.MeshStandardMaterial({\\n      color: new THREE.Color(config.outfitColor),\\n      roughness: 0.82,\\n      metalness: 0.04,\\n    })\\n  );\"}, {\"AllowMultiple\":false, \"EndLine\":87, \"ReplacementContent\":\"  const trouserMat = trackMat(\\n    new THREE.MeshStandardMaterial({\\n      color: trouserColor,\\n      roughness: 0.86,\\n      metalness: 0.02,\\n      side: THREE.DoubleSide,\\n    })\\n  );\", \"StartLine\":79, \"TargetContent\":\"  const trouserMat = trackMat(\\n    new THREE.MeshStandardMaterial({\\n      color: trouserColor,\\n      roughness: 0.86,\\n      metalness: 0.02,\\n    })\\n  );\"}, {\"AllowMultiple\":false, \"EndLine\":162, \"ReplacementContent\":\"  // --- LEGS (Articulated from Hip at y = 0.86) ---\\n  const isSkirted =\\n    isWoman &&\\n    (config.outfitStyle === \'dress\' ||\\n      config.outfitStyle === \'coat\' ||\\n      config.outfitStyle === \'blazer_skirt\');\\n  const hipY = isWoman ? 0.85 : 0.88;\\n  const hipSpread = isWoman ? 0.082 : 0.118;\\n\\n  const makeLeg = (side: -1 | 1) => {\\n    const pivot = new THREE.Group();\\n    pivot.position.set(side * hipSpread, hipY, 0);\\n\\n    const upperRadiusTop = isWoman ? 0.056 : 0.082;\\n    const upperRadiusBot = isWoman ? 0.045 : 0.066;\\n    const legUpperMat =\\n      isWoman && (config.outfitStyle === \'dress\' || config.outfitStyle === \'blazer_skirt\')\\n        ? skinMat\\n        : trouserMat;\\n\\n    // For long dresses/coats, keep upper thigh enclosed cleanly inside skirt volume\\n    if (!isSkirted || config.outfitStyle === \'blazer_skirt\') {\\n      const thigh = new THREE.Mesh(\\n        trackGeo(new THREE.CylinderGeometry(upperRadiusTop, upperRadiusBot, 0.42, 14)),\\n        legUpperMat\\n      );\\n      thigh.position.y = -0.21;\\n      thigh.castShadow = true;\\n      pivot.add(thigh);\\n    } else {\\n      const innerThigh = new THREE.Mesh(\\n        trackGeo(new THREE.CylinderGeometry(0.046, 0.042, 0.22, 12)),\\n        legUpperMat\\n      );\\n      innerThigh.position.y = -0.31;\\n      pivot.add(innerThigh);\\n    }\\n\\n    const calf = new THREE.Mesh(\\n      trackGeo(new THREE.CylinderGeometry(upperRadiusBot * 0.96, isWoman ? 0.036 : 0.054, 0.38, 14)),\\n      legUpperMat\\n    );\\n    calf.position.y = -0.58;\\n    calf.castShadow = true;\\n    pivot.add(calf);\", \"StartLine\":131, \"TargetContent\":\"  // --- LEGS (Articulated from Hip at y = 0.86) ---\\n  const hipY = isWoman ? 0.85 : 0.88;\\n  const hipSpread = isWoman ? 0.105 : 0.125;\\n\\n  const makeLeg = (side: -1 | 1) => {\\n    const pivot = new THREE.Group();\\n    pivot.position.set(side * hipSpread, hipY, 0);\\n\\n    const upperRadiusTop = isWoman ? 0.072 : 0.086;\\n    const upperRadiusBot = isWoman ? 0.056 : 0.068;\\n    const legUpperMat =\\n      isWoman && (config.outfitStyle === \'dress\' || config.outfitStyle === \'blazer_skirt\')\\n        ? skinMat\\n        : trouserMat;\\n\\n    const thigh = new THREE.Mesh(\\n      trackGeo(new THREE.CylinderGeometry(upperRadiusTop, upperRadiusBot, 0.42, 14)),\\n      legUpperMat\\n    );\\n    thigh.position.y = -0.21;\\n    thigh.castShadow = true;\\n    pivot.add(thigh);\\n\\n    const calf = new THREE.Mesh(\\n      trackGeo(new THREE.CylinderGeometry(upperRadiusBot * 0.96, isWoman ? 0.042 : 0.056, 0.38, 14)),\\n      legUpperMat\\n    );\\n    calf.position.y = -0.58;\\n    calf.castShadow = true;\\n    pivot.add(calf);\"}, {\"AllowMultiple\":false, \"EndLine\":290, \"ReplacementContent\":\"    if (config.outfitStyle === \'dress\') {\\n      // Flowing Pleated Midi Dress (generous bell silhouette prevents any leg clipping)\\n      const dressPoints = [\\n        new THREE.Vector2(0.142, 1.0),\\n        new THREE.Vector2(0.205, 0.85),\\n        new THREE.Vector2(0.262, 0.62),\\n        new THREE.Vector2(0.305, 0.35),\\n      ];\\n      const dressMesh = new THREE.Mesh(\\n        trackGeo(new THREE.LatheGeometry(dressPoints, 24)),\\n        outfitMat\\n      );\\n      dressMesh.scale.set(1.0, 1, 0.98);\\n      dressMesh.castShadow = true;\\n      bodyGroup.add(dressMesh);\\n    } else if (config.outfitStyle === \'coat\') {\\n      // Tailored Long Gallery Coat with structured lapels\\n      const coatPoints = [\\n        new THREE.Vector2(0.146, 1.0),\\n        new THREE.Vector2(0.205, 0.82),\\n        new THREE.Vector2(0.265, 0.44),\\n      ];\\n      const coatSkirt = new THREE.Mesh(\\n        trackGeo(new THREE.LatheGeometry(coatPoints, 22)),\\n        outfitMat\\n      );\\n      coatSkirt.scale.set(1.02, 1, 0.96);\\n      coatSkirt.castShadow = true;\\n      bodyGroup.add(coatSkirt);\\n\\n      // Coat lapels\\n      for (const s of [-1, 1]) {\\n        const lapel = new THREE.Mesh(\\n          trackGeo(new THREE.BoxGeometry(0.055, 0.26, 0.025)),\\n          outfitMat\\n        );\\n        lapel.position.set(s * 0.072, 1.32, 0.11);\\n        lapel.rotation.z = s * 0.22;\\n        bodyGroup.add(lapel);\\n      }\\n    } else {\\n      // Curator Blazer & A-Line Skirt\\n      const skirt = new THREE.Mesh(\\n        trackGeo(new THREE.CylinderGeometry(0.155, 0.255, 0.48, 22)),\\n        trouserMat\\n      );\\n      skirt.scale.set(1.04, 1, 0.98);\\n      skirt.position.y = 0.76;\\n      skirt.castShadow = true;\\n      bodyGroup.add(skirt);\\n\\n      const blazerPeplum = new THREE.Mesh(\\n        trackGeo(new THREE.CylinderGeometry(0.148, 0.185, 0.16, 18)),\\n        outfitMat\\n      );\\n      blazerPeplum.scale.set(1.06, 1, 0.86);\\n      blazerPeplum.position.y = 0.94;\\n      bodyGroup.add(blazerPeplum);\\n    }\", \"StartLine\":230, \"TargetContent\":\"    if (config.outfitStyle === \'dress\') {\\n      // Flowing Pleated Midi Dress (LatheGeometry bell silhouette)\\n      const dressPoints = [\\n        new THREE.Vector2(0.138, 0.99),\\n        new THREE.Vector2(0.175, 0.84),\\n        new THREE.Vector2(0.235, 0.62),\\n        new THREE.Vector2(0.285, 0.36),\\n        new THREE.Vector2(0.27, 0.35),\\n      ];\\n      const dressMesh = new THREE.Mesh(\\n        trackGeo(new THREE.LatheGeometry(dressPoints, 24)),\\n        outfitMat\\n      );\\n      dressMesh.scale.set(1.0, 1, 0.88);\\n      dressMesh.castShadow = true;\\n      bodyGroup.add(dressMesh);\\n    } else if (config.outfitStyle === \'coat\') {\\n      // Tailored Long Gallery Coat with structured lapels\\n      const coatPoints = [\\n        new THREE.Vector2(0.142, 1.0),\\n        new THREE.Vector2(0.185, 0.82),\\n        new THREE.Vector2(0.23, 0.48),\\n      ];\\n      const coatSkirt = new THREE.Mesh(\\n        trackGeo(new THREE.LatheGeometry(coatPoints, 20)),\\n        outfitMat\\n      );\\n      coatSkirt.scale.set(1.04, 1, 0.84);\\n      coatSkirt.castShadow = true;\\n      bodyGroup.add(coatSkirt);\\n\\n      // Coat lapels\\n      for (const s of [-1, 1]) {\\n        const lapel = new THREE.Mesh(\\n          trackGeo(new THREE.BoxGeometry(0.055, 0.26, 0.025)),\\n          outfitMat\\n        );\\n        lapel.position.set(s * 0.072, 1.32, 0.11);\\n        lapel.rotation.z = s * 0.22;\\n        bodyGroup.add(lapel);\\n      }\\n    } else {\\n      // Curator Blazer & A-Line Skirt\\n      const skirt = new THREE.Mesh(\\n        trackGeo(new THREE.CylinderGeometry(0.146, 0.225, 0.46, 20)),\\n        trouserMat\\n      );\\n      skirt.scale.set(1.05, 1, 0.86);\\n      skirt.position.y = 0.77;\\n      skirt.castShadow = true;\\n      bodyGroup.add(skirt);\\n\\n      const blazerPeplum = new THREE.Mesh(\\n        trackGeo(new THREE.CylinderGeometry(0.148, 0.18, 0.16, 18)),\\n        outfitMat\\n      );\\n      blazerPeplum.scale.set(1.06, 1, 0.82);\\n      blazerPeplum.position.y = 0.94;\\n      bodyGroup.add(blazerPeplum);\\n    }\"}, {\"AllowMultiple\":false, \"EndLine\":378, \"ReplacementContent\":\"  // --- ARMS (Articulated from Shoulder Pivot) ---\\n  const shoulderY = isWoman ? 1.40 : 1.44;\\n  const shoulderX = isWoman ? 0.205 : 0.256;\\n\\n  const makeArm = (side: -1 | 1) => {\\n    const pivot = new THREE.Group();\\n    pivot.position.set(side * shoulderX, shoulderY, 0);\\n\\n    const shoulderCap = new THREE.Mesh(\\n      trackGeo(new THREE.SphereGeometry(isWoman ? 0.052 : 0.064, 12, 10)),\\n      outfitMat\\n    );\\n    pivot.add(shoulderCap);\", \"StartLine\":366, \"TargetContent\":\"  // --- ARMS (Articulated from Shoulder Pivot) ---\\n  const shoulderY = isWoman ? 1.41 : 1.45;\\n  const shoulderX = isWoman ? 0.225 : 0.275;\\n\\n  const makeArm = (side: -1 | 1) => {\\n    const pivot = new THREE.Group();\\n    pivot.position.set(side * shoulderX, shoulderY, 0);\\n\\n    const shoulderCap = new THREE.Mesh(\\n      trackGeo(new THREE.SphereGeometry(isWoman ? 0.056 : 0.068, 12, 10)),\\n      outfitMat\\n    );\\n    pivot.add(shoulderCap);\"}, {\"AllowMultiple\":false, \"EndLine\":505, \"ReplacementContent\":\"  // --- SCULPTED 3D HAIR BY GENDER & STYLE ---\\n  // Tilted crown cap keeps the forehead, eyebrows, eyes, and glasses completely clear\\n  const hairBase = new THREE.Mesh(\\n    trackGeo(new THREE.SphereGeometry(isWoman ? 0.132 : 0.138, 20, 16, 0, Math.PI * 2, 0, Math.PI * 0.44)),\\n    hairMat\\n  );\\n  hairBase.scale.set(0.95, 1.02, 1.0);\\n  hairBase.position.set(0, 0.145, -0.022);\\n  hairBase.rotation.x = -0.34;\\n  hairBase.castShadow = true;\\n  headGroup.add(hairBase);\\n\\n  // Back-of-head cranial hair volume (leaves front face clean)\\n  const hairBackCrown = new THREE.Mesh(\\n    trackGeo(new THREE.SphereGeometry(isWoman ? 0.126 : 0.13, 18, 14)),\\n    hairMat\\n  );\\n  hairBackCrown.scale.set(0.94, 1.02, 0.84);\\n  hairBackCrown.position.set(0, 0.128, -0.044);\\n  headGroup.add(hairBackCrown);\", \"StartLine\":494, \"TargetContent\":\"  // --- SCULPTED 3D HAIR BY GENDER & STYLE ---\\n  const hairBase = new THREE.Mesh(\\n    trackGeo(new THREE.SphereGeometry(isWoman ? 0.135 : 0.142, 20, 16, 0, Math.PI * 2, 0, Math.PI * 0.58)),\\n    hairMat\\n  );\\n  hairBase.scale.set(0.96, 1.08, 1.02);\\n  hairBase.position.set(0, 0.122, -0.006);\\n  hairBase.castShadow = true;\\n  headGroup.add(hairBase);\"}, {\"AllowMultiple\":false, \"EndLine\":684, \"ReplacementContent\":\"    const sprite = new THREE.Sprite(spriteMat);\\n    sprite.scale.set(0.92, 0.23, 1);\\n    sprite.position.set(0, 2.08, 0);\\n    root.add(sprite);\\n  }\\n\\n  return {\\n    root,\\n    bodyGroup,\\n    headGroup,\\n    leftArmPivot,\\n    rightArmPivot,\\n    leftLegPivot,\\n    rightLegPivot,\\n    stridePhase: 0,\\n    maxLegSwing: isSkirted ? 0.26 : 0.48,\\n    dispose: () => {\\n      for (const item of disposables) {\\n        item.dispose();\\n      }\\n    },\\n  };\\n}\", \"StartLine\":661, \"TargetContent\":\"    const sprite = new THREE.Sprite(spriteMat);\\n    sprite.scale.set(1.15, 0.29, 1);\\n    sprite.position.set(0, 2.15, 0);\\n    root.add(sprite);\\n  }\\n\\n  return {\\n    root,\\n    bodyGroup,\\n    headGroup,\\n    leftArmPivot,\\n    rightArmPivot,\\n    leftLegPivot,\\n    rightLegPivot,\\n    stridePhase: 0,\\n    dispose: () => {\\n      for (const item of disposables) {\\n        item.dispose();\\n      }\\n    },\\n  };\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":705, \"ReplacementContent\":\"  if (isMoving) {\\n    rig.stridePhase += delta * Math.min(11, 5.2 + speed * 1.15);\\n    const swing = Math.sin(rig.stridePhase) * rig.maxLegSwing;\\n    const armSwing = Math.sin(rig.stridePhase) * 0.38;\\n    const bob = Math.abs(Math.cos(rig.stridePhase)) * 0.028;\", \"StartLine\":697, \"TargetContent\":\"  if (isMoving) {\\n    rig.stridePhase += delta * Math.min(11, 5.2 + speed * 1.15);\\n    const swing = Math.sin(rig.stridePhase) * 0.52;\\n    const armSwing = Math.sin(rig.stridePhase) * 0.42;\\n    const bob = Math.abs(Math.cos(rig.stridePhase)) * 0.032;\"}], \"TargetFile\":\"/src/three/avatarBuilder.ts\", \"toolAction\":\"Refining 3D avatar hair and dress geometry\", \"toolSummary\":\"Avatar 3D geometry refinement\"}"
