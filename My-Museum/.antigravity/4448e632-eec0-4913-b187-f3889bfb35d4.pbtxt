      thinking_signature: "\022\271\b\n\266\b\001i\024}\023~\246w\357\331\241\207\210\276^\241\354\356\266\206\006\202\364\020\352\224\215!\305K\017\221\n\227\231Z[c\251\324q\250x\324\354\371b\004)\213\305f\357\213N\241\006\3550\250\t\374,\220\324\343I\274\363\375\365;\321\356K\fM\241_(g#Z4H\330V\3376g\003B\v\034\356uC\215\320\373M,\206H\301&L\315!\035\375\202\374\263\235\215\242\261L\273\316\264\255\375\271\300\253\352\212\336\3401\351\206\325\334\027t\004\370\367\004\376 XJ\r\362\230l$~\304\037\035\027m\372\204-\262}%\300ij\3166\016X\343P\223\2003\260d$\216=\347\243\370Q6A\001\003\227\344w\264\034\364\235\233\211\246\354+\016\333\315\005f\315\016\b\215=\aB-\v-\002\'\317\361#\251\225\b\203\334S\2265\306RX\327\250\220\322\2570\205e\025\232\251B\306]\273\361\005\037\r\306\017|\f\372\257{\001\223\a\000\313\223\267s\300\327\232\350\232\227\225\325\0239\001=E]\017in9\245\223\b\260\240\200q\"T$\370\032\247TZ\364\233\210Q`\364\207\003\323~\277\177\346a\257N\376\236\'\232\364u\a\2459\363+\324\\\tX\n%\016\207\352V]6L\0372m\373p\300\256[\254\002\026\b\272\213\253\276\312N\324\207\325\210\346\366E\246\224\206\000\371\3110\203\225_-\273\301\viY\324x\366il\341W\213]\225\307\307\270\267A\324(\024\021\265S\a=\fQ\306\317Ad\267\2535\211\241Do\035\356x\215\210\0062\264\022\023\352\017\005\217\325/\246Y\240\200C|Q\f\361g\366\034-FT$\324\214\236\244m\254\332\373$,\315;\307\216\f\nY#\275\205|\301m\373\263`\004\000\022\260[\363\233-\a\313\375\036U\322T>\036\3147\274~\336pG\275S\352\274-\304\311?\036<[g\263@\277\271\t~\314\rz\225\222d\201\333\266\330\300\006k\245\277\244\226\250\276\300\b].|U\b]\354\237\004\246\210?\313\357\351\220g[t@\f\201\316\227\327(h\244\017\207\347Bi\354\025rhJ\373\317\260\376\342\217\202\200O\2530\v\225>\246*\023K\337#\314D\213\314R^\310\004#\200\275r\343HE\321+A\003\214\205r\016\360\235\253g\260\320\b\306\212\276\300\321\"\272\"q\311X+Fb\313\351\270\211y\003B\267wJ04P\217D\311\245\033I\304O\344f\227H\020\201\r\v\336~<8!%\357k[\362RJ\214\030?\023\3447\357\3604*\f 