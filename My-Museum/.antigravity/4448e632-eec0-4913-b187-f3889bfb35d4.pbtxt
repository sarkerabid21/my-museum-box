      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Sync VisitorPresence schema in firebase-blueprint.json with optional memberKey and isOnline fields\", \"EndLine\":122, \"Instruction\":\"Add optional memberKey and isOnline properties to VisitorPresence entity in firebase-blueprint.json\", \"ReplacementContent\":\"        \\\"x\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"z\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"yaw\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"isOnline\\\": { \\\"type\\\": \\\"boolean\\\" },\\n        \\\"memberKey\\\": { \\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"maxLength\\\": 32, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"isOpenByCode\\\": { \\\"type\\\": \\\"boolean\\\" },\\n        \\\"viewerEmails\\\": { \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Bounded list of up to 10 invited emails for secure list queries.\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"museumId\\\", \\\"ownerId\\\", \\\"uid\\\", \\\"displayName\\\", \\\"gender\\\", \\\"skinTone\\\", \\\"hairStyle\\\", \\\"hairColor\\\", \\\"outfitStyle\\\", \\\"outfitColor\\\", \\\"accentColor\\\", \\\"accessory\\\", \\\"x\\\", \\\"z\\\", \\\"yaw\\\", \\\"isOpenByCode\\\", \\\"viewerEmails\\\", \\\"updatedAt\\\"]\\n    }\", \"StartLine\":112, \"TargetContent\":\"        \\\"x\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"z\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"yaw\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"isOpenByCode\\\": { \\\"type\\\": \\\"boolean\\\" },\\n        \\\"viewerEmails\\\": { \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Bounded list of up to 10 invited emails for secure list queries.\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"museumId\\\", \\\"ownerId\\\", \\\"uid\\\", \\\"displayName\\\", \\\"gender\\\", \\\"skinTone\\\", \\\"hairStyle\\\", \\\"hairColor\\\", \\\"outfitStyle\\\", \\\"outfitColor\\\", \\\"accentColor\\\", \\\"accessory\\\", \\\"x\\\", \\\"z\\\", \\\"yaw\\\", \\\"isOpenByCode\\\", \\\"viewerEmails\\\", \\\"updatedAt\\\"]\\n    }\", \"TargetFile\":\"/firebase-blueprint.json\", \"toolAction\":\"Updating Firebase blueprint schema\", \"toolSummary\":\"Update firebase-blueprint.json\"}"
