      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Give software WebGL compositor slightly more breathing room between frames\", \"EndLine\":50, \"Instruction\":\"Adjust software GL afterDraw interval from 80ms to 105ms\", \"ReplacementContent\":\"    if (typeof gl.fenceSync !== \'function\') {\\n      getTimerSetter(window.setTimeout(cb, 105));\\n      return;\\n    }\\n    const sync = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0);\\n    gl.flush();\\n    let polls = 0;\\n    const poll = () => {\\n      polls++;\\n      const state = sync ? gl.getSyncParameter(sync, gl.SYNC_STATUS) : gl.SIGNALED;\\n      if (state === gl.UNSIGNALED && polls < 40) {\\n        getTimerSetter(window.setTimeout(poll, 5));\\n      } else {\\n        if (sync) gl.deleteSync(sync);\\n        getTimerSetter(window.setTimeout(cb, 105));\\n      }\\n    };\", \"StartLine\":31, \"TargetContent\":\"    if (typeof gl.fenceSync !== \'function\') {\\n      getTimerSetter(window.setTimeout(cb, 80));\\n      return;\\n    }\\n    const sync = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0);\\n    gl.flush();\\n    let polls = 0;\\n    const poll = () => {\\n      polls++;\\n      const state = sync ? gl.getSyncParameter(sync, gl.SYNC_STATUS) : gl.SIGNALED;\\n      if (state === gl.UNSIGNALED && polls < 40) {\\n        getTimerSetter(window.setTimeout(poll, 5));\\n      } else {\\n        if (sync) gl.deleteSync(sync);\\n        getTimerSetter(window.setTimeout(cb, 80));\\n      }\\n    };\", \"TargetFile\":\"/src/three/webglUtils.ts\", \"toolAction\":\"Tuning software WebGL frame pacing\", \"toolSummary\":\"Tune afterDraw pacing in webglUtils.ts\"}"
