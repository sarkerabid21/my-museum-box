      thinking_signature: "\022\354\t\n\351\t\001i\024}\023\346sa{\231\340\2112n.OH\210r7\303\210\3644\305aXKH\331\026\215\204\r\346\367\261!\361\245FQ\210\336\ns\026\323\373\323\317\032\255D\327:N\237\345vg\346\246~\246W\327\332O\031c\321/\247\260\277\375\207%\362\345V\257\177[\020+\t\346\363\325\216\311N\234\273\341\236\375\033ql\327T\034\215\377a\203\310\301\032\220c!\243Z\2109b\346\333\3009H\371\025\301\023\351\346\020\362\224\245gt\357\262e\031\260\350u\344\t\237\016\356\247\331\265\033\276\v\265Z\247\366\017\316f\240\005\233\233\252ad\033\322g\274A\3622.\224\272\317\343IQ@$\030xFi\351\244\b2$\031\034\276\004x\024>kDk\362\363\337\304\256j\022\005z\340\023\352\035\356\273\306\240\257\312{QXd\211\366\004\177\226\336\026\257^.\204\364\240\223\343\\\354\201\210\207Q\214(\323ArhVq\325Q\3502\202\326\241\231{\356\261\216\342\006\200\017$\332gfs\371Q\006\324\363j\317\341`\237!\314\\\277)\024\rJ\370\263\326\251q\272\033\276\335\336$\313\"\206x\201\034\023\360\204j\2777\237\352\034\005\267\251\232\245\033\321r\276\250 \311J\020\221\\\335Qa[\254BN\253\202a\312G\311\364\316\227%\020\301\241:[\342\350\365\000\2070H\242\002\301\345k\b\017\225=MR\371\301\343\213\247\2538\320\022\212:\001_\235\365\330\2109\346\225\354\203,0%\201\004A\017\225l\236\363[\vg\251\210\267fy9\271\221f@\215\022>\335\371r\346\373B\036$u\366y\t\037g$4\ao\260\354\262\244y\334+C\234\204\271\300\253V\227haPcaB\366s\330uOoE\r\232\020Uq\247^\367dx\355\206R\001\253Y=*v\221\020k\243}\354\377\260.\367\005\033\357\251\314n~\277\235<\361\036\332\003\356\323\312E\372\307\222C\1772\004\236\202VS\017\033XF\t\303W%\320\257\031t\3660i\031\362\004\327\344\212\032\200\215B\316\344\351\346V\271{U\201\327\"lS\241\325c\223\030\375\221k\b\307\2437>\375\235;\227\230\334%\360v2\336/\216U\036\000e\277\0305\235\373P\274u\367\tOF\276\361k+{0+\301k\270J\351~\240\346L;e\351m\005.\274\341\317\030\3258*J\\\270\277\245\335\177\372\n\031A\232\253\332\302\21325\361^\301\226#\002\261^\253\202\256\031b\307\241a\0357\347\200\f\305rw\357\367F\353\234\275\255!\370R\261\237]\274\346<\2677\332\277Y\336\023?\311\342\032\322L\224\272o\345\267\016\306\257Y\260F\366\220l\224,T\376\351\215\"\355\237\302\370\267\037\213\272\364\372m\241\223\252\306\235\222h\352\361\356\363:3\224\022\377\235\321 \3322y3\303If\363\025\273\216\327\272(\263r\351J\223.3R+\370\265\270K\314uS_\003\026\0215\301\234\027W\332\313\270\326\203\357\263s\036\375Xq\306\316e&\262L\337/f1!\3268\262<\005\346\255]C\224\032\234R:a\335!?_\214\024V+\236M\031\'\262\005X\265\320\223\020\001\177\200+\273\030\033J\030\221X|\212\\f#\332\247\302\342\322\264\351\021n\035.V(]\241\276\005\304\026S}F\310\334\320Z\177!\237\3748\177\326V\022\360\351/\322\016<\263\327k\341\370\252\342\312cr3\023\023\213`\333\2178\201\020g%\246{E\323\313\322\365\033j\030\006#$\267G0n\fQ\247\207\310\231F\363 \350\306\243/\341\241\255L\203\365<\237\203\263J\255\342\223\v\262\273~\324~\262\346\260Q\227\314\212\334{w\206\266\335n\t\207\323Dm\230\375\321\000;\217\243r\"\034\313\t\'O\3300#\374\370-\216\247*\376?\211o){OU-\215^1\340\310i\343S\343})\241\247HG\214nx&\256\222\316\256\304\032\267\333\204\020\265P\256\227/\372\356\256\326N\210\356\274C\271\"e\331\302B\"\233-z\375>\237@\341\367\204K\377\\\024\253H\257\332\264\370\217}eM4\262y\245\310%\352\225\363\203P\235\300=\314\272M\315\276\347\\1\272\2557\351\313\377\336\370\363(w\346\274\020\272\265\177\221\035{\212\357b\353/)\370\r\332\353|Ue\327\217h\274\026\314\351\330\037\276e\033B\214V\362\244eg\270\206~\240I\a\353}\005\315\331\315\003T\221W\355\207O\252\323\1776\234zE&\270,p\316\217\023\332s]\231\372\204tX\267\220E\344X\275\347\223,r\345\207T\n\271\304\001\3478\\,|nU\317\373\245gu,o"
