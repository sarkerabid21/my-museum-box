            }
            lines {
              text: "            : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      playerStateRef.current.camYaw = lookYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      playerStateRef.current.yaw ="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
