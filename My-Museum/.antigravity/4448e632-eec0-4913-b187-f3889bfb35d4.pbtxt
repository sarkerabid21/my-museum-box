      arguments_json: "{\"Description\":\"Support custom status nameplate labels and calm straight standing-still posture for offline avatars in avatarBuilder.ts\", \"Instruction\":\"Add AvatarBuildOptions with optional nameplateSubtitle and statusTone, and add standStill option to animateAvatarRig\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":39, \"ReplacementContent\":\"export interface AvatarBuildOptions {\\n  showNameplate?: boolean;\\n  showContactShadow?: boolean;\\n  nameplateSubtitle?: string;\\n  statusTone?: \'default\' | \'active\' | \'standing\';\\n}\\n\\n/**\\n * Builds a high-craft composite procedural 3D human avatar (16+ distinct sculpted parts)\\n * differentiated cleanly by Gender (\'man\' vs \'woman\'), hair style, tailored wardrobe,\\n * skin tone, colors, and curator accessories. Pivoted flush at bottom-center (y = 0).\\n */\\nexport function buildAvatarRig(\\n  config: AvatarConfig,\\n  options?: AvatarBuildOptions\\n): AvatarRig {\\n  if (isAbidSignatureAvatar(config)) {\\n    return buildAbidSignatureRig(config, options);\\n  }\", \"StartLine\":26, \"TargetContent\":\"/**\\n * Builds a high-craft composite procedural 3D human avatar (16+ distinct sculpted parts)\\n * differentiated cleanly by Gender (\'man\' vs \'woman\'), hair style, tailored wardrobe,\\n * skin tone, colors, and curator accessories. Pivoted flush at bottom-center (y = 0).\\n */\\nexport function buildAvatarRig(\\n  config: AvatarConfig,\\n  options?: { showNameplate?: boolean; showContactShadow?: boolean }\\n): AvatarRig {\\n  if (isAbidSignatureAvatar(config)) {\\n    return buildAbidSignatureRig(config, options);\\n  }\"}, {\"AllowMultiple\":false, \"EndLine\":706, \"ReplacementContent\":\"  // Optional floating museum nameplate sprite\\n  if (options?.showNameplate) {\\n    const labelTex = trackTex(\\n      createNameplateTexture(\\n        config.displayName || \'Visitor\',\\n        options.nameplateSubtitle ??\\n          (config.gender === \'woman\' ? \'Woman \302\267 Visitor\' : \'Man \302\267 Visitor\'),\\n        options.statusTone ?? \'default\'\\n      )\\n    );\\n    const spriteMat = trackMat(\\n      new THREE.SpriteMaterial({\\n        map: labelTex,\\n        transparent: true,\\n        depthTest: false,\\n      })\\n    );\\n    const sprite = new THREE.Sprite(spriteMat);\\n    sprite.scale.set(0.92, 0.23, 1);\\n    sprite.position.set(0, 2.08, 0);\\n    root.add(sprite);\\n  }\", \"StartLine\":687, \"TargetContent\":\"  // Optional floating museum nameplate sprite\\n  if (options?.showNameplate) {\\n    const labelTex = trackTex(\\n      createNameplateTexture(\\n        config.displayName || \'Visitor\',\\n        config.gender === \'woman\' ? \'Woman \302\267 Visitor\' : \'Man \302\267 Visitor\'\\n      )\\n    );\\n    const spriteMat = trackMat(\\n      new THREE.SpriteMaterial({\\n        map: labelTex,\\n        transparent: true,\\n        depthTest: false,\\n      })\\n    );\\n    const sprite = new THREE.Sprite(spriteMat);\\n    sprite.scale.set(0.92, 0.23, 1);\\n    sprite.position.set(0, 2.08, 0);\\n    root.add(sprite);\\n  }\"}, {\"AllowMultiple\":false, \"EndLine\":740, \"ReplacementContent\":\"function buildAbidSignatureRig(\\n  config: AvatarConfig,\\n  options?: AvatarBuildOptions\\n): AvatarRig {\", \"StartLine\":732, \"TargetContent\":\"function buildAbidSignatureRig(\\n  config: AvatarConfig,\\n  options?: { showNameplate?: boolean; showContactShadow?: boolean }\\n): AvatarRig {\"}, {\"AllowMultiple\":false, \"EndLine\":1456, \"ReplacementContent\":\"  // Floating nameplate sprite in museum view\\n  if (options?.showNameplate) {\\n    const labelTex = trackTex(\\n      createNameplateTexture(\\n        config.displayName || \'Ashfaq Sarker Abid\',\\n        options.nameplateSubtitle ?? \'Exclusive 3D Model\',\\n        options.statusTone ?? \'default\'\\n      )\\n    );\\n    const spriteMat = trackMat(\\n      new THREE.SpriteMaterial({\\n        map: labelTex,\\n        transparent: true,\\n        depthTest: false,\\n      })\\n    );\\n    const sprite = new THREE.Sprite(spriteMat);\\n    sprite.scale.set(0.96, 0.24, 1);\\n    sprite.position.set(0, 2.08, 0);\\n    root.add(sprite);\\n  }\", \"StartLine\":1437, \"TargetContent\":\"  // Floating nameplate sprite in museum view\\n  if (options?.showNameplate) {\\n    const labelTex = trackTex(\\n      createNameplateTexture(\\n        config.displayName || \'Ashfaq Sarker Abid\',\\n        \'Exclusive 3D Model\'\\n      )\\n    );\\n    const spriteMat = trackMat(\\n      new THREE.SpriteMaterial({\\n        map: labelTex,\\n        transparent: true,\\n        depthTest: false,\\n      })\\n    );\\n    const sprite = new THREE.Sprite(spriteMat);\\n    sprite.scale.set(0.96, 0.24, 1);\\n    sprite.position.set(0, 2.08, 0);\\n    root.add(sprite);\\n  }\"}, {\"AllowMultiple\":false, \"EndLine\":1703, \"ReplacementContent\":\"export function animateAvatarRig(\\n  rig: AvatarRig,\\n  speed: number,\\n  elapsed: number,\\n  delta: number,\\n  options?: { standStill?: boolean }\\n): void {\\n  const standStill = Boolean(options?.standStill);\\n  const isMoving = !standStill && speed > 0.08;\\n  const clampedDelta = Math.min(delta, 0.1);\\n  const damping = 1 - Math.exp(-10 * clampedDelta);\\n\\n  if (rig.isCustomGlb) {\\n    if (rig.mixer) {\\n      rig.mixer.update(isMoving ? clampedDelta * Math.max(0.85, speed * 0.32) : 0);\\n    }\\n    if (isMoving) {\\n      rig.stridePhase += clampedDelta * Math.min(11, 5.5 + speed * 1.15);\\n      const bob = Math.abs(Math.cos(rig.stridePhase)) * (rig.mixer ? 0.018 : 0.048);\\n      const swayZ = Math.sin(rig.stridePhase) * (rig.mixer ? 0.018 : 0.042);\\n      const leanX = rig.mixer ? 0.02 : 0.05;\\n      rig.bodyGroup.position.y += (bob - rig.bodyGroup.position.y) * damping;\\n      rig.bodyGroup.rotation.z += (swayZ - rig.bodyGroup.rotation.z) * damping;\\n      rig.bodyGroup.rotation.x += (leanX - rig.bodyGroup.rotation.x) * damping;\\n    } else {\\n      const breathe = standStill ? 0 : Math.sin(elapsed * 2.1) * 0.008;\\n      rig.bodyGroup.position.y += (breathe - rig.bodyGroup.position.y) * damping;\\n      rig.bodyGroup.rotation.z += (0 - rig.bodyGroup.rotation.z) * damping;\\n      rig.bodyGroup.rotation.x += (0 - rig.bodyGroup.rotation.x) * damping;\\n    }\\n    return;\\n  }\\n\\n  if (isMoving) {\\n    rig.stridePhase += clampedDelta * Math.min(11, 5.2 + speed * 1.15);\\n    const swing = Math.sin(rig.stridePhase) * rig.maxLegSwing;\\n    const armSwing = Math.sin(rig.stridePhase) * 0.38;\\n    const bob = Math.abs(Math.cos(rig.stridePhase)) * 0.028;\\n\\n    rig.leftLegPivot.rotation.x += (swing - rig.leftLegPivot.rotation.x) * damping;\\n    rig.rightLegPivot.rotation.x += (-swing - rig.rightLegPivot.rotation.x) * damping;\\n    rig.leftArmPivot.rotation.x += (-armSwing - rig.leftArmPivot.rotation.x) * damping;\\n    rig.rightArmPivot.rotation.x += (armSwing - rig.rightArmPivot.rotation.x) * damping;\\n    rig.bodyGroup.position.y += (bob - rig.bodyGroup.position.y) * damping;\\n  } else {\\n    const breathe = standStill ? 0 : Math.sin(elapsed * 2.1) * 0.008;\\n    const armIdle = standStill ? 0 : 0.04 * Math.sin(elapsed * 1.4);\\n    rig.leftLegPivot.rotation.x += (0 - rig.leftLegPivot.rotation.x) * damping;\\n    rig.rightLegPivot.rotation.x += (0 - rig.rightLegPivot.rotation.x) * damping;\\n    rig.leftArmPivot.rotation.x += (armIdle - rig.leftArmPivot.rotation.x) * damping;\\n    rig.rightArmPivot.rotation.x += (-armIdle - rig.rightArmPivot.rotation.x) * damping;\\n    rig.bodyGroup.position.y += (breathe - rig.bodyGroup.position.y) * damping;\\n  }\\n}\", \"StartLine\":1651, \"TargetContent\":\"export function animateAvatarRig(\\n  rig: AvatarRig,\\n  speed: number,\\n  elapsed: number,\\n  delta: number\\n): void {\\n  const isMoving = speed > 0.08;\\n  const clampedDelta = Math.min(delta, 0.1);\\n  const damping = 1 - Math.exp(-10 * clampedDelta);\\n\\n  if (rig.isCustomGlb) {\\n    if (rig.mixer) {\\n      rig.mixer.update(isMoving ? clampedDelta * Math.max(0.85, speed * 0.32) : 0);\\n    }\\n    if (isMoving) {\\n      rig.stridePhase += clampedDelta * Math.min(11, 5.5 + speed * 1.15);\\n      const bob = Math.abs(Math.cos(rig.stridePhase)) * (rig.mixer ? 0.018 : 0.048);\\n      const swayZ = Math.sin(rig.stridePhase) * (rig.mixer ? 0.018 : 0.042);\\n      const leanX = rig.mixer ? 0.02 : 0.05;\\n      rig.bodyGroup.position.y += (bob - rig.bodyGroup.position.y) * damping;\\n      rig.bodyGroup.rotation.z += (swayZ - rig.bodyGroup.rotation.z) * damping;\\n      rig.bodyGroup.rotation.x += (leanX - rig.bodyGroup.rotation.x) * damping;\\n    } else {\\n      const breathe = Math.sin(elapsed * 2.1) * 0.008;\\n      rig.bodyGroup.position.y += (breathe - rig.bodyGroup.position.y) * damping;\\n      rig.bodyGroup.rotation.z += (0 - rig.bodyGroup.rotation.z) * damping;\\n      rig.bodyGroup.rotation.x += (0 - rig.bodyGroup.rotation.x) * damping;\\n    }\\n    return;\\n  }\\n\\n  if (isMoving) {\\n    rig.stridePhase += clampedDelta * Math.min(11, 5.2 + speed * 1.15);\\n    const swing = Math.sin(rig.stridePhase) * rig.maxLegSwing;\\n    const armSwing = Math.sin(rig.stridePhase) * 0.38;\\n    const bob = Math.abs(Math.cos(rig.stridePhase)) * 0.028;\\n\\n    rig.leftLegPivot.rotation.x += (swing - rig.leftLegPivot.rotation.x) * damping;\\n    rig.rightLegPivot.rotation.x += (-swing - rig.rightLegPivot.rotation.x) * damping;\\n    rig.leftArmPivot.rotation.x += (-armSwing - rig.leftArmPivot.rotation.x) * damping;\\n    rig.rightArmPivot.rotation.x += (armSwing - rig.rightArmPivot.rotation.x) * damping;\\n    rig.bodyGroup.position.y += (bob - rig.bodyGroup.position.y) * damping;\\n  } else {\\n    const breathe = Math.sin(elapsed * 2.1) * 0.008;\\n    rig.leftLegPivot.rotation.x += (0 - rig.leftLegPivot.rotation.x) * damping;\\n    rig.rightLegPivot.rotation.x += (0 - rig.rightLegPivot.rotation.x) * damping;\\n    rig.leftArmPivot.rotation.x += (0.04 * Math.sin(elapsed * 1.4) - rig.leftArmPivot.rotation.x) * damping;\\n    rig.rightArmPivot.rotation.x += (-0.04 * Math.sin(elapsed * 1.4) - rig.rightArmPivot.rotation.x) * damping;\\n    rig.bodyGroup.position.y += (breathe - rig.bodyGroup.position.y) * damping;\\n  }\\n}\"}], \"TargetFile\":\"/src/three/avatarBuilder.ts\", \"toolAction\":\"Updating avatar builder nameplates and standing posture\", \"toolSummary\":\"Update src/three/avatarBuilder.ts\"}"
