            }
            lines {
              text: "      const vk = virtualKeysRef.current;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const forwardIn ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (k.KeyW || k.ArrowUp || vk.up ? 1 : 0) -"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (k.KeyS || k.ArrowDown || vk.down ? 1 : 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const strafeIn ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (k.KeyD || k.ArrowRight || vk.right ? 1 : 0) -"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (k.KeyA || k.ArrowLeft || vk.left ? 1 : 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const turnLeft = k.KeyQ ? 1 : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const turnRight = k.KeyE ? 1 : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (turnLeft || turnRight) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ps.camYaw += (turnLeft - turnRight) * 1.9 * delta;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const walkSpeed = k.ShiftLeft || k.ShiftRight ? 6.2 : 4.1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _forward.set(-Math.sin(ps.camYaw), 0, -Math.cos(ps.camYaw));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _right.set(Math.cos(ps.camYaw), 0, -Math.sin(ps.camYaw));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _move.set(0, 0, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _move.addScaledVector(_forward, forwardIn);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _move.addScaledVector(_right, strafeIn);"
