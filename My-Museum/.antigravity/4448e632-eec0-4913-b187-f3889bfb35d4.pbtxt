            arguments_json: "{\"CommandLine\":\"trap \'playwright-cli close\' EXIT\\nmkdir -p .playwright-cli\\n\\nplaywright-cli open --browser=chromium \\\"http://localhost:3000/?autostart=1\\\" && \\\\\\nplaywright-cli resize 1440 900 && \\\\\\nsleep 2\\n\\necho \\\"=== STEP 1: START INSIDE ROOM 1 ===\\\"\\nplaywright-cli eval \\\"() => { const d = document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.firstElementChild?.dataset || {}; const r = document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.dataset || {}; return JSON.stringify({ room: r.currentRoom, zone: r.zoneSymbol, x: d.playerX, z: d.playerZ, yaw: d.playerYaw, camYaw: d.camYaw, frames: d.frames }); }\\\"\\nplaywright-cli screenshot --filename=.playwright-cli/r1-room1-start.png\\n\\necho \\\"=== STEP 2: TURN LEFT (A) \342\200\224 VERIFY CAMERA + AVATAR BOTH ROTATE ===\\\"\\nplaywright-cli keydown KeyA && sleep 1.4 && playwright-cli keyup KeyA && sleep 0.4\\nplaywright-cli eval \\\"() => { const d = document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.firstElementChild?.dataset || {}; return JSON.stringify({ afterLeftTurn: true, yaw: d.playerYaw, camYaw: d.camYaw }); }\\\"\\n\\necho \\\"=== STEP 3: TURN AROUND TO FACE SOUTH EXIT DOOR, OPEN WITH [F], WALK OUTSIDE TO GARDEN & ROAD ===\\\"\\nplaywright-cli keydown KeyA && sleep 1.3 && playwright-cli keyup KeyA && sleep 0.3\\nplaywright-cli keydown KeyW && sleep 1.6 && playwright-cli keyup KeyW && sleep 0.5\\nplaywright-cli eval \\\"() => { const d = document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.firstElementChild?.dataset || {}; const dp = document.querySelector(\'[data-testid=\\\\\\\"door-prompt\\\\\\\"]\')?.textContent || \'none\'; return JSON.stringify({ nearDoor: dp, x: d.playerX, z: d.playerZ, camYaw: d.camYaw }); }\\\"\\n\\n# Press F to open the Room 1 Exit Door, then walk outside into the Garden & down to the Highway!\\nplaywright-cli press KeyF && sleep 0.6\\nplaywright-cli eval \\\"() => JSON.stringify({ openDoors: document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.dataset.openDoors })\\\"\\n\\nplaywright-cli keydown KeyW && sleep 5.5 && playwright-cli keyup KeyW && sleep 0.8\\nplaywright-cli eval \\\"() => { const d = document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.firstElementChild?.dataset || {}; const r = document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.dataset || {}; return JSON.stringify({ zone: r.zoneSymbol, x: d.playerX, z: d.playerZ, yaw: d.playerYaw, camYaw: d.camYaw, hail: document.querySelector(\'[data-testid=\\\\\\\"vehicle-hail-prompt\\\\\\\"]\')?.textContent || \'none\' }); }\\\"\\nplaywright-cli screenshot --filename=.playwright-cli/r1-garden-road.png\\n\\necho \\\"=== STEP 4: WAIT FOR NEARBY VEHICLE ON ROAD, PRESS [E] TO STOP & TALK ===\\\"\\nplaywright-cli keydown KeyW && sleep 2.2 && playwright-cli keyup KeyW && sleep 1.5\\nplaywright-cli eval \\\"() => { const d = document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.firstElementChild?.dataset || {}; return JSON.stringify({ x: d.playerX, z: d.playerZ, hail: document.querySelector(\'[data-testid=\\\\\\\"vehicle-hail-prompt\\\\\\\"]\')?.textContent || \'none\' }); }\\\"\\n\\n# Wait briefly if a vehicle is approaching, then press E\\nfor i in 1 2 3 4 5; do\\n  HAS_HAIL=$(playwright-cli eval \\\"() => document.querySelector(\'[data-testid=\\\\\\\"vehicle-hail-prompt\\\\\\\"]\') ? \'YES\' : \'NO\'\\\")\\n  echo \\\"Hail check $i: $HAS_HAIL\\\"\\n  if echo \\\"$HAS_HAIL\\\" | grep -q \\\"YES\\\"; then\\n    break\\n  fi\\n  sleep 1.2\\ndone\\n\\nplaywright-cli press KeyE && sleep 0.6\\nplaywright-cli eval \\\"() => JSON.stringify({ modalOpen: Boolean(document.querySelector(\'[data-testid=\\\\\\\"vehicle-talk-modal\\\\\\\"]\')), fareBefore: document.querySelector(\'[data-testid=\\\\\\\"quoted-fare\\\\\\\"]\')?.textContent, dialogue: document.querySelector(\'[data-testid=\\\\\\\"driver-dialogue\\\\\\\"]\')?.textContent })\\\"\\nplaywright-cli screenshot --filename=.playwright-cli/r1-vehicle-talk.png\\n\\necho \\\"=== STEP 5: BARGAIN FARE THEN CHINTAI & DRIVE TOWARD CHITTAGONG (CTG) ===\\\"\\nplaywright-cli run-code \'async (page) => {\\n  const bargainBtn = page.getByRole(\\\"button\\\", { name: /Bargain/i });\\n  if (await bargainBtn.isVisible()) {\\n    await bargainBtn.click();\\n    await page.waitForTimeout(300);\\n  }\\n  const fareAfter = await page.locator(\\\"[data-testid=\\\\\\\"quoted-fare\\\\\\\"]\\\").textContent().catch(() => \\\"n/a\\\");\\n  console.log(\\\"FARE_AFTER_BARGAIN:\\\", fareAfter);\\n  const chintaiBtn = page.getByRole(\\\"button\\\", { name: /Chintai/i });\\n  if (await chintaiBtn.isVisible()) {\\n    await chintaiBtn.click();\\n    await page.waitForTimeout(400);\\n  }\\n}\'\\nplaywright-cli eval \\\"() => JSON.stringify({ driving: document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.dataset.driving, banner: document.querySelector(\'[data-testid=\\\\\\\"driving-banner\\\\\\\"]\')?.textContent })\\\"\\n\\n# Drive forward along the highway with Shift boost to verify vehicle movement & minimap update!\\nplaywright-cli keydown ShiftLeft && playwright-cli keydown KeyW && sleep 4.5 && playwright-cli keyup KeyW && playwright-cli keyup ShiftLeft && sleep 0.6\\nplaywright-cli eval \\\"() => { const d = document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.firstElementChild?.dataset || {}; const r = document.querySelector(\'[data-testid=\\\\\\\"museum-3d-view\\\\\\\"]\')?.dataset || {}; return JSON.stringify({ afterDrive: true, zone: r.zoneSymbol, x: d.playerX, z: d.playerZ, yaw: d.playerYaw, camYaw: d.camYaw }); }\\\"\\nplaywright-cli screenshot --filename=.playwright-cli/r1-driving-ctg.png\\n\\necho \\\"=== CONSOLE LOGS ===\\\"\\nplaywright-cli console\\n\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Running browser verification of museum exit, outdoor road, vehicles, and minimap\", \"toolSummary\":\"Run Playwright R1 verification\"}"
