    replacement_infos {
      original_chunk {
        target_content: "  // Hot-swap sculpted 3D avatar when customization changes without tearing down WebGL\n  useEffect(() => {\n    const slot = avatarSlotRef.current;\n    if (!slot) return;\n    if (currentRigRef.current) {\n      slot.remove(currentRigRef.current.root);\n      currentRigRef.current.dispose();\n    }\n    const nextRig = buildAvatarRig(avatar, { showNameplate: false, showContactShadow: true });\n    slot.add(nextRig.root);\n    currentRigRef.current = nextRig;\n    requestRenderRef.current?.();\n  }, [avatar]);"
        replacement_content: "  // Hot-swap sculpted 3D avatar (or exclusive Tripo GLB) without tearing down WebGL\n  useEffect(() => {\n    const slot = avatarSlotRef.current;\n    if (!slot) return;\n    let cancelled = false;\n\n    const mountRig = (nextRig: AvatarRig) => {\n      if (cancelled) {\n        nextRig.dispose();\n        return;\n      }\n      if (currentRigRef.current) {\n        slot.remove(currentRigRef.current.root);\n        currentRigRef.current.dispose();\n      }\n      slot.add(nextRig.root);\n      currentRigRef.current = nextRig;\n      requestRenderRef.current?.();\n    };\n\n    if (customGlbBuffer) {\n      void buildCustomGlbAvatarRig(customGlbBuffer, avatar, {\n        showNameplate: false,\n        showContactShadow: true,\n      })\n        .then(mountRig)\n        .catch(() => {\n          mountRig(buildAvatarRig(avatar, { showNameplate: false, showContactShadow: true }));\n        });\n    } else {\n      mountRig(buildAvatarRig(avatar, { showNameplate: false, showContactShadow: true }));\n    }\n\n    return () => {\n      cancelled = true;\n    };\n  }, [avatar, customGlbBuffer]);"
        start_line: 274
        end_line: 287
      }
      num_matches: 1
    }
