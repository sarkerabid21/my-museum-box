              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const handleResize = () => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!container || disposed) return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
