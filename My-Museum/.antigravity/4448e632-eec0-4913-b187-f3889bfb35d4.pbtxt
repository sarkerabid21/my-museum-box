      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Separate getDoc and batch.commit error reporting in ensurePersonalMuseum so diagnostics report exact operation type\", \"EndLine\":189, \"Instruction\":\"Track step phase (GET vs CREATE) in ensurePersonalMuseum so handleFirestoreError reports the exact failing operation\", \"ReplacementContent\":\"export async function ensurePersonalMuseum(\\n  user: User,\\n  ownerName: string\\n): Promise<MuseumMeta> {\\n  const museumId = sanitizeId(`museum_${user.uid}`);\\n  const museumPath = `museums/${museumId}`;\\n  let opType = OperationType.GET;\\n  try {\\n    const snap = await getDoc(doc(db, \'museums\', museumId));\\n    if (snap.exists()) {\\n      return mapMuseumDoc(snap.id, snap.data());\\n    }\\n\\n    opType = OperationType.CREATE;\\n    const safeOwner = (ownerName || user.displayName || \'Curator\').trim().slice(0, 80);\\n    const accessCode = generateAccessCode(user.uid);\\n    const title = `${safeOwner.split(\' \')[0]}\'s Museum`.slice(0, 100);\\n    const description =\\n      \'Personal 3D architectural gallery showcasing curated artworks and chronological photographic memories.\';\\n\\n    const batch = writeBatch(db);\\n    const museumRef = doc(db, \'museums\', museumId);\\n    batch.set(museumRef, {\\n      ownerId: user.uid,\\n      ownerName: safeOwner,\\n      title,\\n      description,\\n      accessCode,\\n      wallTheme: \'alabaster\',\\n      isOpenByCode: false,\\n      memberEmails: [],\\n      curatorEmails: [],\\n      artworkCount: 0,\\n      roomNames: {},\\n      createdAt: serverTimestamp(),\\n      updatedAt: serverTimestamp(),\\n    });\\n\\n    const codeRef = doc(db, \'museumCodes\', accessCode);\\n    batch.set(codeRef, {\\n      accessCode,\\n      museumId,\\n      ownerId: user.uid,\\n      title,\\n      createdAt: serverTimestamp(),\\n    });\\n\\n    await batch.commit();\\n\\n    return {\\n      id: museumId,\\n      ownerId: user.uid,\\n      ownerName: safeOwner,\\n      title,\\n      description,\\n      accessCode,\\n      wallTheme: \'alabaster\',\\n      isOpenByCode: false,\\n      memberEmails: [],\\n      curatorEmails: [],\\n      artworkCount: 0,\\n      roomNames: {},\\n    };\\n  } catch (error) {\\n    handleFirestoreError(error, opType, museumPath);\\n  }\\n}\", \"StartLine\":124, \"TargetContent\":\"export async function ensurePersonalMuseum(\\n  user: User,\\n  ownerName: string\\n): Promise<MuseumMeta> {\\n  const museumId = sanitizeId(`museum_${user.uid}`);\\n  const museumPath = `museums/${museumId}`;\\n  try {\\n    const snap = await getDoc(doc(db, \'museums\', museumId));\\n    if (snap.exists()) {\\n      return mapMuseumDoc(snap.id, snap.data());\\n    }\\n\\n    const safeOwner = (ownerName || user.displayName || \'Curator\').trim().slice(0, 80);\\n    const accessCode = generateAccessCode(user.uid);\\n    const title = `${safeOwner.split(\' \')[0]}\'s Museum`.slice(0, 100);\\n    const description =\\n      \'Personal 3D architectural gallery showcasing curated artworks and chronological photographic memories.\';\\n\\n    const batch = writeBatch(db);\\n    const museumRef = doc(db, \'museums\', museumId);\\n    batch.set(museumRef, {\\n      ownerId: user.uid,\\n      ownerName: safeOwner,\\n      title,\\n      description,\\n      accessCode,\\n      wallTheme: \'alabaster\',\\n      isOpenByCode: false,\\n      memberEmails: [],\\n      curatorEmails: [],\\n      artworkCount: 0,\\n      roomNames: {},\\n      createdAt: serverTimestamp(),\\n      updatedAt: serverTimestamp(),\\n    });\\n\\n    const codeRef = doc(db, \'museumCodes\', accessCode);\\n    batch.set(codeRef, {\\n      accessCode,\\n      museumId,\\n      ownerId: user.uid,\\n      title,\\n      createdAt: serverTimestamp(),\\n    });\\n\\n    await batch.commit();\\n\\n    return {\\n      id: museumId,\\n      ownerId: user.uid,\\n      ownerName: safeOwner,\\n      title,\\n      description,\\n      accessCode,\\n      wallTheme: \'alabaster\',\\n      isOpenByCode: false,\\n      memberEmails: [],\\n      curatorEmails: [],\\n      artworkCount: 0,\\n      roomNames: {},\\n    };\\n  } catch (error) {\\n    handleFirestoreError(error, OperationType.CREATE, museumPath);\\n  }\\n}\", \"TargetFile\":\"/src/services/museumService.ts\", \"toolAction\":\"Refining error reporting in museumService.ts\", \"toolSummary\":\"Track exact opType in ensurePersonalMuseum\"}"
