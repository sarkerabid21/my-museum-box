        instruction: "Make ensurePersonalMuseum strictly private and empty with roomNames, map roomNames in mapMuseumDoc, and add updateMuseumRoomNames helper"
        is_edit: true
        file {
          absolute_uri: "file:///src/services/museumService.ts"
