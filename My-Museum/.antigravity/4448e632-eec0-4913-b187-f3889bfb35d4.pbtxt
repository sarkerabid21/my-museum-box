  code_action {
    action_spec {
      create_file {
        instruction: "import * as THREE from \'three\';\nimport type { ArtworkItem, FrameStyle, WallTheme } from \'../types/museum\';\nimport {\n  formatAccessionNumber,\n  getArtworkPlacement,\n  HALL_HALF_WIDTH,\n  HALL_HEIGHT,\n  HALL_WIDTH,\n  type MuseumLayout,\n} from \'../museum/layout\';\nimport {\n  createFallbackArtworkTexture,\n  createMarbleFloorTextures,\n  createPlaqueTexture,\n  createPlasterWallTexture,\n} from \'./proceduralTextures\';\n\nexport interface BuiltMuseum {\n  group: THREE.Group;\n  interactables: THREE.Object3D[];\n  dispose: () => void;\n}\n\nconst WALL_PALETTES: Record<\n  WallTheme,\n  { wall: string; ceiling: string; trim: number; baseboard: number; fog: number }\n> = {\n  alabaster: {\n    wall: \'#F3EFE8\',\n    ceiling: \'#ECE6DC\',\n    trim: 0xd8cfc2,\n    baseboard: 0x3b2d23,\n    fog: 0xeae4da,\n  },\n  travertine: {\n    wall: \'#E6DDD0\',\n    ceiling: \'#DDD2C2\',\n    trim: 0xc5b7a3,\n    baseboard: 0x2f251d,\n    fog: 0xdfd5c7,\n  },\n  charcoal: {\n    wall: \'#2A2724\',\n    ceiling: \'#1F1D1B\',\n    trim: 0x453f39,\n    baseboard: 0x161412,\n    fog: 0x221f1c,\n  },\n};\n\nconst FRAME_COLORS: Record<FrameStyle, { color: number; metalness: number; roughness: number }> = {\n  bronze: { color: 0xa67c46, metalness: 0.78, roughness: 0.28 },\n  walnut: { color: 0x4b3121, metalness: 0.08, roughness: 0.56 },\n  obsidian: { color: 0x1e1c1a, metalness: 0.22, roughness: 0.36 },\n  alabaster: { color: 0xece7de, metalness: 0.05, roughness: 0.62 },\n};\n\n/**\n * Dynamically constructs the complete 3D architectural museum from layout & artworks.\n * Automatically grows north walls, marble floors, pilasters, skylights, benches, and\n * gallery lighting tracks as bayCount expands with each newly uploaded artwork.\n */\nexport function buildMuseumArchitecture(\n  layout: MuseumLayout,\n  artworks: ArtworkItem[],\n  wallTheme: WallTheme,\n  maxAnisotropy: number,\n  onTextureReady?: () => void\n): BuiltMuseum {\n  const group = new THREE.Group();\n  const interactables: THREE.Object3D[] = [];\n  const disposables: { dispose: () => void }[] = [];\n\n  const trackGeo = <T extends THREE.BufferGeometry>(g: T): T => {\n    disposables.push(g);\n    return g;\n  };\n  const trackMat = <T extends THREE.Material>(m: T): T => {\n    disposables.push(m);\n    return m;\n  };\n  const trackTex = <T extends THREE.Texture>(t: T): T => {\n    disposables.push(t);\n    return t;\n  };\n\n  const palette = WALL_PALETTES[wallTheme];\n  const centerZ = (layout.southWallZ + layout.northWallZ) / 2;\n\n  // --- FLOOR (Veined Travertine Marble Tiles) ---\n  const floorTex = createMarbleFloorTextures(maxAnisotropy);\n  trackTex(floorTex.map);\n  trackTex(floorTex.bumpMap);\n  const repeatX = HALL_WIDTH / 3.4;\n  const repeatZ = layout.totalLength / 3.4;\n  floorTex.map.repeat.set(repeatX, repeatZ);\n  floorTex.bumpMap.repeat.set(repeatX, repeatZ);\n\n  const floorMat = trackMat(\n    new THREE.MeshStandardMaterial({\n      color: 0xffffff,\n      map: floorTex.map,\n      bumpMap: floorTex.bumpMap,\n      bumpScale: 0.015,\n      roughness: 0.28,\n      metalness: 0.06,\n    })\n  );\n\n  const floor = new THREE.Mesh(\n    trackGeo(new THREE.PlaneGeometry(HALL_WIDTH, layout.totalLength)),\n    floorMat\n  );\n  floor.rotation.x = -Math.PI / 2;\n  floor.position.set(0, 0, centerZ);\n  floor.receiveShadow = true;\n  group.add(floor);\n\n  // Center architectural runner border inlay (offset +0.02 on Y to prevent Z-fighting)\n  const runnerMat = trackMat(\n    new THREE.MeshStandardMaterial({\n      color: wallTheme === \'charcoal\' ? 0x3a342e : 0xd5cbbd,\n      roughness: 0.45,\n      metalness: 0.05,\n    })\n  );\n  const runner = new THREE.Mesh(\n    trackGeo(new THREE.PlaneGeometry(4.4, layout.totalLength - 3.6)),\n    runnerMat\n  );\n  runner.rotation.x = -Math.PI / 2;\n  runner.position.set(0, 0.018, centerZ);\n  runner.receiveShadow = true;\n  group.add(runner);\n\n  // --- GALLERY WALLS (Expandable East, West, North, South) ---\n  const wallTex = trackTex(createPlasterWallTexture(palette.wall, maxAnisotropy));\n  wallTex.repeat.set(layout.totalLength / 6, 2);\n\n  const wallMat = trackMat(\n    new THREE.MeshStandardMaterial({\n      color: 0xffffff,\n      map: wallTex,\n      roughness: 0.88,\n      metalness: 0.02,\n    })\n  );\n\n  const trimMat = trackMat(\n    new THREE.MeshStandardMaterial({\n      color: palette.trim,\n      roughness: 0.58,\n      metalness: 0.08,\n    })\n  );\n\n  const baseboardMat = trackMat(\n    new THREE.MeshStandardMaterial({\n      color: palette.baseboard,\n      roughness: 0.48,\n      metalness: 0.1,\n    })\n  );\n\n  const brassMat = trackMat(\n    new THREE.MeshStandardMaterial({\n      color: 0xc2975c,\n      roughness: 0.24,\n      metalness: 0.88,\n    })\n  );\n\n  const sideWallGeo = trackGeo(new THREE.BoxGeometry(0.4, HALL_HEIGHT, layout.totalLength));\n  const westWall = new THREE.Mesh(sideWallGeo, wallMat);\n  westWall.position.set(-HALL_HALF_WIDTH - 0.2, HALL_HEIGHT / 2, centerZ);\n  westWall.receiveShadow = true;\n  group.add(westWall);\n\n  const eastWall = new THREE.Mesh(sideWallGeo, wallMat);\n  eastWall.position.set(HALL_HALF_WIDTH + 0.2, HALL_HEIGHT / 2, centerZ);\n  eastWall.receiveShadow = true;\n  group.add(eastWall);\n\n  const endWallGeo = trackGeo(new THREE.BoxGeometry(HALL_WIDTH + 0.8, HALL_HEIGHT, 0.4));\n  const northWall = new THREE.Mesh(endWallGeo, wallMat);\n  northWall.position.set(0, HALL_HEIGHT / 2, layout.northWallZ - 0.2);\n  northWall.receiveShadow = true;\n  group.add(northWall);\n\n  const southWall = new THREE.Mesh(endWallGeo, wallMat);\n  southWall.position.set(0, HALL_HEIGHT / 2, layout.southWallZ + 0.2);\n  group.add(southWall);\n\n  // Walnut Baseboards & Upper Cornices along side walls\n  const sideBaseGeo = trackGeo(new THREE.BoxGeometry(0.12, 0.32, layout.totalLength));\n  const sideCorniceGeo = trackGeo(new THREE.BoxGeometry(0.24, 0.28, layout.totalLength));\n  for (const s of [-1, 1]) {\n    const base = new THREE.Mesh(sideBaseGeo, baseboardMat);\n    base.position.set(s * (HALL_HALF_WIDTH - 0.04), 0.16, centerZ);\n    group.add(base);\n\n    const cornice = new THREE.Mesh(sideCorniceGeo, trimMat);\n    cornice.position.set(s * (HALL_HALF_WIDTH - 0.1), HALL_HEIGHT - 0.14, centerZ);\n    group.add(cornice);\n  }\n\n  // --- CEILING, COFFERED BEAMS & LUMINOUS SKYLIGHTS ---\n  const ceilingMat = trackMat(\n    new THREE.MeshStandardMaterial({\n      color: palette.ceiling,\n      roughness: 0.9,\n      metalness: 0.02,\n    })\n  );\n  const ceiling = new THREE.Mesh(\n    trackGeo(new THREE.PlaneGeometry(HALL_WIDTH + 0.4, layout.totalLength + 0.4)),\n    ceilingMat\n  );\n  ceiling.rotation.x = Math.PI / 2;\n  ceiling.position.set(0, HALL_HEIGHT, centerZ);\n  group.add(ceiling);\n\n  const skylightMat = trackMat(\n    new THREE.MeshStandardMaterial({\n      color: 0xfffcf5,\n      emissive: new THREE.Color(0xfff5e4),\n      emissiveIntensity: wallTheme === \'charcoal\' ? 0.55 : 0.82,\n      roughness: 0.2,\n      metalness: 0.05,\n    })\n  );\n\n  // Reusable architectural geometries for dynamic gallery bays\n  const columnShaftGeo = trackGeo(new THREE.CylinderGeometry(0.28, 0.31, HALL_HEIGHT - 0.9, 16));\n  const columnBaseGeo = trackGeo(new THREE.BoxGeometry(0.84, 0.48, 0.84));\n  const columnCapGeo = trackGeo(new THREE.BoxGeometry(0.88, 0.38, 0.88));\n  const crossBeamGeo = trackGeo(new THREE.BoxGeometry(HALL_WIDTH, 0.36, 0.52));\n  const skylightGeo = trackGeo(new THREE.PlaneGeometry(5.6, layout.bayLength - 2.1));\n  const trackRailGeo = trackGeo(new THREE.BoxGeometry(0.08, 0.08, layout.totalLength - 2));\n\n  // Overhead gallery lighting track rails\n  const trackMat = trackMat(\n    new THREE.MeshStandardMaterial({ color: 0x1c1917, roughness: 0.42, metalness: 0.55 })\n  );\n  for (const s of [-1, 1]) {\n    const rail = new THREE.Mesh(trackRailGeo, trackMat);\n    rail.position.set(s * (HALL_HALF_WIDTH - 2.15), HALL_HEIGHT - 0.38, centerZ);\n    group.add(rail);\n  }\n\n  // Construct architectural dividers (Fluted Columns + Coffered Beams + Skylights) per dynamic Bay\n  for (let b = 0; b <= layout.bayCount; b++) {\n    const dividerZ = -(b * layout.bayLength);\n\n    // Transverse ceiling beam\n    const beam = new THREE.Mesh(crossBeamGeo, trimMat);\n    beam.position.set(0, HALL_HEIGHT - 0.18, dividerZ);\n    group.add(beam);\n\n    // Flanking architectural marble pilasters\n    for (const s of [-1, 1]) {\n      const colX = s * (HALL_HALF_WIDTH - 0.38);\n      const base = new THREE.Mesh(columnBaseGeo, trimMat);\n      base.position.set(colX, 0.24, dividerZ);\n      group.add(base);\n\n      const shaft = new THREE.Mesh(columnShaftGeo, trimMat);\n      shaft.position.set(colX, HALL_HEIGHT / 2, dividerZ);\n      shaft.castShadow = true;\n      group.add(shaft);\n\n      const cap = new THREE.Mesh(columnCapGeo, trimMat);\n      cap.position.set(colX, HALL_HEIGHT - 0.35, dividerZ);\n      group.add(cap);\n    }\n\n    // Skylight panel centered over each Bay\n    if (b < layout.bayCount) {\n      const bayCenterZ = -(b * layout.bayLength + layout.bayLength * 0.5);\n      const skylight = new THREE.Mesh(skylightGeo, skylightMat);\n      skylight.rotation.x = Math.PI / 2;\n      skylight.position.set(0, HALL_HEIGHT - 0.04, bayCenterZ);\n      group.add(skylight);\n    }\n  }\n\n  // --- ENTRANCE FOYER PORTAL (South Wall) & GRAND NORTH FEATURE ALCOVE ---\n  const doorFrameMat = trackMat(\n    new THREE.MeshStandardMaterial({ color: 0x3b2a1e, roughness: 0.45, metalness: 0.12 })\n  );\n  const portalArch = new THREE.Mesh(\n    trackGeo(new THREE.BoxGeometry(4.2, 4.4, 0.32)),\n    doorFrameMat\n  );\n  portalArch.position.set(0, 2.2, layout.southWallZ - 0.08);\n  group.add(portalArch);\n\n  for (const s of [-1, 1]) {\n    const handle = new THREE.Mesh(trackGeo(new THREE.CylinderGeometry(0.03, 0.03, 0.72, 10)), brassMat);\n    handle.position.set(s * 0.28, 1.55, layout.southWallZ - 0.28);\n    group.add(handle);\n  }\n\n  // Grand North End Feature Pedestal & Abstract Bronze Sculpture (Landmark Vista!)\n  const plinth = new THREE.Mesh(\n    trackGeo(new THREE.BoxGeometry(1.6, 1.15, 1.6)),\n    trimMat\n  );\n  plinth.position.set(0, 0.575, layout.northWallZ + 1.5);\n  plinth.castShadow = true;\n  plinth.receiveShadow = true;\n  group.add(plinth);\n\n  const sculptureRing = new THREE.Mesh(\n    trackGeo(new THREE.TorusGeometry(0.62, 0.11, 16, 36)),\n    brassMat\n  );\n  sculptureRing.position.set(0, 1.98, layout.northWallZ + 1.5);\n  sculptureRing.rotation.y = Math.PI * 0.18;\n  sculptureRing.castShadow = true;\n  group.add(sculptureRing);\n\n  const sculptureCore = new THREE.Mesh(\n    trackGeo(new THREE.OctahedronGeometry(0.28, 1)),\n    trackMat(new THREE.MeshStandardMaterial({ color: 0x292524, roughness: 0.25, metalness: 0.65 }))\n  );\n  sculptureCore.position.set(0, 1.98, layout.northWallZ + 1.5);\n  group.add(sculptureCore);\n\n  // North End architectural wall arch frame\n  const northArch = new THREE.Mesh(\n    trackGeo(new THREE.BoxGeometry(5.2, 4.8, 0.18)),\n    trimMat\n  );\n  northArch.position.set(0, 2.55, layout.northWallZ + 0.06);\n  group.add(northArch);\n\n  const northInner = new THREE.Mesh(\n    trackGeo(new THREE.BoxGeometry(4.5, 4.2, 0.2)),\n    trackMat(\n      new THREE.MeshStandardMaterial({\n        color: wallTheme === \'charcoal\' ? 0x1b1917 : 0xe3dcd1,\n        roughness: 0.85,\n      })\n    )\n  );\n  northInner.position.set(0, 2.55, layout.northWallZ + 0.08);\n  group.add(northInner);\n\n  // --- VELVET MUSEUM GALLERY BENCHES ---\n  const cushionMat = trackMat(\n    new THREE.MeshStandardMaterial({\n      color: wallTheme === \'charcoal\' ? 0x5c3e2b : 0x3b3531,\n      roughness: 0.82,\n      metalness: 0.04,\n    })\n  );\n  const benchSeatGeo = trackGeo(new THREE.BoxGeometry(1.55, 0.22, 2.35));\n  const benchLegGeo = trackGeo(new THREE.BoxGeometry(0.1, 0.42, 0.1));\n\n  for (const bench of layout.benches) {\n    const benchGroup = new THREE.Group();\n    benchGroup.position.set(0, 0, bench.centerZ);\n\n    const seat = new THREE.Mesh(benchSeatGeo, cushionMat);\n    seat.position.y = 0.52;\n    seat.castShadow = true;\n    seat.receiveShadow = true;\n    benchGroup.add(seat);\n\n    const railTrim = new THREE.Mesh(\n      trackGeo(new THREE.BoxGeometry(1.62, 0.06, 2.42)),\n      brassMat\n    );\n    railTrim.position.y = 0.4;\n    benchGroup.add(railTrim);\n\n    for (const lx of [-0.66, 0.66]) {\n      for (const lz of [-1.02, 1.02]) {\n        const leg = new THREE.Mesh(benchLegGeo, brassMat);\n        leg.position.set(lx, 0.21, lz);\n        benchGroup.add(leg);\n      }\n    }\n\n    group.add(benchGroup);\n  }\n\n  // --- FRAMED ARTWORKS ON DYNAMIC WALL SLOTS ---\n  const textureLoader = new THREE.TextureLoader();\n  textureLoader.setCrossOrigin(\'anonymous\');\n\n  const matBoardMaterial = trackMat(\n    new THREE.MeshStandardMaterial({ color: 0xfaf7f0, roughness: 0.9, metalness: 0.0 })\n  );\n  const lampBarMat = trackMat(\n    new THREE.MeshStandardMaterial({\n      color: 0xfff3dc,\n      emissive: new THREE.Color(0xffe9c2),\n      emissiveIntensity: 1.2,\n      roughness: 0.2,\n    })\n  );\n\n  for (let slot = 0; slot < layout.totalWallSlots; slot++) {\n    const placement = getArtworkPlacement(slot);\n    const artwork = artworks[slot];\n\n    const slotGroup = new THREE.Group();\n    slotGroup.position.set(placement.x, placement.y, placement.z);\n    slotGroup.rotation.y = placement.rotY;\n\n    if (!artwork) {\n      // Quiet architectural reserved wall slot showing expandable space ready for uploads\n      const outline = new THREE.Mesh(\n        trackGeo(new THREE.BoxGeometry(2.5, 1.85, 0.03)),\n        trackMat(\n          new THREE.MeshStandardMaterial({\n            color: wallTheme === \'charcoal\' ? 0x35312d : 0xe4ddd2,\n            roughness: 0.85,\n          })\n        )\n      );\n      slotGroup.add(outline);\n\n      const hook = new THREE.Mesh(trackGeo(new THREE.CylinderGeometry(0.03, 0.03, 0.08, 10)), brassMat);\n      hook.rotation.x = Math.PI / 2;\n      hook.position.set(0, 0.72, 0.03);\n      slotGroup.add(hook);\n\n      group.add(slotGroup);\n      continue;\n    }\n\n    const artW = artwork.aspectRatio === \'3:4\' ? 1.95 : artwork.aspectRatio === \'1:1\' ? 2.25 : 2.8;\n    const artH = artwork.aspectRatio === \'3:4\' ? 2.55 : artwork.aspectRatio === \'1:1\' ? 2.25 : 2.1;\n    const frameBorder = 0.14;\n    const matMargin = 0.16;\n    const outerW = artW + (frameBorder + matMargin) * 2;\n    const outerH = artH + (frameBorder + matMargin) * 2;\n\n    const fSpec = FRAME_COLORS[artwork.frameStyle] ?? FRAME_COLORS.bronze;\n    const frameMat = trackMat(\n      new THREE.MeshStandardMaterial({\n        color: fSpec.color,\n        roughness: fSpec.roughness,\n        metalness: fSpec.metalness,\n      })\n    );\n\n    // 4-part beveled architectural frame molding\n    const topBar = new THREE.Mesh(\n      trackGeo(new THREE.BoxGeometry(outerW, frameBorder, 0.14)),\n      frameMat\n    );\n    topBar.position.set(0, outerH / 2 - frameBorder / 2, 0.07);\n    slotGroup.add(topBar);\n\n    const botBar = new THREE.Mesh(\n      trackGeo(new THREE.BoxGeometry(outerW, frameBorder, 0.14)),\n      frameMat\n    );\n    botBar.position.set(0, -outerH / 2 + frameBorder / 2, 0.07);\n    slotGroup.add(botBar);\n\n    const leftBar = new THREE.Mesh(\n      trackGeo(new THREE.BoxGeometry(frameBorder, outerH - frameBorder * 2, 0.14)),\n      frameMat\n    );\n    leftBar.position.set(-outerW / 2 + frameBorder / 2, 0, 0.07);\n    slotGroup.add(leftBar);\n\n    const rightBar = new THREE.Mesh(\n      trackGeo(new THREE.BoxGeometry(frameBorder, outerH - frameBorder * 2, 0.14)),\n      frameMat\n    );\n    rightBar.position.set(outerW / 2 - frameBorder / 2, 0, 0.07);\n    slotGroup.add(rightBar);\n\n    // Archival linen mat backing\n    const matPlane = new THREE.Mesh(\n      trackGeo(new THREE.BoxGeometry(artW + matMargin * 2, artH + matMargin * 2, 0.05)),\n      matBoardMaterial\n    );\n    matPlane.position.set(0, 0, 0.03);\n    slotGroup.add(matPlane);\n\n    // Artwork Canvas Mesh with fallback texture immediately ready, then async image upgrade\n    const fallbackTex = trackTex(createFallbackArtworkTexture(artwork.title));\n    const artMat = trackMat(\n      new THREE.MeshStandardMaterial({\n        color: 0xffffff,\n        map: fallbackTex,\n        roughness: 0.62,\n        metalness: 0.02,\n      })\n    );\n\n    const artPlane = new THREE.Mesh(trackGeo(new THREE.PlaneGeometry(artW, artH)), artMat);\n    artPlane.position.set(0, 0, 0.068);\n    artPlane.userData.artworkId = artwork.id;\n    slotGroup.add(artPlane);\n    interactables.push(artPlane);\n\n    // Load real image texture cleanly\n    if (artwork.imageUrl) {\n      textureLoader.load(\n        artwork.imageUrl,\n        (loadedTex) => {\n          loadedTex.colorSpace = THREE.SRGBColorSpace;\n          loadedTex.anisotropy = maxAnisotropy;\n          if (artwork.cropMargin && artwork.cropMargin > 0) {\n            const m = artwork.cropMargin;\n            loadedTex.repeat.set(1 - m * 2, 1 - m * 2);\n            loadedTex.offset.set(m, m);\n          }\n          trackTex(loadedTex);\n          artMat.map = loadedTex;\n          artMat.needsUpdate = true;\n          onTextureReady?.();\n        },\n        undefined,\n        () => {\n          // Keep clean procedural fallback canvas texture\n        }\n      );\n    }\n\n    // Brass Museum Picture Light Bar above frame\n    const lampArm = new THREE.Mesh(\n      trackGeo(new THREE.BoxGeometry(0.08, 0.08, 0.34)),\n      brassMat\n    );\n    lampArm.position.set(0, outerH / 2 + 0.22, 0.16);\n    slotGroup.add(lampArm);\n\n    const lampHood = new THREE.Mesh(\n      trackGeo(new THREE.CylinderGeometry(0.04, 0.045, Math.min(1.3, artW * 0.55), 12)),\n      brassMat\n    );\n    lampHood.rotation.z = Math.PI / 2;\n    lampHood.position.set(0, outerH / 2 + 0.22, 0.34);\n    slotGroup.add(lampHood);\n\n    const lampGlow = new THREE.Mesh(\n      trackGeo(new THREE.BoxGeometry(Math.min(1.2, artW * 0.5), 0.025, 0.04)),\n      lampBarMat\n    );\n    lampGlow.position.set(0, outerH / 2 + 0.18, 0.34);\n    slotGroup.add(lampGlow);\n\n    // Museum Wall Accession Plaque mounted beside the frame\n    const accession = formatAccessionNumber(artwork.dateCaptured, slot);\n    const plaqueTex = trackTex(\n      createPlaqueTexture(artwork.title, artwork.artist, artwork.dateCaptured, accession, maxAnisotropy)\n    );\n    const plaque = new THREE.Mesh(\n      trackGeo(new THREE.BoxGeometry(0.62, 0.31, 0.025)),\n      trackMat(\n        new THREE.MeshStandardMaterial({\n          color: 0xffffff,\n          map: plaqueTex,\n          roughness: 0.5,\n          metalness: 0.04,\n        })\n      )\n    );\n    plaque.position.set(outerW / 2 + 0.45, -outerH / 2 + 0.35, 0.02);\n    plaque.userData.artworkId = artwork.id;\n    slotGroup.add(plaque);\n    interactables.push(plaque);\n\n    group.add(slotGroup);\n  }\n\n  return {\n    group,\n    interactables,\n    dispose: () => {\n      for (const d of disposables) {\n        d.dispose();\n      }\n    },\n  };\n}\n"
        path {
          absolute_uri: "file:///src/three/museumBuilder.ts"
        }
        overwrite: true
      }
    }
