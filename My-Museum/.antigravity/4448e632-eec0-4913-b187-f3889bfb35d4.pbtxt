            lines {
              text: " * Builds a high-craft composite procedural 3D human avatar (16+ distinct sculpted parts)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * differentiated cleanly by Gender (\'man\' vs \'woman\'), hair style, tailored wardrobe,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * skin tone, colors, and curator accessories. Pivoted flush at bottom-center (y = 0)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function buildAvatarRig("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
