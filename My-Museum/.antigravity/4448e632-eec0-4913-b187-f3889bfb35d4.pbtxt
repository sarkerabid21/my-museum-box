            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Adds room-specific shape architecture (chamfered octagonal corners, arched bays,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * walnut wainscoting, modernist fins, custom ceilings & floor inlays, flower vase centerpiece)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function buildRoomSpecificArchitecture("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  room: RoomDefinition,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  wallTheme: WallTheme,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  wallMat: THREE.Material,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  trimMat: THREE.Material,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  baseboardMat: THREE.Material,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  brassMat: THREE.Material,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  skylightMat: THREE.Material,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  trackGeo: <T extends THREE.BufferGeometry>(g: T) => T,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  trackMat: <T extends THREE.Material>(m: T) => T"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): THREE.Group {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const grp = new THREE.Group();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const palette = WALL_PALETTES[wallTheme];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cz = room.centerZ;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Unique floor inlay per room shape (offset +0.018 on Y to avoid Z-fighting)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const inlayMat = trackMat("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    new THREE.MeshStandardMaterial({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      color: palette.inlay,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      roughness: 0.42,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      metalness: 0.06,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    })"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (room.shape === \'rotunda\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 1. GRAND ROTUNDA: Chamfered octagonal corners + circular oculus dome + circular floor medallion"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const medallion = new THREE.Mesh(trackGeo(new THREE.RingGeometry(1.5, 4.4, 36)), inlayMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    medallion.rotation.x = -Math.PI / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    medallion.position.set(0, 0.018, cz);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grp.add(medallion);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const brassRing = new THREE.Mesh(trackGeo(new THREE.RingGeometry(4.4, 4.54, 36)), brassMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    brassRing.rotation.x = -Math.PI / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    brassRing.position.set(0, 0.022, cz);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grp.add(brassRing);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 4 Diagonal Chamfered Corner Walls creating an octagonal room plan"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const chamferGeo = trackGeo(new THREE.BoxGeometry(3.2, HALL_HEIGHT, 0.36));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const chamferCorners: [number, number, number][] = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      [-ROOM_HALF_WIDTH + 1.05, room.southZ - 1.05, Math.PI / 4],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
