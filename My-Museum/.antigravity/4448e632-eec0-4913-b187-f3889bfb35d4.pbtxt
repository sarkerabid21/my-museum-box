            }
            lines {
              text: "        const bloom = new THREE.Mesh("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          trackGeo(new THREE.DodecahedronGeometry(br, 1)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          i % 2 === 0 ? flameMat : goldFlameMat"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
