            }
            lines {
              text: "export function negotiateTalkSession(session: VehicleTalkSession): VehicleTalkSession {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!session.canBargainMore || session.askingFare <= session.minFare) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ...session,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      canBargainMore: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      driverLine: `Na bhai, \340\247\263${session.minFare} er niche jawa jabe na! Tel ar khoroch onek beshi.`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const nextStep = session.bargainStep + 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const drop = Math.max(10, Math.round(((session.askingFare - session.minFare) * 0.55) / 10) * 10);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const nextFare = Math.max(session.minFare, session.askingFare - drop);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const canBargainMore = nextFare > session.minFare && nextStep < 3;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const line = canBargainMore"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ? `Achha apnar jonno \340\247\263${nextFare} taka den mama, tar cheye kom hobe na.`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    : `Thik ache bhai, last kotha \340\247\263${nextFare} taka! Er kom korle loss hobe, uthe poren!`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
