      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Finalize hardened firestore.rules with Abid trusted circle access and non-PII presence online/standing state\", \"EndLine\":435, \"Instruction\":\"Update firestore.rules with verified trusted-circle access helpers and optional isOnline/memberKey presence validation\", \"ReplacementContent\":\"    function hasVerifiedEmail() {\\n      return isVerified() && request.auth.token.email is string;\\n    }\\n\\n    // Verified trusted-circle accounts pre-authorized for Abid\'s primary museum\\n    function isAbidTrustedCircleVisitor() {\\n      return hasVerifiedEmail() && (\\n        request.auth.token.email == \'abidsarker098@gmail.com\' ||\\n        request.auth.token.email == \'suraia475@gmail.com\'\\n      );\\n    }\\n\\n    function isAbidPrimaryOwner(ownerId) {\\n      return ownerId == \'CwufCmYF1kOQRybSTFLoktJuo8b2\';\\n    }\\n\\n    function getMuseum(museumId) {\\n      return get(/databases/$(database)/documents/museums/$(museumId));\\n    }\\n\\n    function museumExists(museumId) {\\n      return exists(/databases/$(database)/documents/museums/$(museumId));\\n    }\\n\\n    function canAccessMuseumData(mData) {\\n      return isSignedIn() && (\\n        mData.ownerId == request.auth.uid ||\\n        mData.isOpenByCode == true ||\\n        (hasVerifiedEmail() && request.auth.token.email in mData.memberEmails) ||\\n        (isAbidPrimaryOwner(mData.ownerId) && isAbidTrustedCircleVisitor())\\n      );\\n    }\\n\\n    function canCurateMuseum(museumId) {\\n      let mData = getMuseum(museumId).data;\\n      return isVerified() && (\\n        mData.ownerId == request.auth.uid ||\\n        (hasVerifiedEmail() && request.auth.token.email in mData.curatorEmails)\\n      );\\n    }\\n\\n    // --- Validation Blueprints ---\\n    function isValidUserProfile(data) {\\n      return data.keys().hasAll([\\n          \'uid\', \'displayName\', \'gender\', \'skinTone\', \'hairStyle\', \'hairColor\',\\n          \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.keys().hasOnly([\\n          \'uid\', \'displayName\', \'email\', \'gender\', \'skinTone\', \'hairStyle\', \'hairColor\',\\n          \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && isValidId(data.uid)\\n        && data.uid == request.auth.uid\\n        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80\\n        && (!(\'email\' in data) || (data.email is string && data.email.size() <= 160))\\n        && (data.gender == \'man\' || data.gender == \'woman\')\\n        && isHexColor(data.skinTone)\\n        && data.hairStyle is string && data.hairStyle.size() >= 1 && data.hairStyle.size() <= 32\\n        && isHexColor(data.hairColor)\\n        && data.outfitStyle is string && data.outfitStyle.size() >= 1 && data.outfitStyle.size() <= 32\\n        && isHexColor(data.outfitColor)\\n        && isHexColor(data.accentColor)\\n        && (data.accessory == \'none\' || data.accessory == \'glasses\' || data.accessory == \'scarf\' || data.accessory == \'lanyard\')\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidMuseum(data) {\\n      return data.keys().hasAll([\\n          \'ownerId\', \'ownerName\', \'title\', \'description\', \'accessCode\', \'wallTheme\',\\n          \'isOpenByCode\', \'memberEmails\', \'curatorEmails\', \'artworkCount\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.keys().hasOnly([\\n          \'ownerId\', \'ownerName\', \'title\', \'description\', \'accessCode\', \'wallTheme\',\\n          \'isOpenByCode\', \'memberEmails\', \'curatorEmails\', \'artworkCount\', \'roomNames\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && isValidId(data.ownerId)\\n        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100\\n        && data.description is string && data.description.size() <= 400\\n        && data.accessCode is string && data.accessCode.size() >= 4 && data.accessCode.size() <= 20 && data.accessCode.matches(\'^[A-Z0-9\\\\\\\\-]+$\')\\n        && (data.wallTheme == \'alabaster\' || data.wallTheme == \'travertine\' || data.wallTheme == \'charcoal\')\\n        && data.isOpenByCode is bool\\n        && isValidEmailList(data.memberEmails)\\n        && isValidEmailList(data.curatorEmails)\\n        && data.artworkCount is int && data.artworkCount >= 0 && data.artworkCount <= 200\\n        && (!(\'roomNames\' in data) || isValidRoomNames(data.roomNames))\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidMuseumCode(data, code) {\\n      return data.keys().hasAll([\'accessCode\', \'museumId\', \'ownerId\', \'title\', \'createdAt\'])\\n        && data.keys().hasOnly([\'accessCode\', \'museumId\', \'ownerId\', \'title\', \'createdAt\'])\\n        && data.accessCode == code\\n        && data.accessCode is string && data.accessCode.size() >= 4 && data.accessCode.size() <= 20 && data.accessCode.matches(\'^[A-Z0-9\\\\\\\\-]+$\')\\n        && isValidId(data.museumId)\\n        && isValidId(data.ownerId)\\n        && data.ownerId == request.auth.uid\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100\\n        && data.createdAt is timestamp;\\n    }\\n\\n    function isValidArtwork(data, museumId) {\\n      return data.keys().hasAll([\\n          \'museumId\', \'ownerId\', \'uploadedBy\', \'uploadedByName\', \'title\', \'artist\',\\n          \'dateCaptured\', \'notes\', \'imageUrl\', \'aspectRatio\', \'frameStyle\',\\n          \'isOpenByCode\', \'viewerEmails\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.keys().hasOnly([\\n          \'museumId\', \'ownerId\', \'uploadedBy\', \'uploadedByName\', \'title\', \'artist\',\\n          \'dateCaptured\', \'notes\', \'imageUrl\', \'aspectRatio\', \'frameStyle\',\\n          \'isOpenByCode\', \'viewerEmails\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.museumId == museumId\\n        && isValidId(data.museumId)\\n        && isValidId(data.ownerId)\\n        && isValidId(data.uploadedBy)\\n        && data.uploadedByName is string && data.uploadedByName.size() >= 1 && data.uploadedByName.size() <= 80\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120\\n        && data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 100\\n        && data.dateCaptured is string && data.dateCaptured.size() == 10 && data.dateCaptured.matches(\'^\\\\\\\\d{4}-\\\\\\\\d{2}-\\\\\\\\d{2}$\')\\n        && data.notes is string && data.notes.size() <= 500\\n        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 450000\\n        && (data.aspectRatio == \'4:3\' || data.aspectRatio == \'3:4\' || data.aspectRatio == \'1:1\')\\n        && (data.frameStyle == \'bronze\' || data.frameStyle == \'walnut\' || data.frameStyle == \'obsidian\' || data.frameStyle == \'alabaster\')\\n        && data.isOpenByCode is bool\\n        && isValidEmailList(data.viewerEmails)\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidMuseumMember(data, museumId) {\\n      return data.keys().hasAll([\'museumId\', \'ownerId\', \'email\', \'displayName\', \'role\', \'gender\', \'createdAt\'])\\n        && data.keys().hasOnly([\'museumId\', \'ownerId\', \'email\', \'displayName\', \'role\', \'gender\', \'createdAt\'])\\n        && data.museumId == museumId\\n        && isValidId(data.museumId)\\n        && isValidId(data.ownerId)\\n        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160\\n        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80\\n        && (data.role == \'visitor\' || data.role == \'curator\')\\n        && (data.gender == \'man\' || data.gender == \'woman\')\\n        && data.createdAt is timestamp;\\n    }\\n\\n    function isValidPresence(data, museumId, visitorId) {\\n      return data.keys().hasAll([\\n          \'museumId\', \'ownerId\', \'uid\', \'displayName\', \'gender\', \'skinTone\', \'hairStyle\',\\n          \'hairColor\', \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\',\\n          \'x\', \'z\', \'yaw\', \'isOpenByCode\', \'viewerEmails\', \'updatedAt\'\\n        ])\\n        && data.keys().hasOnly([\\n          \'museumId\', \'ownerId\', \'uid\', \'displayName\', \'gender\', \'skinTone\', \'hairStyle\',\\n          \'hairColor\', \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\',\\n          \'x\', \'z\', \'yaw\', \'isOnline\', \'memberKey\', \'isOpenByCode\', \'viewerEmails\', \'updatedAt\'\\n        ])\\n        && data.museumId == museumId\\n        && isValidId(data.museumId)\\n        && isValidId(data.ownerId)\\n        && data.uid == visitorId\\n        && data.uid == request.auth.uid\\n        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80\\n        && (data.gender == \'man\' || data.gender == \'woman\')\\n        && isHexColor(data.skinTone)\\n        && data.hairStyle is string && data.hairStyle.size() >= 1 && data.hairStyle.size() <= 32\\n        && isHexColor(data.hairColor)\\n        && data.outfitStyle is string && data.outfitStyle.size() >= 1 && data.outfitStyle.size() <= 32\\n        && isHexColor(data.outfitColor)\\n        && isHexColor(data.accentColor)\\n        && (data.accessory == \'none\' || data.accessory == \'glasses\' || data.accessory == \'scarf\' || data.accessory == \'lanyard\')\\n        && data.x is number && data.x >= -50 && data.x <= 50\\n        && data.z is number && data.z >= -600 && data.z <= 50\\n        && data.yaw is number && data.yaw >= -10 && data.yaw <= 10\\n        && (!(\'isOnline\' in data) || data.isOnline is bool)\\n        && (!(\'memberKey\' in data) || (data.memberKey is string && data.memberKey.size() >= 1 && data.memberKey.size() <= 32 && data.memberKey.matches(\'^[a-zA-Z0-9_\\\\\\\\-]+$\')))\\n        && data.isOpenByCode is bool\\n        && isValidEmailList(data.viewerEmails)\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    // --- Collection: /users/{userId} (Strict PII Isolation) ---\\n    match /users/{userId} {\\n      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);\\n      allow list: if false;\\n      allow create: if isVerified()\\n        && isValidId(userId)\\n        && isOwner(userId)\\n        && isValidUserProfile(incoming())\\n        && incoming().createdAt == request.time\\n        && incoming().updatedAt == request.time;\\n      allow update: if isVerified()\\n        && isValidId(userId)\\n        && isOwner(userId)\\n        && isValidUserProfile(incoming())\\n        && incoming().uid == existing().uid\\n        && incoming().createdAt == existing().createdAt\\n        && incoming().updatedAt == request.time\\n        && incoming().diff(existing()).affectedKeys().hasOnly([\\n          \'displayName\', \'email\', \'gender\', \'skinTone\', \'hairStyle\', \'hairColor\',\\n          \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\', \'updatedAt\'\\n        ]);\\n      allow delete: if isVerified() && isValidId(userId) && isOwner(userId);\\n    }\\n\\n    // --- Collection: /museumCodes/{code} ---\\n    match /museumCodes/{code} {\\n      allow get: if isSignedIn() && isValidId(code);\\n      allow list: if false;\\n      allow create: if isVerified()\\n        && isValidId(code)\\n        && isValidMuseumCode(incoming(), code)\\n        && incoming().createdAt == request.time\\n        && (\\n          (museumExists(incoming().museumId) && getMuseum(incoming().museumId).data.ownerId == request.auth.uid) ||\\n          (existsAfter(/databases/$(database)/documents/museums/$(incoming().museumId))\\n            && getAfter(/databases/$(database)/documents/museums/$(incoming().museumId)).data.ownerId == request.auth.uid)\\n        );\\n      allow update: if false;\\n      allow delete: if isVerified()\\n        && isValidId(code)\\n        && existing().ownerId == request.auth.uid;\\n    }\\n\\n    // --- Collection: /museums/{museumId} ---\\n    match /museums/{museumId} {\\n      allow get: if isSignedIn()\\n        && isValidId(museumId)\\n        && (\\n          (resource == null && museumId == \'museum_\' + request.auth.uid) ||\\n          (resource != null && canAccessMuseumData(existing()))\\n        );\\n      allow list: if isSignedIn() && (\\n        existing().ownerId == request.auth.uid ||\\n        (hasVerifiedEmail() && request.auth.token.email in existing().memberEmails) ||\\n        (isAbidPrimaryOwner(existing().ownerId) && isAbidTrustedCircleVisitor())\\n      );\\n      allow create: if isVerified()\\n        && isValidId(museumId)\\n        && isValidMuseum(incoming())\\n        && incoming().ownerId == request.auth.uid\\n        && incoming().createdAt == request.time\\n        && incoming().updatedAt == request.time;\\n      allow update: if isVerified()\\n        && isValidId(museumId)\\n        && isValidMuseum(incoming())\\n        && existing().ownerId == request.auth.uid\\n        && incoming().ownerId == existing().ownerId\\n        && incoming().accessCode == existing().accessCode\\n        && incoming().createdAt == existing().createdAt\\n        && incoming().updatedAt == request.time\\n        && (\\n          // Action: Update Museum Settings\\n          incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'description\', \'wallTheme\', \'isOpenByCode\', \'updatedAt\']) ||\\n          // Action: Update Custom Room Names\\n          incoming().diff(existing()).affectedKeys().hasOnly([\'roomNames\', \'updatedAt\']) ||\\n          // Action: Update Access & Curator Lists\\n          incoming().diff(existing()).affectedKeys().hasOnly([\'memberEmails\', \'curatorEmails\', \'updatedAt\']) ||\\n          // Action: Update Artwork Count\\n          incoming().diff(existing()).affectedKeys().hasOnly([\'artworkCount\', \'updatedAt\'])\\n        );\\n      allow delete: if isVerified()\\n        && isValidId(museumId)\\n        && existing().ownerId == request.auth.uid;\\n\\n      // --- Subcollection: /museums/{museumId}/artworks/{artworkId} ---\\n      match /artworks/{artworkId} {\\n        allow get: if isSignedIn()\\n          && isValidId(museumId)\\n          && isValidId(artworkId)\\n          && museumExists(museumId)\\n          && canAccessMuseumData(getMuseum(museumId).data);\\n        allow list: if isSignedIn() && (\\n          existing().ownerId == request.auth.uid ||\\n          existing().isOpenByCode == true ||\\n          (hasVerifiedEmail() && request.auth.token.email in existing().viewerEmails) ||\\n          (isAbidPrimaryOwner(existing().ownerId) && isAbidTrustedCircleVisitor())\\n        );\\n        allow create: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(artworkId)\\n          && isValidArtwork(incoming(), museumId)\\n          && incoming().uploadedBy == request.auth.uid\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time\\n          && museumExists(museumId)\\n          && getMuseum(museumId).data.ownerId == incoming().ownerId\\n          && canCurateMuseum(museumId);\\n        allow update: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(artworkId)\\n          && isValidArtwork(incoming(), museumId)\\n          && incoming().museumId == existing().museumId\\n          && incoming().ownerId == existing().ownerId\\n          && incoming().uploadedBy == existing().uploadedBy\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && museumExists(museumId)\\n          && (\\n            // Tier 1: Owner edits artwork metadata or syncs sharing flags\\n            (getMuseum(museumId).data.ownerId == request.auth.uid && (\\n              incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'artist\', \'dateCaptured\', \'notes\', \'frameStyle\', \'updatedAt\']) ||\\n              incoming().diff(existing()).affectedKeys().hasOnly([\'isOpenByCode\', \'viewerEmails\', \'updatedAt\'])\\n            )) ||\\n            // Tier 2: Co-curator edits own artwork metadata\\n            (existing().uploadedBy == request.auth.uid && canCurateMuseum(museumId) &&\\n              incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'artist\', \'dateCaptured\', \'notes\', \'frameStyle\', \'updatedAt\'])\\n            )\\n          );\\n        allow delete: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(artworkId)\\n          && museumExists(museumId)\\n          && (\\n            getMuseum(museumId).data.ownerId == request.auth.uid ||\\n            (existing().uploadedBy == request.auth.uid && canCurateMuseum(museumId))\\n          );\\n      }\\n\\n      // --- Subcollection: /museums/{museumId}/members/{memberId} ---\\n      match /members/{memberId} {\\n        allow get: if isSignedIn()\\n          && isValidId(museumId)\\n          && isValidId(memberId)\\n          && museumExists(museumId)\\n          && (\\n            getMuseum(museumId).data.ownerId == request.auth.uid ||\\n            (resource != null && hasVerifiedEmail() && existing().email == request.auth.token.email)\\n          );\\n        allow list: if isSignedIn() && (\\n          existing().ownerId == request.auth.uid ||\\n          (hasVerifiedEmail() && existing().email == request.auth.token.email)\\n        );\\n        allow create: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(memberId)\\n          && isValidMuseumMember(incoming(), museumId)\\n          && incoming().ownerId == request.auth.uid\\n          && incoming().createdAt == request.time\\n          && museumExists(museumId)\\n          && getMuseum(museumId).data.ownerId == request.auth.uid;\\n        allow update: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(memberId)\\n          && isValidMuseumMember(incoming(), museumId)\\n          && incoming().museumId == existing().museumId\\n          && incoming().ownerId == existing().ownerId\\n          && incoming().email == existing().email\\n          && incoming().createdAt == existing().createdAt\\n          && museumExists(museumId)\\n          && getMuseum(museumId).data.ownerId == request.auth.uid\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'displayName\', \'role\', \'gender\']);\\n        allow delete: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(memberId)\\n          && museumExists(museumId)\\n          && getMuseum(museumId).data.ownerId == request.auth.uid;\\n      }\\n\\n      // --- Subcollection: /museums/{museumId}/presence/{visitorId} ---\\n      match /presence/{visitorId} {\\n        allow get: if isSignedIn()\\n          && isValidId(museumId)\\n          && isValidId(visitorId)\\n          && museumExists(museumId)\\n          && canAccessMuseumData(getMuseum(museumId).data);\\n        allow list: if isSignedIn() && (\\n          existing().ownerId == request.auth.uid ||\\n          existing().uid == request.auth.uid ||\\n          existing().isOpenByCode == true ||\\n          (hasVerifiedEmail() && request.auth.token.email in existing().viewerEmails) ||\\n          (isAbidPrimaryOwner(existing().ownerId) && isAbidTrustedCircleVisitor())\\n        );\\n        allow create: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(visitorId)\\n          && visitorId == request.auth.uid\\n          && isValidPresence(incoming(), museumId, visitorId)\\n          && incoming().updatedAt == request.time\\n          && museumExists(museumId)\\n          && getMuseum(museumId).data.ownerId == incoming().ownerId\\n          && canAccessMuseumData(getMuseum(museumId).data);\\n        allow update: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(visitorId)\\n          && visitorId == request.auth.uid\\n          && isValidPresence(incoming(), museumId, visitorId)\\n          && incoming().museumId == existing().museumId\\n          && incoming().ownerId == existing().ownerId\\n          && incoming().uid == existing().uid\\n          && incoming().updatedAt == request.time\\n          && museumExists(museumId)\\n          && canAccessMuseumData(getMuseum(museumId).data)\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\\n            \'displayName\', \'gender\', \'skinTone\', \'hairStyle\', \'hairColor\',\\n            \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\',\\n            \'x\', \'z\', \'yaw\', \'isOnline\', \'memberKey\', \'isOpenByCode\', \'viewerEmails\', \'updatedAt\'\\n          ]);\\n        allow delete: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(visitorId)\\n          && visitorId == request.auth.uid;\\n      }\\n    }\\n  }\\n}\", \"StartLine\":48, \"TargetContent\":\"    function hasVerifiedEmail() {\\n      return isVerified() && request.auth.token.email is string;\\n    }\\n\\n    function getMuseum(museumId) {\\n      return get(/databases/$(database)/documents/museums/$(museumId));\\n    }\\n\\n    function museumExists(museumId) {\\n      return exists(/databases/$(database)/documents/museums/$(museumId));\\n    }\\n\\n    function canAccessMuseumData(mData) {\\n      return isSignedIn() && (\\n        mData.ownerId == request.auth.uid ||\\n        mData.isOpenByCode == true ||\\n        (hasVerifiedEmail() && request.auth.token.email in mData.memberEmails)\\n      );\\n    }\\n\\n    function canCurateMuseum(museumId) {\\n      let mData = getMuseum(museumId).data;\\n      return isVerified() && (\\n        mData.ownerId == request.auth.uid ||\\n        (hasVerifiedEmail() && request.auth.token.email in mData.curatorEmails)\\n      );\\n    }\\n\\n    // --- Validation Blueprints ---\\n    function isValidUserProfile(data) {\\n      return data.keys().hasAll([\\n          \'uid\', \'displayName\', \'gender\', \'skinTone\', \'hairStyle\', \'hairColor\',\\n          \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.keys().hasOnly([\\n          \'uid\', \'displayName\', \'email\', \'gender\', \'skinTone\', \'hairStyle\', \'hairColor\',\\n          \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && isValidId(data.uid)\\n        && data.uid == request.auth.uid\\n        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80\\n        && (!(\'email\' in data) || (data.email is string && data.email.size() <= 160))\\n        && (data.gender == \'man\' || data.gender == \'woman\')\\n        && isHexColor(data.skinTone)\\n        && data.hairStyle is string && data.hairStyle.size() >= 1 && data.hairStyle.size() <= 32\\n        && isHexColor(data.hairColor)\\n        && data.outfitStyle is string && data.outfitStyle.size() >= 1 && data.outfitStyle.size() <= 32\\n        && isHexColor(data.outfitColor)\\n        && isHexColor(data.accentColor)\\n        && (data.accessory == \'none\' || data.accessory == \'glasses\' || data.accessory == \'scarf\' || data.accessory == \'lanyard\')\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidMuseum(data) {\\n      return data.keys().hasAll([\\n          \'ownerId\', \'ownerName\', \'title\', \'description\', \'accessCode\', \'wallTheme\',\\n          \'isOpenByCode\', \'memberEmails\', \'curatorEmails\', \'artworkCount\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.keys().hasOnly([\\n          \'ownerId\', \'ownerName\', \'title\', \'description\', \'accessCode\', \'wallTheme\',\\n          \'isOpenByCode\', \'memberEmails\', \'curatorEmails\', \'artworkCount\', \'roomNames\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && isValidId(data.ownerId)\\n        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100\\n        && data.description is string && data.description.size() <= 400\\n        && data.accessCode is string && data.accessCode.size() >= 4 && data.accessCode.size() <= 20 && data.accessCode.matches(\'^[A-Z0-9\\\\\\\\-]+$\')\\n        && (data.wallTheme == \'alabaster\' || data.wallTheme == \'travertine\' || data.wallTheme == \'charcoal\')\\n        && data.isOpenByCode is bool\\n        && isValidEmailList(data.memberEmails)\\n        && isValidEmailList(data.curatorEmails)\\n        && data.artworkCount is int && data.artworkCount >= 0 && data.artworkCount <= 200\\n        && (!(\'roomNames\' in data) || isValidRoomNames(data.roomNames))\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidMuseumCode(data, code) {\\n      return data.keys().hasAll([\'accessCode\', \'museumId\', \'ownerId\', \'title\', \'createdAt\'])\\n        && data.keys().hasOnly([\'accessCode\', \'museumId\', \'ownerId\', \'title\', \'createdAt\'])\\n        && data.accessCode == code\\n        && data.accessCode is string && data.accessCode.size() >= 4 && data.accessCode.size() <= 20 && data.accessCode.matches(\'^[A-Z0-9\\\\\\\\-]+$\')\\n        && isValidId(data.museumId)\\n        && isValidId(data.ownerId)\\n        && data.ownerId == request.auth.uid\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100\\n        && data.createdAt is timestamp;\\n    }\\n\\n    function isValidArtwork(data, museumId) {\\n      return data.keys().hasAll([\\n          \'museumId\', \'ownerId\', \'uploadedBy\', \'uploadedByName\', \'title\', \'artist\',\\n          \'dateCaptured\', \'notes\', \'imageUrl\', \'aspectRatio\', \'frameStyle\',\\n          \'isOpenByCode\', \'viewerEmails\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.keys().hasOnly([\\n          \'museumId\', \'ownerId\', \'uploadedBy\', \'uploadedByName\', \'title\', \'artist\',\\n          \'dateCaptured\', \'notes\', \'imageUrl\', \'aspectRatio\', \'frameStyle\',\\n          \'isOpenByCode\', \'viewerEmails\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.museumId == museumId\\n        && isValidId(data.museumId)\\n        && isValidId(data.ownerId)\\n        && isValidId(data.uploadedBy)\\n        && data.uploadedByName is string && data.uploadedByName.size() >= 1 && data.uploadedByName.size() <= 80\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120\\n        && data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 100\\n        && data.dateCaptured is string && data.dateCaptured.size() == 10 && data.dateCaptured.matches(\'^\\\\\\\\d{4}-\\\\\\\\d{2}-\\\\\\\\d{2}$\')\\n        && data.notes is string && data.notes.size() <= 500\\n        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 450000\\n        && (data.aspectRatio == \'4:3\' || data.aspectRatio == \'3:4\' || data.aspectRatio == \'1:1\')\\n        && (data.frameStyle == \'bronze\' || data.frameStyle == \'walnut\' || data.frameStyle == \'obsidian\' || data.frameStyle == \'alabaster\')\\n        && data.isOpenByCode is bool\\n        && isValidEmailList(data.viewerEmails)\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidMuseumMember(data, museumId) {\\n      return data.keys().hasAll([\'museumId\', \'ownerId\', \'email\', \'displayName\', \'role\', \'gender\', \'createdAt\'])\\n        && data.keys().hasOnly([\'museumId\', \'ownerId\', \'email\', \'displayName\', \'role\', \'gender\', \'createdAt\'])\\n        && data.museumId == museumId\\n        && isValidId(data.museumId)\\n        && isValidId(data.ownerId)\\n        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160\\n        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80\\n        && (data.role == \'visitor\' || data.role == \'curator\')\\n        && (data.gender == \'man\' || data.gender == \'woman\')\\n        && data.createdAt is timestamp;\\n    }\\n\\n    function isValidPresence(data, museumId, visitorId) {\\n      return data.keys().hasAll([\\n          \'museumId\', \'ownerId\', \'uid\', \'displayName\', \'gender\', \'skinTone\', \'hairStyle\',\\n          \'hairColor\', \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\',\\n          \'x\', \'z\', \'yaw\', \'isOpenByCode\', \'viewerEmails\', \'updatedAt\'\\n        ])\\n        && data.keys().hasOnly([\\n          \'museumId\', \'ownerId\', \'uid\', \'displayName\', \'gender\', \'skinTone\', \'hairStyle\',\\n          \'hairColor\', \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\',\\n          \'x\', \'z\', \'yaw\', \'isOpenByCode\', \'viewerEmails\', \'updatedAt\'\\n        ])\\n        && data.museumId == museumId\\n        && isValidId(data.museumId)\\n        && isValidId(data.ownerId)\\n        && data.uid == visitorId\\n        && data.uid == request.auth.uid\\n        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80\\n        && (data.gender == \'man\' || data.gender == \'woman\')\\n        && isHexColor(data.skinTone)\\n        && data.hairStyle is string && data.hairStyle.size() >= 1 && data.hairStyle.size() <= 32\\n        && isHexColor(data.hairColor)\\n        && data.outfitStyle is string && data.outfitStyle.size() >= 1 && data.outfitStyle.size() <= 32\\n        && isHexColor(data.outfitColor)\\n        && isHexColor(data.accentColor)\\n        && (data.accessory == \'none\' || data.accessory == \'glasses\' || data.accessory == \'scarf\' || data.accessory == \'lanyard\')\\n        && data.x is number && data.x >= -50 && data.x <= 50\\n        && data.z is number && data.z >= -600 && data.z <= 50\\n        && data.yaw is number && data.yaw >= -10 && data.yaw <= 10\\n        && data.isOpenByCode is bool\\n        && isValidEmailList(data.viewerEmails)\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    // --- Collection: /users/{userId} (Strict PII Isolation) ---\\n    match /users/{userId} {\\n      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);\\n      allow list: if false;\\n      allow create: if isVerified()\\n        && isValidId(userId)\\n        && isOwner(userId)\\n        && isValidUserProfile(incoming())\\n        && incoming().createdAt == request.time\\n        && incoming().updatedAt == request.time;\\n      allow update: if isVerified()\\n        && isValidId(userId)\\n        && isOwner(userId)\\n        && isValidUserProfile(incoming())\\n        && incoming().uid == existing().uid\\n        && incoming().createdAt == existing().createdAt\\n        && incoming().updatedAt == request.time\\n        && incoming().diff(existing()).affectedKeys().hasOnly([\\n          \'displayName\', \'email\', \'gender\', \'skinTone\', \'hairStyle\', \'hairColor\',\\n          \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\', \'updatedAt\'\\n        ]);\\n      allow delete: if isVerified() && isValidId(userId) && isOwner(userId);\\n    }\\n\\n    // --- Collection: /museumCodes/{code} ---\\n    match /museumCodes/{code} {\\n      allow get: if isSignedIn() && isValidId(code);\\n      allow list: if false;\\n      allow create: if isVerified()\\n        && isValidId(code)\\n        && isValidMuseumCode(incoming(), code)\\n        && incoming().createdAt == request.time\\n        && (\\n          (museumExists(incoming().museumId) && getMuseum(incoming().museumId).data.ownerId == request.auth.uid) ||\\n          (existsAfter(/databases/$(database)/documents/museums/$(incoming().museumId))\\n            && getAfter(/databases/$(database)/documents/museums/$(incoming().museumId)).data.ownerId == request.auth.uid)\\n        );\\n      allow update: if false;\\n      allow delete: if isVerified()\\n        && isValidId(code)\\n        && existing().ownerId == request.auth.uid;\\n    }\\n\\n    // --- Collection: /museums/{museumId} ---\\n    match /museums/{museumId} {\\n      allow get: if isSignedIn()\\n        && isValidId(museumId)\\n        && (\\n          (resource == null && museumId == \'museum_\' + request.auth.uid) ||\\n          (resource != null && canAccessMuseumData(existing()))\\n        );\\n      allow list: if isSignedIn() && (\\n        existing().ownerId == request.auth.uid ||\\n        (hasVerifiedEmail() && request.auth.token.email in existing().memberEmails)\\n      );\\n      allow create: if isVerified()\\n        && isValidId(museumId)\\n        && isValidMuseum(incoming())\\n        && incoming().ownerId == request.auth.uid\\n        && incoming().createdAt == request.time\\n        && incoming().updatedAt == request.time;\\n      allow update: if isVerified()\\n        && isValidId(museumId)\\n        && isValidMuseum(incoming())\\n        && existing().ownerId == request.auth.uid\\n        && incoming().ownerId == existing().ownerId\\n        && incoming().accessCode == existing().accessCode\\n        && incoming().createdAt == existing().createdAt\\n        && incoming().updatedAt == request.time\\n        && (\\n          // Action: Update Museum Settings\\n          incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'description\', \'wallTheme\', \'isOpenByCode\', \'updatedAt\']) ||\\n          // Action: Update Custom Room Names\\n          incoming().diff(existing()).affectedKeys().hasOnly([\'roomNames\', \'updatedAt\']) ||\\n          // Action: Update Access & Curator Lists\\n          incoming().diff(existing()).affectedKeys().hasOnly([\'memberEmails\', \'curatorEmails\', \'updatedAt\']) ||\\n          // Action: Update Artwork Count\\n          incoming().diff(existing()).affectedKeys().hasOnly([\'artworkCount\', \'updatedAt\'])\\n        );\\n      allow delete: if isVerified()\\n        && isValidId(museumId)\\n        && existing().ownerId == request.auth.uid;\\n\\n      // --- Subcollection: /museums/{museumId}/artworks/{artworkId} ---\\n      match /artworks/{artworkId} {\\n        allow get: if isSignedIn()\\n          && isValidId(museumId)\\n          && isValidId(artworkId)\\n          && museumExists(museumId)\\n          && canAccessMuseumData(getMuseum(museumId).data);\\n        allow list: if isSignedIn() && (\\n          existing().ownerId == request.auth.uid ||\\n          existing().isOpenByCode == true ||\\n          (hasVerifiedEmail() && request.auth.token.email in existing().viewerEmails)\\n        );\\n        allow create: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(artworkId)\\n          && isValidArtwork(incoming(), museumId)\\n          && incoming().uploadedBy == request.auth.uid\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time\\n          && museumExists(museumId)\\n          && getMuseum(museumId).data.ownerId == incoming().ownerId\\n          && canCurateMuseum(museumId);\\n        allow update: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(artworkId)\\n          && isValidArtwork(incoming(), museumId)\\n          && incoming().museumId == existing().museumId\\n          && incoming().ownerId == existing().ownerId\\n          && incoming().uploadedBy == existing().uploadedBy\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && museumExists(museumId)\\n          && (\\n            // Tier 1: Owner edits artwork metadata or syncs sharing flags\\n            (getMuseum(museumId).data.ownerId == request.auth.uid && (\\n              incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'artist\', \'dateCaptured\', \'notes\', \'frameStyle\', \'updatedAt\']) ||\\n              incoming().diff(existing()).affectedKeys().hasOnly([\'isOpenByCode\', \'viewerEmails\', \'updatedAt\'])\\n            )) ||\\n            // Tier 2: Co-curator edits own artwork metadata\\n            (existing().uploadedBy == request.auth.uid && canCurateMuseum(museumId) &&\\n              incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'artist\', \'dateCaptured\', \'notes\', \'frameStyle\', \'updatedAt\'])\\n            )\\n          );\\n        allow delete: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(artworkId)\\n          && museumExists(museumId)\\n          && (\\n            getMuseum(museumId).data.ownerId == request.auth.uid ||\\n            (existing().uploadedBy == request.auth.uid && canCurateMuseum(museumId))\\n          );\\n      }\\n\\n      // --- Subcollection: /museums/{museumId}/members/{memberId} ---\\n      match /members/{memberId} {\\n        allow get: if isSignedIn()\\n          && isValidId(museumId)\\n          && isValidId(memberId)\\n          && museumExists(museumId)\\n          && (\\n            getMuseum(museumId).data.ownerId == request.auth.uid ||\\n            (resource != null && hasVerifiedEmail() && existing().email == request.auth.token.email)\\n          );\\n        allow list: if isSignedIn() && (\\n          existing().ownerId == request.auth.uid ||\\n          (hasVerifiedEmail() && existing().email == request.auth.token.email)\\n        );\\n        allow create: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(memberId)\\n          && isValidMuseumMember(incoming(), museumId)\\n          && incoming().ownerId == request.auth.uid\\n          && incoming().createdAt == request.time\\n          && museumExists(museumId)\\n          && getMuseum(museumId).data.ownerId == request.auth.uid;\\n        allow update: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(memberId)\\n          && isValidMuseumMember(incoming(), museumId)\\n          && incoming().museumId == existing().museumId\\n          && incoming().ownerId == existing().ownerId\\n          && incoming().email == existing().email\\n          && incoming().createdAt == existing().createdAt\\n          && museumExists(museumId)\\n          && getMuseum(museumId).data.ownerId == request.auth.uid\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'displayName\', \'role\', \'gender\']);\\n        allow delete: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(memberId)\\n          && museumExists(museumId)\\n          && getMuseum(museumId).data.ownerId == request.auth.uid;\\n      }\\n\\n      // --- Subcollection: /museums/{museumId}/presence/{visitorId} ---\\n      match /presence/{visitorId} {\\n        allow get: if isSignedIn()\\n          && isValidId(museumId)\\n          && isValidId(visitorId)\\n          && museumExists(museumId)\\n          && canAccessMuseumData(getMuseum(museumId).data);\\n        allow list: if isSignedIn() && (\\n          existing().ownerId == request.auth.uid ||\\n          existing().uid == request.auth.uid ||\\n          existing().isOpenByCode == true ||\\n          (hasVerifiedEmail() && request.auth.token.email in existing().viewerEmails)\\n        );\\n        allow create: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(visitorId)\\n          && visitorId == request.auth.uid\\n          && isValidPresence(incoming(), museumId, visitorId)\\n          && incoming().updatedAt == request.time\\n          && museumExists(museumId)\\n          && getMuseum(museumId).data.ownerId == incoming().ownerId\\n          && canAccessMuseumData(getMuseum(museumId).data);\\n        allow update: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(visitorId)\\n          && visitorId == request.auth.uid\\n          && isValidPresence(incoming(), museumId, visitorId)\\n          && incoming().museumId == existing().museumId\\n          && incoming().ownerId == existing().ownerId\\n          && incoming().uid == existing().uid\\n          && incoming().updatedAt == request.time\\n          && museumExists(museumId)\\n          && canAccessMuseumData(getMuseum(museumId).data)\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\\n            \'displayName\', \'gender\', \'skinTone\', \'hairStyle\', \'hairColor\',\\n            \'outfitStyle\', \'outfitColor\', \'accentColor\', \'accessory\',\\n            \'x\', \'z\', \'yaw\', \'isOpenByCode\', \'viewerEmails\', \'updatedAt\'\\n          ]);\\n        allow delete: if isVerified()\\n          && isValidId(museumId)\\n          && isValidId(visitorId)\\n          && visitorId == request.auth.uid;\\n      }\\n    }\\n  }\\n}\", \"TargetFile\":\"/firestore.rules\", \"toolAction\":\"Updating production firestore.rules\", \"toolSummary\":\"Update firestore.rules\"}"
