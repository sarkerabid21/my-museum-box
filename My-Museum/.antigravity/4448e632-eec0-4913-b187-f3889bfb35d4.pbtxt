      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Improve WorldMinimap Museum label placement and badge clarity so player arrow never overlaps MUSEUM text\", \"EndLine\":120, \"Instruction\":\"Widen the Museum building box and move the MUSEUM label cleanly above the roof so the \360\237\217\233 icon and yellow player marker stay crisp and readable\", \"ReplacementContent\":\"          {/* Museum Architectural Footprint */}\\n          <text\\n            x={museumPt.mx}\\n            y={10}\\n            textAnchor=\\\"middle\\\"\\n            fill=\\\"#E8CFA6\\\"\\n            fontSize=\\\"7\\\"\\n            fontFamily=\\\"monospace\\\"\\n            fontWeight=\\\"800\\\"\\n          >\\n            MUSEUM\\n          </text>\\n          <rect\\n            x={museumPt.mx - 18}\\n            y={13}\\n            width={36}\\n            height={28}\\n            fill={zone.symbol === \'MUSEUM\' ? \'#A6723B\' : \'#574A3D\'}\\n            stroke=\\\"#E8CFA6\\\"\\n            strokeWidth={1.4}\\n          />\\n          {/* Museum Classical Symbol */}\\n          <text\\n            x={museumPt.mx}\\n            y={31}\\n            textAnchor=\\\"middle\\\"\\n            fill=\\\"#FAF5EC\\\"\\n            fontSize=\\\"13\\\"\\n            fontWeight=\\\"700\\\"\\n          >\\n            \360\237\217\233\\n          </text>\", \"StartLine\":80, \"TargetContent\":\"          {/* Museum Architectural Footprint */}\\n          <rect\\n            x={museumPt.mx - 14}\\n            y={12}\\n            width={28}\\n            height={30}\\n            fill={zone.symbol === \'MUSEUM\' ? \'#A6723B\' : \'#574A3D\'}\\n            stroke=\\\"#E8CFA6\\\"\\n            strokeWidth={1.3}\\n          />\\n          {/* Museum Classical Symbol */}\\n          <text\\n            x={museumPt.mx}\\n            y={28}\\n            textAnchor=\\\"middle\\\"\\n            fill=\\\"#FAF5EC\\\"\\n            fontSize=\\\"11\\\"\\n            fontWeight=\\\"700\\\"\\n          >\\n            \360\237\217\233\\n          </text>\\n          <text\\n            x={museumPt.mx}\\n            y={39}\\n            textAnchor=\\\"middle\\\"\\n            fill=\\\"#E8CFA6\\\"\\n            fontSize=\\\"6.5\\\"\\n            fontFamily=\\\"monospace\\\"\\n            fontWeight=\\\"700\\\"\\n          >\\n            MUSEUM\\n          </text>\", \"TargetFile\":\"/src/components/WorldMinimap.tsx\", \"toolAction\":\"Polishing WorldMinimap museum label layout\", \"toolSummary\":\"Refine WorldMinimap.tsx layout\"}"
      original_name: "replace_file_content"
