    tool_calls {
      id: "call_10494090872450525594"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Fix AvatarPreview3D resize buffering, immediate first-frame render, and architectural gallery studio backdrop\", \"EndLine\":250, \"Instruction\":\"Update AvatarPreview3D.tsx to defer setSize into render callback, render cleanly on mount and updates, and frame the avatar in an architectural studio niche\", \"ReplacementContent\":\"    const camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 40);\\n    camera.position.set(0.45, 1.38, 3.45);\\n\\n    const controls = new OrbitControls(camera, renderer.domElement);\\n    controls.target.set(0, 0.98, 0);\\n    controls.enablePan = false;\\n    controls.enableDamping = !isSoftwareGl;\\n    controls.dampingFactor = 0.08;\\n    controls.minDistance = 2.1;\\n    controls.maxDistance = 5.0;\\n    controls.minPolarAngle = Math.PI * 0.22;\\n    controls.maxPolarAngle = Math.PI * 0.56;\\n    controls.update();\\n\\n    // Warm/cool 3-point museum studio lighting\\n    const hemi = new THREE.HemisphereLight(0xf6f9ff, 0x8f7a64, 1.05);\\n    scene.add(hemi);\\n\\n    const keyLight = new THREE.DirectionalLight(0xfff1dc, 1.7);\\n    keyLight.position.set(3.2, 5.4, 3.8);\\n    keyLight.castShadow = !isSoftwareGl;\\n    keyLight.shadow.mapSize.set(1024, 1024);\\n    keyLight.shadow.camera.near = 0.5;\\n    keyLight.shadow.camera.far = 16;\\n    keyLight.shadow.camera.left = -2.5;\\n    keyLight.shadow.camera.right = 2.5;\\n    keyLight.shadow.camera.top = 2.5;\\n    keyLight.shadow.camera.bottom = -2.5;\\n    keyLight.shadow.bias = -0.0005;\\n    keyLight.shadow.normalBias = 0.02;\\n    scene.add(keyLight);\\n\\n    const rimLight = new THREE.DirectionalLight(0xdce8f8, 0.78);\\n    rimLight.position.set(-3.2, 3.4, -3.5);\\n    scene.add(rimLight);\\n\\n    // Sculpted Marble Exhibition Pedestal & Architectural Studio Backdrop\\n    const pedestalGeo = new THREE.CylinderGeometry(0.84, 0.92, 0.2, 36);\\n    const pedestalMat = new THREE.MeshStandardMaterial({\\n      color: 0xf7f3eb,\\n      roughness: 0.32,\\n      metalness: 0.06,\\n    });\\n    const pedestal = new THREE.Mesh(pedestalGeo, pedestalMat);\\n    pedestal.position.y = -0.1;\\n    pedestal.receiveShadow = true;\\n    scene.add(pedestal);\\n\\n    const brassRingGeo = new THREE.TorusGeometry(0.86, 0.018, 12, 48);\\n    const brassRingMat = new THREE.MeshStandardMaterial({\\n      color: 0xc2975c,\\n      roughness: 0.24,\\n      metalness: 0.88,\\n    });\\n    const brassRing = new THREE.Mesh(brassRingGeo, brassRingMat);\\n    brassRing.rotation.x = Math.PI / 2;\\n    brassRing.position.y = -0.004;\\n    scene.add(brassRing);\\n\\n    const studioFloorGeo = new THREE.CircleGeometry(8, 36);\\n    const studioFloorMat = new THREE.MeshStandardMaterial({\\n      color: 0xddd6c9,\\n      roughness: 0.5,\\n      metalness: 0.04,\\n    });\\n    const studioFloor = new THREE.Mesh(studioFloorGeo, studioFloorMat);\\n    studioFloor.rotation.x = -Math.PI / 2;\\n    studioFloor.position.y = -0.2;\\n    studioFloor.receiveShadow = true;\\n    scene.add(studioFloor);\\n\\n    // Flat architectural limestone studio wall with subtle recessed molding behind avatar\\n    const backWallGeo = new THREE.BoxGeometry(8, 5, 0.2);\\n    const backWallMat = new THREE.MeshStandardMaterial({\\n      color: 0xe6dfd3,\\n      roughness: 0.86,\\n      metalness: 0.02,\\n    });\\n    const backWall = new THREE.Mesh(backWallGeo, backWallMat);\\n    backWall.position.set(0, 2.2, -2.4);\\n    scene.add(backWall);\\n\\n    const moldingGeo = new THREE.BoxGeometry(2.6, 3.2, 0.06);\\n    const moldingMat = new THREE.MeshStandardMaterial({\\n      color: 0xd6cdc0,\\n      roughness: 0.72,\\n      metalness: 0.04,\\n    });\\n    const molding = new THREE.Mesh(moldingGeo, moldingMat);\\n    molding.position.set(0, 1.55, -2.28);\\n    scene.add(molding);\\n\\n    const avatarSlot = new THREE.Group();\\n    scene.add(avatarSlot);\\n    avatarSlotRef.current = avatarSlot;\\n\\n    // On-demand coalesced rendering; apply resize INSIDE draw frame so buffer is never wiped\\n    let frameId = 0;\\n    let renderBusy = false;\\n    let renderDirty = false;\\n    let disposed = false;\\n    let pendingSize: { w: number; h: number } | null = null;\\n\\n    const afterDraw = createAfterDrawScheduler(renderer, (id) => {\\n      frameId = id;\\n    });\\n\\n    const drawNow = () => {\\n      if (disposed) return;\\n      if (pendingSize) {\\n        camera.aspect = pendingSize.w / pendingSize.h;\\n        camera.updateProjectionMatrix();\\n        renderer.setSize(pendingSize.w, pendingSize.h);\\n        pendingSize = null;\\n      }\\n      controls.update();\\n      renderer.render(scene, camera);\\n    };\\n\\n    const requestRender = () => {\\n      if (disposed) return;\\n      if (renderBusy) {\\n        renderDirty = true;\\n        return;\\n      }\\n      renderBusy = true;\\n      frameId = requestAnimationFrame(() => {\\n        if (disposed) return;\\n        renderDirty = false;\\n        drawNow();\\n        const done = () => {\\n          renderBusy = false;\\n          if (renderDirty && !disposed) requestRender();\\n        };\\n        if (isSoftwareGl) afterDraw(done);\\n        else done();\\n      });\\n    };\\n\\n    requestRenderRef.current = requestRender;\\n    resetCameraRef.current = () => {\\n      camera.position.set(0.45, 1.38, 3.45);\\n      controls.target.set(0, 0.98, 0);\\n      controls.update();\\n      requestRender();\\n    };\\n\\n    const onControlChange = () => requestRender();\\n    controls.addEventListener(\'change\', onControlChange);\\n\\n    const onContextLost = (e: Event) => {\\n      e.preventDefault();\\n    };\\n    const onContextRestored = () => {\\n      requestRender();\\n    };\\n    renderer.domElement.addEventListener(\'webglcontextlost\', onContextLost);\\n    renderer.domElement.addEventListener(\'webglcontextrestored\', onContextRestored);\\n\\n    const handleResize = () => {\\n      if (!container || disposed) return;\\n      const w = Math.max(280, container.clientWidth);\\n      const h = Math.max(360, container.clientHeight);\\n      pendingSize = { w, h };\\n      requestRender();\\n    };\\n\\n    const resizeObserver = new ResizeObserver(handleResize);\\n    resizeObserver.observe(container);\\n\\n    // Build initial rig right after mount & draw immediate first frame\\n    const initialRig = buildAvatarRig(avatar, { showNameplate: false, showContactShadow: true });\\n    avatarSlot.add(initialRig.root);\\n    currentRigRef.current = initialRig;\\n    if (!isSoftwareGl) {\\n      renderer.compile(scene, camera);\\n    }\\n    drawNow();\\n\\n    return () => {\\n      disposed = true;\\n      cancelAnimationFrame(frameId);\\n      clearTimeout(frameId);\\n      resizeObserver.disconnect();\\n      controls.removeEventListener(\'change\', onControlChange);\\n      controls.dispose();\\n      renderer.domElement.removeEventListener(\'webglcontextlost\', onContextLost);\\n      renderer.domElement.removeEventListener(\'webglcontextrestored\', onContextRestored);\\n      currentRigRef.current?.dispose();\\n      currentRigRef.current = null;\\n      avatarSlotRef.current = null;\\n      requestRenderRef.current = null;\\n      resetCameraRef.current = null;\\n      pedestalGeo.dispose();\\n      pedestalMat.dispose();\\n      brassRingGeo.dispose();\\n      brassRingMat.dispose();\\n      studioFloorGeo.dispose();\\n      studioFloorMat.dispose();\\n      backWallGeo.dispose();\\n      backWallMat.dispose();\\n      moldingGeo.dispose();\\n      moldingMat.dispose();\\n      envTexture.dispose();\\n      renderer.dispose();\\n      if (renderer.domElement.parentNode === container) {\\n        container.removeChild(renderer.domElement);\\n      }\\n    };\\n  }, []);\\n\\n  // Hot-swap sculpted 3D avatar when customization changes without tearing down WebGL\\n  useEffect(() => {\\n    const slot = avatarSlotRef.current;\\n    if (!slot) return;\\n    if (currentRigRef.current) {\\n      slot.remove(currentRigRef.current.root);\\n      currentRigRef.current.dispose();\\n    }\\n    const nextRig = buildAvatarRig(avatar, { showNameplate: false, showContactShadow: true });\\n    slot.add(nextRig.root);\\n    currentRigRef.current = nextRig;\\n    requestRenderRef.current?.();\\n  }, [avatar]);\\n\\n  if (webglUnavailable) {\\n    return (\\n      <div className=\\\"w-full h-full min-h-[440px] bg-[#EBE6DD] border border-stone-200 flex flex-col items-center justify-center p-8 text-center\\\">\\n        <p className=\\\"font-editorial text-2xl text-stone-900 mb-2\\\">\\n          {avatar.displayName} ({avatar.gender === \'woman\' ? \'Woman\' : \'Man\'})\\n        </p>\\n        <p className=\\\"text-sm text-stone-600\\\">\\n          3D preview requires WebGL. Your avatar selections are saved and ready for the museum.\\n        </p>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div\\n      className=\\\"relative w-full h-full min-h-[440px] lg:min-h-[540px] bg-[#EBE6DD] border border-stone-200 overflow-hidden\\\"\\n      data-testid=\\\"avatar-preview-stage\\\"\\n      data-gender={avatar.gender}\\n      data-outfit={avatar.outfitStyle}\\n    >\\n      <div ref={mountRef} className=\\\"w-full h-full\\\" />\\n\\n      <div className=\\\"absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none\\\">\\n        <div className=\\\"bg-[#1C1917]/90 text-[#F7F5F0] px-3 py-1.5 text-xs tracking-wide\\\">\\n          <span>{avatar.displayName || \'Curator\'}</span>\\n          <span className=\\\"mx-2 text-stone-400\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n          <span className=\\\"text-[#D4B282]\\\">\\n            {avatar.gender === \'woman\' ? \'Woman 3D Model\' : \'Man 3D Model\'}\\n          </span>\\n        </div>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => resetCameraRef.current?.()}\\n          aria-label=\\\"Reset 3D avatar camera view\\\"\\n          className=\\\"pointer-events-auto inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#F7F5F0]/95 text-stone-800 border border-stone-300 text-xs font-medium hover:bg-white transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n        >\\n          <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n          Reset View\\n        </button>\\n      </div>\\n\\n      <div className=\\\"absolute bottom-4 left-4 pointer-events-none text-xs text-stone-700 bg-[#F7F5F0]/92 px-3 py-1.5 border border-stone-300/80\\\">\\n        Drag to rotate 360\302\260 \302\267 Scroll to zoom\\n      </div>\\n    </div>\\n  );\\n}\", \"StartLine\":58, \"TargetContent\":\"    const camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 40);\\n    camera.position.set(0.55, 1.48, 3.65);\\n\\n    const controls = new OrbitControls(camera, renderer.domElement);\\n    controls.target.set(0, 1.05, 0);\\n    controls.enablePan = false;\\n    controls.enableDamping = !isSoftwareGl;\\n    controls.dampingFactor = 0.08;\\n    controls.minDistance = 2.2;\\n    controls.maxDistance = 5.2;\\n    controls.minPolarAngle = Math.PI * 0.22;\\n    controls.maxPolarAngle = Math.PI * 0.56;\\n    controls.update();\\n\\n    // Warm/cool 3-point museum studio lighting\\n    const hemi = new THREE.HemisphereLight(0xf6f9ff, 0x8f7a64, 0.95);\\n    scene.add(hemi);\\n\\n    const keyLight = new THREE.DirectionalLight(0xfff1dc, 1.65);\\n    keyLight.position.set(3.2, 5.4, 3.8);\\n    keyLight.castShadow = !isSoftwareGl;\\n    keyLight.shadow.mapSize.set(1024, 1024);\\n    keyLight.shadow.camera.near = 0.5;\\n    keyLight.shadow.camera.far = 16;\\n    keyLight.shadow.camera.left = -2.5;\\n    keyLight.shadow.camera.right = 2.5;\\n    keyLight.shadow.camera.top = 2.5;\\n    keyLight.shadow.camera.bottom = -2.5;\\n    keyLight.shadow.bias = -0.0005;\\n    keyLight.shadow.normalBias = 0.02;\\n    scene.add(keyLight);\\n\\n    const rimLight = new THREE.DirectionalLight(0xdce8f8, 0.72);\\n    rimLight.position.set(-3.2, 3.4, -3.5);\\n    scene.add(rimLight);\\n\\n    // Sculpted Marble Exhibition Pedestal & Architectural Backdrop\\n    const pedestalGeo = new THREE.CylinderGeometry(0.82, 0.88, 0.18, 36);\\n    const pedestalMat = new THREE.MeshStandardMaterial({\\n      color: 0xf6f2ea,\\n      roughness: 0.34,\\n      metalness: 0.05,\\n    });\\n    const pedestal = new THREE.Mesh(pedestalGeo, pedestalMat);\\n    pedestal.position.y = -0.09;\\n    pedestal.receiveShadow = true;\\n    scene.add(pedestal);\\n\\n    const brassRingGeo = new THREE.TorusGeometry(0.84, 0.016, 12, 48);\\n    const brassRingMat = new THREE.MeshStandardMaterial({\\n      color: 0xc2975c,\\n      roughness: 0.24,\\n      metalness: 0.88,\\n    });\\n    const brassRing = new THREE.Mesh(brassRingGeo, brassRingMat);\\n    brassRing.rotation.x = Math.PI / 2;\\n    brassRing.position.y = -0.004;\\n    scene.add(brassRing);\\n\\n    const studioFloorGeo = new THREE.CircleGeometry(7, 36);\\n    const studioFloorMat = new THREE.MeshStandardMaterial({\\n      color: 0xe3ddd2,\\n      roughness: 0.52,\\n      metalness: 0.04,\\n    });\\n    const studioFloor = new THREE.Mesh(studioFloorGeo, studioFloorMat);\\n    studioFloor.rotation.x = -Math.PI / 2;\\n    studioFloor.position.y = -0.18;\\n    studioFloor.receiveShadow = true;\\n    scene.add(studioFloor);\\n\\n    // Subtle architectural curved gallery niche behind the avatar\\n    const nicheGeo = new THREE.CylinderGeometry(3.4, 3.4, 4.6, 32, 1, true, Math.PI * 0.65, Math.PI * 0.7);\\n    const nicheMat = new THREE.MeshStandardMaterial({\\n      color: 0xf2ede4,\\n      roughness: 0.88,\\n      metalness: 0.02,\\n      side: THREE.BackSide,\\n    });\\n    const niche = new THREE.Mesh(nicheGeo, nicheMat);\\n    niche.position.set(0, 2.1, -0.4);\\n    scene.add(niche);\\n\\n    const avatarSlot = new THREE.Group();\\n    scene.add(avatarSlot);\\n    avatarSlotRef.current = avatarSlot;\\n\\n    // On-demand coalesced rendering (safe on Software WebGL & GPU)\\n    let frameId = 0;\\n    let renderBusy = false;\\n    let renderDirty = false;\\n    let disposed = false;\\n\\n    const afterDraw = createAfterDrawScheduler(renderer, (id) => {\\n      frameId = id;\\n    });\\n\\n    const requestRender = () => {\\n      if (disposed) return;\\n      if (renderBusy) {\\n        renderDirty = true;\\n        return;\\n      }\\n      renderBusy = true;\\n      frameId = requestAnimationFrame(() => {\\n        if (disposed) return;\\n        renderDirty = false;\\n        controls.update();\\n        renderer.render(scene, camera);\\n        const done = () => {\\n          renderBusy = false;\\n          if (renderDirty && !disposed) requestRender();\\n        };\\n        if (isSoftwareGl) afterDraw(done);\\n        else done();\\n      });\\n    };\\n\\n    requestRenderRef.current = requestRender;\\n    resetCameraRef.current = () => {\\n      camera.position.set(0.55, 1.48, 3.65);\\n      controls.target.set(0, 1.05, 0);\\n      controls.update();\\n      requestRender();\\n    };\\n\\n    const onControlChange = () => requestRender();\\n    controls.addEventListener(\'change\', onControlChange);\\n\\n    const onContextLost = (e: Event) => {\\n      e.preventDefault();\\n    };\\n    const onContextRestored = () => {\\n      requestRender();\\n    };\\n    renderer.domElement.addEventListener(\'webglcontextlost\', onContextLost);\\n    renderer.domElement.addEventListener(\'webglcontextrestored\', onContextRestored);\\n\\n    const handleResize = () => {\\n      if (!container || disposed) return;\\n      const w = Math.max(280, container.clientWidth);\\n      const h = Math.max(360, container.clientHeight);\\n      camera.aspect = w / h;\\n      camera.updateProjectionMatrix();\\n      renderer.setSize(w, h);\\n      requestRender();\\n    };\\n\\n    const resizeObserver = new ResizeObserver(handleResize);\\n    resizeObserver.observe(container);\\n\\n    // Build initial rig right after mount\\n    const initialRig = buildAvatarRig(avatar, { showNameplate: false, showContactShadow: true });\\n    avatarSlot.add(initialRig.root);\\n    currentRigRef.current = initialRig;\\n    if (!isSoftwareGl) {\\n      renderer.compile(scene, camera);\\n    }\\n    requestRender();\\n\\n    return () => {\\n      disposed = true;\\n      cancelAnimationFrame(frameId);\\n      clearTimeout(frameId);\\n      resizeObserver.disconnect();\\n      controls.removeEventListener(\'change\', onControlChange);\\n      controls.dispose();\\n      renderer.domElement.removeEventListener(\'webglcontextlost\', onContextLost);\\n      renderer.domElement.removeEventListener(\'webglcontextrestored\', onContextRestored);\\n      currentRigRef.current?.dispose();\\n      currentRigRef.current = null;\\n      avatarSlotRef.current = null;\\n      requestRenderRef.current = null;\\n      resetCameraRef.current = null;\\n      pedestalGeo.dispose();\\n      pedestalMat.dispose();\\n      brassRingGeo.dispose();\\n      brassRingMat.dispose();\\n      studioFloorGeo.dispose();\\n      studioFloorMat.dispose();\\n      nicheGeo.dispose();\\n      nicheMat.dispose();\\n      envTexture.dispose();\\n      renderer.dispose();\\n      if (renderer.domElement.parentNode === container) {\\n        container.removeChild(renderer.domElement);\\n      }\\n    };\\n  }, []);\\n\\n  // Hot-swap sculpted 3D avatar when customization changes without tearing down WebGL\\n  useEffect(() => {\\n    const slot = avatarSlotRef.current;\\n    if (!slot) return;\\n    if (currentRigRef.current) {\\n      slot.remove(currentRigRef.current.root);\\n      currentRigRef.current.dispose();\\n    }\\n    const nextRig = buildAvatarRig(avatar, { showNameplate: false, showContactShadow: true });\\n    slot.add(nextRig.root);\\n    currentRigRef.current = nextRig;\\n    requestRenderRef.current?.();\\n  }, [avatar]);\\n\\n  if (webglUnavailable) {\\n    return (\\n      <div className=\\\"w-full h-full min-h-[460px] bg-[#EBE6DD] border border-stone-200 flex flex-col items-center justify-center p-8 text-center\\\">\\n        <p className=\\\"font-editorial text-2xl text-stone-900 mb-2\\\">\\n          {avatar.displayName} ({avatar.gender === \'woman\' ? \'Woman\' : \'Man\'})\\n        </p>\\n        <p className=\\\"text-sm text-stone-600\\\">\\n          3D preview requires WebGL. Your avatar selections are saved and ready for the museum.\\n        </p>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div\\n      className=\\\"relative w-full h-full min-h-[440px] lg:min-h-[580px] bg-[#EBE6DD] border border-stone-200 overflow-hidden\\\"\\n      data-testid=\\\"avatar-preview-stage\\\"\\n      data-gender={avatar.gender}\\n      data-outfit={avatar.outfitStyle}\\n    >\\n      <div ref={mountRef} className=\\\"w-full h-full\\\" />\\n\\n      <div className=\\\"absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none\\\">\\n        <div className=\\\"bg-[#1C1917]/85 text-[#F7F5F0] px-3 py-1.5 text-xs tracking-wide\\\">\\n          <span>{avatar.displayName || \'Curator\'}</span>\\n          <span className=\\\"mx-2 text-stone-400\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n          <span className=\\\"text-[#D4B282]\\\">\\n            {avatar.gender === \'woman\' ? \'Woman 3D Model\' : \'Man 3D Model\'}\\n          </span>\\n        </div>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => resetCameraRef.current?.()}\\n          aria-label=\\\"Reset 3D avatar camera view\\\"\\n          className=\\\"pointer-events-auto inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#F7F5F0]/95 text-stone-800 border border-stone-300 text-xs font-medium hover:bg-white transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n        >\\n          <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n          Reset View\\n        </button>\\n      </div>\\n\\n      <div className=\\\"absolute bottom-4 left-4 pointer-events-none text-xs text-stone-600 bg-[#F7F5F0]/90 px-3 py-1.5 border border-stone-300/80\\\">\\n        Drag to rotate 360\302\260 \302\267 Scroll to zoom\\n      </div>\\n    </div>\\n  );\\n}\", \"TargetFile\":\"/src/components/AvatarPreview3D.tsx\", \"toolAction\":\"Fixing AvatarPreview3D camera and resize rendering\", \"toolSummary\":\"Fix AvatarPreview3D.tsx\"}"
