    content: "import type {\n  ArtworkItem,\n  DateSortOrder,\n  Gender,\n  MemberRole,\n  RoomShape,\n} from \'../types/museum\';\n\nexport const ARTWORKS_PER_ROOM = 8;\nexport const MIN_ROOMS = 1;\nexport const ROOM_WIDTH = 16.4;\nexport const ROOM_HALF_WIDTH = ROOM_WIDTH / 2;\nexport const ROOM_DEPTH = 18.0;\nexport const ROOM_HALF_DEPTH = ROOM_DEPTH / 2;\nexport const HALL_HEIGHT = 6.4;\nexport const DOOR_WIDTH = 3.4;\nexport const DOOR_HEIGHT = 3.9;\nexport const DOOR_INTERACT_RADIUS = 5.2;\nexport const WALL_COLLISION_MARGIN = 1.05;\nexport const DOOR_WALL_BUFFER = 0.78;\nexport const PEDESTAL_COLLISION_RADIUS = 1.48;\n\nexport const ROOM_SHAPES: RoomShape[] = [\'rotunda\', \'atrium\', \'salon\', \'pavilion\'];\n\nexport interface RoomDefinition {\n  index: number;\n  roomNumber: number;\n  romanNumeral: string;\n  shape: RoomShape;\n  defaultName: string;\n  architectureSubtitle: string;\n  vaseLabel: string;\n  centerZ: number;\n  southZ: number;\n  northZ: number;\n}\n\nexport interface DoorDefinition {\n  id: string;\n  fromRoomIndex: number;\n  toRoomIndex: number;\n  x: number;\n  z: number;\n  width: number;\n  height: number;\n}\n\nexport interface PedestalObstacle {\n  roomIndex: number;\n  x: number;\n  z: number;\n  radius: number;\n}\n\nexport interface MuseumLayout {\n  artworkCount: number;\n  roomCount: number;\n  totalWallSlots: number;\n  roomWidth: number;\n  roomDepth: number;\n  hallHeight: number;\n  southWallZ: number;\n  northWallZ: number;\n  totalLength: number;\n  rooms: RoomDefinition[];\n  doors: DoorDefinition[];\n  pedestals: PedestalObstacle[];\n}\n\nexport interface ArtworkPlacement {\n  index: number;\n  roomIndex: number;\n  roomNumber: number;\n  slotInRoom: number; // 0..7\n  wallSide: \'west\' | \'east\' | \'north\';\n  wallLabel: string;\n  x: number;\n  y: number;\n  z: number;\n  rotY: number;\n  standPoint: {\n    x: number;\n    z: number;\n    yaw: number;\n  };\n}\n\nexport interface DateGroup {\n  dateKey: string; // YYYY-MM-DD\n  label: string;\n  items: ArtworkItem[];\n}\n\nexport interface ValidationResult {\n  valid: boolean;\n  errors: Record<string, string>;\n}\n\nconst ROMAN_NUMERALS = [\n  \'I\', \'II\', \'III\', \'IV\', \'V\', \'VI\', \'VII\', \'VIII\', \'IX\', \'X\',"
