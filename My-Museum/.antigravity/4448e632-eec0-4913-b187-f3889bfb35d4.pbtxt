            lines {
              text: "        lip.position.set(ox, oy - 0.01, oz);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        grp.add(lip);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
