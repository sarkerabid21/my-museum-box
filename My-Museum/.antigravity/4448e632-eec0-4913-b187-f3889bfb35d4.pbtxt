        replacement_chunks {
          target_content: "  // Contoured Dark-Black Moustache & Sleek Tightly-Fitted Jawline/Chin Beard (no boxy flaps)\n  for (const s of [-1, 1]) {\n    const stacheHalf = new THREE.Mesh(\n      trackGeo(new THREE.SphereGeometry(0.016, 10, 8)),\n      beardMat\n    );\n    stacheHalf.scale.set(1.45, 0.42, 0.58);\n    stacheHalf.position.set(s * 0.017, 0.07, 0.125);\n    stacheHalf.rotation.z = -s * 0.18;\n    stacheHalf.rotation.y = -s * 0.2;\n    headGroup.add(stacheHalf);\n\n    // Smoothly contoured cheek/jaw beard hugging the lower side of the oval head\n    const cheekBeard = new THREE.Mesh(\n      trackGeo(new THREE.SphereGeometry(0.064, 14, 12)),\n      beardMat\n    );\n    cheekBeard.scale.set(0.46, 0.92, 1.08);\n    cheekBeard.position.set(s * 0.094, 0.058, 0.036);\n    cheekBeard.rotation.y = -s * 0.36;\n    cheekBeard.rotation.z = s * 0.22;\n    headGroup.add(cheekBeard);\n\n    // Tapered sideburn blending hair cleanly into jawline beard\n    const sideburn = new THREE.Mesh(\n      trackGeo(new THREE.CylinderGeometry(0.014, 0.011, 0.088, 10)),\n      hairMat\n    );\n    sideburn.scale.set(0.62, 1, 1.45);\n    sideburn.position.set(s * 0.121, 0.118, 0.016);\n    headGroup.add(sideburn);\n  }\n\n  // Smooth rounded chin-jaw beard shell hugging the lower skull curve tightly\n  const jawBeardShell = new THREE.Mesh(\n    trackGeo(new THREE.SphereGeometry(0.132, 22, 16, 0, Math.PI * 2, Math.PI * 0.62, Math.PI * 0.38)),\n    beardMat\n  );\n  jawBeardShell.scale.set(0.95, 1.07, 1.01);\n  jawBeardShell.position.set(0, 0.108, 0.008);\n  jawBeardShell.rotation.x = 0.22;\n  headGroup.add(jawBeardShell);\n\n  const soulPatch = new THREE.Mesh(\n    trackGeo(new THREE.SphereGeometry(0.016, 10, 8)),\n    beardMat\n  );\n  soulPatch.scale.set(1.1, 0.65, 0.55);\n  soulPatch.position.set(0, 0.042, 0.124);\n  headGroup.add(soulPatch);"
          replacement_content: "  // Contoured Dark-Black Moustache & Sleek Tightly-Fitted Jawline/Chin Beard\n  for (const s of [-1, 1]) {\n    const stacheHalf = new THREE.Mesh(\n      trackGeo(new THREE.SphereGeometry(0.016, 10, 8)),\n      beardMat\n    );\n    stacheHalf.scale.set(1.45, 0.42, 0.58);\n    stacheHalf.position.set(s * 0.017, 0.07, 0.125);\n    stacheHalf.rotation.z = -s * 0.18;\n    stacheHalf.rotation.y = -s * 0.2;\n    headGroup.add(stacheHalf);\n\n    // Tapered sideburn blending hair cleanly down to the jawline beard\n    const sideburn = new THREE.Mesh(\n      trackGeo(new THREE.CylinderGeometry(0.014, 0.011, 0.095, 10)),\n      hairMat\n    );\n    sideburn.scale.set(0.55, 1, 1.35);\n    sideburn.position.set(s * 0.119, 0.112, 0.014);\n    headGroup.add(sideburn);\n  }\n\n  // Single sleek contoured chin-jaw beard shell hugging the exact oval lower skull curve\n  const jawBeardShell = new THREE.Mesh(\n    trackGeo(new THREE.SphereGeometry(0.138, 24, 18, 0, Math.PI * 2, Math.PI * 0.57, Math.PI * 0.43)),\n    beardMat\n  );\n  jawBeardShell.scale.set(0.955, 1.09, 1.005);\n  jawBeardShell.position.set(0, 0.112, 0.005);\n  jawBeardShell.rotation.x = 0.24;\n  headGroup.add(jawBeardShell);\n\n  const soulPatch = new THREE.Mesh(\n    trackGeo(new THREE.SphereGeometry(0.016, 10, 8)),\n    beardMat\n  );\n  soulPatch.scale.set(1.1, 0.65, 0.55);\n  soulPatch.position.set(0, 0.042, 0.124);\n  headGroup.add(soulPatch);"
