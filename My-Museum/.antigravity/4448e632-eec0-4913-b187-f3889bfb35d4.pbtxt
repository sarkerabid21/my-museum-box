      thinking_signature: "\022\332\020\n\327\020\001i\024}\023\277\247\245\000\317esg$\035wq?ifA\v\320\244\320.\2713\260\244MJ\016\207\372\317\232F\223\fG\023\367\315\244\2305\245vj\231\365N\264\31757G8\360\303_C\035\202^\343\341\304\a/\316N\371\301\024\027\332H4\2551h\2327\374k\276R\f5e\247\001\364\343>\213o\313\371c\272c\251(\241,B\342\204Xk\310\033\274\313\235\255y\t\272|\345u\271\253\331\336\270\312\330\344D,\2640\334\266\v\200\211\330\223J\212\372\350V\vQ\363\036\374\004%\233\317=\276R\353Ws\341\226\022Y\027S\301x]\217\265\333\371\r\303H\356\324\205\025/\230\v\301L\020p\v\177].4\253\241\204\211\032\273D\374\0334\355j\365\202\250\233)b\316>O\020\377j0\375y\032\205I\357\002\277J\326\203\235\276-u\216kYY\3411^\250\226\nd\361\215\362\316\361\342\246|0\211\3304\373Zu\203\024\226\315y\357&\301f\323^z\216\335L,\255\306}\255\203\0023\220\221\215\375W=&\322\201\344\323\022\220\3320\224\213T\264\344\332)\001\235/\2318l\200\344\017\263\375\205\177d\000(cC\200y\037\275\217\245K\276\225\320\n\271\213O+it\024A\000\202r\261\221q\235\254\306\267\033A\233\234$E\331z\377>\004+@WT\234\323iD\361a\017Z\265\203\001\266\256\374kx.\334_PaOQB\255*7\376=J\341\212\264:\254\230\232\026\331\346\004\375LE\326\341\037r\211G\306\021\340=~\"h\341D\250(\276\327\004\304\235\360~{\364\344\366\326\241}\266\361\200t\356\343\316\303 h\361+\365\035\211\315\306\031#>\024\031l\236\241T\276\375R\366\236\361w;\0353_7_\253\265;\002~Wz\247\251xv\357\304\200\021\334{\256\340\266]\210\371\b\373U\355\266,h~\317D%\247q\a\00495\222{\2216\332)\025\006<\f\371\035\217Bl\362\324K\370\"\367\357M\356\265(\b\266\257\026\305b&M\353\321~\211z-\250:#\344l=twB\334\210\027\340\355\276\202t\222\037\234\205\351=\375)\353p\336HYa\306\\\315\177\201\223\002\351\026\a\205q=\366\373d\367\326\245\207zc\245z\025\254\313\221(\210\3527\315W\004\207\022\210B\332\2542\362(1\303\022\207\272d\335\311\210\321\207\330\b6n\356\177\323\f\311\273\205\243\331\325\"m\213\363\273\244\245x\032+\346:\376{\264\321\375\025h\203\241t\242MD\377\316\3