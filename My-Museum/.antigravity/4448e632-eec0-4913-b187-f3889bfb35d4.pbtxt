            lines {
              text: "export function animateAvatarRig("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  rig: AvatarRig,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  speed: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
