      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Allow clean static status tone styling on 3D avatar nameplates (Active Live vs Standing Offline)\", \"EndLine\":217, \"Instruction\":\"Add optional statusTone parameter to createNameplateTexture for crisp static Active vs Standing visual distinction\", \"ReplacementContent\":\"export function createNameplateTexture(\\n  displayName: string,\\n  genderLabel: string,\\n  statusTone: \'default\' | \'active\' | \'standing\' = \'default\'\\n): THREE.CanvasTexture {\\n  const w = 384;\\n  const h = 96;\\n  const canvas = document.createElement(\'canvas\');\\n  canvas.width = w;\\n  canvas.height = h;\\n  const ctx = canvas.getContext(\'2d\')!;\\n\\n  ctx.clearRect(0, 0, w, h);\\n\\n  // Clean museum obsidian label bar (sharp architectural corners, static indicator only)\\n  ctx.fillStyle = statusTone === \'standing\' ? \'rgba(24, 21, 18, 0.78)\' : \'rgba(24, 21, 18, 0.90)\';\\n  ctx.fillRect(16, 12, w - 32, h - 24);\\n  ctx.strokeStyle =\\n    statusTone === \'active\'\\n      ? \'rgba(110, 231, 183, 0.85)\'\\n      : statusTone === \'standing\'\\n        ? \'rgba(168, 162, 158, 0.52)\'\\n        : \'rgba(201, 154, 91, 0.72)\';\\n  ctx.lineWidth = 2;\\n  ctx.strokeRect(16, 12, w - 32, h - 24);\\n\\n  ctx.textAlign = \'center\';\\n  ctx.fillStyle = \'#F7F4EE\';\\n  ctx.font = \'600 24px \\\"Plus Jakarta Sans\\\", sans-serif\';\\n  const name = displayName.length > 18 ? `${displayName.slice(0, 17)}\342\200\246` : displayName;\\n  ctx.fillText(name, w / 2, 47);\\n\\n  ctx.fillStyle =\\n    statusTone === \'active\'\\n      ? \'#6EE7B7\'\\n      : statusTone === \'standing\'\\n        ? \'#A8A29E\'\\n        : \'#D4B282\';\\n  ctx.font = \'500 15px \\\"JetBrains Mono\\\", monospace\';\\n  ctx.fillText(genderLabel.toUpperCase(), w / 2, 70);\\n\\n  const texture = new THREE.CanvasTexture(canvas);\\n  texture.colorSpace = THREE.SRGBColorSpace;\\n  return texture;\\n}\", \"StartLine\":183, \"TargetContent\":\"export function createNameplateTexture(\\n  displayName: string,\\n  genderLabel: string\\n): THREE.CanvasTexture {\\n  const w = 384;\\n  const h = 96;\\n  const canvas = document.createElement(\'canvas\');\\n  canvas.width = w;\\n  canvas.height = h;\\n  const ctx = canvas.getContext(\'2d\')!;\\n\\n  ctx.clearRect(0, 0, w, h);\\n\\n  // Clean museum obsidian label bar (sharp architectural corners)\\n  ctx.fillStyle = \'rgba(24, 21, 18, 0.88)\';\\n  ctx.fillRect(16, 12, w - 32, h - 24);\\n  ctx.strokeStyle = \'rgba(201, 154, 91, 0.72)\';\\n  ctx.lineWidth = 2;\\n  ctx.strokeRect(16, 12, w - 32, h - 24);\\n\\n  ctx.textAlign = \'center\';\\n  ctx.fillStyle = \'#F7F4EE\';\\n  ctx.font = \'600 24px \\\"Plus Jakarta Sans\\\", sans-serif\';\\n  const name = displayName.length > 18 ? `${displayName.slice(0, 17)}\342\200\246` : displayName;\\n  ctx.fillText(name, w / 2, 47);\\n\\n  ctx.fillStyle = \'#D4B282\';\\n  ctx.font = \'500 15px \\\"JetBrains Mono\\\", monospace\';\\n  ctx.fillText(genderLabel.toUpperCase(), w / 2, 70);\\n\\n  const texture = new THREE.CanvasTexture(canvas);\\n  texture.colorSpace = THREE.SRGBColorSpace;\\n  return texture;\\n}\", \"TargetFile\":\"/src/three/proceduralTextures.ts\", \"toolAction\":\"Updating nameplate status tone styling\", \"toolSummary\":\"Update createNameplateTexture\"}"
