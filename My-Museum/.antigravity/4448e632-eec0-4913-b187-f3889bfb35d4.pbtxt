      arguments_json: "{\"Description\":\"Reduce dynamic lights on software WebGL and ensure smooth center-plinth bypass when walking North to the door\", \"Instruction\":\"Cap active point lights to 2 on software GL and keep light updates bounded by roomLights.length\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":268, \"ReplacementContent\":\"    const roomLights: THREE.PointLight[] = [];\\n    const lightCount = isSoftwareGl ? 2 : 4;\\n    for (let i = 0; i < lightCount; i++) {\\n      const pt = new THREE.PointLight(0xffe7c6, isSoftwareGl ? 7.2 : 8.0, 24, 1.7);\\n      pt.position.set(0, 5.2, -i * 10);\\n      scene.add(pt);\\n      roomLights.push(pt);\\n    }\", \"StartLine\":254, \"TargetContent\":\"    const roomLights: THREE.PointLight[] = [];\\n    for (let i = 0; i < 4; i++) {\\n      const pt = new THREE.PointLight(0xffe7c6, 8.2, 24, 1.7);\\n      pt.position.set(0, 5.2, -i * 10);\\n      scene.add(pt);\\n      roomLights.push(pt);\\n    }\"}, {\"AllowMultiple\":false, \"EndLine\":595, \"ReplacementContent\":\"      // Keep dynamic room lights centered on the player\'s current & adjacent rooms\\n      const activeRoomIdx = getRoomIndexAtZ(ps.z, curLayout);\\n      const activeRoom = curLayout.rooms[activeRoomIdx] ?? curLayout.rooms[0];\\n      if (roomLights[0]) roomLights[0].position.set(0, 5.4, activeRoom.centerZ + 4.2);\\n      if (roomLights[1]) roomLights[1].position.set(0, 5.4, activeRoom.centerZ - 4.2);\\n      const nextRoom = curLayout.rooms[activeRoomIdx + 1] ?? activeRoom;\\n      const prevRoom = curLayout.rooms[activeRoomIdx - 1] ?? activeRoom;\\n      if (roomLights[2]) roomLights[2].position.set(0, 5.4, nextRoom.centerZ);\\n      if (roomLights[3]) roomLights[3].position.set(0, 5.4, prevRoom.centerZ);\", \"StartLine\":575, \"TargetContent\":\"      // Keep the 4 room lights centered on the player\'s current & adjacent rooms\\n      const activeRoomIdx = getRoomIndexAtZ(ps.z, curLayout);\\n      const activeRoom = curLayout.rooms[activeRoomIdx] ?? curLayout.rooms[0];\\n      roomLights[0].position.set(0, 5.4, activeRoom.centerZ + 4.2);\\n      roomLights[1].position.set(0, 5.4, activeRoom.centerZ - 4.2);\\n      const nextRoom = curLayout.rooms[activeRoomIdx + 1] ?? activeRoom;\\n      const prevRoom = curLayout.rooms[activeRoomIdx - 1] ?? activeRoom;\\n      roomLights[2].position.set(0, 5.4, nextRoom.centerZ);\\n      roomLights[3].position.set(0, 5.4, prevRoom.centerZ);\"}], \"TargetFile\":\"/src/components/Museum3DView.tsx\", \"toolAction\":\"Optimizing room lighting count for software WebGL\", \"toolSummary\":\"Optimize lighting in Museum3DView.tsx\"}"
      original_name: "multi_replace_file_content"
    }
