            }
            lines {
              text: "    wGrp.add(rim);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    root.add(wGrp);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    wheels.push(wGrp);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
