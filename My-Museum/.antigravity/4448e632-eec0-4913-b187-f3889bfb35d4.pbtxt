    tool_calls {
      id: "call_4304158251172808430"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { Compass, Trash2, X } from \'lucide-react\';\\nimport type { ArtworkItem } from \'../types/museum\';\\nimport {\\n  formatAccessionNumber,\\n  formatArchivalDate,\\n  getArtworkPlacement,\\n} from \'../museum/layout\';\\n\\ninterface ArtworkInspectModalProps {\\n  artwork: ArtworkItem | null;\\n  slotIndex: number;\\n  canDelete: boolean;\\n  onClose: () => void;\\n  onWalkTo?: (artworkId: string) => void;\\n  onDelete: (artworkId: string) => void;\\n}\\n\\nexport function ArtworkInspectModal({\\n  artwork,\\n  slotIndex,\\n  canDelete,\\n  onClose,\\n  onWalkTo,\\n  onDelete,\\n}: ArtworkInspectModalProps) {\\n  if (!artwork) return null;\\n\\n  const placement = getArtworkPlacement(slotIndex);\\n  const accession = formatAccessionNumber(artwork.dateCaptured, slotIndex);\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-stone-950/75\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label={`Inspect ${artwork.title}`}\\n    >\\n      <div className=\\\"bg-[#FAF8F4] text-[#1C1917] w-full max-w-4xl max-h-[92vh] overflow-y-auto border border-stone-300 shadow-2xl grid grid-cols-1 md:grid-cols-12\\\">\\n        {/* Artwork Frame Presentation */}\\n        <div className=\\\"md:col-span-7 bg-[#E9E4DB] p-6 sm:p-8 flex items-center justify-center min-h-[280px]\\\">\\n          <div className=\\\"bg-white p-3 shadow-lg border border-stone-300 max-h-[65vh] overflow-hidden\\\">\\n            <img\\n              src={artwork.imageUrl}\\n              alt={artwork.title}\\n              referrerPolicy=\\\"no-referrer\\\"\\n              className=\\\"max-h-[58vh] w-auto object-contain block\\\"\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Museum Accession Details */}\\n        <div className=\\\"md:col-span-5 p-6 sm:p-8 flex flex-col justify-between\\\">\\n          <div>\\n            <div className=\\\"flex items-start justify-between gap-3 mb-4\\\">\\n              <p className=\\\"text-xs font-mono text-[#8A5A2B] tracking-wider tabular-nums\\\">\\n                {accession}\\n              </p>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onClose}\\n                aria-label=\\\"Close artwork inspection\\\"\\n                className=\\\"p-1.5 text-stone-500 hover:text-stone-900 cursor-pointer -mt-1 -mr-1\\\"\\n              >\\n                <X className=\\\"w-5 h-5\\\" />\\n              </button>\\n            </div>\\n\\n            <h2 className=\\\"font-editorial text-3xl font-semibold text-stone-900 leading-tight mb-2\\\">\\n              {artwork.title}\\n            </h2>\\n            <p className=\\\"text-sm text-stone-600 mb-6\\\">{artwork.artist}</p>\\n\\n            <dl className=\\\"divide-y divide-stone-200 border-t border-b border-stone-200 text-xs\\\">\\n              <div className=\\\"py-2.5 flex justify-between gap-4\\\">\\n                <dt className=\\\"text-stone-500\\\">Archival Date</dt>\\n                <dd className=\\\"text-stone-900 font-medium tabular-nums\\\">\\n                  {formatArchivalDate(artwork.dateCaptured)}\\n                </dd>\\n              </div>\\n              <div className=\\\"py-2.5 flex justify-between gap-4\\\">\\n                <dt className=\\\"text-stone-500\\\">Gallery Location</dt>\\n                <dd className=\\\"text-stone-900 font-medium\\\">\\n                  {placement.wingLabel} \302\267 {placement.wallSide === \'west\' ? \'West Wall\' : \'East Wall\'}\\n                </dd>\\n              </div>\\n              <div className=\\\"py-2.5 flex justify-between gap-4\\\">\\n                <dt className=\\\"text-stone-500\\\">Frame Finish</dt>\\n                <dd className=\\\"text-stone-900 font-medium capitalize\\\">{artwork.frameStyle}</dd>\\n              </div>\\n              <div className=\\\"py-2.5 flex justify-between gap-4\\\">\\n                <dt className=\\\"text-stone-500\\\">Curated By</dt>\\n                <dd className=\\\"text-stone-900 font-medium\\\">{artwork.uploadedByName}</dd>\\n              </div>\\n            </dl>\\n\\n            {artwork.notes && (\\n              <p className=\\\"mt-5 text-sm text-stone-700 leading-relaxed\\\">\\n                {artwork.notes}\\n              </p>\\n            )}\\n          </div>\\n\\n          <div className=\\\"mt-8 pt-4 border-t border-stone-200 flex flex-wrap items-center justify-between gap-3\\\">\\n            {onWalkTo && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  onWalkTo(artwork.id);\\n                  onClose();\\n                }}\\n                className=\\\"inline-flex items-center gap-2 px-4 py-2 bg-[#1C1917] text-[#F7F5F0] text-xs font-medium hover:bg-stone-800 transition-colors cursor-pointer\\\"\\n              >\\n                <Compass className=\\\"w-3.5 h-3.5\\\" />\\n                Stand Before Work\\n              </button>\\n            )}\\n            {canDelete && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  onDelete(artwork.id);\\n                  onClose();\\n                }}\\n                className=\\\"inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium text-red-700 hover:bg-red-50 transition-colors cursor-pointer\\\"\\n              >\\n                <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                Remove from Wall\\n              </button>\\n            )}\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create ArtworkInspectModal with museum accession metadata, framing preview, and actions\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ArtworkInspectModal.tsx\", \"toolAction\":\"Creating ArtworkInspectModal component\", \"toolSummary\":\"Create ArtworkInspectModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_4304158251172807175"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useMemo, useRef, useState } from \'react\';\\nimport * as THREE from \'three\';\\nimport { RoomEnvironment } from \'three/addons/environments/RoomEnvironment.js\';\\nimport {\\n  ArrowDown,\\n  ArrowLeft,\\n  ArrowRight,\\n  ArrowUp,\\n  ChevronDown,\\n  ChevronUp,\\n  Eye,\\n  FolderKanban,\\n  Home,\\n  Palette,\\n  Plus,\\n  Users,\\n} from \'lucide-react\';\\nimport type {\\n  ArtworkItem,\\n  AvatarConfig,\\n  MuseumMember,\\n  MuseumMeta,\\n  VisitorPresence,\\n  WallTheme,\\n} from \'../types/museum\';\\nimport { DEFAULT_AVATAR_BY_GENDER } from \'../types/museum\';\\nimport {\\n  calculateMuseumLayout,\\n  clampPlayerPosition,\\n  getArtworkPlacement,\\n  type MuseumLayout,\\n} from \'../museum/layout\';\\nimport { animateAvatarRig, buildAvatarRig, type AvatarRig } from \'../three/avatarBuilder\';\\nimport { buildMuseumArchitecture, type BuiltMuseum } from \'../three/museumBuilder\';\\nimport { createAfterDrawScheduler, detectSoftwareGl } from \'../three/webglUtils\';\\n\\ninterface Museum3DViewProps {\\n  museum: MuseumMeta;\\n  avatar: AvatarConfig;\\n  artworks: ArtworkItem[];\\n  members: MuseumMember[];\\n  liveVisitors: VisitorPresence[];\\n  showInvitedIn3D: boolean;\\n  canCurate: boolean;\\n  teleportTargetId: string | null;\\n  onClearTeleport: () => void;\\n  onSelectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\\n  onOpenCatalog: () => void;\\n  onOpenUpload: () => void;\\n  onOpenAccess: () => void;\\n  onReturnHome: () => void;\\n  onChangeWallTheme: (theme: WallTheme) => void;\\n  onPositionBroadcast?: (x: number, z: number, yaw: number) => void;\\n}\\n\\n// Reusable scratch vectors allocated outside render loop (zero GC)\\nconst _forward = new THREE.Vector3();\\nconst _right = new THREE.Vector3();\\nconst _move = new THREE.Vector3();\\nconst _camDesired = new THREE.Vector3();\\nconst _camLook = new THREE.Vector3();\\n\\nconst THEME_FOG_COLOR: Record<WallTheme, number> = {\\n  alabaster: 0xeae4da,\\n  travertine: 0xdfd5c7,\\n  charcoal: 0x1e1c1a,\\n};\\n\\nexport function Museum3DView({\\n  museum,\\n  avatar,\\n  artworks,\\n  members,\\n  liveVisitors,\\n  showInvitedIn3D,\\n  canCurate,\\n  teleportTargetId,\\n  onClearTeleport,\\n  onSelectArtwork,\\n  onOpenCatalog,\\n  onOpenUpload,\\n  onOpenAccess,\\n  onReturnHome,\\n  onChangeWallTheme,\\n  onPositionBroadcast,\\n}: Museum3DViewProps) {\\n  const mountRef = useRef<HTMLDivElement | null>(null);\\n  const [cameraMode, setCameraMode] = useState<\'third\' | \'first\'>(\'third\');\\n  const [dockCollapsed, setDockCollapsed] = useState(false);\\n  const [activeWingLabel, setActiveWingLabel] = useState(\'Entrance Foyer\');\\n  const [hoveredTitle, setHoveredTitle] = useState<string | null>(null);\\n\\n  const layout = useMemo(() => calculateMuseumLayout(artworks.length), [artworks.length]);\\n\\n  // Combine live Firestore co-visitors + simulated companion avatars for invited members\\n  const companionVisitors = useMemo<VisitorPresence[]>(() => {\\n    const combined: VisitorPresence[] = [...liveVisitors];\\n    if (showInvitedIn3D) {\\n      const liveNames = new Set(liveVisitors.map((v) => v.displayName.toLowerCase()));\\n      members.forEach((m, idx) => {\\n        if (liveNames.has(m.displayName.toLowerCase())) return;\\n        const preset = DEFAULT_AVATAR_BY_GENDER[m.gender];\\n        const placement = getArtworkPlacement(idx % Math.max(1, artworks.length));\\n        combined.push({\\n          uid: `invited-${m.id}`,\\n          museumId: museum.id,\\n          ownerId: museum.ownerId,\\n          displayName: m.displayName,\\n          gender: m.gender,\\n          skinTone: preset.skinTone,\\n          hairStyle: preset.hairStyle,\\n          hairColor: preset.hairColor,\\n          outfitStyle: preset.outfitStyle,\\n          outfitColor: m.gender === \'woman\' ? \'#6E2E36\' : \'#2D4739\',\\n          accentColor: preset.accentColor,\\n          accessory: preset.accessory,\\n          x: idx % 2 === 0 ? -2.35 : 2.35,\\n          z: Math.min(-1.8, placement.z + 1.2),\\n          yaw: idx % 2 === 0 ? Math.PI * 0.35 : -Math.PI * 0.35,\\n          isSimulated: true,\\n        });\\n      });\\n    }\\n    return combined;\\n  }, [liveVisitors, showInvitedIn3D, members, artworks.length, museum.id, museum.ownerId]);\\n\\n  // Refs bridging React state into stable single-mount WebGL loop\\n  const layoutRef = useRef<MuseumLayout>(layout);\\n  layoutRef.current = layout;\\n  const artworksRef = useRef(artworks);\\n  artworksRef.current = artworks;\\n  const cameraModeRef = useRef(cameraMode);\\n  cameraModeRef.current = cameraMode;\\n  const onSelectArtworkRef = useRef(onSelectArtwork);\\n  onSelectArtworkRef.current = onSelectArtwork;\\n  const onPositionBroadcastRef = useRef(onPositionBroadcast);\\n  onPositionBroadcastRef.current = onPositionBroadcast;\\n\\n  const sceneRef = useRef<THREE.Scene | null>(null);\\n  const rendererRef = useRef<THREE.WebGLRenderer | null>(null);\\n  const builtMuseumRef = useRef<BuiltMuseum | null>(null);\\n  const interactablesRef = useRef<THREE.Object3D[]>([]);\\n  const playerRigRef = useRef<AvatarRig | null>(null);\\n  const playerSlotRef = useRef<THREE.Group | null>(null);\\n  const companionsSlotRef = useRef<THREE.Group | null>(null);\\n  const companionRigsRef = useRef<\\n    Map<\\n      string,\\n      {\\n        rig: AvatarRig;\\n        visitor: VisitorPresence;\\n        targetX: number;\\n        targetZ: number;\\n        targetYaw: number;\\n      }\\n    >\\n  >(new Map());\\n\\n  // Mutable player kinematics state\\n  const playerStateRef = useRef({\\n    x: 0,\\n    z: 3.2,\\n    yaw: 0, // 0 faces -Z down the grand gallery corridor!\\n    camYaw: 0,\\n    camPitch: 0.22,\\n    speed: 0,\\n    lastBroadcast: 0,\\n  });\\n\\n  // Mobile/D-pad held input state\\n  const virtualKeysRef = useRef<Record<string, boolean>>({});\\n\\n  // Mount WebGLRenderer & Walkable 3D Museum Scene ONCE\\n  useEffect(() => {\\n    const container = mountRef.current;\\n    if (!container) return;\\n\\n    const isSoftwareGl = detectSoftwareGl();\\n    const renderer = new THREE.WebGLRenderer({\\n      antialias: !isSoftwareGl,\\n      powerPreference: \'high-performance\',\\n    });\\n    const width = Math.max(320, container.clientWidth);\\n    const height = Math.max(320, container.clientHeight);\\n    renderer.setSize(width, height);\\n    renderer.setPixelRatio(isSoftwareGl ? 1 : Math.min(window.devicePixelRatio, 2));\\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\\n    renderer.toneMappingExposure = 1.08;\\n    renderer.shadowMap.enabled = !isSoftwareGl;\\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\\n    renderer.domElement.style.display = \'block\';\\n    renderer.domElement.style.width = \'100%\';\\n    renderer.domElement.style.height = \'100%\';\\n    container.appendChild(renderer.domElement);\\n    rendererRef.current = renderer;\\n\\n    const scene = new THREE.Scene();\\n    const fogHex = THEME_FOG_COLOR[museum.wallTheme];\\n    scene.background = new THREE.Color(fogHex);\\n    scene.fog = new THREE.FogExp2(fogHex, 0.017);\\n    sceneRef.current = scene;\\n\\n    // Mandatory studio environment map for metallic bronze frames & marble reflections\\n    const pmrem = new THREE.PMREMGenerator(renderer);\\n    const envTex = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;\\n    scene.environment = envTex;\\n    pmrem.dispose();\\n\\n    const camera = new THREE.PerspectiveCamera(56, width / height, 0.1, 140);\\n    camera.position.set(0, 2.5, 7.6);\\n    camera.lookAt(0, 1.8, -6);\\n\\n    // Warm/cool museum architectural lighting rig (<= 1 shadow caster)\\n    const hemiLight = new THREE.HemisphereLight(0xf6f8ff, 0x8b7b6b, 0.92);\\n    scene.add(hemiLight);\\n\\n    const keyDir = new THREE.DirectionalLight(0xfff1dc, 1.35);\\n    keyDir.position.set(6, 14, 6);\\n    keyDir.castShadow = !isSoftwareGl;\\n    keyDir.shadow.mapSize.set(1024, 1024);\\n    keyDir.shadow.camera.near = 1;\\n    keyDir.shadow.camera.far = 55;\\n    keyDir.shadow.camera.left = -18;\\n    keyDir.shadow.camera.right = 18;\\n    keyDir.shadow.camera.top = 18;\\n    keyDir.shadow.camera.bottom = -28;\\n    keyDir.shadow.bias = -0.0005;\\n    keyDir.shadow.normalBias = 0.02;\\n    scene.add(keyDir);\\n\\n    // Warm gallery corridor fill point lights (capped at 4 for lossless performance)\\n    const corridorLights: THREE.PointLight[] = [];\\n    for (let i = 0; i < 4; i++) {\\n      const pt = new THREE.PointLight(0xffe8c8, 16, 22, 1.7);\\n      pt.position.set(0, 5.1, -i * 9.5 - 2);\\n      scene.add(pt);\\n      corridorLights.push(pt);\\n    }\\n\\n    const playerSlot = new THREE.Group();\\n    scene.add(playerSlot);\\n    playerSlotRef.current = playerSlot;\\n\\n    const companionsSlot = new THREE.Group();\\n    scene.add(companionsSlot);\\n    companionsSlotRef.current = companionsSlot;\\n\\n    // Keyboard & Pointer controls\\n    const keys: Record<string, boolean> = {};\\n    let isDragging = false;\\n    let dragMoved = false;\\n    let lastPointerX = 0;\\n    let lastPointerY = 0;\\n    const raycaster = new THREE.Raycaster();\\n    const pointerNdc = new THREE.Vector2();\\n    let lastHoverRaycast = 0;\\n\\n    const onKeyDown = (e: KeyboardEvent) => {\\n      const target = e.target as HTMLElement | null;\\n      if (\\n        target &&\\n        (target.tagName === \'INPUT\' ||\\n          target.tagName === \'TEXTAREA\' ||\\n          target.tagName === \'SELECT\')\\n      ) {\\n        return;\\n      }\\n      keys[e.code] = true;\\n      if (e.code === \'KeyV\') {\\n        setCameraMode((prev) => (prev === \'third\' ? \'first\' : \'third\'));\\n      } else if (e.code === \'KeyH\') {\\n        setDockCollapsed((prev) => !prev);\\n      }\\n    };\\n\\n    const onKeyUp = (e: KeyboardEvent) => {\\n      keys[e.code] = false;\\n    };\\n\\n    const onPointerDown = (e: PointerEvent) => {\\n      isDragging = true;\\n      dragMoved = false;\\n      lastPointerX = e.clientX;\\n      lastPointerY = e.clientY;\\n    };\\n\\n    const onPointerMove = (e: PointerEvent) => {\\n      if (isDragging) {\\n        const dx = e.clientX - lastPointerX;\\n        const dy = e.clientY - lastPointerY;\\n        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) dragMoved = true;\\n        lastPointerX = e.clientX;\\n        lastPointerY = e.clientY;\\n        playerStateRef.current.camYaw -= dx * 0.0055;\\n        playerStateRef.current.camPitch = THREE.MathUtils.clamp(\\n          playerStateRef.current.camPitch + dy * 0.0038,\\n          -0.2,\\n          0.62\\n        );\\n        return;\\n      }\\n\\n      // Throttled hover raycast on artwork frames\\n      const now = performance.now();\\n      if (now - lastHoverRaycast < 90) return;\\n      lastHoverRaycast = now;\\n      const rect = renderer.domElement.getBoundingClientRect();\\n      pointerNdc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;\\n      pointerNdc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;\\n      raycaster.setFromCamera(pointerNdc, camera);\\n      const hits = raycaster.intersectObjects(interactablesRef.current, false);\\n      if (hits.length > 0 && hits[0].distance < 15) {\\n        const id = hits[0].object.userData.artworkId as string | undefined;\\n        const found = artworksRef.current.find((a) => a.id === id);\\n        renderer.domElement.style.cursor = \'pointer\';\\n        setHoveredTitle(found ? found.title : null);\\n      } else {\\n        renderer.domElement.style.cursor = \'grab\';\\n        setHoveredTitle(null);\\n      }\\n    };\\n\\n    const onPointerUp = (e: PointerEvent) => {\\n      const wasClick = isDragging && !dragMoved;\\n      isDragging = false;\\n      if (!wasClick) return;\\n\\n      const rect = renderer.domElement.getBoundingClientRect();\\n      pointerNdc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;\\n      pointerNdc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;\\n      raycaster.setFromCamera(pointerNdc, camera);\\n      const hits = raycaster.intersectObjects(interactablesRef.current, false);\\n      if (hits.length > 0) {\\n        const id = hits[0].object.userData.artworkId as string | undefined;\\n        if (id) {\\n          const idx = artworksRef.current.findIndex((a) => a.id === id);\\n          if (idx >= 0) {\\n            onSelectArtworkRef.current(artworksRef.current[idx], idx);\\n          }\\n        }\\n      }\\n    };\\n\\n    const onResize = () => {\\n      if (!container) return;\\n      const w = Math.max(320, container.clientWidth);\\n      const h = Math.max(320, container.clientHeight);\\n      camera.aspect = w / h;\\n      camera.updateProjectionMatrix();\\n      renderer.setSize(w, h);\\n    };\\n\\n    window.addEventListener(\'keydown\', onKeyDown);\\n    window.addEventListener(\'keyup\', onKeyUp);\\n    window.addEventListener(\'resize\', onResize);\\n    renderer.domElement.addEventListener(\'pointerdown\', onPointerDown);\\n    window.addEventListener(\'pointermove\', onPointerMove);\\n    window.addEventListener(\'pointerup\', onPointerUp);\\n\\n    const onContextLost = (e: Event) => e.preventDefault();\\n    renderer.domElement.addEventListener(\'webglcontextlost\', onContextLost);\\n\\n    // Animation loop paced via afterDraw() on software WebGL, rAF on GPU\\n    const clock = new THREE.Clock();\\n    let frameId = 0;\\n    let disposed = false;\\n    let lastWingCheck = 0;\\n\\n    const afterDraw = createAfterDrawScheduler(renderer, (id) => {\\n      frameId = id;\\n    });\\n\\n    const tick = () => {\\n      if (disposed) return;\\n      const delta = Math.min(clock.getDelta(), 0.1);\\n      const elapsed = clock.getElapsedTime();\\n      const ps = playerStateRef.current;\\n      const curLayout = layoutRef.current;\\n\\n      const k = keys;\\n      const vk = virtualKeysRef.current;\\n      const forwardIn =\\n        (k.KeyW || k.ArrowUp || vk.up ? 1 : 0) -\\n        (k.KeyS || k.ArrowDown || vk.down ? 1 : 0);\\n      const strafeIn =\\n        (k.KeyD || k.ArrowRight || vk.right ? 1 : 0) -\\n        (k.KeyA || k.ArrowLeft || vk.left ? 1 : 0);\\n      const turnLeft = k.KeyQ ? 1 : 0;\\n      const turnRight = k.KeyE ? 1 : 0;\\n\\n      if (turnLeft || turnRight) {\\n        ps.camYaw += (turnLeft - turnRight) * 1.9 * delta;\\n      }\\n\\n      const walkSpeed = k.ShiftLeft || k.ShiftRight ? 6.2 : 4.1;\\n      _forward.set(-Math.sin(ps.camYaw), 0, -Math.cos(ps.camYaw));\\n      _right.set(Math.cos(ps.camYaw), 0, -Math.sin(ps.camYaw));\\n      _move.set(0, 0, 0);\\n      _move.addScaledVector(_forward, forwardIn);\\n      _move.addScaledVector(_right, strafeIn);\\n\\n      if (_move.lengthSq() > 0.001) {\\n        _move.normalize();\\n        const nextPos = clampPlayerPosition(\\n          ps.x + _move.x * walkSpeed * delta,\\n          ps.z + _move.z * walkSpeed * delta,\\n          curLayout\\n        );\\n        ps.x = nextPos.x;\\n        ps.z = nextPos.z;\\n        ps.speed = walkSpeed;\\n\\n        // Smoothly orient avatar body toward direction of travel\\n        const desiredYaw = Math.atan2(_move.x, _move.z);\\n        let diff = desiredYaw - ps.yaw;\\n        while (diff > Math.PI) diff -= Math.PI * 2;\\n        while (diff < -Math.PI) diff += Math.PI * 2;\\n        ps.yaw += diff * (1 - Math.exp(-12 * delta));\\n      } else {\\n        ps.speed = 0;\\n      }\\n\\n      // Update player avatar rig transform & stride animation\\n      const playerRig = playerRigRef.current;\\n      if (playerRig) {\\n        playerRig.root.position.set(ps.x, 0, ps.z);\\n        playerRig.root.rotation.y = ps.yaw;\\n        playerRig.root.visible = cameraModeRef.current === \'third\';\\n        animateAvatarRig(playerRig, ps.speed, elapsed, delta);\\n      }\\n\\n      // Animate co-visitors (live Firestore interpolation + gentle strolling for invited companions)\\n      let companionIdx = 0;\\n      companionRigsRef.current.forEach((entry) => {\\n        if (entry.visitor.isSimulated) {\\n          const baseZ = Math.min(-2.5, -(companionIdx * 4.2 + 3.2));\\n          const patrolZ = baseZ + Math.sin(elapsed * 0.35 + companionIdx * 1.9) * 2.2;\\n          const patrolX = (companionIdx % 2 === 0 ? -2.6 : 2.6) + Math.cos(elapsed * 0.25 + companionIdx) * 0.4;\\n          const dz = patrolZ - entry.rig.root.position.z;\\n          const dx = patrolX - entry.rig.root.position.x;\\n          entry.rig.root.position.x += dx * (1 - Math.exp(-3 * delta));\\n          entry.rig.root.position.z += dz * (1 - Math.exp(-3 * delta));\\n          const moveSpeed = Math.hypot(dx, dz) / Math.max(delta, 0.016);\\n          if (moveSpeed > 0.15) {\\n            entry.rig.root.rotation.y = Math.atan2(dx, dz);\\n          }\\n          animateAvatarRig(entry.rig, Math.min(2.1, moveSpeed * 0.6), elapsed + companionIdx, delta);\\n        } else {\\n          const lerpAlpha = 1 - Math.exp(-7 * delta);\\n          const dx = entry.targetX - entry.rig.root.position.x;\\n          const dz = entry.targetZ - entry.rig.root.position.z;\\n          entry.rig.root.position.x += dx * lerpAlpha;\\n          entry.rig.root.position.z += dz * lerpAlpha;\\n          entry.rig.root.rotation.y += (entry.targetYaw - entry.rig.root.rotation.y) * lerpAlpha;\\n          const distSpeed = Math.hypot(dx, dz) * 3.5;\\n          animateAvatarRig(entry.rig, distSpeed, elapsed + companionIdx, delta);\\n        }\\n        companionIdx++;\\n      });\\n\\n      // Keep corridor lights centered along player\'s Z progress\\n      for (let i = 0; i < corridorLights.length; i++) {\\n        corridorLights[i].position.z =\\n          Math.max(curLayout.northWallZ + 2, Math.min(curLayout.southWallZ - 2, ps.z - i * 8 + 4));\\n      }\\n\\n      // Smooth damped Third-Person or First-Person Camera with wall pull-in\\n      const camDamp = 1 - Math.exp(-9 * delta);\\n      if (cameraModeRef.current === \'first\') {\\n        _camDesired.set(ps.x, 1.66, ps.z);\\n        camera.position.lerp(_camDesired, camDamp);\\n        _camLook.set(\\n          ps.x - Math.sin(ps.camYaw) * 6,\\n          1.66 - Math.sin(ps.camPitch) * 3.5,\\n          ps.z - Math.cos(ps.camYaw) * 6\\n        );\\n        camera.lookAt(_camLook);\\n      } else {\\n        const dist = 4.35;\\n        const desiredX = ps.x + Math.sin(ps.camYaw) * dist;\\n        const desiredZ = ps.z + Math.cos(ps.camYaw) * dist;\\n        const clampedCam = clampPlayerPosition(desiredX, desiredZ, curLayout);\\n        const desiredY = 2.15 + Math.sin(ps.camPitch) * 1.4;\\n        _camDesired.set(clampedCam.x, desiredY, clampedCam.z);\\n        camera.position.lerp(_camDesired, camDamp);\\n\\n        _camLook.set(\\n          ps.x - Math.sin(ps.camYaw) * 2.2,\\n          1.55,\\n          ps.z - Math.cos(ps.camYaw) * 2.2\\n        );\\n        camera.lookAt(_camLook);\\n      }\\n\\n      // Throttled HUD wing indicator & Firestore presence broadcast (<= 2Hz)\\n      const nowMs = performance.now();\\n      if (nowMs - lastWingCheck > 320) {\\n        lastWingCheck = nowMs;\\n        if (ps.z > 0.2) {\\n          setActiveWingLabel(\'Entrance Foyer\');\\n        } else {\\n          const wingIdx = Math.min(\\n            curLayout.bayCount,\\n            Math.max(1, Math.floor(-ps.z / curLayout.bayLength) + 1)\\n          );\\n          setActiveWingLabel(`Wing ${wingIdx} of ${curLayout.bayCount}`);\\n        }\\n      }\\n\\n      if (nowMs - ps.lastBroadcast > 650) {\\n        ps.lastBroadcast = nowMs;\\n        onPositionBroadcastRef.current?.(ps.x, ps.z, ps.yaw);\\n      }\\n\\n      renderer.render(scene, camera);\\n\\n      if (isSoftwareGl) {\\n        afterDraw(tick);\\n      } else {\\n        frameId = requestAnimationFrame(tick);\\n      }\\n    };\\n\\n    if (isSoftwareGl) {\\n      // Draw immediate initial frame, then pace via afterDraw\\n      renderer.render(scene, camera);\\n      afterDraw(tick);\\n    } else {\\n      frameId = requestAnimationFrame(tick);\\n    }\\n\\n    return () => {\\n      disposed = true;\\n      cancelAnimationFrame(frameId);\\n      clearTimeout(frameId);\\n      window.removeEventListener(\'keydown\', onKeyDown);\\n      window.removeEventListener(\'keyup\', onKeyUp);\\n      window.removeEventListener(\'resize\', onResize);\\n      renderer.domElement.removeEventListener(\'pointerdown\', onPointerDown);\\n      window.removeEventListener(\'pointermove\', onPointerMove);\\n      window.removeEventListener(\'pointerup\', onPointerUp);\\n      renderer.domElement.removeEventListener(\'webglcontextlost\', onContextLost);\\n      builtMuseumRef.current?.dispose();\\n      builtMuseumRef.current = null;\\n      playerRigRef.current?.dispose();\\n      playerRigRef.current = null;\\n      companionRigsRef.current.forEach((c) => c.rig.dispose());\\n      companionRigsRef.current.clear();\\n      envTex.dispose();\\n      renderer.dispose();\\n      sceneRef.current = null;\\n      rendererRef.current = null;\\n      if (renderer.domElement.parentNode === container) {\\n        container.removeChild(renderer.domElement);\\n      }\\n    };\\n  }, []);\\n\\n  // Dynamically rebuild museum architecture & wall slots whenever artworks or wallTheme changes\\n  useEffect(() => {\\n    const scene = sceneRef.current;\\n    const renderer = rendererRef.current;\\n    if (!scene || !renderer) return;\\n\\n    const fogHex = THEME_FOG_COLOR[museum.wallTheme];\\n    scene.background = new THREE.Color(fogHex);\\n    scene.fog = new THREE.FogExp2(fogHex, 0.017);\\n\\n    if (builtMuseumRef.current) {\\n      scene.remove(builtMuseumRef.current.group);\\n      builtMuseumRef.current.dispose();\\n    }\\n\\n    const built = buildMuseumArchitecture(\\n      layout,\\n      artworks,\\n      museum.wallTheme,\\n      renderer.capabilities.getMaxAnisotropy()\\n    );\\n    scene.add(built.group);\\n    builtMuseumRef.current = built;\\n    interactablesRef.current = built.interactables;\\n\\n    // Ensure player remains safely inside new layout bounds\\n    const clamped = clampPlayerPosition(\\n      playerStateRef.current.x,\\n      playerStateRef.current.z,\\n      layout\\n    );\\n    playerStateRef.current.x = clamped.x;\\n    playerStateRef.current.z = clamped.z;\\n  }, [layout, artworks, museum.wallTheme]);\\n\\n  // Rebuild player 3D avatar when user\'s avatar configuration changes\\n  useEffect(() => {\\n    const slot = playerSlotRef.current;\\n    if (!slot) return;\\n    if (playerRigRef.current) {\\n      slot.remove(playerRigRef.current.root);\\n      playerRigRef.current.dispose();\\n    }\\n    const rig = buildAvatarRig(avatar, { showNameplate: true, showContactShadow: true });\\n    rig.root.position.set(playerStateRef.current.x, 0, playerStateRef.current.z);\\n    rig.root.rotation.y = playerStateRef.current.yaw;\\n    slot.add(rig.root);\\n    playerRigRef.current = rig;\\n  }, [avatar]);\\n\\n  // Sync co-visitor / invited companion 3D avatars in the museum hall\\n  useEffect(() => {\\n    const slot = companionsSlotRef.current;\\n    if (!slot) return;\\n\\n    const activeIds = new Set(companionVisitors.map((v) => v.uid));\\n    // Remove departed visitors\\n    companionRigsRef.current.forEach((entry, uid) => {\\n      if (!activeIds.has(uid)) {\\n        slot.remove(entry.rig.root);\\n        entry.rig.dispose();\\n        companionRigsRef.current.delete(uid);\\n      }\\n    });\\n\\n    // Add or update active visitors\\n    for (const v of companionVisitors) {\\n      const existing = companionRigsRef.current.get(v.uid);\\n      if (existing) {\\n        existing.targetX = v.x;\\n        existing.targetZ = v.z;\\n        existing.targetYaw = v.yaw;\\n        existing.visitor = v;\\n      } else {\\n        const rig = buildAvatarRig(\\n          {\\n            displayName: v.displayName,\\n            gender: v.gender,\\n            skinTone: v.skinTone,\\n            hairStyle: v.hairStyle,\\n            hairColor: v.hairColor,\\n            outfitStyle: v.outfitStyle,\\n            outfitColor: v.outfitColor,\\n            accentColor: v.accentColor,\\n            accessory: v.accessory,\\n          },\\n          { showNameplate: true, showContactShadow: true }\\n        );\\n        rig.root.position.set(v.x, 0, v.z);\\n        rig.root.rotation.y = v.yaw;\\n        slot.add(rig.root);\\n        companionRigsRef.current.set(v.uid, {\\n          rig,\\n          visitor: v,\\n          targetX: v.x,\\n          targetZ: v.z,\\n          targetYaw: v.yaw,\\n        });\\n      }\\n    }\\n  }, [companionVisitors]);\\n\\n  // Teleport avatar cleanly in front of an artwork selected from the Catalog\\n  useEffect(() => {\\n    if (!teleportTargetId) return;\\n    const idx = artworks.findIndex((a) => a.id === teleportTargetId);\\n    if (idx >= 0) {\\n      const placement = getArtworkPlacement(idx);\\n      playerStateRef.current.x = placement.standPoint.x;\\n      playerStateRef.current.z = placement.standPoint.z;\\n      // Orient camera and avatar toward the artwork wall\\n      const lookYaw = placement.wallSide === \'west\' ? Math.PI / 2 : -Math.PI / 2;\\n      playerStateRef.current.camYaw = lookYaw;\\n      playerStateRef.current.yaw = placement.wallSide === \'west\' ? -Math.PI / 2 : Math.PI / 2;\\n    }\\n    onClearTeleport();\\n  }, [teleportTargetId, artworks, onClearTeleport]);\\n\\n  const cycleTheme = () => {\\n    const order: WallTheme[] = [\'alabaster\', \'travertine\', \'charcoal\'];\\n    const next = order[(order.indexOf(museum.wallTheme) + 1) % order.length];\\n    onChangeWallTheme(next);\\n  };\\n\\n  const setVirtualKey = (dir: string, active: boolean) => {\\n    virtualKeysRef.current[dir] = active;\\n  };\\n\\n  return (\\n    <div\\n      className=\\\"relative w-screen h-screen overflow-hidden bg-[#1C1917] select-none\\\"\\n      data-testid=\\\"museum-3d-view\\\"\\n      data-wings={layout.bayCount}\\n      data-artworks={artworks.length}\\n      data-visitors={companionVisitors.length + 1}\\n    >\\n      {/* Dedicated WebGL Mount Container */}\\n      <div ref={mountRef} className=\\\"w-full h-full\\\" />\\n\\n      {/* Minimal Top-Left Museum Placard (solid rgba, zero backdrop-blur over WebGL) */}\\n      <div className=\\\"absolute top-4 left-4 z-10 pointer-events-auto bg-[#181512]/90 text-[#F7F5F0] px-4 py-2.5 border border-stone-700/80 max-w-[min(440px,calc(100vw-2rem))]\\\">\\n        <div className=\\\"flex items-center justify-between gap-4\\\">\\n          <div className=\\\"min-w-0\\\">\\n            <h1 className=\\\"font-editorial text-lg font-semibold leading-tight truncate\\\">\\n              {museum.title}\\n            </h1>\\n            <p className=\\\"text-xs text-stone-300 font-mono tabular-nums mt-0.5 truncate\\\">\\n              {activeWingLabel} \302\267 {artworks.length}/{layout.totalWallSlots} Walls \302\267{\' \'}\\n              {companionVisitors.length + 1} {companionVisitors.length === 0 ? \'Visitor\' : \'Visitors\'}\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onReturnHome}\\n            aria-label=\\\"Return to Avatar Studio\\\"\\n            className=\\\"inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-xs font-medium text-stone-100 border border-stone-600 transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n          >\\n            <Home className=\\\"w-3.5 h-3.5\\\" />\\n            Studio\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* Subtle Hover Prompt when pointing at a framed painting */}\\n      {hoveredTitle && (\\n        <div className=\\\"absolute top-20 left-1/2 -translate-x-1/2 z-10 pointer-events-none bg-[#181512]/90 text-[#F7F5F0] px-4 py-2 border border-[#C99A5B]/60 text-xs\\\">\\n          Click to inspect <span className=\\\"font-semibold text-[#E8CFA6]\\\">{hoveredTitle}</span>\\n        </div>\\n      )}\\n\\n      {/* Compact On-Screen Touch / Click Walk Pad (Mobile & Mouse convenience) */}\\n      <div\\n        className=\\\"absolute bottom-24 right-4 z-10 md:hidden grid grid-cols-3 gap-1 w-28\\\"\\n        aria-label=\\\"Directional walk pad\\\"\\n      >\\n        <div />\\n        <button\\n          type=\\\"button\\\"\\n          aria-label=\\\"Walk forward\\\"\\n          onPointerDown={() => setVirtualKey(\'up\', true)}\\n          onPointerUp={() => setVirtualKey(\'up\', false)}\\n          onPointerLeave={() => setVirtualKey(\'up\', false)}\\n          className=\\\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\\\"\\n        >\\n          <ArrowUp className=\\\"w-4 h-4\\\" />\\n        </button>\\n        <div />\\n        <button\\n          type=\\\"button\\\"\\n          aria-label=\\\"Walk left\\\"\\n          onPointerDown={() => setVirtualKey(\'left\', true)}\\n          onPointerUp={() => setVirtualKey(\'left\', false)}\\n          onPointerLeave={() => setVirtualKey(\'left\', false)}\\n          className=\\\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\\\"\\n        >\\n          <ArrowLeft className=\\\"w-4 h-4\\\" />\\n        </button>\\n        <button\\n          type=\\\"button\\\"\\n          aria-label=\\\"Walk backward\\\"\\n          onPointerDown={() => setVirtualKey(\'down\', true)}\\n          onPointerUp={() => setVirtualKey(\'down\', false)}\\n          onPointerLeave={() => setVirtualKey(\'down\', false)}\\n          className=\\\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\\\"\\n        >\\n          <ArrowDown className=\\\"w-4 h-4\\\" />\\n        </button>\\n        <button\\n          type=\\\"button\\\"\\n          aria-label=\\\"Walk right\\\"\\n          onPointerDown={() => setVirtualKey(\'right\', true)}\\n          onPointerUp={() => setVirtualKey(\'right\', false)}\\n          onPointerLeave={() => setVirtualKey(\'right\', false)}\\n          className=\\\"h-9 bg-[#181512]/90 border border-stone-700 text-stone-100 flex items-center justify-center active:bg-[#8A5A2B]\\\"\\n        >\\n          <ArrowRight className=\\\"w-4 h-4\\\" />\\n        </button>\\n      </div>\\n\\n      {/* Collapsible Unified Bottom Control Dock (Zero Viewport Occlusion) */}\\n      <div className=\\\"absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center max-w-[96vw]\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setDockCollapsed((v) => !v)}\\n          aria-expanded={!dockCollapsed}\\n          className=\\\"inline-flex items-center gap-1.5 px-3 py-1 bg-[#181512]/90 text-stone-300 hover:text-white border border-b-0 border-stone-700 text-xs transition-colors cursor-pointer whitespace-nowrap\\\"\\n        >\\n          {dockCollapsed ? (\\n            <>\\n              <ChevronUp className=\\\"w-3.5 h-3.5\\\" />\\n              Show Controls\\n            </>\\n          ) : (\\n            <>\\n              <ChevronDown className=\\\"w-3.5 h-3.5\\\" />\\n              Hide Controls\\n            </>\\n          )}\\n        </button>\\n\\n        {!dockCollapsed && (\\n          <nav\\n            aria-label=\\\"Museum controls\\\"\\n            className=\\\"bg-[#181512]/92 text-[#F7F5F0] border border-stone-700 px-3 py-2 flex flex-wrap items-center justify-center gap-2 shadow-2xl\\\"\\n          >\\n            {canCurate && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onOpenUpload}\\n                className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#8A5A2B] hover:bg-[#9E6833] text-white text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n              >\\n                <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                Add Artwork\\n              </button>\\n            )}\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenCatalog}\\n              className=\\\"inline-flex items-center gap-1.5 px-3 py-2 bg-stone-800 hover:bg-stone-700 text-stone-100 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n            >\\n              <FolderKanban className=\\\"w-3.5 h-3.5 text-[#D4B282]\\\" />\\n              Catalog by Date ({artworks.length})\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenAccess}\\n              className=\\\"inline-flex items-center gap-1.5 px-3 py-2 bg-stone-800 hover:bg-stone-700 text-stone-100 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n            >\\n              <Users className=\\\"w-3.5 h-3.5 text-[#D4B282]\\\" />\\n              Share Access\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setCameraMode((m) => (m === \'third\' ? \'first\' : \'third\'))}\\n              className=\\\"inline-flex items-center gap-1.5 px-3 py-2 bg-stone-800 hover:bg-stone-700 text-stone-100 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n            >\\n              <Eye className=\\\"w-3.5 h-3.5 text-[#D4B282]\\\" />\\n              {cameraMode === \'third\' ? \'3rd Person\' : \'1st Person\'}\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={cycleTheme}\\n              className=\\\"inline-flex items-center gap-1.5 px-3 py-2 bg-stone-800 hover:bg-stone-700 text-stone-100 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0 capitalize\\\"\\n            >\\n              <Palette className=\\\"w-3.5 h-3.5 text-[#D4B282]\\\" />\\n              {museum.wallTheme}\\n            </button>\\n\\n            <span className=\\\"hidden lg:inline-block text-xs text-stone-400 pl-2 border-l border-stone-700 whitespace-nowrap\\\">\\n              WASD / Arrows to walk \302\267 Drag to look \302\267 Click painting\\n            </span>\\n          </nav>\\n        )}\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Implement full-viewport walkable 3D Museum with dynamic expanding walls, gender avatars, companion visitors, and collapsible dock\", \"Overwrite\":true, \"TargetFile\":\"/src/components/Museum3DView.tsx\", \"toolAction\":\"Creating Museum3DView component\", \"toolSummary\":\"Create Museum3DView.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_4304158251172810016"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { User } from \'firebase/auth\';\\nimport {\\n  ArrowRight,\\n  Calendar,\\n  FolderKanban,\\n  LogIn,\\n  LogOut,\\n  Plus,\\n  Users,\\n} from \'lucide-react\';\\nimport {\\n  ACCENT_COLORS,\\n  ACCESSORIES,\\n  DEFAULT_AVATAR_BY_GENDER,\\n  HAIR_COLORS,\\n  HAIR_STYLES_BY_GENDER,\\n  OUTFIT_COLORS,\\n  OUTFIT_STYLES_BY_GENDER,\\n  SKIN_TONES,\\n  type AccessoryType,\\n  type ArtworkItem,\\n  type AvatarConfig,\\n  type Gender,\\n  type MuseumMember,\\n  type MuseumMeta,\\n} from \'../types/museum\';\\nimport {\\n  calculateMuseumLayout,\\n  formatArchivalDate,\\n  sortArtworksByDate,\\n} from \'../museum/layout\';\\nimport { AvatarPreview3D } from \'./AvatarPreview3D\';\\n\\ninterface HomeStudioProps {\\n  user: User | null;\\n  authLoading: boolean;\\n  avatar: AvatarConfig;\\n  museum: MuseumMeta;\\n  artworks: ArtworkItem[];\\n  members: MuseumMember[];\\n  accessibleMuseums: MuseumMeta[];\\n  onSignInGoogle: () => void;\\n  onSignOut: () => void;\\n  onChangeAvatar: (next: AvatarConfig) => void;\\n  onEnterMuseum: () => void;\\n  onOpenCatalog: () => void;\\n  onOpenUpload: () => void;\\n  onOpenAccess: () => void;\\n  onSwitchMuseum: (museumId: string) => void;\\n  onInspectArtwork: (artwork: ArtworkItem, slotIndex: number) => void;\\n}\\n\\nexport function HomeStudio({\\n  user,\\n  authLoading,\\n  avatar,\\n  museum,\\n  artworks,\\n  members,\\n  accessibleMuseums,\\n  onSignInGoogle,\\n  onSignOut,\\n  onChangeAvatar,\\n  onEnterMuseum,\\n  onOpenCatalog,\\n  onOpenUpload,\\n  onOpenAccess,\\n  onSwitchMuseum,\\n  onInspectArtwork,\\n}: HomeStudioProps) {\\n  const layout = calculateMuseumLayout(artworks.length);\\n  const recentArtworks = sortArtworksByDate(artworks, \'newest\').slice(0, 4);\\n  const hairOptions = HAIR_STYLES_BY_GENDER[avatar.gender];\\n  const outfitOptions = OUTFIT_STYLES_BY_GENDER[avatar.gender];\\n\\n  const handleGenderSwitch = (nextGender: Gender) => {\\n    if (nextGender === avatar.gender) return;\\n    const defaults = DEFAULT_AVATAR_BY_GENDER[nextGender];\\n    onChangeAvatar({\\n      ...avatar,\\n      gender: nextGender,\\n      hairStyle: defaults.hairStyle,\\n      outfitStyle: defaults.outfitStyle,\\n      outfitColor: defaults.outfitColor,\\n    });\\n  };\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#F7F5F0] text-[#1C1917] flex flex-col\\\">\\n      {/* Strict 3-Zone Top Bar Contract */}\\n      <header className=\\\"sticky top-0 z-30 bg-[#F7F5F0]/95 border-b border-stone-200\\\">\\n        <div className=\\\"max-w-[1320px] mx-auto px-5 sm:px-8 h-16 flex items-center justify-between gap-8\\\">\\n          {/* Zone 1: Single-line Brand Wordmark */}\\n          <a\\n            href=\\\"#studio\\\"\\n            className=\\\"font-editorial text-2xl font-semibold tracking-tight text-stone-900 whitespace-nowrap shrink-0\\\"\\n          >\\n            My Museum\\n          </a>\\n\\n          {/* Zone 2: 4 concise single-line text nav links */}\\n          <nav\\n            aria-label=\\\"Primary navigation\\\"\\n            className=\\\"hidden md:flex items-center gap-7 text-sm font-medium text-stone-600\\\"\\n          >\\n            <a\\n              href=\\\"#studio\\\"\\n              className=\\\"hover:text-stone-900 transition-colors whitespace-nowrap shrink-0\\\"\\n            >\\n              Avatar Studio\\n            </a>\\n            <a\\n              href=\\\"#collection\\\"\\n              className=\\\"hover:text-stone-900 transition-colors whitespace-nowrap shrink-0\\\"\\n            >\\n              Collection\\n            </a>\\n            <a\\n              href=\\\"#shared-access\\\"\\n              className=\\\"hover:text-stone-900 transition-colors whitespace-nowrap shrink-0\\\"\\n            >\\n              Shared Access\\n            </a>\\n            <a\\n              href=\\\"#architecture\\\"\\n              className=\\\"hover:text-stone-900 transition-colors whitespace-nowrap shrink-0\\\"\\n            >\\n              Guide\\n            </a>\\n          </nav>\\n\\n          {/* Zone 3: 1 Primary CTA */}\\n          <div className=\\\"shrink-0\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onEnterMuseum}\\n              className=\\\"inline-flex items-center gap-2 px-4 py-2 bg-[#1C1917] text-[#F7F5F0] text-xs font-medium hover:bg-stone-800 transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n            >\\n              Enter Museum\\n              <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n            </button>\\n          </div>\\n        </div>\\n      </header>\\n\\n      <main className=\\\"flex-1\\\">\\n        {/* SECTION 1: Avatar Studio Hero (2-Column Balanced 1440px Split) */}\\n        <section id=\\\"studio\\\" className=\\\"max-w-[1320px] mx-auto px-5 sm:px-8 pt-8 pb-14\\\">\\n          {/* Quiet Account & Museum Utility Ribbon */}\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-stone-200 text-xs text-stone-600\\\">\\n            <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n              <span className=\\\"font-medium text-stone-900\\\">{museum.title}</span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {artworks.length} Artworks \302\267 {layout.bayCount} Expandable Wings\\n              </span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span className=\\\"font-mono tabular-nums\\\">Code {museum.accessCode}</span>\\n            </div>\\n\\n            <div className=\\\"flex items-center gap-4\\\">\\n              {authLoading ? (\\n                <span className=\\\"text-stone-500\\\">Checking account...</span>\\n              ) : user ? (\\n                <div className=\\\"flex items-center gap-3\\\">\\n                  <span className=\\\"text-stone-800 font-medium\\\">\\n                    Signed in as {user.displayName || user.email}\\n                  </span>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={onSignOut}\\n                    className=\\\"inline-flex items-center gap-1.5 text-stone-600 hover:text-stone-900 underline underline-offset-4 cursor-pointer\\\"\\n                  >\\n                    <LogOut className=\\\"w-3.5 h-3.5\\\" />\\n                    Sign Out\\n                  </button>\\n                </div>\\n              ) : (\\n                <div className=\\\"flex items-center gap-3\\\">\\n                  <span className=\\\"text-stone-500\\\">Guest Studio Mode</span>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={onSignInGoogle}\\n                    className=\\\"inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-stone-300 text-stone-900 font-medium hover:border-stone-500 transition-colors cursor-pointer whitespace-nowrap\\\"\\n                  >\\n                    <LogIn className=\\\"w-3.5 h-3.5 text-[#8A5A2B]\\\" />\\n                    Sign in with Google\\n                  </button>\\n                </div>\\n              )}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch\\\">\\n            {/* Left Dominant Anchor: Live 3D Avatar Preview Stage */}\\n            <div className=\\\"lg:col-span-6 flex flex-col\\\">\\n              <AvatarPreview3D avatar={avatar} />\\n            </div>\\n\\n            {/* Right Column: Curatorial Avatar Customization Atelier */}\\n            <div className=\\\"lg:col-span-6 bg-white border border-stone-200 p-6 sm:p-8 flex flex-col justify-between\\\">\\n              <div className=\\\"space-y-6\\\">\\n                <div>\\n                  <p className=\\\"text-xs font-mono text-[#8A5A2B] tracking-wider mb-1.5\\\">\\n                    STEP 01 \302\267 PERSONALIZE YOUR 3D VISITOR\\n                  </p>\\n                  <h1 className=\\\"font-editorial text-4xl sm:text-5xl font-semibold text-stone-900 leading-[1.08] text-balance\\\">\\n                    Craft your avatar before entering the gallery\\n                  </h1>\\n                  <p className=\\\"text-sm text-stone-600 mt-3 leading-relaxed max-w-xl\\\">\\n                    Select Man or Woman proportions, customize your hair, attire, and accessories, then walk through your expanding 3D art museum or visit shared collections.\\n                  </p>\\n                </div>\\n\\n                {/* Gender & Display Name */}\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div>\\n                    <span className=\\\"block text-xs font-medium text-stone-700 mb-2\\\">\\n                      3D Model Silhouette\\n                    </span>\\n                    <div\\n                      className=\\\"grid grid-cols-2 gap-1.5 p-1 bg-[#F3EFE8] border border-stone-200\\\"\\n                      role=\\\"group\\\"\\n                      aria-label=\\\"Choose avatar gender\\\"\\n                    >\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => handleGenderSwitch(\'man\')}\\n                        aria-pressed={avatar.gender === \'man\'}\\n                        className={`py-2 text-xs font-medium transition-colors cursor-pointer ${\\n                          avatar.gender === \'man\'\\n                            ? \'bg-[#1C1917] text-[#F7F5F0]\'\\n                            : \'text-stone-700 hover:text-stone-950\'\\n                        }`}\\n                      >\\n                        Man Model\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => handleGenderSwitch(\'woman\')}\\n                        aria-pressed={avatar.gender === \'woman\'}\\n                        className={`py-2 text-xs font-medium transition-colors cursor-pointer ${\\n                          avatar.gender === \'woman\'\\n                            ? \'bg-[#1C1917] text-[#F7F5F0]\'\\n                            : \'text-stone-700 hover:text-stone-950\'\\n                        }`}\\n                      >\\n                        Woman Model\\n                      </button>\\n                    </div>\\n                  </div>\\n\\n                  <div>\\n                    <label\\n                      htmlFor=\\\"avatar-display-name\\\"\\n                      className=\\\"block text-xs font-medium text-stone-700 mb-2\\\"\\n                    >\\n                      Visitor Nameplate\\n                    </label>\\n                    <input\\n                      id=\\\"avatar-display-name\\\"\\n                      type=\\\"text\\\"\\n                      maxLength={80}\\n                      value={avatar.displayName}\\n                      onChange={(e) =>\\n                        onChangeAvatar({ ...avatar, displayName: e.target.value })\\n                      }\\n                      placeholder=\\\"Your name in the museum\\\"\\n                      className=\\\"w-full px-3 py-2.5 bg-[#FAF8F4] border border-stone-300 text-sm text-stone-900 focus:outline-none focus:border-[#8A5A2B]\\\"\\n                    />\\n                  </div>\\n                </div>\\n\\n                {/* Hair Style & Attire Style */}\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div>\\n                    <span className=\\\"block text-xs font-medium text-stone-700 mb-2\\\">\\n                      Hair Style\\n                    </span>\\n                    <div className=\\\"grid grid-cols-2 gap-1.5\\\">\\n                      {hairOptions.map((opt) => (\\n                        <button\\n                          key={opt.id}\\n                          type=\\\"button\\\"\\n                          onClick={() => onChangeAvatar({ ...avatar, hairStyle: opt.id })}\\n                          className={`px-2.5 py-2 text-xs border text-left transition-colors cursor-pointer truncate ${\\n                            avatar.hairStyle === opt.id\\n                              ? \'border-[#8A5A2B] bg-[#F5EFE6] text-stone-900 font-medium\'\\n                              : \'border-stone-200 bg-[#FAF8F4] text-stone-600 hover:border-stone-400\'\\n                          }`}\\n                        >\\n                          {opt.label}\\n                        </button>\\n                      ))}\\n                    </div>\\n                  </div>\\n\\n                  <div>\\n                    <span className=\\\"block text-xs font-medium text-stone-700 mb-2\\\">\\n                      Gallery Attire\\n                    </span>\\n                    <div className=\\\"grid grid-cols-1 gap-1.5\\\">\\n                      {outfitOptions.map((opt) => (\\n                        <button\\n                          key={opt.id}\\n                          type=\\\"button\\\"\\n                          onClick={() => onChangeAvatar({ ...avatar, outfitStyle: opt.id })}\\n                          className={`px-3 py-1.5 text-xs border text-left transition-colors cursor-pointer ${\\n                            avatar.outfitStyle === opt.id\\n                              ? \'border-[#8A5A2B] bg-[#F5EFE6] text-stone-900 font-medium\'\\n                              : \'border-stone-200 bg-[#FAF8F4] text-stone-600 hover:border-stone-400\'\\n                          }`}\\n                        >\\n                          {opt.label}\\n                        </button>\\n                      ))}\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                {/* Color Swatches: Skin, Hair, Outfit, Accent */}\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div>\\n                    <span className=\\\"block text-xs font-medium text-stone-700 mb-2\\\">\\n                      Skin Tone\\n                    </span>\\n                    <div className=\\\"flex flex-wrap gap-2\\\">\\n                      {SKIN_TONES.map((tone) => (\\n                        <button\\n                          key={tone.hex}\\n                          type=\\\"button\\\"\\n                          onClick={() => onChangeAvatar({ ...avatar, skinTone: tone.hex })}\\n                          aria-label={`Skin tone ${tone.label}`}\\n                          className={`w-7 h-7 border transition-transform cursor-pointer ${\\n                            avatar.skinTone === tone.hex\\n                              ? \'border-stone-950 scale-110 ring-2 ring-[#8A5A2B]/40\'\\n                              : \'border-stone-300 hover:scale-105\'\\n                          }`}\\n                          style={{ backgroundColor: tone.hex }}\\n                        />\\n                      ))}\\n                    </div>\\n                  </div>\\n\\n                  <div>\\n                    <span className=\\\"block text-xs font-medium text-stone-700 mb-2\\\">\\n                      Hair Color\\n                    </span>\\n                    <div className=\\\"flex flex-wrap gap-2\\\">\\n                      {HAIR_COLORS.map((c) => (\\n                        <button\\n                          key={c.hex}\\n                          type=\\\"button\\\"\\n                          onClick={() => onChangeAvatar({ ...avatar, hairColor: c.hex })}\\n                          aria-label={`Hair color ${c.label}`}\\n                          className={`w-7 h-7 border transition-transform cursor-pointer ${\\n                            avatar.hairColor === c.hex\\n                              ? \'border-stone-950 scale-110 ring-2 ring-[#8A5A2B]/40\'\\n                              : \'border-stone-300 hover:scale-105\'\\n                          }`}\\n                          style={{ backgroundColor: c.hex }}\\n                        />\\n                      ))}\\n                    </div>\\n                  </div>\\n\\n                  <div>\\n                    <span className=\\\"block text-xs font-medium text-stone-700 mb-2\\\">\\n                      Primary Wardrobe Color\\n                    </span>\\n                    <div className=\\\"flex flex-wrap gap-2\\\">\\n                      {OUTFIT_COLORS.map((c) => (\\n                        <button\\n                          key={c.hex}\\n                          type=\\\"button\\\"\\n                          onClick={() => onChangeAvatar({ ...avatar, outfitColor: c.hex })}\\n                          aria-label={`Outfit color ${c.label}`}\\n                          className={`w-7 h-7 border transition-transform cursor-pointer ${\\n                            avatar.outfitColor === c.hex\\n                              ? \'border-stone-950 scale-110 ring-2 ring-[#8A5A2B]/40\'\\n                              : \'border-stone-300 hover:scale-105\'\\n                          }`}\\n                          style={{ backgroundColor: c.hex }}\\n                        />\\n                      ))}\\n                    </div>\\n                  </div>\\n\\n                  <div>\\n                    <span className=\\\"block text-xs font-medium text-stone-700 mb-2\\\">\\n                      Accent & Trim\\n                    </span>\\n                    <div className=\\\"flex flex-wrap gap-2\\\">\\n                      {ACCENT_COLORS.map((c) => (\\n                        <button\\n                          key={c.hex}\\n                          type=\\\"button\\\"\\n                          onClick={() => onChangeAvatar({ ...avatar, accentColor: c.hex })}\\n                          aria-label={`Accent color ${c.label}`}\\n                          className={`w-7 h-7 border transition-transform cursor-pointer ${\\n                            avatar.accentColor === c.hex\\n                              ? \'border-stone-950 scale-110 ring-2 ring-[#8A5A2B]/40\'\\n                              : \'border-stone-300 hover:scale-105\'\\n                          }`}\\n                          style={{ backgroundColor: c.hex }}\\n                        />\\n                      ))}\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                {/* Accessories */}\\n                <div>\\n                  <span className=\\\"block text-xs font-medium text-stone-700 mb-2\\\">\\n                    Accessory\\n                  </span>\\n                  <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-2\\\">\\n                    {ACCESSORIES.map((acc) => (\\n                      <button\\n                        key={acc.id}\\n                        type=\\\"button\\\"\\n                        onClick={() =>\\n                          onChangeAvatar({ ...avatar, accessory: acc.id as AccessoryType })\\n                        }\\n                        className={`px-3 py-2 text-xs border transition-colors cursor-pointer whitespace-nowrap ${\\n                          avatar.accessory === acc.id\\n                            ? \'border-[#8A5A2B] bg-[#F5EFE6] text-stone-900 font-medium\'\\n                            : \'border-stone-200 bg-[#FAF8F4] text-stone-600 hover:border-stone-400\'\\n                        }`}\\n                      >\\n                        {acc.label}\\n                      </button>\\n                    ))}\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Primary Enter Museum Action */}\\n              <div className=\\\"mt-8 pt-6 border-t border-stone-200 flex flex-wrap items-center justify-between gap-4\\\">\\n                <div className=\\\"text-xs text-stone-500\\\">\\n                  Entering <span className=\\\"font-medium text-stone-800\\\">{museum.title}</span> as{\' \'}\\n                  <span className=\\\"font-medium text-stone-800\\\">\\n                    {avatar.gender === \'woman\' ? \'Woman\' : \'Man\'}\\n                  </span>\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onEnterMuseum}\\n                  className=\\\"inline-flex items-center gap-2.5 px-7 py-3 bg-[#8A5A2B] text-white text-sm font-medium hover:bg-[#734922] transition-colors cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  Enter 3D Museum\\n                  <ArrowRight className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* 4-Column Architectural Summary Strip below the Hero Split */}\\n          <div className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4 mt-8 pt-8 border-t border-stone-200\\\">\\n            <div>\\n              <p className=\\\"text-xs text-stone-500\\\">Curated Works</p>\\n              <p className=\\\"font-editorial text-3xl font-semibold text-stone-900 tabular-nums mt-1\\\">\\n                {artworks.length}\\n              </p>\\n              <p className=\\\"text-xs text-stone-500 mt-0.5\\\">Framed across gallery walls</p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-stone-500\\\">Dynamic Gallery Wings</p>\\n              <p className=\\\"font-editorial text-3xl font-semibold text-stone-900 tabular-nums mt-1\\\">\\n                {layout.bayCount} Wings\\n              </p>\\n              <p className=\\\"text-xs text-stone-500 mt-0.5\\\">\\n                {layout.totalWallSlots} total wall bays \302\267 expands automatically\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-stone-500\\\">Authorized Visitors</p>\\n              <p className=\\\"font-editorial text-3xl font-semibold text-stone-900 tabular-nums mt-1\\\">\\n                {members.length + 1}\\n              </p>\\n              <p className=\\\"text-xs text-stone-500 mt-0.5\\\">\\n                Gender-matched 3D visitors in hall\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-stone-500\\\">Corridor Length</p>\\n              <p className=\\\"font-editorial text-3xl font-semibold text-stone-900 tabular-nums mt-1\\\">\\n                {Math.round(layout.totalLength)}m\\n              </p>\\n              <p className=\\\"text-xs text-stone-500 mt-0.5\\\">\\n                Walkable neoclassical marble hall\\n              </p>\\n            </div>\\n          </div>\\n        </section>\\n\\n        {/* SECTION 2: Exhibition Collection Preview (Date-Sorted) */}\\n        <section id=\\\"collection\\\" className=\\\"bg-[#EFECE6] border-t border-b border-stone-200 py-14\\\">\\n          <div className=\\\"max-w-[1320px] mx-auto px-5 sm:px-8\\\">\\n            <div className=\\\"flex flex-wrap items-end justify-between gap-4 mb-8\\\">\\n              <div>\\n                <p className=\\\"text-xs font-mono text-[#8A5A2B] tracking-wider mb-1.5\\\">\\n                  CURATED ARCHIVE \302\267 CHRONOLOGICAL ORDER\\n                </p>\\n                <h2 className=\\\"font-editorial text-3xl sm:text-4xl font-semibold text-stone-900\\\">\\n                  Recent Works on the Gallery Walls\\n                </h2>\\n              </div>\\n\\n              <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onOpenUpload}\\n                  className=\\\"inline-flex items-center gap-1.5 px-4 py-2 bg-[#1C1917] text-[#F7F5F0] text-xs font-medium hover:bg-stone-800 transition-colors cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                  Add Artwork\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onOpenCatalog}\\n                  className=\\\"inline-flex items-center gap-1.5 px-4 py-2 bg-white border border-stone-300 text-stone-900 text-xs font-medium hover:border-stone-500 transition-colors cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <FolderKanban className=\\\"w-3.5 h-3.5 text-[#8A5A2B]\\\" />\\n                  View All Sorted by Date ({artworks.length})\\n                </button>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\\\">\\n              {recentArtworks.map((work) => {\\n                const slotIdx = artworks.findIndex((a) => a.id === work.id);\\n                return (\\n                  <article\\n                    key={work.id}\\n                    className=\\\"bg-white border border-stone-200 flex flex-col overflow-hidden\\\"\\n                  >\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => onInspectArtwork(work, Math.max(0, slotIdx))}\\n                      className=\\\"aspect-[4/3] bg-stone-200 overflow-hidden text-left cursor-pointer group\\\"\\n                    >\\n                      <img\\n                        src={work.imageUrl}\\n                        alt={work.title}\\n                        referrerPolicy=\\\"no-referrer\\\"\\n                        className=\\\"w-full h-full object-cover group-hover:scale-103 transition-transform duration-300\\\"\\n                      />\\n                    </button>\\n                    <div className=\\\"p-4 flex-1 flex flex-col\\\">\\n                      <p className=\\\"text-xs font-mono text-stone-500 tabular-nums flex items-center gap-1.5 mb-1\\\">\\n                        <Calendar className=\\\"w-3 h-3 text-[#8A5A2B]\\\" />\\n                        {formatArchivalDate(work.dateCaptured)}\\n                      </p>\\n                      <h3 className=\\\"font-editorial text-xl font-semibold text-stone-900 leading-snug\\\">\\n                        {work.title}\\n                      </h3>\\n                      <p className=\\\"text-xs text-stone-600 mt-1\\\">{work.artist}</p>\\n                    </div>\\n                  </article>\\n                );\\n              })}\\n            </div>\\n          </div>\\n        </section>\\n\\n        {/* SECTION 3: Shared Access & Multi-Museum Switching */}\\n        <section id=\\\"shared-access\\\" className=\\\"max-w-[1320px] mx-auto px-5 sm:px-8 py-14\\\">\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\\\">\\n            <div className=\\\"lg:col-span-5\\\">\\n              <p className=\\\"text-xs font-mono text-[#8A5A2B] tracking-wider mb-1.5\\\">\\n                SHARED EXHIBITIONS \302\267 COLLABORATIVE VISITS\\n              </p>\\n              <h2 className=\\\"font-editorial text-3xl sm:text-4xl font-semibold text-stone-900 mb-3 text-balance\\\">\\n                Invite companions to walk your museum together\\n              </h2>\\n              <p className=\\\"text-sm text-stone-600 leading-relaxed mb-6\\\">\\n                Grant private access by email or share your gallery code. Each visitor enters with their chosen Man or Woman 3D model, exploring your framed photographs and paintings side by side.\\n              </p>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onOpenAccess}\\n                className=\\\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#1C1917] text-[#F7F5F0] text-xs font-medium hover:bg-stone-800 transition-colors cursor-pointer\\\"\\n              >\\n                <Users className=\\\"w-4 h-4\\\" />\\n                Manage Access & Join Museum\\n              </button>\\n            </div>\\n\\n            <div className=\\\"lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n              {accessibleMuseums.map((m) => {\\n                const isActive = m.id === museum.id;\\n                return (\\n                  <button\\n                    key={m.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => onSwitchMuseum(m.id)}\\n                    className={`p-5 border text-left transition-colors cursor-pointer ${\\n                      isActive\\n                        ? \'border-[#8A5A2B] bg-white\'\\n                        : \'border-stone-200 bg-[#FAF8F4] hover:border-stone-400\'\\n                    }`}\\n                  >\\n                    <p className=\\\"text-xs font-mono text-[#8A5A2B] tabular-nums mb-1\\\">\\n                      {isActive ? \'ACTIVE GALLERY\' : \'AVAILABLE GALLERY\'} \302\267 {m.accessCode}\\n                    </p>\\n                    <h3 className=\\\"font-editorial text-2xl font-semibold text-stone-900\\\">\\n                      {m.title}\\n                    </h3>\\n                    <p className=\\\"text-xs text-stone-600 mt-1\\\">\\n                      Curated by {m.ownerName}\\n                    </p>\\n                  </button>\\n                );\\n              })}\\n\\n              <div className=\\\"p-5 border border-dashed border-stone-300 bg-[#FAF8F4] flex flex-col justify-between\\\">\\n                <div>\\n                  <p className=\\\"text-xs font-mono text-stone-500 mb-1\\\">AUTHORIZED ROSTER</p>\\n                  <p className=\\\"font-editorial text-2xl font-semibold text-stone-900\\\">\\n                    {members.length} Invited {members.length === 1 ? \'Visitor\' : \'Visitors\'}\\n                  </p>\\n                  <p className=\\\"text-xs text-stone-600 mt-1\\\">\\n                    {members.length > 0\\n                      ? members.map((m) => `${m.displayName} (${m.gender === \'woman\' ? \'Woman\' : \'Man\'})`).join(\' \302\267 \')\\n                      : \'Invite friends by email or share your code.\'}\\n                  </p>\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onOpenAccess}\\n                  className=\\\"mt-4 text-xs font-medium text-[#8A5A2B] hover:text-[#66401B] text-left cursor-pointer\\\"\\n                >\\n                  Add or manage visitors \342\206\222\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        </section>\\n\\n        {/* SECTION 4: Architectural Guide */}\\n        <section id=\\\"architecture\\\" className=\\\"border-t border-stone-200 bg-[#FAF8F4] py-12\\\">\\n          <div className=\\\"max-w-[1320px] mx-auto px-5 sm:px-8 grid grid-cols-1 md:grid-cols-3 gap-8\\\">\\n            <div>\\n              <p className=\\\"text-xs font-mono text-[#8A5A2B] mb-2\\\">01 \302\267 DYNAMIC ARCHITECTURE</p>\\n              <h3 className=\\\"font-editorial text-2xl font-semibold text-stone-900 mb-2\\\">\\n                Walls expand as you upload\\n              </h3>\\n              <p className=\\\"text-sm text-stone-600 leading-relaxed\\\">\\n                Every gallery wing frames two featured works across opposing walls. Uploading new images automatically extends the 3D marble corridor, skylights, pilasters, and picture lights.\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs font-mono text-[#8A5A2B] mb-2\\\">02 \302\267 CHRONOLOGICAL CATALOG</p>\\n              <h3 className=\\\"font-editorial text-2xl font-semibold text-stone-900 mb-2\\\">\\n                Browse every work sorted by date\\n              </h3>\\n              <p className=\\\"text-sm text-stone-600 leading-relaxed\\\">\\n                Open the exhibition catalog at any time to sort your entire museum newest-first or oldest-first, filter by keyword, and teleport your avatar directly in front of any frame.\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs font-mono text-[#8A5A2B] mb-2\\\">03 \302\267 WALKABLE 3D CONTROLS</p>\\n              <h3 className=\\\"font-editorial text-2xl font-semibold text-stone-900 mb-2\\\">\\n                Third-person & first-person exploration\\n              </h3>\\n              <p className=\\\"text-sm text-stone-600 leading-relaxed\\\">\\n                Walk with WASD or Arrow keys, drag to orbit your view around your customized 3D avatar, press V to toggle first-person gallery view, and click any framed piece to inspect its provenance.\\n              </p>\\n            </div>\\n          </div>\\n        </section>\\n      </main>\\n\\n      <footer className=\\\"border-t border-stone-200 bg-[#F7F5F0] py-6\\\">\\n        <div className=\\\"max-w-[1320px] mx-auto px-5 sm:px-8 flex flex-wrap items-center justify-between gap-4 text-xs text-stone-500\\\">\\n          <span className=\\\"font-editorial text-base text-stone-800\\\">My Museum</span>\\n          <span>3D Architectural Gallery \302\267 Personal & Shared Exhibitions</span>\\n        </div>\\n      </footer>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create HomeStudio page with 3-zone top bar, interactive 3D Avatar Studio, collection preview, and shared access section\", \"Overwrite\":true, \"TargetFile\":\"/src/components/HomeStudio.tsx\", \"toolAction\":\"Creating HomeStudio component\", \"toolSummary\":\"Create HomeStudio.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_4304158251172808761"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useCallback, useEffect, useMemo, useState } from \'react\';\\nimport { onAuthStateChanged, signInWithPopup, signOut, type User } from \'firebase/auth\';\\nimport { auth, googleProvider } from \'./firebase\';\\nimport {\\n  addArtworkToMuseum,\\n  deleteArtworkFromMuseum,\\n  ensurePersonalMuseum,\\n  findMuseumByAccessCode,\\n  grantMuseumAccess,\\n  loadOrCreateUserProfile,\\n  removePresence,\\n  revokeMuseumAccess,\\n  saveUserProfile,\\n  subscribeAccessibleMuseums,\\n  subscribeArtworks,\\n  subscribeMembers,\\n  subscribePresence,\\n  updateMuseumSettings,\\n  upsertPresence,\\n} from \'./services/museumService\';\\nimport {\\n  DEFAULT_AVATAR_BY_GENDER,\\n  type ArtworkItem,\\n  type AspectRatioType,\\n  type AvatarConfig,\\n  type FrameStyle,\\n  type Gender,\\n  type MemberRole,\\n  type MuseumMember,\\n  type MuseumMeta,\\n  type VisitorPresence,\\n  type WallTheme,\\n} from \'./types/museum\';\\nimport {\\n  createSeedArtworks,\\n  createSeedMembers,\\n  createSeedMuseum,\\n} from \'./data/seedMuseum\';\\nimport { ErrorBoundary } from \'./components/ErrorBoundary\';\\nimport { HomeStudio } from \'./components/HomeStudio\';\\nimport { Museum3DView } from \'./components/Museum3DView\';\\nimport { CatalogDrawer } from \'./components/CatalogDrawer\';\\nimport { UploadArtworkModal } from \'./components/UploadArtworkModal\';\\nimport { AccessModal } from \'./components/AccessModal\';\\nimport { ArtworkInspectModal } from \'./components/ArtworkInspectModal\';\\n\\nconst STORAGE_AVATAR_KEY = \'mymuseum_avatar_v1\';\\nconst STORAGE_ARTWORKS_KEY = \'mymuseum_guest_artworks_v1\';\\nconst STORAGE_MEMBERS_KEY = \'mymuseum_guest_members_v1\';\\nconst STORAGE_MUSEUM_KEY = \'mymuseum_guest_museum_v1\';\\n\\nfunction loadStoredJson<T>(key: string, fallback: T): T {\\n  try {\\n    const raw = window.localStorage.getItem(key);\\n    if (!raw) return fallback;\\n    return JSON.parse(raw) as T;\\n  } catch {\\n    return fallback;\\n  }\\n}\\n\\nfunction MyMuseumApp() {\\n  const autostart = useMemo(() => {\\n    const params = new URLSearchParams(window.location.search);\\n    return params.get(\'autostart\') === \'1\';\\n  }, []);\\n\\n  const [view, setView] = useState<\'home\' | \'museum\'>(autostart ? \'museum\' : \'home\');\\n  const [user, setUser] = useState<User | null>(null);\\n  const [authLoading, setAuthLoading] = useState(true);\\n\\n  // Avatar Config (synced with Firestore when signed in, localStorage when guest)\\n  const [avatar, setAvatar] = useState<AvatarConfig>(() =>\\n    loadStoredJson<AvatarConfig>(STORAGE_AVATAR_KEY, DEFAULT_AVATAR_BY_GENDER.man)\\n  );\\n\\n  // Guest / Fallback local museum state\\n  const [guestMuseum, setGuestMuseum] = useState<MuseumMeta>(() =>\\n    loadStoredJson<MuseumMeta>(STORAGE_MUSEUM_KEY, createSeedMuseum(\'guest\', \'Julian Vance\'))\\n  );\\n  const [guestArtworks, setGuestArtworks] = useState<ArtworkItem[]>(() =>\\n    loadStoredJson<ArtworkItem[]>(\\n      STORAGE_ARTWORKS_KEY,\\n      createSeedArtworks(\'museum-guest\', \'guest\', \'Julian Vance\')\\n    )\\n  );\\n  const [guestMembers, setGuestMembers] = useState<MuseumMember[]>(() =>\\n    loadStoredJson<MuseumMember[]>(\\n      STORAGE_MEMBERS_KEY,\\n      createSeedMembers(\'museum-guest\', \'guest\')\\n    )\\n  );\\n\\n  // Firestore synced state when authenticated\\n  const [cloudMuseums, setCloudMuseums] = useState<MuseumMeta[]>([]);\\n  const [activeMuseumId, setActiveMuseumId] = useState<string>(\'\');\\n  const [cloudArtworks, setCloudArtworks] = useState<ArtworkItem[]>([]);\\n  const [cloudMembers, setCloudMembers] = useState<MuseumMember[]>([]);\\n  const [liveVisitors, setLiveVisitors] = useState<VisitorPresence[]>([]);\\n\\n  // Shared Modals & Drawers\\n  const [catalogOpen, setCatalogOpen] = useState(false);\\n  const [uploadOpen, setUploadOpen] = useState(false);\\n  const [accessOpen, setAccessOpen] = useState(false);\\n  const [showInvitedIn3D, setShowInvitedIn3D] = useState(true);\\n  const [inspectState, setInspectState] = useState<{\\n    artwork: ArtworkItem | null;\\n    slotIndex: number;\\n  }>({ artwork: null, slotIndex: 0 });\\n  const [teleportTargetId, setTeleportTargetId] = useState<string | null>(null);\\n  const [toastMsg, setToastMsg] = useState<string | null>(null);\\n\\n  const showToast = useCallback((msg: string) => {\\n    setToastMsg(msg);\\n    window.setTimeout(() => {\\n      setToastMsg((cur) => (cur === msg ? null : cur));\\n    }, 3200);\\n  }, []);\\n\\n  // Persist guest state cleanly in localStorage\\n  useEffect(() => {\\n    try {\\n      window.localStorage.setItem(STORAGE_AVATAR_KEY, JSON.stringify(avatar));\\n    } catch {\\n      // Ignore storage quota issues\\n    }\\n  }, [avatar]);\\n\\n  useEffect(() => {\\n    if (user) return;\\n    try {\\n      window.localStorage.setItem(STORAGE_MUSEUM_KEY, JSON.stringify(guestMuseum));\\n      window.localStorage.setItem(STORAGE_ARTWORKS_KEY, JSON.stringify(guestArtworks));\\n      window.localStorage.setItem(STORAGE_MEMBERS_KEY, JSON.stringify(guestMembers));\\n    } catch {\\n      // Ignore storage quota issues\\n    }\\n  }, [user, guestMuseum, guestArtworks, guestMembers]);\\n\\n  // Firebase Auth listener\\n  useEffect(() => {\\n    const unsub = onAuthStateChanged(auth, async (nextUser) => {\\n      setUser(nextUser);\\n      setAuthLoading(false);\\n      if (nextUser) {\\n        try {\\n          const loadedProfile = await loadOrCreateUserProfile(nextUser, avatar);\\n          setAvatar(loadedProfile);\\n          const personal = await ensurePersonalMuseum(nextUser, loadedProfile.displayName);\\n          setActiveMuseumId((prev) => prev || personal.id);\\n        } catch (err) {\\n          console.error(\'Error initializing cloud museum:\', err);\\n        }\\n      } else {\\n        setCloudMuseums([]);\\n        setCloudArtworks([]);\\n        setCloudMembers([]);\\n        setLiveVisitors([]);\\n      }\\n    });\\n    return () => unsub();\\n  }, []);\\n\\n  // Subscribe to owned + shared museums when authenticated\\n  useEffect(() => {\\n    if (!user) return;\\n    const unsub = subscribeAccessibleMuseums(user, (list) => {\\n      setCloudMuseums(list);\\n      if (list.length > 0) {\\n        setActiveMuseumId((prev) => (list.some((m) => m.id === prev) ? prev : list[0].id));\\n      }\\n    });\\n    return () => unsub();\\n  }, [user]);\\n\\n  const activeMuseum: MuseumMeta = useMemo(() => {\\n    if (user && cloudMuseums.length > 0) {\\n      return cloudMuseums.find((m) => m.id === activeMuseumId) ?? cloudMuseums[0];\\n    }\\n    return guestMuseum;\\n  }, [user, cloudMuseums, activeMuseumId, guestMuseum]);\\n\\n  const accessibleMuseums = user && cloudMuseums.length > 0 ? cloudMuseums : [guestMuseum];\\n  const artworks = user && cloudMuseums.length > 0 ? cloudArtworks : guestArtworks;\\n  const members = user && cloudMuseums.length > 0 ? cloudMembers : guestMembers;\\n\\n  const isOwner = user ? activeMuseum.ownerId === user.uid : true;\\n  const canCurate = useMemo(() => {\\n    if (!user) return true;\\n    if (activeMuseum.ownerId === user.uid) return true;\\n    const email = (user.email || \'\').toLowerCase();\\n    return Boolean(user.emailVerified && activeMuseum.curatorEmails.includes(email));\\n  }, [user, activeMuseum]);\\n\\n  // Subscribe to active museum artworks, members, and real-time visitor presence\\n  useEffect(() => {\\n    if (!user || cloudMuseums.length === 0) return;\\n    const unsubArt = subscribeArtworks(activeMuseum, user, setCloudArtworks);\\n    const unsubMem = subscribeMembers(activeMuseum, user, setCloudMembers);\\n    const unsubPres = subscribePresence(activeMuseum, user, setLiveVisitors);\\n    return () => {\\n      unsubArt();\\n      unsubMem();\\n      unsubPres();\\n    };\\n  }, [user, activeMuseum, cloudMuseums.length]);\\n\\n  // Clean up own presence when leaving the 3D museum view\\n  useEffect(() => {\\n    if (view !== \'museum\' && user && activeMuseum.id) {\\n      void removePresence(activeMuseum.id, user.uid);\\n    }\\n  }, [view, user, activeMuseum.id]);\\n\\n  const handleSignInGoogle = async () => {\\n    try {\\n      await signInWithPopup(auth, googleProvider);\\n      showToast(\'Signed in with Google. Your avatar and museum are synced.\');\\n    } catch (err) {\\n      console.warn(\'Google sign-in cancelled or failed:\', err);\\n      showToast(\'Sign-in was cancelled. You can continue customizing in Guest Studio Mode.\');\\n    }\\n  };\\n\\n  const handleSignOut = async () => {\\n    if (user && activeMuseum.id) {\\n      await removePresence(activeMuseum.id, user.uid);\\n    }\\n    await signOut(auth);\\n    showToast(\'Signed out.\');\\n  };\\n\\n  const handleAvatarChange = (next: AvatarConfig) => {\\n    setAvatar(next);\\n  };\\n\\n  const handleEnterMuseum = async () => {\\n    if (user) {\\n      try {\\n        await saveUserProfile(user, avatar);\\n      } catch (err) {\\n        console.warn(\'Could not sync avatar profile before entering:\', err);\\n      }\\n    }\\n    setView(\'museum\');\\n  };\\n\\n  const handleAddArtwork = async (payload: {\\n    title: string;\\n    artist: string;\\n    dateCaptured: string;\\n    notes: string;\\n    imageUrl: string;\\n    aspectRatio: AspectRatioType;\\n    frameStyle: FrameStyle;\\n  }) => {\\n    const prevCount = artworks.length;\\n    const prevWings = Math.max(2, Math.ceil(prevCount / 2));\\n    const nextWings = Math.max(2, Math.ceil((prevCount + 1) / 2));\\n\\n    if (user && cloudMuseums.length > 0) {\\n      await addArtworkToMuseum(activeMuseum, user, avatar.displayName, payload);\\n    } else {\\n      const newWork: ArtworkItem = {\\n        id: `guest-art-${Date.now()}`,\\n        museumId: guestMuseum.id,\\n        ownerId: guestMuseum.ownerId,\\n        uploadedBy: guestMuseum.ownerId,\\n        uploadedByName: avatar.displayName || \'Curator\',\\n        title: payload.title,\\n        artist: payload.artist,\\n        dateCaptured: payload.dateCaptured,\\n        notes: payload.notes,\\n        imageUrl: payload.imageUrl,\\n        aspectRatio: payload.aspectRatio,\\n        frameStyle: payload.frameStyle,\\n        isOpenByCode: guestMuseum.isOpenByCode,\\n        viewerEmails: guestMuseum.memberEmails,\\n      };\\n      setGuestArtworks((prev) => [...prev, newWork]);\\n      setGuestMuseum((m) => ({ ...m, artworkCount: prevCount + 1 }));\\n    }\\n\\n    if (nextWings > prevWings) {\\n      showToast(`Artwork hung! Museum expanded to Wing ${nextWings} automatically.`);\\n    } else {\\n      showToast(`\\\"${payload.title}\\\" added to the gallery wall.`);\\n    }\\n  };\\n\\n  const handleDeleteArtwork = async (artworkId: string) => {\\n    if (user && cloudMuseums.length > 0) {\\n      await deleteArtworkFromMuseum(activeMuseum, user, artworkId);\\n    } else {\\n      setGuestArtworks((prev) => prev.filter((a) => a.id !== artworkId));\\n      setGuestMuseum((m) => ({ ...m, artworkCount: Math.max(0, m.artworkCount - 1) }));\\n    }\\n    showToast(\'Artwork removed from the gallery wall.\');\\n  };\\n\\n  const handleGrantAccess = async (input: {\\n    email: string;\\n    displayName: string;\\n    role: MemberRole;\\n    gender: Gender;\\n  }) => {\\n    if (user && cloudMuseums.length > 0) {\\n      await grantMuseumAccess(activeMuseum, input);\\n    } else {\\n      const nextMember: MuseumMember = {\\n        id: `guest-mem-${Date.now()}`,\\n        museumId: guestMuseum.id,\\n        ownerId: guestMuseum.ownerId,\\n        email: input.email,\\n        displayName: input.displayName,\\n        role: input.role,\\n        gender: input.gender,\\n      };\\n      setGuestMembers((prev) => [...prev, nextMember]);\\n      setGuestMuseum((m) => ({\\n        ...m,\\n        memberEmails: Array.from(new Set([...m.memberEmails, input.email])).slice(0, 10),\\n        curatorEmails:\\n          input.role === \'curator\'\\n            ? Array.from(new Set([...m.curatorEmails, input.email])).slice(0, 10)\\n            : m.curatorEmails,\\n      }));\\n    }\\n    showToast(`Access granted to ${input.displayName} (${input.gender === \'woman\' ? \'Woman\' : \'Man\'} avatar).`);\\n  };\\n\\n  const handleRevokeAccess = async (member: MuseumMember) => {\\n    if (user && cloudMuseums.length > 0) {\\n      await revokeMuseumAccess(activeMuseum, member);\\n    } else {\\n      setGuestMembers((prev) => prev.filter((m) => m.id !== member.id));\\n      setGuestMuseum((m) => ({\\n        ...m,\\n        memberEmails: m.memberEmails.filter((e) => e !== member.email),\\n        curatorEmails: m.curatorEmails.filter((e) => e !== member.email),\\n      }));\\n    }\\n    showToast(`Access revoked for ${member.displayName}.`);\\n  };\\n\\n  const handleToggleOpenByCode = async (isOpen: boolean) => {\\n    if (user && cloudMuseums.length > 0) {\\n      await updateMuseumSettings(activeMuseum, { isOpenByCode: isOpen });\\n    } else {\\n      setGuestMuseum((m) => ({ ...m, isOpenByCode: isOpen }));\\n    }\\n  };\\n\\n  const handleChangeWallTheme = async (wallTheme: WallTheme) => {\\n    if (user && cloudMuseums.length > 0 && isOwner) {\\n      await updateMuseumSettings(activeMuseum, { wallTheme });\\n    } else {\\n      setGuestMuseum((m) => ({ ...m, wallTheme }));\\n    }\\n  };\\n\\n  const handleJoinByCode = async (code: string): Promise<string | null> => {\\n    if (!user) {\\n      if (code === guestMuseum.accessCode) {\\n        setView(\'museum\');\\n        return null;\\n      }\\n      return \'Sign in with Google to join another user\342\200\231s cloud museum by access code.\';\\n    }\\n    const found = await findMuseumByAccessCode(code);\\n    if (!found) {\\n      return \'No museum found with that access code, or entry is restricted.\';\\n    }\\n    setCloudMuseums((prev) => (prev.some((m) => m.id === found.id) ? prev : [...prev, found]));\\n    setActiveMuseumId(found.id);\\n    setView(\'museum\');\\n    showToast(`Entered \\\"${found.title}\\\" as ${avatar.displayName}.`);\\n    return null;\\n  };\\n\\n  const handlePositionBroadcast = useCallback(\\n    (x: number, z: number, yaw: number) => {\\n      if (!user || cloudMuseums.length === 0) return;\\n      void upsertPresence(activeMuseum, user, avatar, x, z, yaw);\\n    },\\n    [user, cloudMuseums.length, activeMuseum, avatar]\\n  );\\n\\n  return (\\n    <div data-view={view}>\\n      {view === \'home\' ? (\\n        <HomeStudio\\n          user={user}\\n          authLoading={authLoading}\\n          avatar={avatar}\\n          museum={activeMuseum}\\n          artworks={artworks}\\n          members={members}\\n          accessibleMuseums={accessibleMuseums}\\n          onSignInGoogle={handleSignInGoogle}\\n          onSignOut={handleSignOut}\\n          onChangeAvatar={handleAvatarChange}\\n          onEnterMuseum={handleEnterMuseum}\\n          onOpenCatalog={() => setCatalogOpen(true)}\\n          onOpenUpload={() => setUploadOpen(true)}\\n          onOpenAccess={() => setAccessOpen(true)}\\n          onSwitchMuseum={(id) => {\\n            setActiveMuseumId(id);\\n            showToast(\'Switched active museum.\');\\n          }}\\n          onInspectArtwork={(artwork, slotIndex) =>\\n            setInspectState({ artwork, slotIndex })\\n          }\\n        />\\n      ) : (\\n        <Museum3DView\\n          museum={activeMuseum}\\n          avatar={avatar}\\n          artworks={artworks}\\n          members={members}\\n          liveVisitors={liveVisitors}\\n          showInvitedIn3D={showInvitedIn3D}\\n          canCurate={canCurate}\\n          teleportTargetId={teleportTargetId}\\n          onClearTeleport={() => setTeleportTargetId(null)}\\n          onSelectArtwork={(artwork, slotIndex) =>\\n            setInspectState({ artwork, slotIndex })\\n          }\\n          onOpenCatalog={() => setCatalogOpen(true)}\\n          onOpenUpload={() => setUploadOpen(true)}\\n          onOpenAccess={() => setAccessOpen(true)}\\n          onReturnHome={() => setView(\'home\')}\\n          onChangeWallTheme={handleChangeWallTheme}\\n          onPositionBroadcast={handlePositionBroadcast}\\n        />\\n      )}\\n\\n      {/* Date-Sorted Complete Archival Catalog Drawer */}\\n      <CatalogDrawer\\n        open={catalogOpen}\\n        onClose={() => setCatalogOpen(false)}\\n        artworks={artworks}\\n        canCurate={canCurate}\\n        onWalkToArtwork={\\n          view === \'museum\'\\n            ? (id) => setTeleportTargetId(id)\\n            : (id) => {\\n                setView(\'museum\');\\n                setTeleportTargetId(id);\\n              }\\n        }\\n        onInspectArtwork={(artwork, slotIndex) =>\\n          setInspectState({ artwork, slotIndex })\\n        }\\n        onDeleteArtwork={handleDeleteArtwork}\\n        onOpenUpload={() => {\\n          setCatalogOpen(false);\\n          setUploadOpen(true);\\n        }}\\n      />\\n\\n      {/* Upload / Hang New Artwork Modal */}\\n      <UploadArtworkModal\\n        open={uploadOpen}\\n        onClose={() => setUploadOpen(false)}\\n        currentArtworkCount={artworks.length}\\n        defaultArtist={avatar.displayName}\\n        onSubmitArtwork={handleAddArtwork}\\n      />\\n\\n      {/* Shared Museum Access & Multi-Visitor Modal */}\\n      <AccessModal\\n        open={accessOpen}\\n        onClose={() => setAccessOpen(false)}\\n        museum={activeMuseum}\\n        isOwner={isOwner}\\n        members={members}\\n        accessibleMuseums={accessibleMuseums}\\n        showInvitedIn3D={showInvitedIn3D}\\n        onToggleShowInvitedIn3D={setShowInvitedIn3D}\\n        onGrantAccess={handleGrantAccess}\\n        onRevokeAccess={handleRevokeAccess}\\n        onToggleOpenByCode={handleToggleOpenByCode}\\n        onJoinByCode={handleJoinByCode}\\n        onSwitchMuseum={(id) => {\\n          setActiveMuseumId(id);\\n          setView(\'museum\');\\n        }}\\n      />\\n\\n      {/* Artwork Inspection Modal */}\\n      <ArtworkInspectModal\\n        artwork={inspectState.artwork}\\n        slotIndex={inspectState.slotIndex}\\n        canDelete={canCurate}\\n        onClose={() => setInspectState({ artwork: null, slotIndex: 0 })}\\n        onWalkTo={(id) => {\\n          setView(\'museum\');\\n          setTeleportTargetId(id);\\n        }}\\n        onDelete={handleDeleteArtwork}\\n      />\\n\\n      {/* Quiet Toast Feedback */}\\n      {toastMsg && (\\n        <div\\n          role=\\\"status\\\"\\n          aria-live=\\\"polite\\\"\\n          className=\\\"fixed top-5 right-5 z-50 bg-[#1C1917] text-[#F7F5F0] border border-[#C99A5B]/60 px-4 py-2.5 text-xs shadow-lg max-w-sm\\\"\\n        >\\n          {toastMsg}\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\\nexport default function App() {\\n  return (\\n    <ErrorBoundary>\\n      <MyMuseumApp />\\n    </ErrorBoundary>\\n  );\\n}\\n\", \"Description\":\"Wire complete My Museum application with Firebase Auth/Firestore sync, Guest Studio mode, 3D Museum, Date Catalog, and Shared Access\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating src/App.tsx\", \"toolSummary\":\"Update src/App.tsx\"}"
